<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Asked for the first time a notice is posted as a notification, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No backup: the tokens are sealed with a key that never leaves this device's keystore, so a
         restored copy could not open them, and everything else comes back from AniList and the stores. -->
    <application
        android:name=".AnistreamApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anistream">

        <!-- A turn or a fold changes the configuration without recreating the activity, so the
             player, its surface and the shared state stay where they are. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Where the AniList and MyAnimeList sign-ins send the browser back:
                 anistream://auth/anilist and anistream://auth/mal. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anistream" android:host="auth" android:pathPrefix="/" />
            </intent-filter>
            <!-- Plugin store invites, which open the join sheet with the link in it:
                 anistream://join?link=<the store's https invite>, and the store's own
                 https://<host>/join/<code>#<key> with anistream:// in place of https://. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anistream" android:host="join" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anistream" android:host="*" android:pathPrefix="/join/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
