<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window before Compose draws: the ground colour from the first frame, the splash screen
         too, so a launch never flashes white. -->
    <style name="Theme.Anistream" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:windowSplashScreenBackground">@color/ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
