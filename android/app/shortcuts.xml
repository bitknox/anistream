<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's static shortcuts: Search and Downloads. Each opens the activity on an app link,
     anistream://open/…, which the frame follows through the app's own navigation (AppLinks.kt).
     Continue <title> is published from the Continue queue at run time (ContinueShortcut).
     build.gradle.kts writes this into each variant's res/xml/shortcuts.xml with its application id
     over the placeholder: the system takes the target package as written, never a resource. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@drawable/shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search_long"
        android:shortcutDisabledMessage="@string/shortcut_unavailable">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="anistream://open/search"
            android:targetPackage="${applicationId}"
            android:targetClass="tv.anistream.app.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="downloads"
        android:enabled="true"
        android:icon="@drawable/shortcut_downloads"
        android:shortcutShortLabel="@string/shortcut_downloads"
        android:shortcutLongLabel="@string/shortcut_downloads"
        android:shortcutDisabledMessage="@string/shortcut_unavailable">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="anistream://open/downloads"
            android:targetPackage="${applicationId}"
            android:targetClass="tv.anistream.app.MainActivity" />
    </shortcut>
</shortcuts>
