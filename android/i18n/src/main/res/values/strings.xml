<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/i18n from i18n/. Do not edit: change the catalogue and run
     `cargo run -p i18n-tool generate`. -->
<resources>
    <!-- A reason on its own, as a toast or a failed play's explanation. The reason is one of the engine's own reasons, so it is translated. -->
    <string name="notice_reason">%1$s</string>
    <!-- Reason: no source is set up, so nothing can be played or downloaded. Shown in a toast. -->
    <string name="cause_no_sources">No sources are set up. Add one on the Sources screen.</string>
    <!-- A play's explanation: the episode's broadcast is still ahead. The "when" says today, tomorrow or a date. -->
    <string name="notice_not_aired">Episode %1$d airs %2$s.</string>
    <!-- A play's explanation: the episode is after the next one to air. The "when" says when that one airs. -->
    <string name="notice_not_aired_yet">Episode %1$d hasn\'t aired yet. Episode %2$d airs %3$s.</string>
    <!-- Part of an air time: the broadcast is later today. The time is the viewer's local time. -->
    <string name="cause_airs_today">today at %1$s</string>
    <!-- Part of an air time: the broadcast is tomorrow. The time is the viewer's local time. -->
    <string name="cause_airs_tomorrow">tomorrow at %1$s</string>
    <!-- Part of an air time: the broadcast is within the next week. -->
    <plurals name="cause_airs_in_days">
        <item quantity="one">in one day at %2$s</item>
        <item quantity="other">in %1$d days at %2$s</item>
    </plurals>
    <!-- Part of an air time: the broadcast is more than a week away. The date is year-month-day. -->
    <string name="cause_airs_on_date">on %1$s at %2$s</string>
    <!-- Reason: the source answered but gave nothing to play. -->
    <string name="cause_no_playable_stream">The source answered, but with nothing to play. Try another.</string>
    <!-- Reason: no source could be matched to the title. The detail is what each source said. -->
    <string name="cause_title_no_match">Couldn\'t match this title: %1$s</string>
    <!-- Reason: the source the person picked is no longer installed or enabled. -->
    <string name="cause_source_gone">The source %1$s is no longer available. Choose another.</string>
    <!-- Reason: the release the person picked would not start. The detail comes from the source. -->
    <string name="cause_release_failed">Couldn\'t start that release: %1$s</string>
    <!-- Reason: every source matched the title but none has the episode. The detail is what each said. -->
    <string name="cause_no_source_has_episode">No source has episode %1$s: %2$s</string>
    <!-- Reason: the source streams episodes but only torrents can be downloaded. -->
    <string name="cause_source_cannot_download">This source streams episodes but can\'t download them.</string>
    <!-- Reason: the title was never listed by a source, so it can't be downloaded. -->
    <string name="cause_no_source_could_list_show">No source could list this show, so it can\'t be downloaded.</string>
    <!-- Part of a finished download's toast: subtitle files were merged into the video. -->
    <plurals name="cause_subtitles_merged">
        <item quantity="one">One subtitle track was merged in.</item>
        <item quantity="other">%1$d subtitle tracks were merged in.</item>
    </plurals>
    <!-- Part of a finished download's toast: merging failed, so the subtitles stay as files beside it. -->
    <string name="cause_subtitles_left_apart">The subtitles stay as separate files. %1$s</string>
    <!-- Part of a download toast: how many episodes of the range were in the queue already. -->
    <plurals name="cause_already_in_downloads">
        <item quantity="one">One episode is already in downloads.</item>
        <item quantity="other">%1$d episodes are already in downloads.</item>
    </plurals>
    <!-- Job note while a play looks the title up. -->
    <string name="status_looking_up_title">Looking up the title…</string>
    <!-- Job note while a play waits for the sources to arrive. -->
    <string name="status_loading_sources">Loading sources…</string>
    <!-- Job note while the sources are asked for an episode. The episode is its label, often a number. -->
    <string name="status_searching_sources">Searching sources for episode %1$s…</string>
    <!-- Status while the player opens. -->
    <string name="status_starting_player">Starting mpv…</string>
    <!-- Status line while an episode plays. -->
    <string name="status_playing">Playing %1$s, episode %2$s</string>
    <!-- Toast when the player cannot be started. The reason comes from the system. -->
    <string name="notice_player_failed_to_start">Couldn\'t start mpv. Check that it runs on its own. (%1$s)</string>
    <!-- Toast when a stream never showed a frame and the next one is tried. -->
    <string name="notice_stream_no_video">No video from that stream. Trying %1$d of %2$d.</string>
    <!-- Toast when mpv gave up on a file. The reason is mpv's own line. -->
    <string name="notice_player_could_not_play">mpv couldn\'t play this. %1$s</string>
    <!-- Toast when mpv closed without playing and without saying why. -->
    <string name="notice_player_exited_silently">mpv exited without playing anything and gave no reason. Try another source.</string>
    <!-- Toast when no picture has appeared a while after the player opened. -->
    <string name="notice_player_not_playing">mpv hasn\'t started playing after %1$d s. The source may have no data. Check that mpv plays a file on its own.</string>
    <!-- Toast when a play is asked for in a build with no player. -->
    <string name="notice_no_player">This version of anistream can\'t play video.</string>
    <!-- Toast at launch when the mpv program is missing. The binary is the name the settings give it. -->
    <string name="notice_mpv_missing">%1$s wasn\'t found. Install mpv to play episodes.</string>
    <!-- Toast at launch when mpv is too old for anistream's own player. -->
    <string name="notice_mpv_old">mpv %1$s can play, but anistream\'s player needs mpv 0.36 or newer for its skip button, Up next card, menus and thumbnails.</string>
    <!-- Toast after a link was handed to the browser. -->
    <string name="notice_opened_in_browser">Opened in your browser.</string>
    <!-- Toast when a link could not be opened. The reason comes from the system. -->
    <string name="notice_could_not_open">Couldn\'t open that. %1$s</string>
    <!-- Toast when a trailer plays in mpv. -->
    <string name="notice_trailer_playing">Trailer playing in mpv.</string>
    <!-- Toast when a trailer opens in the browser. -->
    <string name="notice_trailer_opened">Trailer opened in your browser.</string>
    <!-- Toast when a trailer could not be opened. The reason comes from the system. -->
    <string name="notice_trailer_failed">Couldn\'t open the trailer. %1$s</string>
    <!-- Toast when the next episode is not the one after this because filler was skipped. -->
    <string name="notice_filler_skipped">Skipped filler. Up next is episode %1$s.</string>
    <!-- Toast after switching the audio while playing. -->
    <string name="notice_audio_now_subbed">Audio is now subbed.</string>
    <!-- Toast after switching the audio while playing. -->
    <string name="notice_audio_now_dubbed">Audio is now dubbed.</string>
    <!-- Toast when the previous-episode control is used on the first episode. -->
    <string name="notice_already_first_episode">Already at the first episode.</string>
    <!-- Toast when the next-episode control is used on the last known episode. -->
    <string name="notice_last_episode">There\'s no next episode. Episode %1$s is the last.</string>
    <!-- Toast when the next-episode control is used and the next episode is not known. -->
    <string name="notice_no_next_episode">There\'s no next episode.</string>
    <!-- Toast when the previous-episode control finds no previous episode. -->
    <string name="notice_no_previous_episode">There\'s no previous episode.</string>
    <!-- Toast when the title's episode match could not be cleared. The reason comes from the system. -->
    <string name="notice_match_reset_failed">Couldn\'t reset the match. %1$s</string>
    <!-- Toast when the chosen match could not be saved. The reason comes from the system. -->
    <string name="notice_match_save_failed">Couldn\'t save that match. %1$s</string>
    <!-- Toast when a chosen match still left the title undecided. -->
    <string name="notice_match_did_not_stick">That match didn\'t stick. The source may have changed. Try choosing it again.</string>
    <!-- Toast when a search of the sources for a title found nothing. -->
    <string name="notice_source_search_empty">Nothing found for “%1$s”. Try a different search.</string>
    <!-- Toast after the person picked a source for one title. -->
    <string name="notice_source_pinned">%1$s will be used for this title.</string>
    <!-- Toast after the person went back to automatic source selection for one title. -->
    <string name="notice_source_automatic">Back to automatic source selection.</string>
    <!-- Toast when the source choice for a title could not be saved. The reason comes from the system. -->
    <string name="notice_source_choice_failed">Couldn\'t save that choice. %1$s</string>
    <!-- Toast when no source could list a show's episodes. The reason is what the sources said. -->
    <string name="notice_no_source_could_list">No source could list this show: %1$s</string>
    <!-- Toast when a title cannot be taken off the Continue row. The reason comes from the system. -->
    <string name="notice_continue_hide_failed">Couldn\'t remove that from Continue. %1$s</string>
    <!-- Toast after an episode was added to the download queue. -->
    <string name="notice_download_queued">Queued episode %2$s of %1$s.</string>
    <!-- Toast when an episode asked for is in downloads already. -->
    <string name="notice_download_already_queued">Episode %2$s of %1$s is already in downloads.</string>
    <!-- Toast when a waiting or paused download was moved to the front and started. -->
    <string name="notice_download_starting_now">Starting episode %2$s of %1$s now.</string>
    <!-- Toast after a download was cancelled. -->
    <string name="notice_download_cancelled">Download cancelled.</string>
    <!-- Toast after a download and its file were deleted. -->
    <string name="notice_download_file_deleted">Download and file deleted.</string>
    <!-- Toast after a download was removed whose file was already gone. -->
    <string name="notice_download_removed_file_gone">Download removed. Its file was already gone.</string>
    <!-- Toast after a download was removed but its file could not be deleted. The reason comes from the system. -->
    <string name="notice_download_removed_file_kept">Removed the download, but couldn\'t delete its file. %1$s</string>
    <!-- Toast after a download with no file was removed. -->
    <string name="notice_download_removed">Download removed.</string>
    <!-- Toast after finished downloads were cleared from the list. -->
    <plurals name="notice_downloads_cleared">
        <item quantity="one">Cleared one finished download.</item>
        <item quantity="other">Cleared %1$d finished downloads.</item>
    </plurals>
    <!-- Toast when an episode finished downloading. -->
    <string name="notice_download_finished">Downloaded episode %2$s of %1$s.</string>
    <!-- Toast when an episode finished downloading and the note says what happened to its subtitles. -->
    <string name="notice_download_finished_note">Downloaded episode %2$s of %1$s. %3$s</string>
    <!-- Toast when a download could not start. The reason comes from the torrent client. -->
    <string name="notice_download_failed">Couldn\'t download episode %2$s of %1$s. %3$s</string>
    <!-- Toast after a range was asked for and nothing was queued. -->
    <string name="notice_downloads_none_queued">Nothing queued.</string>
    <!-- Toast after a range was asked for and nothing was queued, and the reason it stopped. -->
    <string name="notice_downloads_none_queued_stopped">Nothing queued. %1$s</string>
    <!-- Toast after a range was asked for and every episode was in the queue already. -->
    <string name="notice_downloads_none_new">Nothing new queued. %1$s</string>
    <!-- Toast as above, with the reason the range stopped. -->
    <string name="notice_downloads_none_new_stopped">Nothing new queued. %1$s %2$s</string>
    <!-- Toast after a range was asked for, some episodes were queued and some were there already. -->
    <plurals name="notice_episodes_queued_existing">
        <item quantity="one">Queued one episode. %2$s</item>
        <item quantity="other">Queued %1$d episodes. %2$s</item>
    </plurals>
    <!-- Toast as above, with the reason the range stopped. -->
    <plurals name="notice_episodes_queued_stopped">
        <item quantity="one">Queued one episode, then it stopped. %2$s</item>
        <item quantity="other">Queued %1$d episodes, then it stopped. %2$s</item>
    </plurals>
    <!-- Toast as above, with some episodes in the queue already and the reason the range stopped. -->
    <plurals name="notice_episodes_queued_existing_stopped">
        <item quantity="one">Queued one episode, then it stopped. %2$s %3$s</item>
        <item quantity="other">Queued %1$d episodes, then it stopped. %2$s %3$s</item>
    </plurals>
    <!-- Toast when keep next found no room for another episode. -->
    <string name="notice_keep_next_full">Not enough free space to keep the next episodes downloaded. Free up some space to download more.</string>
    <!-- Message when a watch party was asked for with no server chosen. The names are a suggested server and who runs it. -->
    <string name="party_needs_server">Choose a server for the watch party first, as syncplay.server. %1$s is run by %2$s.</string>
    <!-- Toast when a watch party is asked for in a build without watch parties. -->
    <string name="notice_no_party">Watch parties aren\'t available in this version of anistream.</string>
    <!-- Message when a watch party was asked for with no room named. -->
    <string name="party_needs_room">A watch party needs a room to meet in. Choose one first.</string>
    <!-- Message in a watch party when its server connection dropped and is retried. -->
    <string name="party_server_lost">Lost the watch party server. Trying again.</string>
    <!-- Message in a watch party when the connection came back. -->
    <string name="party_rejoined">Back in the watch party.</string>
    <!-- Message when the person left a watch party. -->
    <string name="party_left">Left the watch party.</string>
    <!-- The legal line. It exists once, so no translation can paraphrase it. -->
    <string name="legal_hosts_no_content">anistream hosts no content.</string>
    <!-- Toast after a setting is stored. The label is the setting's name. -->
    <string name="notice_saved">Saved %1$s.</string>
    <!-- Toast when a setting could not be stored. The reason comes from the system. -->
    <string name="notice_not_saved">Couldn\'t save that setting. %1$s</string>
    <!-- Toast when a title's details did not load. -->
    <string name="notice_title_load_failed">Couldn\'t load this title. Check your connection and try again.</string>
    <!-- Toast when playback stops with an error. -->
    <string name="notice_playback_failed">Playback failed. Try another source.</string>
    <!-- Toast after episodes are added to the download queue. -->
    <plurals name="notice_episodes_queued">
        <item quantity="one">Queued one episode.</item>
        <item quantity="other">Queued %1$d episodes.</item>
    </plurals>
    <!-- Name of the notification channel for download progress, shown in the system's settings. -->
    <string name="channel_downloads_name">Downloads</string>
    <!-- Button that runs a failed action again. -->
    <string name="action_try_again">Try again</string>
    <!-- Button that closes a dialog without doing what it offered. -->
    <string name="action_cancel">Cancel</string>
    <!-- Button that puts a question off until later. -->
    <string name="action_not_now">Not now</string>
    <!-- A span of time in whole days. The unit letter belongs to the language. -->
    <string name="duration_days">%1$dd</string>
    <!-- A span of time in hours and minutes. -->
    <string name="duration_hours_minutes">%1$dh %2$dm</string>
    <!-- A span of time in whole hours. -->
    <string name="duration_hours">%1$dh</string>
    <!-- A span of time in minutes. -->
    <string name="duration_minutes">%1$dm</string>
    <!-- A short wait in minutes and seconds. The seconds come with a leading zero. -->
    <string name="duration_minutes_seconds">%1$dm %2$ss</string>
    <!-- A short wait in seconds. -->
    <string name="duration_seconds">%1$ds</string>
    <!-- A file size in bytes. The number is already formatted. -->
    <string name="size_byte">%1$s B</string>
    <!-- A file size in kilobytes (1,000 bytes). The number is already formatted. -->
    <string name="size_kilobyte">%1$s kB</string>
    <!-- A file size in megabytes (1,000,000 bytes). The number is already formatted. -->
    <string name="size_megabyte">%1$s MB</string>
    <!-- A file size in gigabytes (1,000,000,000 bytes). The number is already formatted. -->
    <string name="size_gigabyte">%1$s GB</string>
    <!-- Continue row subtitle. The show's title is cut first when the row is short. -->
    <plurals name="queue_episodes_left">
        <item quantity="one">One episode left in %2$s</item>
        <item quantity="other">%1$d episodes left in %2$s</item>
    </plurals>
    <!-- A number of episodes, alone: a badge or a count under a title. -->
    <plurals name="episodes_count">
        <item quantity="one">%1$d episode</item>
        <item quantity="other">%1$d episodes</item>
    </plurals>
    <!-- How far through a show a person is. The plural follows the total. -->
    <plurals name="progress_episodes">
        <item quantity="one">%1$d of %2$d episode</item>
        <item quantity="other">%1$d of %2$d episodes</item>
    </plurals>
    <!-- A span of time to the next episode, in days and hours. The unit letters belong to the language. -->
    <string name="duration_days_hours">%1$dd %2$dh</string>
    <!-- Group header on the library and continue screens. -->
    <string name="group_in_progress">In progress</string>
    <!-- Group header for what aired in the last few days. -->
    <string name="group_new_this_week">New this week</string>
    <!-- Label on the card for the episode that plays after this one. -->
    <string name="player_up_next">Up next</string>
    <!-- Label before the name of the work a show is based on. -->
    <string name="title_based_on">Based on</string>
    <!-- Settings group and row title for choosing a language. -->
    <string name="settings_language">Language</string>
    <!-- Settings row for the language of the app's own text. -->
    <string name="settings_language_app">App language</string>
    <!-- First choice in the language list: use the device's language. -->
    <string name="language_follow_system">Follow system language</string>
    <!-- Label beside a language whose text a person has not reviewed yet. -->
    <string name="language_draft_label">Draft translation</string>
    <!-- Note under the language row and in the language list, for a draft language. -->
    <string name="language_draft_note">This translation has not been reviewed yet. Some text may be wrong.</string>
    <!-- Shown after changing the language on Windows, Linux and in the terminal, which read it at start. -->
    <string name="language_restart_note">Restart anistream to use the new language.</string>
    <!-- Settings row for which audio plays. -->
    <string name="settings_audio">Audio</string>
    <!-- Value of the audio setting: the original audio with subtitles. -->
    <string name="audio_subbed">Subbed</string>
    <!-- Value of the audio setting: translated audio. -->
    <string name="audio_dubbed">Dubbed</string>
    <!-- Title of the screen or section that lists sources. -->
    <string name="sources_title">Sources</string>
    <!-- Shown on the sources screen when none is installed. -->
    <string name="sources_empty">No sources yet. Join a plugin store to add some.</string>
    <!-- Warning at install and in onboarding, in the same words in both. -->
    <string name="plugin_risk_warning">Plugins are written by other people and run on your device. Install only from people you trust.</string>
    <!-- Menu and palette entry that opens the picker, and the picker's title. -->
    <string name="source_picker_title">Source for this title</string>
    <!-- The first choice: let anistream pick per episode. Paired with source-picker-automatic-detail. -->
    <string name="source_picker_automatic">Automatic</string>
    <!-- Under "Automatic": what it does. -->
    <string name="source_picker_automatic_detail">Each episode from the first source that has it</string>
    <!-- Under a source: how many of the title's released episodes it lists. -->
    <plurals name="source_picker_coverage">
        <item quantity="one">%1$d of %2$d episode</item>
        <item quantity="other">%1$d of %2$d episodes</item>
    </plurals>
    <!-- Under a source that is switched off in Settings. -->
    <string name="source_note_off">Switched off</string>
    <!-- Under a source that failed a few times in a row. It is tried again shortly. -->
    <string name="source_note_resting">Not responding, trying again soon</string>
    <!-- Under a source picked for this title that is no longer installed. -->
    <string name="source_note_gone">Not installed</string>
    <!-- Under a source that found more than one show by this name and could not tell which is this one. -->
    <string name="source_note_ambiguous">Couldn\'t match this title</string>
    <!-- Under a source held back by the VPN check in Settings. -->
    <string name="source_note_held_back">Held back by the VPN check</string>
    <!-- Heading over one source's releases, for a source that offers several (a batch, single episodes). -->
    <string name="source_picker_releases">Releases</string>
    <!-- Accessibility label and badge for the chosen row. -->
    <string name="source_picker_chosen">Chosen</string>
    <!-- Notice when the source picked for a title is off, removed or failing. Shown once per visit. -->
    <string name="source_pin_unavailable">%1$s isn\'t available right now, so this title\'s episodes come from your other sources.</string>
    <!-- Under an episode that is out but that no source lists. The row is dimmed and can't be played. -->
    <string name="episode_unsourced">No source has this episode</string>
</resources>
