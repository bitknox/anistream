        <item quantity="one">One episode is already in downloads.</item>
        <item quantity="other">%1$d episodes are already in downloads.</item>
    </plurals>
    <!-- Job note while a play looks the title up. -->
    <string name="status_looking_up_title">Looking up the title…</string>
    <!-- Job note while a play waits for the sources to arrive. -->
    <string name="status_loading_sources">Loading sources…</string>
    <!-- Job note while the sources are asked for an episode. The episode is its label, often a number. -->
    <string name="status_searching_sources">Searching sources for episode %1$s…</string>
    <!-- Status while the player opens. -->
    <string name="status_starting_player">Starting mpv…</string>
    <!-- Status line while an episode plays. -->
    <string name="status_playing">Playing %1$s, episode %2$s</string>
    <!-- Toast when the player cannot be started. The reason comes from the system. -->
    <string name="notice_player_failed_to_start">Couldn\'t start mpv. Check that it runs on its own. (%1$s)</string>
    <!-- Toast when a stream never showed a frame and the next one is tried. -->
    <string name="notice_stream_no_video">No video from that stream. Trying %1$d of %2$d.</string>
