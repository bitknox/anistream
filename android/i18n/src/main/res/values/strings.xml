    <string name="notice_opened_in_browser">Opened in your browser.</string>
    <!-- Toast when a link could not be opened. The reason comes from the system. -->
    <string name="notice_could_not_open">Couldn\'t open that. %1$s</string>
    <!-- Toast when a trailer plays in mpv. -->
    <string name="notice_trailer_playing">Trailer playing in mpv.</string>
    <!-- Toast when a trailer opens in the browser. -->
    <string name="notice_trailer_opened">Trailer opened in your browser.</string>
    <!-- Toast when a trailer could not be opened. The reason comes from the system. -->
    <string name="notice_trailer_failed">Couldn\'t open the trailer. %1$s</string>
    <!-- Toast when the next episode is not the one after this because filler was skipped. -->
    <string name="notice_filler_skipped">Skipped filler. Up next is episode %1$s.</string>
    <!-- Toast after switching the audio while playing. -->
    <string name="notice_audio_now_subbed">Audio is now subbed.</string>
    <!-- Toast after switching the audio while playing. -->
    <string name="notice_audio_now_dubbed">Audio is now dubbed.</string>
