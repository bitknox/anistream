    <!-- Toast when a sign-in token could not be stored. The reason comes from the system. -->
    <string name="notice_token_not_saved">Couldn\'t save the sign-in token. Try signing in again. %1$s</string>
    <!-- Toast when a sign-in did not finish. The reason comes from the tracker or the network. -->
    <string name="notice_sign_in_failed">Couldn\'t sign in to %1$s. Try again. %2$s</string>
    <!-- Toast when the wait for a sign-in ended early. The reason comes from the system. -->
    <string name="notice_sign_in_stopped">The sign-in to %1$s stopped before it finished. Try again. %2$s</string>
    <!-- Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker. -->
    <string name="notice_token_exchange_failed">Couldn\'t get a token from %1$s. Try signing in again. %2$s</string>
    <!-- Toast when no browser could be opened for a sign-in. The reason comes from the system. -->
    <string name="notice_browser_not_opened">Couldn\'t open a browser for the sign-in. Check that one is installed and try again. %1$s</string>
    <!-- Toast when a sign-in redirect arrives and no sign-in is waiting for it. -->
    <string name="notice_sign_in_not_waiting">No sign-in to %1$s is waiting for that. Start the sign-in again.</string>
    <!-- Toast when a sign-in redirect does not match the request that was made. -->
    <string name="notice_sign_in_wrong_request">That sign-in to %1$s didn\'t come back from this request. Start the sign-in again.</string>
    <!-- Toast when a tracker sent the person back without a token. -->
    <string name="notice_sign_in_no_token">The sign-in to %1$s came back without a token. Try again.</string>
    <!-- Toast when this build has no MyAnimeList client to finish a sign-in with. -->
    <string name="notice_mal_client_missing_build">Couldn\'t finish signing in to MyAnimeList: this build has no client for it.</string>
    <!-- Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it. -->
    <string name="notice_kitsu_signs_in_on_accounts">Kitsu signs in from the Accounts screen.</string>
    <!-- Toast when a tracker has no way to sign in yet. -->
    <string name="notice_sign_in_unsupported">Signing in to %1$s isn\'t supported yet.</string>
    <!-- Toast on an app that cannot receive a browser redirect. -->
    <string name="notice_sign_in_needs_redirect">Signing in to %1$s needs a browser redirect, which this app can\'t receive.</string>
    <!-- Toast when AniList is set to a sign-in method only the anistream app can finish. The setting name is a key of the config file and is not translated. -->
    <string name="notice_anilist_implicit_flow">This AniList sign-in method works only in the anistream app. To sign in here, set %1$s to \"loopback\" in the config file.</string>
    <!-- Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated. -->
    <string name="notice_anilist_client_missing">AniList needs a client id and secret. Set %1$s and %2$s in the config file, then sign in again. To get the sign-in address, run anistream --login-url.</string>
    <!-- Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. -->
    <string name="notice_anilist_paste_flow">Pasting a code isn\'t possible here. Quit and run anistream --login instead.</string>
    <!-- Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated. -->
    <string name="notice_mal_client_missing">MyAnimeList needs a client id. Register an app of type other at myanimelist.net/apiconfig, then set %1$s in the config file.</string>
    <!-- Status line while the browser sign-in is open and the app waits for it to come back. -->
    <string name="status_waiting_for_redirect">Waiting for %1$s to redirect back…</string>
    <!-- Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month. -->
    <string name="notice_mal_no_refresh_token">MyAnimeList didn\'t issue a refresh token. You\'ll need to sign in again in about a month.</string>
    <!-- Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated. -->
    <string name="notice_client_id_missing">Set %1$s in the config file first.</string>
    <!-- Toast after signing out of a tracker with nothing waiting to send. -->
    <string name="notice_signed_out">Signed out of %1$s.</string>
    <!-- Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in. -->
    <plurals name="notice_signed_out_queue">
        <item quantity="one">Signed out of %1$s. One queued change is kept for the next sign-in.</item>
        <item quantity="other">Signed out of %1$s. %2$d queued changes are kept for the next sign-in.</item>
    </plurals>
    <!-- Toast when signing out of a tracker failed. The reason comes from the system. -->
    <string name="notice_sign_out_failed">Couldn\'t sign out of %1$s. Try again. %2$s</string>
    <!-- Toast when a setting could not be stored. The cause says why and what to do. -->
    <string name="notice_not_saved_because">Couldn\'t save that setting. %1$s</string>
    <!-- Toast when the torrent protection choice was saved. -->
    <string name="notice_protection_saved">Saved torrent protection.</string>
    <!-- Toast when the torrent protection could not be checked. The cause says why. -->
    <string name="notice_protection_not_checked">Couldn\'t check the torrent protection. %1$s</string>
    <!-- Toast when the proxy's password could not be stored. The reason comes from the system. -->
    <string name="notice_proxy_password_not_kept">Couldn\'t keep the proxy\'s password. Enter it again to try saving it. %1$s</string>
    <!-- Toast when a show's setting was given a value it does not take. The value is what was given. -->
    <string name="notice_show_setting_refused">Couldn\'t save that setting. %1$s isn\'t a value for %2$s.</string>
    <!-- Toast when resetting a show's settings failed. The reason comes from the local database. -->
    <string name="notice_show_not_reset">Couldn\'t reset this show\'s settings. %1$s</string>
    <!-- Toast when a subtitle choice names subtitles the show has not used. -->
    <string name="notice_show_no_such_subtitles">Couldn\'t save that subtitle choice. This show hasn\'t used those subtitles before.</string>
    <!-- Toast while torrents are held until the connection check passes. -->
    <string name="notice_torrents_waiting_for_check">Torrents are waiting for the connection check to pass again.</string>
    <!-- Toast when the mapping data downloads work again after a failure. -->
    <string name="notice_mapping_data_refreshed">Mapping data refreshed.</string>
    <!-- Toast when the mapping data could not be downloaded. It is said once; the retries are silent. -->
    <string name="notice_mapping_data_failed">Couldn\'t refresh the mapping data (%1$s). Trying again in %2$s. %3$s</string>
    <!-- Toast, and desktop notification, for one episode that aired while the app was closed. -->
    <string name="notice_episode_aired">%1$s, episode %2$d, aired while you were away.</string>
    <!-- Toast, and desktop notification, for several episodes that aired while the app was closed. -->
    <plurals name="notice_episodes_aired">
        <item quantity="one">One new episode of a show you watch aired. The calendar has it.</item>
        <item quantity="other">%1$d new episodes of shows you watch aired. The calendar has them.</item>
    </plurals>
    <!-- Toast when a new release of anistream is out, on the terminal app. The command is not translated. -->
    <string name="notice_update_available">%1$s is out. Run anistream --update to install it.</string>
    <!-- The reason a setting was refused until the person confirms having no protection. -->
    <string name="cause_confirm_no_protection">Confirm that you want no protection first.</string>
    <!-- The reason a setting was refused until the person confirms the "warn only" choice. -->
    <string name="cause_confirm_warn_only">Confirm that you want to be warned only first.</string>
    <!-- The reason a proxy was refused: it has no host or no port. -->
    <string name="cause_proxy_needs_address">A proxy needs a host and a port.</string>
    <!-- The reason a proxy could not be checked: its address is not one the check can use. -->
    <string name="cause_proxy_address_unusable">The proxy\'s address is not one a check can use.</string>
    <!-- The reason a request failed: it never reached the server. -->
    <string name="cause_server_unreachable">The server couldn\'t be reached.</string>
    <!-- The legal line. It exists once, so no translation can paraphrase it. -->
    <string name="legal_hosts_no_content">anistream hosts no content.</string>
    <!-- Toast after a setting is stored. The label is the setting's name. -->
    <string name="notice_saved">Saved %1$s.</string>
    <!-- Toast when a setting could not be stored. The reason comes from the system. -->
    <string name="notice_not_saved">Couldn\'t save that setting. %1$s</string>
    <!-- Toast when a title's details did not load. -->
    <string name="notice_title_load_failed">Couldn\'t load this title. Check your connection and try again.</string>
    <!-- Toast when playback stops with an error. -->
    <string name="notice_playback_failed">Playback failed. Try another source.</string>
    <!-- Toast after episodes are added to the download queue. -->
    <plurals name="notice_episodes_queued">
        <item quantity="one">Queued one episode.</item>
        <item quantity="other">Queued %1$d episodes.</item>
    </plurals>
    <!-- Name of the notification channel for download progress, shown in the system's settings. -->
    <string name="channel_downloads_name">Downloads</string>
    <!-- Under a release in the source picker: how many people share it right now. -->
    <plurals name="release_seeders">
        <item quantity="one">One seeder</item>
        <item quantity="other">%1$d seeders</item>
    </plurals>
    <!-- Button that runs a failed action again. -->
    <string name="action_try_again">Try again</string>
    <!-- Button that closes a dialog without doing what it offered. -->
    <string name="action_cancel">Cancel</string>
    <!-- Button that puts a question off until later. -->
    <string name="action_not_now">Not now</string>
    <!-- A span of time in whole days. The unit letter belongs to the language. -->
    <string name="duration_days">%1$dd</string>
    <!-- A span of time in hours and minutes. -->
    <string name="duration_hours_minutes">%1$dh %2$dm</string>
    <!-- A span of time in whole hours. -->
    <string name="duration_hours">%1$dh</string>
    <!-- A span of time in minutes. -->
    <string name="duration_minutes">%1$dm</string>
    <!-- A short wait in minutes and seconds. The seconds come with a leading zero. -->
    <string name="duration_minutes_seconds">%1$dm %2$ss</string>
    <!-- A short wait in seconds. -->
    <string name="duration_seconds">%1$ds</string>
    <!-- A file size in bytes. The number is already formatted. -->
    <string name="size_byte">%1$s B</string>
    <!-- A file size in kilobytes (1,000 bytes). The number is already formatted. -->
    <string name="size_kilobyte">%1$s kB</string>
    <!-- A file size in megabytes (1,000,000 bytes). The number is already formatted. -->
    <string name="size_megabyte">%1$s MB</string>
    <!-- A file size in gigabytes (1,000,000,000 bytes). The number is already formatted. -->
    <string name="size_gigabyte">%1$s GB</string>
    <!-- Button that closes a sheet whose changes have already been made. -->
    <string name="action_done">Done</string>
    <!-- Continue row subtitle. The show's title is cut first when the row is short. -->
    <plurals name="queue_episodes_left">
        <item quantity="one">One episode left in %2$s</item>
        <item quantity="other">%1$d episodes left in %2$s</item>
    </plurals>
    <!-- A number of episodes, alone: a badge or a count under a title. -->
    <plurals name="episodes_count">
        <item quantity="one">%1$d episode</item>
        <item quantity="other">%1$d episodes</item>
    </plurals>
    <!-- How far through a show a person is. The plural follows the total. -->
    <plurals name="progress_episodes">
        <item quantity="one">%1$d of %2$d episode</item>
        <item quantity="other">%1$d of %2$d episodes</item>
    </plurals>
    <!-- A span of time to the next episode, in days and hours. The unit letters belong to the language. -->
    <string name="duration_days_hours">%1$dd %2$dh</string>
    <!-- Group header on the library and continue screens. -->
    <string name="group_in_progress">In progress</string>
    <!-- Group header for what aired in the last few days. -->
    <string name="group_new_this_week">New this week</string>
    <!-- Label on the card for the episode that plays after this one. -->
    <string name="player_up_next">Up next</string>
    <!-- Label before the name of the work a show is based on. -->
    <string name="title_based_on">Based on</string>
    <!-- Settings group and row title for choosing a language. -->
    <string name="settings_language">Language</string>
    <!-- Settings row for the language of the app's own text. -->
    <string name="settings_language_app">App language</string>
    <!-- First choice in the language list: use the device's language. -->
    <string name="language_follow_system">Follow system language</string>
    <!-- Label beside a language whose text a person has not reviewed yet. -->
    <string name="language_draft_label">Draft translation</string>
    <!-- Note under the language row and in the language list, for a draft language. -->
    <string name="language_draft_note">This translation has not been reviewed yet. Some text may be wrong.</string>
    <!-- Shown after changing the language on Windows, Linux and in the terminal, which read it at start. -->
    <string name="language_restart_note">Restart anistream to use the new language.</string>
    <!-- Settings row for which audio plays. -->
    <string name="settings_audio">Audio</string>
    <!-- Value of the audio setting: the original audio with subtitles. -->
    <string name="audio_subbed">Subbed</string>
    <!-- Value of the audio setting: translated audio. -->
    <string name="audio_dubbed">Dubbed</string>
    <!-- Title of the screen or section that lists sources. -->
    <string name="sources_title">Sources</string>
    <!-- Shown on the sources screen when none is installed. -->
    <string name="sources_empty">No sources yet. Join a plugin store to add some.</string>
    <!-- Warning at install and in onboarding, in the same words in both. -->
    <string name="plugin_risk_warning">Plugins are written by other people and run on your device. Install only from people you trust.</string>
    <!-- Menu and palette entry that opens the picker, and the picker's title. -->
    <string name="source_picker_title">Source for this title</string>
    <!-- The first choice: let anistream pick per episode. Paired with source-picker-automatic-detail. -->
    <string name="source_picker_automatic">Automatic</string>
    <!-- Under "Automatic": what it does. -->
    <string name="source_picker_automatic_detail">Each episode from the first source that has it</string>
    <!-- Under a source: how many of the title's released episodes it lists. -->
    <plurals name="source_picker_coverage">
        <item quantity="one">%1$d of %2$d episode</item>
        <item quantity="other">%1$d of %2$d episodes</item>
    </plurals>
    <!-- Under a source that is switched off in Settings. -->
    <string name="source_note_off">Switched off</string>
    <!-- Under a source that failed a few times in a row. It is tried again shortly. -->
    <string name="source_note_resting">Not responding, trying again soon</string>
    <!-- Under a source picked for this title that is no longer installed. -->
    <string name="source_note_gone">Not installed</string>
    <!-- Under a source that found more than one show by this name and could not tell which is this one. -->
    <string name="source_note_ambiguous">Couldn\'t match this title</string>
    <!-- Under a source held back by the VPN check in Settings. -->
    <string name="source_note_held_back">Held back by the VPN check</string>
    <!-- Heading over one source's releases, for a source that offers several (a batch, single episodes). -->
    <string name="source_picker_releases">Releases</string>
    <!-- Accessibility label and badge for the chosen row. -->
    <string name="source_picker_chosen">Chosen</string>
    <!-- Notice when the source picked for a title is off, removed or failing. Shown once per visit. -->
    <string name="source_pin_unavailable">%1$s isn\'t available right now, so this title\'s episodes come from your other sources.</string>
    <!-- Under an episode that is out but that no source lists. The row is dimmed and can't be played. -->
    <string name="episode_unsourced">No source has this episode</string>
