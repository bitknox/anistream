    <string name="notice_source_automatic">Back to automatic source selection.</string>
    <!-- Toast when the source choice for a title could not be saved. The reason comes from the system. -->
    <string name="notice_source_choice_failed">Couldn\'t save that choice. %1$s</string>
    <!-- Toast when no source could list a show's episodes. The reason is what the sources said. -->
    <string name="notice_no_source_could_list">No source could list this show: %1$s</string>
