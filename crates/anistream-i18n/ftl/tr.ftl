plugin-unpublished = { $plugin } artık sunulmuyor.

# Toast after the store's admin page opens in the browser.
store-admin-opened = Yönetici sayfası tarayıcınızda açıldı. Bağlantı yalnızca bir kez ve 10 dakika çalışır.

# Toast when the browser could not be opened for the store's admin page. The reason comes from the system. The command is typed as it is run.
store-admin-open-failed = Tarayıcı açılamadı ({ $reason }). Bağlantı yazdırmak için eklenti mağazasının bulunduğu makinede "anistream store admin" komutunu çalıştırın.

# Toast after a plugin is installed while plugins are switched off in the source order.
plugin-installed-unused = { $plugin } { $version } kuruldu, ama eklentiler kaynak sıralamasında kapalı olduğundan kullanılmıyor.

# Toast after a plugin is installed under the name of a built-in source, so it was not loaded.
plugin-installed-name-clash = { $plugin } kuruldu, ama { $id } yerleşik bir kaynak adı olduğu için yüklenmedi.

# Toast after a plugin is installed and ready to use.
plugin-installed = { $plugin } { $version } kuruldu.

# Toast after a plugin is installed but could not be loaded. The reason comes from the plugin host.
plugin-installed-not-loaded = { $plugin } kuruldu, ama yüklenemedi. { $reason }

# Toast at launch when joined plugin stores offer newer versions of installed plugins.
plugin-updates-ready =
    { $count ->
        [one] Eklenti güncellemesi hazır: { $names }.
       *[other] Eklenti güncellemeler hazır: { $names }.
    }

# Note on the sources screen when the plugins could not be loaded. The reason comes from the plugin host.
plugins-load-failed = Eklentiler yüklenemedi. { $reason }

# Error: the store was joined once, but this device has no saved token for it.
store-token-missing = { $store } için bu cihazda kayıtlı bir belirteç yok. Yeni bir davetle yeniden katılın.

# Error: the store the record points to is gone from the saved list.
store-not-joined = Bu eklenti mağazası artık katıldıklarınız arasında değil.

# Error: a store's signing key is unreadable. Shown as the reason a store is offline.
store-key-damaged = Bu cihazda eklenti mağazasının imza anahtarı bozuk. eklenti mağazasını bırakıp yeni bir davetle yeniden katılın.

# Error: a store rejected this device's token.
store-device-refused = { $store } bu cihazı artık kabul etmiyor. Yeni bir davetle yeniden katılın.

# Error: a store could not be reached. The reason comes from the network.
store-unreachable = { $store } ile bağlantı kurulamadı. { $reason }

# Error: an invite link names a store this device already joined, but at another address.
store-moved = { $store }, { $current } adresinde katılmış durumda, ama bu bağlantı { $target } adresini gösteriyor. Bu eklenti mağazası taşındıysa önce onu bırakıp yeniden katılın.

# Error: an open link would replace the named membership this device already has.
store-join-would-unname = { $store }: { $member } olarak katıldınız. Bu bağlantı adınız olmadan yeniden katılmanızı sağlardı, bu yüzden hiçbir şey değiştirilmedi.

# Error: the server at a link's address could not prove it is the store the invite named.
store-not-the-invited = { $url } davette adı geçen eklenti mağazası değil ({ $reason }). Hiçbir şeye katılınmadı.

# Error: the token for a joined store could not be saved on this device. The reason comes from the system.
store-token-not-kept = Bu eklenti mağazası için belirteç kaydedilemedi. { $reason }

# Error: an invite that cannot be used any more.
store-invite-unusable = Bu davet zaten kullanılmış, iptal edilmiş ya da süresi dolmuş. Yeni bir tane isteyin.

# Error: an open link that no longer lets anyone join.
store-open-link-unusable = Bu bağlantı artık kimsenin katılmasına izin vermiyor. Yeni bir bağlantı ya da davet için eklenti mağazasının sahibinden isteyin.

# Error: a plugin takes the name of a built-in source.
plugin-reserved-name = { $plugin } yerleşik bir kaynak adı, bu yüzden eklenti olamaz.

# Error: a store stopped offering a plugin between listing it and installing it.
store-plugin-withdrawn = { $store } artık { $plugin } sunmuyor.

# Error: a store changed a plugin after the person agreed to what was shown.
store-plugin-changed = { $store }, { $plugin } eklentisini gösterildikten sonra değiştirdi. Kurmadan önce tekrar bakın.

# Error: a plugin installed from one store is offered by another.
plugin-from-other-store = { $plugin } { $store } üzerinden kuruldu. Güncellemeleri oradan gelir.

# Error: a plugin file added by hand already declares the same name.
plugin-duplicate-file = { $path } zaten { $plugin } tanımlıyor. Önce o dosyayı kaldırın, yoksa iki kopya çalışır.

# Error: a plugin could not be downloaded or installed. The reason comes from the store or the system.
plugin-install-failed = { $plugin } kurulamadı. { $reason }

# Error: a plugin could not be published. The reason comes from the store or the system.
plugin-publish-failed = { $plugin } yayımlanamadı. { $reason }

# Error: a plugin to publish is no longer in the plugin folder.
plugin-missing-locally = { $plugin } artık eklenti klasöründe yok.

# Error: an invite for another device cannot be made from a device that joined with the open link.
store-invite-needs-link = Bu cihaz bağlantıyla { $store } listesine katıldı. Aynı bağlantıyı diğer cihazda yapıştırın.

# Error: the store sent an invite link that does not parse. The reason comes from the link parser.
store-link-malformed = Bu eklenti mağazasının gönderdiği bağlantı çalışmıyor. Sahibinden eklenti mağazasını kontrol etmesini isteyin. { $reason }

# Error: the store sent a link carrying another store's key.
store-link-wrong-key = Bu eklenti mağazası farklı bir anahtarla bağlantı oluşturdu. Başladığınız adresi kontrol edin.

# Error: the store's server has no admin page.
store-admin-missing = { $store } yönetici sayfasına sahip değil. Sunucusu daha eski olabilir.

# Error: the store sent an admin link that points somewhere else.
store-admin-link-foreign = { $store } başka bir adresi gösteren bir yönetici bağlantısı gönderdi.

# Error: the store's server is too old for joining with a link.
store-open-join-unsupported = { $store } sunucusu daha eski, bu yüzden bağlantıyla kimse katılamaz. Önce güncelleyin.

# Toast after a source (plugin) is switched off. It is skipped when looking for episodes.
source-switched-off = { $name } kapatıldı. Bölüm ararken atlanır.

# Toast after a source (plugin) is switched on.
source-switched-on = { $name } açıldı.

# Error: a command named a plugin that is not loaded.
plugin-not-loaded = { $id } yüklenmedi. Kaynaklar altında kurulu olduğunu kontrol edin.

# Toast after a release is chosen for a title. The name is the release's title.
release-pinned = { $name } bu başlık için kullanılacak.

# Toast when the chosen source or release for a title could not be saved. The reason comes from the database.
notice-choice-not-saved = Bu seçim kaydedilemedi. { $reason }

# Toast while torrents are running but the connection check failed, and the settings say to warn only.
torrent-check-failed-running = Bağlantı denetimi başarısız oldu. Torrentler çalışmaya devam ediyor.

# Note on the sources screen: torrents are waiting for the VPN guard. The reason comes from the guard.
torrent-vpn-waiting = Torrentler VPN korumasından geçince başlar. { $reason }

# Note on the sources screen: the VPN guard has no verdict yet.
torrent-vpn-unverified = Torrentler VPN korumasından geçince başlar. Bağlantı henüz doğrulanmadı.

# Error: torrents are on, but no torrent index is set.
torrent-no-index = Torrentler için bir torrent dizini gerekir. anistream bir tane içermez, bu yüzden ayarlarda kendi adresinizi ekleyin.

# Error: the torrent session did not start because the interface closed first.
torrent-interface-closed = anistream torrentler başlamadan kapandı.

# Error: the torrent session could not start. The reason comes from the torrent engine.
torrent-session-failed = Torrent oturumu başlatılamadı. { $reason }

# Toast when torrents are up but no operating-system firewall rule backs the VPN guard. Terminal only: the engine never sends it to the apps.
torrent-no-kill-switch = Bu cihazda VPN koparsa torrent trafiğini durduran bir şey yok. Kurulum için "anistream --doctor" komutunu çalıştırın.

# Toast when the connection check could not run. The reason comes from the VPN settings.
torrent-not-checked = Bağlantı denetlenemedi. { $reason }

# Note on the sources screen after the source chain is rebuilt with torrents on.
sources-reloaded-torrents-pending = Kaynaklar yeniden yüklendi. Torrentler VPN korumasından geçince başlar.

# Note on the sources screen after the source chain is rebuilt with torrents off.
sources-reloaded-torrents-off = Torrentler kapalı. Oturum durduruldu.

# Note on a running job: requests to AniList are being slowed to stay within its limit. A countdown follows.
job-anilist-limit = AniList istek sınırı nedeniyle bekleniyor

# Toast when there is no job to carry the wait for AniList's rate limit.
notice-anilist-limit = AniList istek sınırı nedeniyle { $wait } bekleniyor.

# Toast when the AniList fallback takes over because AniList cannot be reached.
notice-anilist-unreachable = AniList yanıt vermiyor. Şimdilik başka bir hizmetten veriler gösteriliyor.

# Toast when no metadata service answered and the last cached data is shown.
notice-metadata-cached = Hiçbir üst veri hizmeti yanıt vermedi. Son önbelleğe alınan veriler gösteriliyor.

# Toast when AniList answers again.
notice-anilist-back = AniList yeniden yanıt veriyor.

# Toast when a command needs watch parties but this app was built without them.
notice-party-not-built = Birlikte izlemeler bu uygulamaya dahil edilmemiş.

# Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList.
notice-signed-in = Oturum açıldı: { $tracker }.

# Toast after a sign-in succeeded and the token went into the system keychain.
notice-signed-in-keychain = Oturum açıldı: { $tracker }. Erişim jetonu işletim sistemi anahtarlığında saklanıyor.

# Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows.
notice-signed-in-file = Oturum açıldı: { $tracker }. Anahtarlık yok. Erişim jetonu bu cihaz üzerinde, yalnızca bu kullanıcının okuyabildiği özel bir dosyada.

# Toast when a sign-in worked but the token could not be stored. The reason comes from the system.
notice-signed-in-unsaved = Oturum açıldı: { $tracker }, ama jeton kaydedilemedi. Bir dahaki sefer yeniden oturum açmanız gerekecek. { $reason }

# Toast when a sign-in token could not be stored. The reason comes from the system.
notice-token-not-saved = Jeton kaydedilemedi. Yeniden oturum açmayı deneyin. { $reason }

# Toast when a sign-in did not finish. The reason comes from the tracker or the network.
notice-sign-in-failed = Oturum açılamadı: { $tracker }. Yeniden deneyin. { $reason }

# Toast when the wait for a sign-in ended early. The reason comes from the system.
notice-sign-in-stopped = Oturum açma tamamlanmadan durdu: { $tracker }. Yeniden deneyin. { $reason }

# Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker.
notice-token-exchange-failed = Jeton alınamadı: { $tracker }. Yeniden oturum açmayı deneyin. { $reason }

# Toast when no browser could be opened for a sign-in. The reason comes from the system.
notice-browser-not-opened = Oturum açma için tarayıcı açılamadı. Bir tarayıcının kurulu olup olmadığını denetleyin ve yeniden deneyin. { $reason }

# Toast when a sign-in redirect arrives and no sign-in is waiting for it.
notice-sign-in-not-waiting = Bunu bekleyen bir oturum açma işlemi yok ({ $tracker }). Oturum açmayı yeniden başlatın.

# Toast when a sign-in redirect does not match the request that was made.
notice-sign-in-wrong-request = Bu oturum açma ({ $tracker }) bu istekten dönmedi. Oturum açmayı yeniden başlatın.

# Toast when a tracker sent the person back without a token.
notice-sign-in-no-token = Oturum açma ({ $tracker }) jetonsuz döndü. Yeniden deneyin.

# Toast when this build has no MyAnimeList client to finish a sign-in with.
notice-mal-client-missing-build = MyAnimeList oturumu tamamlanamadı: bu derlemede bunun için bir istemci yok.

# Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.
notice-kitsu-signs-in-on-accounts = Kitsu oturumu Hesaplar ekranından açılır.

# Toast when a tracker has no way to sign in yet.
notice-sign-in-unsupported = { $tracker } için oturum açma henüz desteklenmiyor.

# Toast on an app that cannot receive a browser redirect.
notice-sign-in-needs-redirect = { $tracker } için oturum açmak, bu uygulamanın alamayacağı bir tarayıcı yönlendirmesi gerektirir.

# Toast when AniList is set to a sign-in method only the anistream app can finish. The setting name is a key of the config file and is not translated.
notice-anilist-implicit-flow = Bu AniList oturum açma yöntemi yalnızca anistream uygulamasında çalışır. Burada oturum açmak için yapılandırma dosyasında { $setting } değerini "loopback" olarak ayarlayın.

# Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated.
notice-anilist-client-missing = AniList için istemci kimliği ve gizli anahtar gerekiyor. Yapılandırma dosyasında { $client } ve { $secret } değerlerini ayarlayın, sonra yeniden oturum açın. Oturum açma adresini almak için anistream --login-url komutunu çalıştırın.

# Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.
notice-anilist-paste-flow = Burada kod yapıştırmak mümkün değil. Çıkıp bunun yerine anistream --login komutunu çalıştırın.

# Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated.
notice-mal-client-missing = MyAnimeList için istemci kimliği gerekiyor. myanimelist.net/apiconfig adresinde "other" türünde bir uygulama kaydedin, sonra yapılandırma dosyasında { $setting } değerini ayarlayın.

# Job note while the browser sign-in is open and the terminal app waits for it to come back.
status-waiting-for-redirect = { $tracker } yönlendirmesi bekleniyor…

# Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.
notice-mal-no-refresh-token = MyAnimeList yenileme jetonu vermedi. Yaklaşık bir ay içinde yeniden oturum açmanız gerekecek.

# Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated.
notice-client-id-missing = Önce yapılandırma dosyasında { $setting } değerini ayarlayın.

# Toast after signing out of a tracker with nothing waiting to send.
notice-signed-out = Oturum kapatıldı: { $tracker }.

# Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in.
notice-signed-out-queue =
    { $count ->
        [one] Oturum kapatıldı: { $tracker }. Bekleyen bir değişiklik, bir sonraki oturum açmada gönderilmek üzere saklandı.
       *[other] Oturum kapatıldı: { $tracker }. Bekleyen { $count } değişiklik, bir sonraki oturum açmada gönderilmek üzere saklandı.
    }

# Toast when signing out of a tracker failed. The reason comes from the system.
notice-sign-out-failed = Oturum kapatılamadı: { $tracker }. Yeniden deneyin. { $reason }

# Toast when a setting could not be stored. The cause says why and what to do.
notice-not-saved-because = Bu ayar kaydedilemedi. { $cause }

# Toast when the torrent protection choice was saved.
notice-protection-saved = Torrent koruması kaydedildi.

# Toast when the torrent protection could not be checked. The cause says why.
notice-protection-not-checked = Torrent koruması denetlenemedi. { $cause }

# Toast when the proxy's password could not be stored. The reason comes from the system.
notice-proxy-password-not-kept = Vekil sunucu parolası saklanamadı. Kaydetmeyi denemek için yeniden girin. { $reason }

# Toast when a show's setting was given a value it does not take. The value is what was given.
notice-show-setting-refused = Bu ayar kaydedilemedi. { $value }, { $setting } için geçerli bir değer değil.

# Toast when resetting a show's settings failed. The reason comes from the local database.
notice-show-not-reset = Bu dizinin ayarları sıfırlanamadı. { $reason }

# Toast when a subtitle choice names subtitles the show has not used.
notice-show-no-such-subtitles = Bu altyazı seçimi kaydedilemedi. Bu dizi bu altyazıları daha önce kullanmadı.

# Toast while torrents are held until the connection check passes.
notice-torrents-waiting-for-check = Torrentler bağlantı denetiminin yeniden geçmesini bekliyor.

# Toast when the mapping data downloads work again after a failure.
notice-mapping-data-refreshed = Eşleme verileri yenilendi.

# Toast when the mapping data could not be downloaded. It is said once; the retries are silent.
notice-mapping-data-failed = Eşleme verileri yenilenemedi ({ $datasets }). { $wait } içinde yeniden denenecek. { $cause }

# Toast, and desktop notification, for one episode that aired while the app was closed.
notice-episode-aired = { $title }, { $episode }. bölüm, siz yokken yayınlandı.

# Toast, and desktop notification, for several episodes that aired while the app was closed.
notice-episodes-aired =
    { $count ->
        [one] İzlediğiniz dizilerden bir yeni bölüm yayınlandı. Takvimde görebilirsiniz.
       *[other] İzlediğiniz dizilerden { $count } yeni bölüm yayınlandı. Takvimde görebilirsiniz.
    }

# Toast when a new release of anistream is out, on the terminal app. The command is not translated. Terminal only: the engine never sends it to the apps.
notice-update-available = { $tag } çıktı. Kurmak için anistream --update komutunu çalıştırın.

# The reason a setting was refused until the person confirms having no protection.
cause-confirm-no-protection = Önce korumasız kalmak istediğinizi onaylayın.

# The reason a setting was refused until the person confirms the "warn only" choice.
cause-confirm-warn-only = Önce yalnızca uyarılmak istediğinizi onaylayın.

# The reason a proxy was refused: it has no host or no port.
cause-proxy-needs-address = Vekil sunucu için bir ana makine ve bir bağlantı noktası gerekir.

# The reason a proxy could not be checked: its address is not one the check can use.
cause-proxy-address-unusable = Vekil sunucunun adresi denetim için kullanılamıyor.

# The reason a request failed: it never reached the server.
cause-server-unreachable = Sunucuya ulaşılamadı.

# Toast after a setting is stored. The label is the setting's name.
notice-saved = Kaydedildi: { $label }.

# Toast when a setting could not be stored. The reason comes from the system.
notice-not-saved = Bu ayar kaydedilemedi. { $reason }

# Toast when a title's details did not load.
notice-title-load-failed = Bu başlık yüklenemedi. Bağlantınızı denetleyin ve yeniden deneyin.

# Toast when playback stops with an error.
notice-playback-failed = Oynatma başarısız oldu. Başka bir kaynak deneyin.

# Toast when something went wrong inside the engine and it carried on.
notice-engine-fault = anistream içinde bir sorun oluştu. Uygulama çalışmaya devam etti, ama bir ekran donmuş görünüyorsa çıkıp uygulamayı yeniden açın.

# Toast at launch when the database was damaged, so a fresh one was started. The path is where the damaged file was moved, kept for recovery. Watch history and downloads start over; what the trackers hold comes back with the next sync.
notice-database-set-aside = Veritabanı bozulduğu için anistream yenisini başlattı. Eski dosya { $path } konumunda saklanıyor. takip hizmetlerinde tutulanlar bir sonraki eşitlemede geri gelir.

# Message when anistream could not start because a folder could not be made. The path is the folder, the reason comes from the system.
start-failed-folder = anistream { $path } klasörünü oluşturamadı. Diskte yer olduğunu ve klasöre yazılabildiğini denetleyin, sonra yeniden deneyin. { $reason }

# Message when anistream could not start because the config file has a setting it can't use. The path is the file; the problem names the line where it can.
start-failed-config = Yapılandırma dosyası ({ $path }) anistream için kullanılamayan bir ayar içeriyor: { $problem }. Ayarı düzeltin ya da kaldırın, sonra yeniden deneyin.

# Message when the settings could not be reset after a start failed on them: the config file could not be moved aside. The path is the file, the reason comes from the system.
config-reset-failed = Ayarları sıfırlamak için yapılandırma dosyası ({ $path }) kenara taşınamadı. { $reason }

# Message when anistream could not start because its database could not be opened. The path is the database file, the reason comes from the system.
start-failed-database = anistream veritabanı dosyasını açamadı ({ $path }). Bu klasörde başka bir anistream uygulaması açıksa onu kapatıp yeniden deneyin. { $reason }

# Message when anistream could not start its network connection from the network settings.
start-failed-network = anistream, config.toml dosyasındaki ağ ayarlarıyla ağ bağlantısını kuramadı. { $reason }

# Message when anistream itself could not start. The reason comes from the system or the engine.
start-failed = anistream başlatılamadı. Çıkın ve yeniden açın. { $reason }

# Message when the TV remote could not start listening or could not forget a phone.
start-failed-remote = Uzaktan kumanda başlatılamadı. { $reason }

# Message when the built-in player could not start.
start-failed-player = Oynatıcı başlatılamadı. { $reason }

# Toast after episodes are added to the download queue.
notice-episodes-queued =
    { $count ->
        [one] Bir bölüm indirme kuyruğuna eklendi.
       *[other] { $count } bölüm indirme kuyruğuna eklendi.
    }

# Note under the connection-check group of the torrents dialog: what the check does.
torrents-linux-check-note = anistream, torrent trafiğinin nereden çıktığını bir torrent başladığında ve çalışırken her dakika denetler. Denetim başarısız olursa torrentleri duraklatır. Sizi koruyan şey VPN'iniz ya da proxy'nizdir.

# Confirmation text when choosing "Warn only" for a failed check.
torrents-linux-warn-confirm = anistream duraklatmak yerine sizi uyarır. VPN'iniz ya da proxy'niz kapalıysa diğer kişiler IP adresinizi görebilir.

# Status line once the protection has been checked and saved.
torrents-linux-protection-saved = Torrent koruması kaydedildi

# Title of the dialog that turns torrents on.
torrents-linux-turn-on-title = Torrentleri aç

# Title of the dialog that changes what protects torrents.
torrents-linux-protect-title = Torrentleri koru

# Title of the dialog that edits the proxy.
torrents-linux-edit-proxy-title = Proxy'yi düzenle

# Button that turns torrents on in the dialog.
torrents-linux-turn-on-button = Aç

# Seeding row: time left until the goal, in a span already worded ("18h", "1d 6h").
downloads-linux-seed-left = { $span } kaldı

# Seeding row: less than an hour left until the goal.
downloads-linux-seed-left-soon = Bir saatten az kaldı

# Storage row: free space, the disk's size and what downloads take. All three are sizes already formatted.
downloads-linux-space-free = { $total } içinden { $free } boş · indirmeler { $taken } kullanıyor

# Placeholder of the search field. It also finds settings.
search-linux-placeholder = Dizilerde ve ayarlarda ara

# Tooltip of the button that clears the recent searches.
search-linux-clear-recent = Son aramaları temizle

# Title of the state when a browse with no filters lists nothing.
search-linux-nothing-found = Sonuç bulunamadı

# Title of the state when a typed search waits for Enter.
search-linux-press-enter = Aramak için Enter'a basın

# Line under the Enter title: why results do not come as you type. The tracker is a name.
search-linux-paused = Yazarken arama kısa süreliğine duraklatıldı, { $tracker } sınırlarını aşmamak için.

# Menu title over the sort choices of the filter row.
