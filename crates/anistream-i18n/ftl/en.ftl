# Generated by tools/i18n from i18n/. Do not edit.

# A reason on its own, as a toast or a failed play's explanation. The reason is one of the engine's own reasons, so it is translated.
notice-reason = { $reason }

# Reason: no source is set up, so nothing can be played or downloaded. Shown in a toast.
cause-no-sources = No sources are set up. Add one on the Sources screen.

# A play's explanation: the episode's broadcast is still ahead. The "when" says today, tomorrow or a date.
notice-not-aired = Episode { $episode } airs { $when }.

# A play's explanation: the episode is after the next one to air. The "when" says when that one airs.
notice-not-aired-yet = Episode { $episode } hasn't aired yet. Episode { $next } airs { $when }.

# Part of an air time: the broadcast is later today. The time is the viewer's local time.
cause-airs-today = today at { $time }

# Part of an air time: the broadcast is tomorrow. The time is the viewer's local time.
cause-airs-tomorrow = tomorrow at { $time }

# Part of an air time: the broadcast is within the next week.
cause-airs-in-days =
    { $days ->
        [one] in one day at { $time }
       *[other] in { $days } days at { $time }
    }

# Part of an air time: the broadcast is more than a week away. The date is year-month-day.
cause-airs-on-date = on { $date } at { $time }

# Reason: the source answered but gave nothing to play.
cause-no-playable-stream = The source answered, but with nothing to play. Try another.

# Reason: no source could be matched to the title. The detail is what each source said.
cause-title-no-match = Couldn't match this title: { $detail }

# Reason: the source the person picked is no longer installed or enabled.
cause-source-gone = The source { $source } is no longer available. Choose another.

# Reason: the release the person picked would not start. The detail comes from the source.
cause-release-failed = Couldn't start that release: { $detail }

# Reason: every source matched the title but none has the episode. The detail is what each said.
cause-no-source-has-episode = No source has episode { $episode }: { $detail }

# Reason: the source streams episodes but only torrents can be downloaded.
cause-source-cannot-download = This source streams episodes but can't download them.

# Reason: the title was never listed by a source, so it can't be downloaded.
cause-no-source-could-list-show = No source could list this show, so it can't be downloaded.

# Part of a finished download's toast: subtitle files were merged into the video.
cause-subtitles-merged =
    { $tracks ->
        [one] One subtitle track was merged in.
       *[other] { $tracks } subtitle tracks were merged in.
    }

# Part of a finished download's toast: merging failed, so the subtitles stay as files beside it.
cause-subtitles-left-apart = The subtitles stay as separate files. { $reason }

# Part of a download toast: how many episodes of the range were in the queue already.
cause-already-in-downloads =
    { $count ->
        [one] One episode is already in downloads.
       *[other] { $count } episodes are already in downloads.
    }

# Job note while a play looks the title up.
status-looking-up-title = Looking up the title…

# Job note while a play waits for the sources to arrive.
status-loading-sources = Loading sources…

# Job note while the sources are asked for an episode. The episode is its label, often a number.
status-searching-sources = Searching sources for episode { $episode }…

# Status while the player opens.
status-starting-player = Starting mpv…

# Status line while an episode plays.
status-playing = Playing { $title }, episode { $episode }

# Toast when the player cannot be started. The reason comes from the system.
notice-player-failed-to-start = Couldn't start mpv. Check that it runs on its own. ({ $reason })

# Toast when a stream never showed a frame and the next one is tried.
notice-stream-no-video = No video from that stream. Trying { $next } of { $total }.

# Toast when mpv gave up on a file. The reason is mpv's own line.
notice-player-could-not-play = mpv couldn't play this. { $reason }

# Toast when mpv closed without playing and without saying why.
notice-player-exited-silently = mpv exited without playing anything and gave no reason. Try another source.

# Toast when no picture has appeared a while after the player opened.
notice-player-not-playing = mpv hasn't started playing after { $seconds } s. The source may have no data. Check that mpv plays a file on its own.

# Toast when a play is asked for in a build with no player.
notice-no-player = This version of anistream can't play video.

# Toast at launch when the mpv program is missing. The binary is the name the settings give it.
notice-mpv-missing = { $binary } wasn't found. Install mpv to play episodes.

# Toast at launch when mpv is too old for anistream's own player.
notice-mpv-old = mpv { $version } can play, but anistream's player needs mpv 0.36 or newer for its skip button, Up next card, menus and thumbnails.

# Toast after a link was handed to the browser.
notice-opened-in-browser = Opened in your browser.

# Toast when a link could not be opened. The reason comes from the system.
notice-could-not-open = Couldn't open that. { $reason }

# Toast when a trailer plays in mpv.
notice-trailer-playing = Trailer playing in mpv.

# Toast when a trailer opens in the browser.
notice-trailer-opened = Trailer opened in your browser.

# Toast when a trailer could not be opened. The reason comes from the system.
notice-trailer-failed = Couldn't open the trailer. { $reason }

# Toast when the next episode is not the one after this because filler was skipped.
notice-filler-skipped = Skipped filler. Up next is episode { $episode }.

# Toast after switching the audio while playing.
notice-audio-now-subbed = Audio is now subbed.

# Toast after switching the audio while playing.
notice-audio-now-dubbed = Audio is now dubbed.

# Toast when the previous-episode control is used on the first episode.
notice-already-first-episode = Already at the first episode.

# Toast when the next-episode control is used on the last known episode.
notice-last-episode = There's no next episode. Episode { $episode } is the last.

# Toast when the next-episode control is used and the next episode is not known.
notice-no-next-episode = There's no next episode.

# Toast when the previous-episode control finds no previous episode.
notice-no-previous-episode = There's no previous episode.

# Toast when the title's episode match could not be cleared. The reason comes from the system.
notice-match-reset-failed = Couldn't reset the match. { $reason }

# Toast when the chosen match could not be saved. The reason comes from the system.
notice-match-save-failed = Couldn't save that match. { $reason }

# Toast when a chosen match still left the title undecided.
notice-match-did-not-stick = That match didn't stick. The source may have changed. Try choosing it again.

# Toast when a search of the sources for a title found nothing.
notice-source-search-empty = Nothing found for “{ $query }”. Try a different search.

# Toast after the person picked a source for one title.
notice-source-pinned = { $source } will be used for this title.

# Toast after the person went back to automatic source selection for one title.
notice-source-automatic = Back to automatic source selection.

# Toast when the source choice for a title could not be saved. The reason comes from the system.
notice-source-choice-failed = Couldn't save that choice. { $reason }

# Toast when no source could list a show's episodes. The reason is what the sources said.
notice-no-source-could-list = No source could list this show: { $reason }

# Toast when a title cannot be taken off the Continue row. The reason comes from the system.
notice-continue-hide-failed = Couldn't remove that from Continue. { $reason }

# Toast after an episode was added to the download queue.
notice-download-queued = Queued episode { $episode } of { $title }.

# Toast when an episode asked for is in downloads already.
notice-download-already-queued = Episode { $episode } of { $title } is already in downloads.

# Toast when a waiting or paused download was moved to the front and started.
notice-download-starting-now = Starting episode { $episode } of { $title } now.

# Toast after a download was cancelled.
notice-download-cancelled = Download cancelled.

# Toast after a download and its file were deleted.
notice-download-file-deleted = Download and file deleted.

# Toast after a download was removed whose file was already gone.
notice-download-removed-file-gone = Download removed. Its file was already gone.

# Toast after a download was removed but its file could not be deleted. The reason comes from the system.
notice-download-removed-file-kept = Removed the download, but couldn't delete its file. { $reason }

# Toast after a download with no file was removed.
notice-download-removed = Download removed.

# Toast after finished downloads were cleared from the list.
notice-downloads-cleared =
    { $count ->
        [one] Cleared one finished download.
       *[other] Cleared { $count } finished downloads.
    }

# Toast when an episode finished downloading.
notice-download-finished = Downloaded episode { $episode } of { $title }.

# Toast when an episode finished downloading and the note says what happened to its subtitles.
notice-download-finished-note = Downloaded episode { $episode } of { $title }. { $note }

# Toast when a download could not start. The reason comes from the torrent client.
notice-download-failed = Couldn't download episode { $episode } of { $title }. { $reason }

# Toast after a range was asked for and nothing was queued.
notice-downloads-none-queued = Nothing queued.

# Toast after a range was asked for and nothing was queued, and the reason it stopped.
notice-downloads-none-queued-stopped = Nothing queued. { $reason }

# Toast after a range was asked for and every episode was in the queue already.
notice-downloads-none-new = Nothing new queued. { $existing }

# Toast as above, with the reason the range stopped.
notice-downloads-none-new-stopped = Nothing new queued. { $existing } { $reason }

# Toast after a range was asked for, some episodes were queued and some were there already.
notice-episodes-queued-existing =
    { $count ->
        [one] Queued one episode. { $existing }
       *[other] Queued { $count } episodes. { $existing }
    }

# Toast as above, with the reason the range stopped.
notice-episodes-queued-stopped =
    { $count ->
        [one] Queued one episode, then it stopped. { $reason }
       *[other] Queued { $count } episodes, then it stopped. { $reason }
    }

# Toast as above, with some episodes in the queue already and the reason the range stopped.
notice-episodes-queued-existing-stopped =
    { $count ->
        [one] Queued one episode, then it stopped. { $existing } { $reason }
       *[other] Queued { $count } episodes, then it stopped. { $existing } { $reason }
    }

# Toast when keep next found no room for another episode.
notice-keep-next-full = Not enough free space to keep the next episodes downloaded. Free up some space to download more.

# Message when a watch party was asked for with no server chosen. The names are a suggested server and who runs it.
party-needs-server = Choose a server for the watch party first, as syncplay.server. { $server } is run by { $operator }.

# Toast when a watch party is asked for in a build without watch parties.
notice-no-party = Watch parties aren't available in this version of anistream.

# Message when a watch party was asked for with no room named.
party-needs-room = A watch party needs a room to meet in. Choose one first.

# Message in a watch party when its server connection dropped and is retried.
party-server-lost = Lost the watch party server. Trying again.

# Message in a watch party when the connection came back.
party-rejoined = Back in the watch party.

# Message when the person left a watch party.
party-left = Left the watch party.

# Toast after joining a plugin store with an invite that names this device's owner.
store-joined = Joined { $store } as { $member }.

# Toast after joining a plugin store with its open link, which keeps no name.
store-joined-unnamed = Joined { $store } without a name.

# Toast after leaving a plugin store.
store-left = Left { $store }. Its plugins stay installed.

# Toast after a plugin is deleted from this device.
plugin-removed = Removed { $plugin }.

# Toast after a store owner removes a member.
store-member-removed = Removed. Their devices stopped working with this plugin store.

# Toast after a store owner cancels an invite.
store-invite-cancelled = Invite cancelled. The link no longer works.

# Toast after a store owner lets anyone with the store's link join.
store-open-join-on = Anyone with the plugin store's link can join now. Copy it from the members screen.

# Toast after a store owner turns off joining with the link, when no device joined that way.
store-open-join-off = Only people you invite can join now.

# Toast after a store owner turns off joining with the link, when some devices joined that way.
store-open-join-off-devices =
    { $devices ->
        [one] Only people you invite can join now. The device that joined with the link keeps working until you remove it.
       *[other] Only people you invite can join now. The { $devices } devices that joined with the link keep working until you remove them.
    }

# Toast after one device that joined with the store's link is removed.
store-device-removed = That device no longer works with this plugin store.

# Toast after every device that joined with the store's link is removed.
store-devices-removed = Removed every device that joined with the link.

# Toast after a plugin is published to a store.
plugin-published = Published { $plugin } { $version }.

# Toast after a plugin stops being offered in a store.
plugin-unpublished = { $plugin } is no longer offered.

# Toast after the store's admin page opens in the browser.
store-admin-opened = Opened the admin page in your browser. The link works once, for ten minutes.

# Toast when the browser could not be opened for the store's admin page. The reason comes from the system.
store-admin-open-failed = Couldn't open a browser ({ $reason }). On the plugin store's machine, run "anistream store admin" to print a link.

# Toast after a plugin is installed while plugins are switched off in the source order.
plugin-installed-unused = Installed { $plugin } { $version }, but plugins are switched off in the source order, so it isn't used.

# Toast after a plugin is installed under the name of a built-in source, so it was not loaded.
plugin-installed-name-clash = Installed { $plugin }, but { $id } is the name of a built-in source, so it wasn't loaded.

# Toast after a plugin is installed and ready to use.
plugin-installed = Installed { $plugin } { $version }.

# Toast after a plugin is installed but could not be loaded. The reason comes from the plugin host.
plugin-installed-not-loaded = Installed { $plugin }, but it didn't load. { $reason }

# Toast at launch when joined plugin stores offer newer versions of installed plugins.
plugin-updates-ready =
    { $count ->
        [one] Plugin update ready: { $names }.
       *[other] Plugin updates ready: { $names }.
    }

# Note on the sources screen when the plugins could not be loaded. The reason comes from the plugin host.
plugins-load-failed = Couldn't load plugins. { $reason }

# Error: the store was joined once, but this device has no saved token for it.
store-token-missing = There is no token for { $store } on this device. Join it again with a new invite.

# Error: the store the record points to is gone from the saved list.
store-not-joined = That plugin store is no longer joined.

# Error: a store's signing key is unreadable. Shown as the reason a store is offline.
store-key-damaged = The plugin store's key is damaged.

# Error: a store rejected this device's token.
store-device-refused = { $store } no longer accepts this device. Join it again with a new invite.

# Error: a store could not be reached. The reason comes from the network.
store-unreachable = Couldn't reach { $store }. { $reason }

# Error: an invite link names a store this device already joined, but at another address.
store-moved = { $store } is joined at { $current }, but this link points to { $target }. If the plugin store has moved, leave it first and join again.

# Error: an open link would replace the named membership this device already has.
store-join-would-unname = You joined { $store } as { $member }. This link would join it again without your name, so nothing was changed.

# Error: the server at a link's address could not prove it is the store the invite named.
store-not-the-invited = { $url } is not the plugin store in the invite ({ $reason }). Nothing was joined.

# Error: the token for a joined store could not be saved on this device. The reason comes from the system.
store-token-not-kept = Couldn't keep the token for this plugin store. { $reason }

# Error: an invite that cannot be used any more.
store-invite-unusable = That invite was already used, was cancelled or has expired. Ask for a new one.

# Error: an open link that no longer lets anyone join.
store-open-link-unusable = That link no longer lets anyone join. Ask the plugin store's owner for a new link or an invite.

# Error: a plugin takes the name of a built-in source.
plugin-reserved-name = { $plugin } is the name of a built-in source, so it can't be a plugin.

# Error: a store stopped offering a plugin between listing it and installing it.
store-plugin-withdrawn = { $store } no longer offers { $plugin }.

# Error: a store changed a plugin after the person agreed to what was shown.
store-plugin-changed = { $store } changed { $plugin } since it was shown. Look at it again before installing.

# Error: a plugin installed from one store is offered by another.
plugin-from-other-store = { $plugin } is installed from { $store }, which keeps it updated.

# Error: a plugin file added by hand already declares the same name.
plugin-duplicate-file = { $path } already declares { $plugin }. Remove that file first, or two copies would run.

# Error: a plugin could not be downloaded or installed. The reason comes from the store or the system.
plugin-install-failed = Couldn't install { $plugin }. { $reason }

# Error: a plugin could not be published. The reason comes from the store or the system.
plugin-publish-failed = Couldn't publish { $plugin }. { $reason }

# Error: a plugin to publish is no longer in the plugin folder.
plugin-missing-locally = { $plugin } is no longer in the plugin folder.

# Error: an invite for another device cannot be made from a device that joined with the open link.
store-invite-needs-link = This device joined { $store } with its link. Paste the same link on the other device.

# Error: the store sent an invite link that does not parse. The reason comes from the link parser.
store-link-malformed = The plugin store made a bad link. { $reason }

# Error: the store sent a link carrying another store's key.
store-link-wrong-key = The plugin store made a link with a different key. Check the address it was started with.

# Error: the store's server has no admin page.
store-admin-missing = { $store } has no admin page. Its server may be older.

# Error: the store sent an admin link that points somewhere else.
store-admin-link-foreign = { $store } sent an admin link for another address.

# Error: the store's server is too old for joining with a link.
store-open-join-unsupported = { $store }'s server is older and can't let anyone join with a link. Update it first.

# Toast after a source (plugin) is switched off. It is skipped when looking for episodes.
source-switched-off = { $name } is off. It is skipped when looking for episodes.

# Toast after a source (plugin) is switched on.
source-switched-on = { $name } is on.

# Error: a command named a plugin that is not loaded.
plugin-not-loaded = { $id } is not a plugin that is loaded.

# Toast after a release is chosen for a title. The name is the release's title.
release-pinned = { $name } will be used for this title.

# Toast when the chosen source or release for a title could not be saved. The reason comes from the database.
notice-choice-not-saved = Couldn't save that choice. { $reason }

# Toast while torrents are running but the connection check failed, and the settings say to warn only.
torrent-check-failed-running = The connection check failed. Torrents keep running.

# Note on the sources screen: torrents are waiting for the VPN guard. The reason comes from the guard.
torrent-vpn-waiting = Torrents start once the VPN guard passes. { $reason }

# Note on the sources screen: the VPN guard has no verdict yet.
torrent-vpn-unverified = Torrents start once the VPN guard passes. The connection hasn't been verified yet.

# Error: torrents are on, but no torrent index is set.
torrent-no-index = Torrents need a torrent index. anistream ships none, so add your own address in the settings.

# Error: the torrent session did not start because the interface closed first.
torrent-interface-closed = The interface closed before torrents started.

# Error: the torrent session could not start. The reason comes from the torrent engine.
torrent-session-failed = Couldn't start the torrent session. { $reason }

# Toast when torrents are up but no operating-system firewall rule backs the VPN guard.
torrent-no-kill-switch = There is no OS-level kill switch behind the VPN guard. Run "anistream --doctor" for advice.

# Toast when the connection check could not run. The reason comes from the VPN settings.
torrent-not-checked = Couldn't check the connection. { $reason }

# Note on the sources screen after the source chain is rebuilt with torrents on.
sources-reloaded-torrents-pending = Sources reloaded. Torrents start once the VPN guard passes.

# Note on the sources screen after the source chain is rebuilt with torrents off.
sources-reloaded-torrents-off = Torrents are off. The session was stopped.

# Note on a running job: requests to AniList are being slowed to stay within its limit. A countdown follows.
job-anilist-limit = Waiting on the AniList rate limit

# Toast when there is no job to carry the wait for AniList's rate limit.
notice-anilist-limit = Waiting { $wait } on the AniList rate limit.

# Toast when the AniList fallback takes over because AniList cannot be reached.
notice-anilist-unreachable = AniList is unreachable. Using the fallback for fresh data for now.

# Toast when no metadata service answered and the last cached data is shown.
notice-metadata-cached = No metadata service answered. Showing what was last cached.

# Toast when AniList answers again.
notice-anilist-back = AniList is back.

# Toast when a command needs watch parties but this app was built without them.
notice-party-not-built = Watch parties aren't built into this app.

# Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList.
notice-signed-in = Signed in to { $tracker }.

# Toast after a sign-in succeeded and the token went into the system keychain.
notice-signed-in-keychain = Signed in to { $tracker }. The token is in the OS keychain.

# Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows.
notice-signed-in-file = Signed in to { $tracker }. No keychain is available, so the token is in a private file on this device.

# Toast when a sign-in worked but the token could not be stored. The reason comes from the system.
notice-signed-in-unsaved = Signed in to { $tracker }, but the token wasn't saved, so you'll need to sign in again next time. { $reason }

# Toast when a sign-in token could not be stored. The reason comes from the system.
notice-token-not-saved = Couldn't save the sign-in token. Try signing in again. { $reason }

# Toast when a sign-in did not finish. The reason comes from the tracker or the network.
notice-sign-in-failed = Couldn't sign in to { $tracker }. Try again. { $reason }

# Toast when the wait for a sign-in ended early. The reason comes from the system.
notice-sign-in-stopped = The sign-in to { $tracker } stopped before it finished. Try again. { $reason }

# Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker.
notice-token-exchange-failed = Couldn't get a token from { $tracker }. Try signing in again. { $reason }

# Toast when no browser could be opened for a sign-in. The reason comes from the system.
notice-browser-not-opened = Couldn't open a browser for the sign-in. Check that one is installed and try again. { $reason }

# Toast when a sign-in redirect arrives and no sign-in is waiting for it.
notice-sign-in-not-waiting = No sign-in to { $tracker } is waiting for that. Start the sign-in again.

# Toast when a sign-in redirect does not match the request that was made.
notice-sign-in-wrong-request = That sign-in to { $tracker } didn't come back from this request. Start the sign-in again.

# Toast when a tracker sent the person back without a token.
notice-sign-in-no-token = The sign-in to { $tracker } came back without a token. Try again.

# Toast when this build has no MyAnimeList client to finish a sign-in with.
notice-mal-client-missing-build = Couldn't finish signing in to MyAnimeList: this build has no client for it.

# Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.
notice-kitsu-signs-in-on-accounts = Kitsu signs in from the Accounts screen.

# Toast when a tracker has no way to sign in yet.
notice-sign-in-unsupported = Signing in to { $tracker } isn't supported yet.

# Toast on an app that cannot receive a browser redirect.
notice-sign-in-needs-redirect = Signing in to { $tracker } needs a browser redirect, which this app can't receive.

# Toast when AniList is set to a sign-in method only the anistream app can finish. The setting name is a key of the config file and is not translated.
notice-anilist-implicit-flow = This AniList sign-in method works only in the anistream app. To sign in here, set { $setting } to "loopback" in the config file.

# Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated.
notice-anilist-client-missing = AniList needs a client id and secret. Set { $client } and { $secret } in the config file, then sign in again. To get the sign-in address, run anistream --login-url.

# Toast when AniList is set to paste the code by hand, which a running terminal app cannot take.
notice-anilist-paste-flow = Pasting a code isn't possible here. Quit and run anistream --login instead.

# Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated.
notice-mal-client-missing = MyAnimeList needs a client id. Register an app of type other at myanimelist.net/apiconfig, then set { $setting } in the config file.

# Status line while the browser sign-in is open and the app waits for it to come back.
status-waiting-for-redirect = Waiting for { $tracker } to redirect back…

# Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.
notice-mal-no-refresh-token = MyAnimeList didn't issue a refresh token. You'll need to sign in again in about a month.

# Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated.
notice-client-id-missing = Set { $setting } in the config file first.

# Toast after signing out of a tracker with nothing waiting to send.
notice-signed-out = Signed out of { $tracker }.

# Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in.
notice-signed-out-queue =
    { $count ->
        [one] Signed out of { $tracker }. One queued change is kept for the next sign-in.
       *[other] Signed out of { $tracker }. { $count } queued changes are kept for the next sign-in.
    }

# Toast when signing out of a tracker failed. The reason comes from the system.
notice-sign-out-failed = Couldn't sign out of { $tracker }. Try again. { $reason }

# Toast when a setting could not be stored. The cause says why and what to do.
notice-not-saved-because = Couldn't save that setting. { $cause }

# Toast when the torrent protection choice was saved.
notice-protection-saved = Saved torrent protection.

# Toast when the torrent protection could not be checked. The cause says why.
notice-protection-not-checked = Couldn't check the torrent protection. { $cause }

# Toast when the proxy's password could not be stored. The reason comes from the system.
notice-proxy-password-not-kept = Couldn't keep the proxy's password. Enter it again to try saving it. { $reason }

# Toast when a show's setting was given a value it does not take. The value is what was given.
notice-show-setting-refused = Couldn't save that setting. { $value } isn't a value for { $setting }.

# Toast when resetting a show's settings failed. The reason comes from the local database.
notice-show-not-reset = Couldn't reset this show's settings. { $reason }

# Toast when a subtitle choice names subtitles the show has not used.
