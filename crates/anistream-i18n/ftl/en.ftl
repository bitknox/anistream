# The legal line. It exists once, so no translation can paraphrase it.
legal-hosts-no-content = anistream hosts no content.

# Toast after a setting is stored. The label is the setting's name.
notice-saved = Saved { $label }.

# Toast when a setting could not be stored. The reason comes from the system.
notice-not-saved = Couldn't save that setting. { $reason }

# Toast when a title's details did not load.
notice-title-load-failed = Couldn't load this title. Check your connection and try again.

# Toast when playback stops with an error.
notice-playback-failed = Playback failed. Try another source.

# Toast after episodes are added to the download queue.
notice-episodes-queued =
    { $count ->
        [one] Queued one episode.
       *[other] Queued { $count } episodes.
    }

# Under a release in the source picker: how many people share it right now.
source-picker-seeders-linux =
    { $count ->
        [one] One seeder
       *[other] { $count } seeders
    }

# Button that runs a failed action again.
action-try-again = Try again

# Button that closes a dialog without doing what it offered.
action-cancel = Cancel

# Button that puts a question off until later.
action-not-now = Not now

# Button that closes a sheet whose changes have already been made.
action-done = Done

# Continue row subtitle. The show's title is cut first when the row is short.
queue-episodes-left =
    { $count ->
        [one] One episode left in { $title }
       *[other] { $count } episodes left in { $title }
    }

# A number of episodes, alone: a badge or a count under a title.
episodes-count =
    { $count ->
        [one] { $count } episode
       *[other] { $count } episodes
    }

# How far through a show a person is. The plural follows the total.
progress-episodes =
    { $total ->
        [one] { $watched } of { $total } episode
       *[other] { $watched } of { $total } episodes
    }

# A span of time to the next episode, in days and hours. The unit letters belong to the language.
duration-days-hours = { $days }d { $hours }h

# Group header on the library and continue screens.
group-in-progress = In progress

# Group header for what aired in the last few days.
group-new-this-week = New this week

# Label on the card for the episode that plays after this one.
player-up-next = Up next

# Label before the name of the work a show is based on.
title-based-on = Based on

# Settings group and row title for choosing a language.
settings-language = Language

# Settings row for the language of the app's own text.
settings-language-app = App language

# First choice in the language list: use the device's language.
language-follow-system = Follow system language

# Label beside a language whose text a person has not reviewed yet.
