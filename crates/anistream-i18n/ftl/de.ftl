# Heading of the empty episode table when a { -source } matched the title and listed nothing.
episodes-empty-none-listed = Keine Folgen aufgeführt

# Under the heading when a { -source } listed no episodes. The keys search by hand and pick another { -source }.
episodes-empty-none-listed-hint = Die Quelle hat für diesen Titel keine Folgen aufgeführt. Drücke { $search }, um nach dem richtigen Treffer zu suchen, oder { $pick }, um eine andere Quelle auszuwählen.

# Toast when an episode has no { -release } to pick from.
episodes-no-releases = Für diese Folge stehen keine Releases zur Auswahl.

# Toast when a download is asked for from a table listed from AniList alone. The key opens the { -source-pl } screen.
episodes-add-source-to-download = Füge vor dem Herunterladen eine Quelle hinzu. Drücke { $key }, um den Bildschirm Quellen zu öffnen.

# Toast when marking the episodes before the highlighted one and the table is empty.
episodes-mark-none-listed = Keine Folgen zum Markieren aufgeführt.

# Toast when marking the episodes before the first one.
episodes-mark-nothing-before = Vor der ersten Folge gibt es nichts.

# Toast when every episode before the highlighted one is already watched.
episodes-mark-already-watched = Alle Folgen vor Folge { $episode } sind schon gesehen.

# Toast after the episodes before the highlighted one are marked watched.
episodes-marked-watched =
    { $count ->
        [one] { $count } Folge als gesehen markiert.
       *[other] { $count } Folgen als gesehen markiert.
    }

# Toast when the range typed for a download is not understood. The examples are typed as they are.
episodes-range-invalid = Der Bereich konnte nicht gelesen werden. Verwende eine Folge (4), einen Bereich (1-12) oder alles ab einer Folge (7-).

# Toast when no episode falls in the range typed for a download.
episodes-range-empty = In diesem Bereich gibt es keine Folgen. Versuche einen anderen Bereich.

# Toast after a range is queued for download.
episodes-queueing =
    { $count ->
        [one] { $count } Folge wird zum Herunterladen vorgemerkt.
       *[other] { $count } Folgen werden zum Herunterladen vorgemerkt.
    }

# Toast when a match is fixed from a list.
episodes-match-off-page = Öffne die Seite des Titels, um die Zuordnung zu korrigieren.

# Toast when a match is fixed and no title is highlighted.
episodes-match-nothing = Nichts ist ausgewählt, das neu zugeordnet werden kann.

# Toast after a match is picked. The title is the candidate's own.
episodes-matched = Zugeordnet zu { $title }.

# After a { -release } in the picker: it holds both the subbed and the dubbed audio.
episodes-release-dual = Untertitelt und synchronisiert

# After a { -release } in the picker: it is dubbed.
episodes-release-dub = Synchronisiert

# After a { -release } in the picker: it is the one anistream would play on its own.
episodes-release-current-pick = Aktuelle Auswahl

