episodes-empty-no-source-hint = AniList non elenca ancora episodi per questo titolo, e nessuna fonte è pronta. Premi { $key } per aprire la schermata Fonti.

# Heading of the empty episode table when the title has not aired yet.
episodes-empty-unaired = Nessun episodio è ancora uscito

# Under the heading when the title has not aired yet. The span is short, such as 2d 3h.
episodes-empty-unaired-hint = L'episodio { $episode } esce tra { $span }.

# Heading of the empty episode table when a { -source } matched the title and listed nothing.
episodes-empty-none-listed = Nessun episodio elencato

# Under the heading when a { -source } listed no episodes. The keys search by hand and pick another { -source }.
episodes-empty-none-listed-hint = La fonte non elenca episodi per questo titolo. Premi { $search } per cercare la corrispondenza giusta, o { $pick } per scegliere un'altra fonte.

# Toast when an episode has no { -release } to pick from.
episodes-no-releases = Non ci sono versioni tra cui scegliere per questo episodio.

# Toast when a download is asked for from a table listed from AniList alone. The key opens the { -source-pl } screen.
episodes-add-source-to-download = Aggiungi una fonte prima di scaricare. Premi { $key } per aprire la schermata Fonti.

# Toast when marking the episodes before the highlighted one and the table is empty.
episodes-mark-none-listed = Non ci sono episodi elencati da segnare.

# Toast when marking the episodes before the first one.
episodes-mark-nothing-before = Non c'è nulla prima del primo episodio.

# Toast when every episode before the highlighted one is already watched.
episodes-mark-already-watched = Tutti gli episodi prima dell'episodio { $episode } sono già visti.

# Toast after the episodes before the highlighted one are marked watched.
episodes-marked-watched =
    { $count ->
        [one] Segnato { $count } episodio come visto.
        [many] Segnati { $count } episodi come visti.
       *[other] Segnati { $count } episodi come visti.
    }

# Toast when the range typed for a download is not understood. The examples are typed as they are.
episodes-range-invalid = Non riesco a leggere questo intervallo. Usa un episodio (4), un intervallo (1-12) o tutti dal settimo in poi (7-).

# Toast when no episode falls in the range typed for a download.
episodes-range-empty = Nessun episodio in questo intervallo. Prova un altro intervallo.

# Toast after a range is queued for download.
episodes-queueing =
    { $count ->
        [one] Metto in coda { $count } episodio per il download.
        [many] Metto in coda { $count } episodi per il download.
       *[other] Metto in coda { $count } episodi per il download.
    }

# Toast when a match is fixed from a list.
episodes-match-off-page = Apri la pagina del titolo per correggere la corrispondenza.

# Toast when a match is fixed and no title is highlighted.
episodes-match-nothing = Nessun titolo è selezionato da associare di nuovo.

# Toast after a match is picked. The title is the candidate's own.
episodes-matched = Associato a { $title }.

# After a { -release } in the picker: it holds both the subbed and the dubbed audio.
