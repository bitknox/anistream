# Note under the titles row.
settings-note-titles = La scelta di AniList segue il tuo account AniList. Senza accesso, è l'inglese.

# Note under the subtitles row.
settings-note-subtitles = Premi Invio per digitare un codice lingua. Ci sono troppi valori da scorrere.

# Note under the opening and ending marks row.
settings-note-mark-chapters = Aggiunge segni dei capitoli alla barra quando lo stream non ne ha.

# Note under the skip button row.
settings-note-skip-button = Mostra un pulsante su apertura e chiusura quando il salto non è automatico.

# Note under the fullscreen row. "f" is mpv's own key and is not translated.
settings-note-fullscreen = mpv si apre a schermo intero. Il suo tasto f continua a uscire dallo schermo intero.

# Note under the upscaling row.
settings-note-upscaling = Si adatta al video e alla scheda grafica. Si applica dall'episodio successivo.

# Note under the player interface row.
settings-note-player-ui = Mostra miniature, menu e pulsante Salta nell'aspetto di anistream.

# Note under the night mode row.
settings-note-night-mode = Attenua i dialoghi sommessi e la musica alta.

# Note under the download folder row.
settings-note-download-dir = Premi Invio per digitare un percorso. Si applica al download successivo.

# Note under the merge subtitles row.
settings-note-merge-subtitles = Si applica al download successivo che termina.

# Note under the keep seeding row. It is a privacy choice.
settings-note-keep-seeding = Se attiva, resti elencato come seeder. Si applica subito.

# Note under the after each download row.
settings-note-download-hook = Premi Invio per digitare un comando. Viene eseguito dopo ogni download completato.

# Note under the Syncplay row. The key is the one that plays a single episode in a { -watch-party }.
settings-note-syncplay = Premi { $key } per riprodurre un solo episodio nella stanza impostata qui sotto. Se attiva, ogni riproduzione finisce lì.

# Note under the Syncplay server row.
settings-note-syncplay-server = Premi Invio per digitare host:port. Non c'è nessun server finché non ne scegli uno.

# Note under the Syncplay room row.
settings-note-syncplay-room = Premi Invio per digitare la stanza di un amico. Lasciala vuota per crearne una che nessuno possa indovinare.

# Note under the check for updates row.
settings-note-update-check = Una richiesta in cache al giorno, fatta all'avvio.

# Note under the Discord presence row once a client ID is set.
settings-note-presence = Ha effetto dall'episodio successivo.

# Note under the Discord presence row when no client ID is set. The address is a web address.
settings-note-presence-needs-client = Serve un ID client. Registra un'app su discord.com/developers.

# Note under the presence title row. The quoted text is what Discord shows.
settings-note-presence-title = Disattivato mostra “Guarda anime” senza nominare la serie.

# Note under the rich presence row.
settings-note-presence-rich = Aggiunge la copertina, una barra di avanzamento e un link ad AniList. Richiede il titolo visibile.

# Note under the torrent playback row.
settings-note-torrents = Richiede una VPN configurata. Ha effetto subito.

# Note under the VPN mode row.
settings-note-vpn-mode = Modifica config.toml per cambiare. Disattivare la protezione richiede un passaggio esplicito.

# Note under the seed after watching row.
settings-note-seed-ratio = Mantiene in condivisione gli episodi visti mentre anistream è aperta.

# Note under the seed for at most row.
settings-note-seed-hours = Il limite massimo di condivisione di un episodio, a prescindere dal rapporto.

# Note under the upload limit row.
settings-note-upload-limit = Limita tutto il caricamento torrent, così la condivisione non rallenta mai la riproduzione.

# Note under the token storage row. The option is a command-line flag and is not translated.
settings-note-token-storage = Usa --token-to-file per spostare un token esistente.

# Heading of the { -plugin-store } screens when the terminal is too small to draw them.
