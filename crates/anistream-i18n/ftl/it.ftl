# Generated by tools/i18n from i18n/. Do not edit.

# What the TV's loading screen and its own controls show under the show's name.
cast-episode = Episodio { $episode }

# What the TV's loading screen and its own controls show under the show's name, with the episode's own title.
cast-episode-titled = Episodio { $episode } · { $title }

# The episode opens in another app, which this device can't cast.
notice-cast-deep-link = Questo episodio si apre in un'altra app, quindi non può essere trasmesso.

# The TV picked to cast to has left the network.
notice-cast-no-device = Quel TV non è più sulla rete.

# This build of the app has no casting.
notice-cast-unavailable = Questa build di anistream non può trasmettere ai TV.

# A comment's age, beside its author, when it was written under a minute ago.
discussion-age-now = ora

# A comment's age, beside its author, in minutes. Abbreviated, as a timeline shows it.
discussion-age-minutes = { $minutes } min

# A comment's age, beside its author, in hours. Abbreviated, as a timeline shows it.
discussion-age-hours = { $hours } h

# A comment's age, beside its author, in days. Abbreviated, as a timeline shows it.
discussion-age-days = { $days } g

# A comment's age, beside its author, in weeks. Abbreviated, as a timeline shows it.
discussion-age-weeks = { $weeks } sett

# A comment's age, beside its author, in years. Abbreviated, as a timeline shows it.
discussion-age-years = { $years } a

# Toast when a like on a comment did not reach AniList. The like is taken back.
notice-comment-like-failed = Impossibile mettere mi piace al commento. Riprova.

# Toast when a comment could not be deleted on AniList. The comment stays.
notice-comment-delete-failed = Impossibile eliminare il commento. Riprova.

# Toast when the viewer tried to like or post in a discussion without signing in to AniList.
notice-discussion-sign-in = Accedi con AniList per mettere mi piace e rispondere.

# A reason on its own, as a toast or a failed play's explanation. The reason is one of the engine's own reasons, so it is translated.
notice-reason = { $reason }

# Reason: no source is set up, so nothing can be played or downloaded. Shown in a toast.
cause-no-sources = Non sono configurate fonti. Aggiungine una nella schermata Fonti.

# A play's explanation: the episode's broadcast is still ahead. The "when" says today, tomorrow or a date.
notice-not-aired = L'episodio { $episode } va in onda { $when }.

# A play's explanation: the episode is after the next one to air. The "when" says when that one airs.
notice-not-aired-yet = L'episodio { $episode } non è ancora in onda. L'episodio { $next } va in onda { $when }.

# Part of an air time: the broadcast is later today. The time is the viewer's local time.
cause-airs-today = oggi alle { $time }

# Part of an air time: the broadcast is tomorrow. The time is the viewer's local time.
cause-airs-tomorrow = domani alle { $time }

# Part of an air time: the broadcast is within the next week.
cause-airs-in-days =
    { $days ->
        [one] tra un giorno alle { $time }
        [many] tra { $days } giorni alle { $time }
       *[other] tra { $days } giorni alle { $time }
    }

# Part of an air time: the broadcast is more than a week away. The date is year-month-day.
cause-airs-on-date = il { $date } alle { $time }

# Reason: the source answered but gave nothing to play.
cause-no-playable-stream = La fonte ha risposto, ma non c'è niente da riprodurre. Provane un'altra.

# Reason: no source could be matched to the title. The detail is what each source said.
cause-title-no-match = Impossibile abbinare questo titolo: { $detail }

# Reason: the source the person picked is no longer installed or enabled.
cause-source-gone = La fonte { $source } non è più disponibile. Scegline un'altra.

# Reason: the release the person picked would not start. The detail comes from the source.
cause-release-failed = Impossibile avviare quella versione: { $detail }

# Reason: a play waited too long for its sources to give it a stream, and gave up.
cause-sources-timed-out = Le fonti hanno impiegato troppo tempo a rispondere. Riprova, oppure scegline un'altra.

# Reason: every source matched the title but none has the episode. The detail is what each said.
cause-no-source-has-episode = Nessuna fonte ha l'episodio { $episode }: { $detail }

# Reason: the source streams episodes but only torrents can be downloaded.
cause-source-cannot-download = Questa fonte offre episodi in streaming, ma non permette di scaricarli.

# Reason: the title was never listed by a source, so it can't be downloaded.
cause-no-source-could-list-show = Nessuna fonte è riuscita a elencare questa serie, quindi non può essere scaricata.

# Part of a finished download's toast: subtitle files were merged into the video.
cause-subtitles-merged =
    { $tracks ->
        [one] È stata unita al video una traccia di sottotitoli.
        [many] Sono state unite al video { $tracks } tracce di sottotitoli.
       *[other] Sono state unite al video { $tracks } tracce di sottotitoli.
    }

# Part of a finished download's toast: merging failed, so the subtitles stay as files beside it.
cause-subtitles-left-apart = I sottotitoli restano come file separati. { $reason }

# Part of a download toast: how many episodes of the range were in the queue already.
cause-already-in-downloads =
    { $count ->
        [one] Un episodio è già nei download.
        [many] { $count } episodi sono già nei download.
       *[other] { $count } episodi sono già nei download.
    }

# Job note while a play looks the title up.
status-looking-up-title = Cerco il titolo…

# Job note while a play waits for the sources to arrive.
status-loading-sources = Carico le fonti…

# Job note while the sources are asked for an episode. The episode is its label, often a number.
status-searching-sources = Cerco nelle fonti l'episodio { $episode }…

# Toast when the player cannot be started. The reason comes from the system.
notice-player-failed-to-start = Impossibile avviare mpv. Verifica che si avvii da solo. ({ $reason })

# Toast when a stream never showed a frame and the next one is tried.
notice-stream-no-video = Nessun video da questo flusso. Provo il flusso { $next } di { $total }.

# Toast when mpv gave up on a file. The reason is mpv's own line.
notice-player-could-not-play = mpv non è riuscito a riprodurre questo file. { $reason }

# Toast when mpv closed without playing and without saying why.
notice-player-exited-silently = mpv si è chiuso senza riprodurre nulla e senza spiegare il motivo. Prova un'altra fonte.

# Toast when no picture has appeared a while after the player opened.
notice-player-not-playing = mpv non ha iniziato a riprodurre dopo { $seconds } s. La fonte potrebbe non avere dati. Verifica che mpv riproduca un file da solo.

# Toast when a play is asked for in a build with no player.
notice-no-player = Questa edizione di anistream non può riprodurre video.

# Toast at launch when the mpv program is missing. The binary is the name the settings give it. Terminal only: the engine never sends it to the apps.
notice-mpv-missing = { $binary } non è stato trovato. Installa mpv per riprodurre gli episodi.

# Toast at launch when mpv is too old for anistream's own player. Terminal only: the engine never sends it to the apps.
notice-mpv-old = mpv { $version } può riprodurre, ma il player di anistream richiede mpv 0.36 o più recente per il pulsante di salto, la scheda Prossimo, i menu e le miniature.

# Toast when an episode plays with no subtitles because none of the source's subtitle files could be downloaded.
notice-subtitles-unavailable = Non è stato possibile caricare i sottotitoli di questa fonte. Scegline un'altra per riprovare.

# Toast after a link was handed to the browser.
notice-opened-in-browser = Aperto nel tuo browser.

# Toast when a link could not be opened. The reason comes from the system.
notice-could-not-open = Impossibile aprire questo link. { $reason }

# Toast when a trailer plays in mpv.
notice-trailer-playing = Trailer in riproduzione in mpv.

# Toast when a trailer opens in the browser.
notice-trailer-opened = Trailer aperto nel browser.

# Toast when a trailer could not be opened. The reason comes from the system.
notice-trailer-failed = Impossibile aprire il trailer. { $reason }

# Toast when the next episode is not the one after this because filler was skipped.
notice-filler-skipped = Filler saltati. Prossimo è l'episodio { $episode }.

# Toast after switching the audio while playing.
notice-audio-now-subbed = Ora l'audio è sottotitolato.

# Toast after switching the audio while playing.
notice-audio-now-dubbed = Ora l'audio è doppiato.

# Toast when the previous-episode control is used on the first episode.
notice-already-first-episode = Sei già al primo episodio.

# Toast when the next-episode control is used on the last known episode.
notice-last-episode = Non c'è un episodio successivo. L'episodio { $episode } è l'ultimo.

# Toast when the next-episode control is used and the next episode is not known.
notice-no-next-episode = Non c'è un episodio successivo.

# Toast when the previous-episode control finds no previous episode.
notice-no-previous-episode = Non c'è un episodio precedente.

# Toast when the title's episode match could not be cleared. The reason comes from the system.
notice-match-reset-failed = Impossibile reimpostare l'abbinamento. { $reason }

# Toast when the chosen match could not be saved. The reason comes from the system.
notice-match-save-failed = Impossibile salvare questo abbinamento. { $reason }

# Toast when a chosen match still left the title undecided.
notice-match-did-not-stick = Questo abbinamento non è stato applicato. La fonte potrebbe essere cambiata. Prova a sceglierlo di nuovo.

# Toast when a search of the sources for a title found nothing.
notice-source-search-empty = Nessun risultato per “{ $query }”. Prova una ricerca diversa.

# Toast after the person picked a source for one title.
notice-source-pinned = Per questo titolo si userà { $source }.

# Toast after the person went back to automatic source selection for one title.
notice-source-automatic = Per questo titolo la fonte viene scelta di nuovo automaticamente.

# Toast when the source choice for a title could not be saved. The reason comes from the system.
notice-source-choice-failed = Impossibile salvare la scelta. { $reason }

# Toast when no source could list a show's episodes. The reason is what the sources said.
notice-no-source-could-list = Nessuna fonte è riuscita a elencare questa serie: { $reason }

# Why a title's episodes could not be loaded at all, shown on its page and as a toast. The reason comes from AniList or the network.
notice-episodes-failed = Impossibile caricare gli episodi. { $reason }

# Toast when a source found several shows that could be this one and could not tell which. The episodes shown are AniList's until one is picked. The source is its name.
notice-match-uncertain = { $source } ha trovato più serie che potrebbero essere questa, quindi per ora gli episodi sono quelli di AniList.

# Toast when a title cannot be taken off the Continue row. The reason comes from the system.
notice-continue-hide-failed = Impossibile rimuovere il titolo da Continua a guardare. { $reason }

# Toast after an episode was added to the download queue.
notice-download-queued = Aggiunto alla coda l'episodio { $episode } di { $title }.

# Toast when an episode asked for is in downloads already.
notice-download-already-queued = L'episodio { $episode } di { $title } è già nei download.

# Toast when a waiting or paused download was moved to the front and started.
notice-download-starting-now = Avvio ora l'episodio { $episode } di { $title }.

# Toast after a download was cancelled.
notice-download-cancelled = Download annullato.

# Toast after a download and its file were deleted.
notice-download-file-deleted = Download e file eliminati.

# Toast after a download was removed whose file was already gone.
notice-download-removed-file-gone = Download rimosso. Il file era già stato eliminato.

# Toast after a download was removed but its file could not be deleted. The reason comes from the system.
notice-download-removed-file-kept = Download rimosso, ma non è stato possibile eliminare il file. { $reason }

# Toast after a download with no file was removed.
notice-download-removed = Download rimosso.

# Toast after finished downloads were cleared from the list.
notice-downloads-cleared =
    { $count ->
        [one] Cancellato un download completato.
        [many] Cancellati { $count } download completati.
       *[other] Cancellati { $count } download completati.
    }

# Toast when an episode finished downloading.
notice-download-finished = Episodio { $episode } di { $title } scaricato.

# Toast when an episode finished downloading and the note says what happened to its subtitles.
notice-download-finished-note = Episodio { $episode } di { $title } scaricato. { $note }

# Toast when a download could not start. The reason comes from the torrent client.
notice-download-failed = Impossibile scaricare l'episodio { $episode } di { $title }. { $reason }

# Toast after a range was asked for and nothing was queued.
notice-downloads-none-queued = Niente in coda.

# Toast after a range was asked for and nothing was queued, and the reason it stopped.
notice-downloads-none-queued-stopped = Niente in coda. { $reason }

# Toast after a range was asked for and every episode was in the queue already. `existing` is the sentence of `cause-already-in-downloads`.
notice-downloads-none-new = Niente di nuovo in coda. { $existing }

# Toast as above, with the reason the range stopped. `existing` is the sentence of `cause-already-in-downloads`; `reason` is a sentence saying why the range stopped.
notice-downloads-none-new-stopped = Niente di nuovo in coda. { $existing } { $reason }

# Toast after a range was asked for, some episodes were queued and some were there already. `existing` is the sentence of `cause-already-in-downloads`.
notice-episodes-queued-existing =
    { $count ->
        [one] Aggiunto in coda un episodio. { $existing }
        [many] Aggiunti in coda { $count } episodi. { $existing }
       *[other] Aggiunti in coda { $count } episodi. { $existing }
    }

# Toast as above, with the reason the range stopped.
notice-episodes-queued-stopped =
    { $count ->
        [one] Aggiunto in coda un episodio, poi l'operazione si è fermata. { $reason }
        [many] Aggiunti in coda { $count } episodi, poi l'operazione si è fermata. { $reason }
       *[other] Aggiunti in coda { $count } episodi, poi l'operazione si è fermata. { $reason }
    }

# Toast as above, with some episodes in the queue already and the reason the range stopped. `existing` is the sentence of `cause-already-in-downloads`; `reason` is a sentence saying why the range stopped.
notice-episodes-queued-existing-stopped =
    { $count ->
        [one] Aggiunto in coda un episodio, poi l'operazione si è fermata. { $existing } { $reason }
        [many] Aggiunti in coda { $count } episodi, poi l'operazione si è fermata. { $existing } { $reason }
       *[other] Aggiunti in coda { $count } episodi, poi l'operazione si è fermata. { $existing } { $reason }
    }

# Toast when keep next found no room for another episode.
notice-keep-next-full = Spazio libero insufficiente per tenere scaricati i prossimi episodi. Libera un po' di spazio per scaricarne altri.

# Message when a watch party was asked for with no server chosen. The names are a suggested server and who runs it. Terminal only: the engine never sends it to the apps.
party-needs-server = Scegli prima un server per il watch party, come syncplay.server. { $server } è gestito da { $operator }.

# Message when an app asked for a watch party with no server chosen. The names are a suggested server and who runs it.
party-choose-server = Scegli prima un server per il watch party. { $server } è gestito da { $operator }.

# Toast when a watch party is asked for in a build without watch parties.
notice-no-party = I Watch party non sono disponibili in questa edizione di anistream.

# Message when a watch party was asked for with no room named.
party-needs-room = Per il watch party serve una stanza in cui incontrarsi. Scegline prima una.

# Message in a watch party when its server connection dropped and is retried.
party-server-lost = Persa la connessione al server del watch party. Riprovo.

# Message in a watch party when the connection came back.
party-rejoined = Di nuovo nel watch party.

# Message when the person left a watch party.
party-left = Uscito dal watch party.

# Toast after joining a plugin store with an invite that names this device's owner.
store-joined = Ti sei unito a { $store } come { $member }.

# Toast after joining a plugin store with its open link, which keeps no name.
store-joined-unnamed = Ti sei unito a { $store } senza nome.

# Toast after leaving a plugin store.
store-left = Hai lasciato { $store }. I suoi plugin restano installati.

# Toast after a plugin is deleted from this device.
plugin-removed = Rimosso { $plugin }.

# Toast after a store owner removes a member.
store-member-removed = Rimosso. I suoi dispositivi non funzionano più con questo negozio di plugin.

# Toast after a store owner cancels an invite.
store-invite-cancelled = Invito annullato. Il link non funziona più.

# Toast after a store owner lets anyone with the store's link join.
store-open-join-on = Ora chiunque abbia il link del negozio di plugin può unirsi. Copialo dalla schermata dei membri.

# Toast after a store owner turns off joining with the link, when no device joined that way.
store-open-join-off = Ora possono unirsi solo le persone che inviti.

# Toast after a store owner turns off joining with the link, when some devices joined that way.
store-open-join-off-devices =
    { $devices ->
        [one] Ora possono unirsi solo le persone che inviti. Il dispositivo che si è unito con il link continua a funzionare finché non lo rimuovi.
        [many] Ora possono unirsi solo le persone che inviti. I { $devices } dispositivi che si sono uniti con il link continuano a funzionare finché non li rimuovi.
       *[other] Ora possono unirsi solo le persone che inviti. I { $devices } dispositivi che si sono uniti con il link continuano a funzionare finché non li rimuovi.
    }

# Toast after one device that joined with the store's link is removed.
store-device-removed = Quel dispositivo non funziona più con questo negozio di plugin.

# Toast after every device that joined with the store's link is removed.
store-devices-removed = Rimossi tutti i dispositivi che si erano uniti con il link.

# Toast after a plugin is published to a store.
plugin-published = Pubblicato { $plugin } { $version }.

# Toast after a plugin stops being offered in a store.
plugin-unpublished = { $plugin } non è più offerto.

# Toast after the store's admin page opens in the browser.
store-admin-opened = Pagina di amministrazione aperta nel browser. Il link funziona una sola volta, per 10 minuti.

# Toast when the browser could not be opened for the store's admin page. The reason comes from the system. The command is typed as it is run.
store-admin-open-failed = Impossibile aprire il browser ({ $reason }). Sul computer del negozio di plugin, esegui "anistream store admin" per stampare un link.

# Toast after a plugin is installed while plugins are switched off in the source order.
plugin-installed-unused = Installato { $plugin } { $version }, ma i plugin sono disattivati nell'ordine delle fonti, quindi non viene usato.

# Toast after a plugin is installed under the name of a built-in source, so it was not loaded.
plugin-installed-name-clash = Installato { $plugin }, ma { $id } è il nome di una fonte integrata, quindi non è stato caricato.

# Toast after a plugin is installed and ready to use.
plugin-installed = Installato { $plugin } { $version }.

# Toast after a plugin is installed but could not be loaded. The reason comes from the plugin host.
plugin-installed-not-loaded = Installato { $plugin }, ma non è stato caricato. { $reason }

# Toast at launch when joined plugin stores offer newer versions of installed plugins.
plugin-updates-ready =
    { $count ->
        [one] Aggiornamento del Plugin pronto: { $names }.
        [many] Aggiornamenti dei Plugin pronti: { $names }.
       *[other] Aggiornamenti dei Plugin pronti: { $names }.
    }

# Note on the sources screen when the plugins could not be loaded. The reason comes from the plugin host.
plugins-load-failed = Impossibile caricare i plugin. { $reason }

# Error: the store was joined once, but this device has no saved token for it.
store-token-missing = Non c'è un token per { $store } su questo dispositivo. Unisciti di nuovo con un nuovo invito.

# Error: the store the record points to is gone from the saved list.
store-not-joined = Non ti sei più unito a quel negozio di plugin.

# Error: a store's signing key is unreadable. Shown as the reason a store is offline.
store-key-damaged = La chiave di questo negozio di plugin su questo dispositivo è danneggiata. Lascia il negozio di plugin e unisciti di nuovo con un nuovo invito.

# Error: a store rejected this device's token.
store-device-refused = { $store } non accetta più questo dispositivo. Unisciti di nuovo con un nuovo invito.

# Error: a store could not be reached. The reason comes from the network.
store-unreachable = Impossibile raggiungere { $store }. { $reason }

# Error: an invite link names a store this device already joined, but at another address.
store-moved = Sei unito a { $store } su { $current }, ma questo link punta a { $target }. Se il negozio di plugin è stato spostato, lascialo prima e unisciti di nuovo.

# Error: an open link would replace the named membership this device already has.
store-join-would-unname = Ti sei unito a { $store } come { $member }. Questo link ti unirebbe di nuovo senza il tuo nome, quindi non è stato cambiato nulla.

# Error: the server at a link's address could not prove it is the store the invite named.
store-not-the-invited = { $url } non è il negozio di plugin dell'invito ({ $reason }). Non ti sei unito a nulla.

# Error: the token for a joined store could not be saved on this device. The reason comes from the system.
store-token-not-kept = Impossibile salvare il token per questo negozio di plugin. { $reason }

# Error: an invite that cannot be used any more.
store-invite-unusable = Questo invito è già stato usato, è stato annullato o è scaduto. Chiedine uno nuovo.

# Error: an open link that no longer lets anyone join.
store-open-link-unusable = Questo link non permette più a nessuno di unirsi. Chiedi al proprietario del negozio di plugin un nuovo link o un invito.

# Error: a plugin takes the name of a built-in source.
plugin-reserved-name = { $plugin } è il nome di una fonte integrata, quindi non può essere un plugin.

# Error: a store stopped offering a plugin between listing it and installing it.
store-plugin-withdrawn = { $store } non offre più { $plugin }.

# Error: a store changed a plugin after the person agreed to what was shown.
store-plugin-changed = { $store } ha cambiato { $plugin } dopo che è stato mostrato. Guardalo di nuovo prima di installarlo.

# Error: a plugin installed from one store is offered by another.
plugin-from-other-store = { $plugin } è installato da { $store }, che lo tiene aggiornato.

# Error: a plugin file added by hand already declares the same name.
plugin-duplicate-file = { $path } dichiara già { $plugin }. Rimuovi prima quel file, altrimenti girerebbero due copie.

# Error: a plugin could not be downloaded or installed. The reason comes from the store or the system.
plugin-install-failed = Impossibile installare { $plugin }. { $reason }

# Error: a plugin could not be published. The reason comes from the store or the system.
plugin-publish-failed = Impossibile pubblicare { $plugin }. { $reason }

# Error: a plugin to publish is no longer in the plugin folder.
plugin-missing-locally = { $plugin } non è più nella cartella dei plugin.

# Error: an invite for another device cannot be made from a device that joined with the open link.
store-invite-needs-link = Questo dispositivo si è unito a { $store } con il suo link. Incolla lo stesso link sull'altro dispositivo.

# Error: the store sent an invite link that does not parse. The reason comes from the link parser.
store-link-malformed = Il negozio di plugin ha inviato un link che non funziona. Chiedi al proprietario di controllare il negozio di plugin. { $reason }

# Error: the store sent a link carrying another store's key.
store-link-wrong-key = Il negozio di plugin ha creato un link con una chiave diversa. Controlla l'indirizzo da cui è stato avviato.

# Error: the store's server has no admin page.
store-admin-missing = { $store } non ha una pagina di amministrazione. Il suo server potrebbe essere più vecchio.

# Error: the store sent an admin link that points somewhere else.
store-admin-link-foreign = { $store } ha inviato un link di amministrazione per un altro indirizzo.

# Error: the store's server is too old for joining with a link.
store-open-join-unsupported = Il server di { $store } è più vecchio e non può far unire nessuno con un link. Aggiornalo prima.

# Toast after a source (plugin) is switched off. It is skipped when looking for episodes.
source-switched-off = { $name } è disattivato. Viene saltato quando si cercano gli episodi.

# Toast after a source (plugin) is switched on.
source-switched-on = { $name } è attivo.

# Error: a command named a plugin that is not loaded.
plugin-not-loaded = { $id } non è caricato. Controlla che sia installato sotto Fonti.

# Toast after a release is chosen for a title. The name is the release's title.
release-pinned = { $name } sarà usato per questo titolo.

# Toast when the chosen source or release for a title could not be saved. The reason comes from the database.
notice-choice-not-saved = Impossibile salvare quella scelta. { $reason }

# Toast while torrents are running but the connection check failed, and the settings say to warn only.
torrent-check-failed-running = La verifica della connessione non è riuscita. I torrent continuano a funzionare.

# Note on the sources screen: torrents are waiting for the VPN guard. The reason comes from the guard.
torrent-vpn-waiting = I torrent partono quando il controllo VPN è superato. { $reason }

# Note on the sources screen: the VPN guard has no verdict yet.
torrent-vpn-unverified = I torrent partono quando il controllo VPN è superato. La connessione non è ancora stata verificata.

# Error: the torrent session did not start because the interface closed first.
torrent-interface-closed = anistream si è chiuso prima che partissero i torrent.

# Error: the torrent session could not start. The reason comes from the torrent engine.
torrent-session-failed = Impossibile avviare la sessione torrent. { $reason }

# Toast when torrents are up but no operating-system firewall rule backs the VPN guard. Terminal only: the engine never sends it to the apps.
torrent-no-kill-switch = Nulla su questo dispositivo ferma il traffico torrent se la VPN cade. Esegui "anistream --doctor" per configurarlo.

# Toast when the connection check could not run. The reason comes from the VPN settings.
torrent-not-checked = Impossibile verificare la connessione. { $reason }

# Note on the sources screen after the source chain is rebuilt with torrents on.
sources-reloaded-torrents-pending = Fonti ricaricate. I torrent partono quando il controllo VPN è superato.

# Note on the sources screen after the source chain is rebuilt with torrents off.
sources-reloaded-torrents-off = I torrent sono disattivati. La sessione è stata fermata.

# Note on a running job: requests to AniList are being slowed to stay within its limit. A countdown follows.
job-anilist-limit = In attesa del limite di richieste di AniList

# Toast when there is no job to carry the wait for AniList's rate limit.
notice-anilist-limit = In attesa di { $wait } per il limite di richieste di AniList.

# Toast when the AniList fallback takes over because AniList cannot be reached.
notice-anilist-unreachable = AniList non risponde. Per ora vengono mostrati dati di un altro servizio.

# Toast when no metadata service answered and the last cached data is shown.
notice-metadata-cached = Nessun servizio di metadati ha risposto. Vengono mostrati i dati salvati l'ultima volta.

# Toast when AniList answers again.
notice-anilist-back = AniList è di nuovo disponibile.

# Toast when a command needs watch parties but this app was built without them.
notice-party-not-built = Watch party non sono incluse in questa app.

# Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList.
notice-signed-in = Accesso effettuato a { $tracker }.

# Toast after a sign-in succeeded and the token went into the system keychain.
notice-signed-in-keychain = Accesso effettuato a { $tracker }. Il token è nel portachiavi del sistema.

# Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows.
notice-signed-in-file = Accesso effettuato a { $tracker }. Non c'è un portachiavi disponibile, quindi il token è in un file privato su questo dispositivo.

# Toast when a sign-in worked but the token could not be stored. The reason comes from the system.
notice-signed-in-unsaved = Accesso effettuato a { $tracker }, ma il token non è stato salvato: dovrai accedere di nuovo la prossima volta. { $reason }

# Toast when a sign-in token could not be stored. The reason comes from the system.
notice-token-not-saved = Impossibile salvare il token di accesso. Prova ad accedere di nuovo. { $reason }

# Toast when a sign-in did not finish. The reason comes from the tracker or the network.
notice-sign-in-failed = Impossibile accedere a { $tracker }. Riprova. { $reason }

# Toast when the wait for a sign-in ended early. The reason comes from the system.
notice-sign-in-stopped = L'accesso a { $tracker } si è interrotto prima di finire. Riprova. { $reason }

# Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker.
notice-token-exchange-failed = Impossibile ottenere un token da { $tracker }. Prova ad accedere di nuovo. { $reason }

# Toast when no browser could be opened for a sign-in. The reason comes from the system.
notice-browser-not-opened = Impossibile aprire un browser per l'accesso. Controlla che ce ne sia uno installato e riprova. { $reason }

# Toast when a sign-in redirect arrives and no sign-in is waiting for it.
notice-sign-in-not-waiting = Nessun accesso a { $tracker } è in attesa di questa risposta. Avvia di nuovo l'accesso.

# Toast when a sign-in redirect does not match the request that was made.
notice-sign-in-wrong-request = L'accesso a { $tracker } non corrisponde a questa richiesta. Avvia di nuovo l'accesso.

# Toast when a tracker sent the person back without a token.
notice-sign-in-no-token = L'accesso a { $tracker } è tornato senza token. Riprova.

# Toast when this build has no MyAnimeList client to finish a sign-in with.
notice-mal-client-missing-build = Impossibile completare l'accesso a MyAnimeList: questa build non ha un client per farlo.

# Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.
notice-kitsu-signs-in-on-accounts = Per Kitsu l'accesso avviene dalla schermata Account.

# Toast when a tracker has no way to sign in yet.
notice-sign-in-unsupported = L'accesso a { $tracker } non è ancora supportato.

# Toast on an app that cannot receive a browser redirect.
notice-sign-in-needs-redirect = L'accesso a { $tracker } richiede un reindirizzamento dal browser, che questa app non può ricevere.

# Toast when AniList is set to a sign-in method only the anistream app can finish. The setting name is a key of the config file and is not translated.
notice-anilist-implicit-flow = Questo metodo di accesso ad AniList funziona solo nell'app anistream. Per accedere qui, imposta { $setting } su "loopback" nel file di configurazione.

# Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated.
notice-anilist-client-missing = AniList richiede un id client e un segreto. Imposta { $client } e { $secret } nel file di configurazione, poi accedi di nuovo. Per ottenere l'indirizzo di accesso, esegui anistream --login-url.

# Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.
notice-anilist-paste-flow = Qui non è possibile incollare un codice. Esci ed esegui anistream --login.

# Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated.
notice-mal-client-missing = MyAnimeList richiede un id client. Registra un'app di tipo "other" su myanimelist.net/apiconfig, poi imposta { $setting } nel file di configurazione.

# Job note while the browser sign-in is open and the terminal app waits for it to come back.
status-waiting-for-redirect = In attesa che { $tracker } riporti al programma…

# Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.
notice-mal-no-refresh-token = MyAnimeList non ha rilasciato un token di aggiornamento. Dovrai accedere di nuovo tra circa un mese.

# Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated.
notice-client-id-missing = Imposta prima { $setting } nel file di configurazione.

# Toast after signing out of a tracker with nothing waiting to send.
notice-signed-out = Disconnesso da { $tracker }.

# Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in.
notice-signed-out-queue =
    { $count ->
        [one] Disconnesso da { $tracker }. Una modifica in coda viene conservata per il successivo accesso.
        [many] Disconnesso da { $tracker }. { $count } modifiche in coda vengono conservate per il successivo accesso.
       *[other] Disconnesso da { $tracker }. { $count } modifiche in coda vengono conservate per il successivo accesso.
    }

# Toast when signing out of a tracker failed. The reason comes from the system.
notice-sign-out-failed = Impossibile disconnettersi da { $tracker }. Riprova. { $reason }

# Toast when a setting could not be stored. The cause says why and what to do.
notice-not-saved-because = Impossibile salvare questa impostazione. { $cause }

# Toast when the torrent protection choice was saved.
notice-protection-saved = Protezione torrent salvata.

# Toast when the torrent protection could not be checked. The cause says why.
notice-protection-not-checked = Impossibile verificare la protezione torrent. { $cause }

# Toast when the proxy's password could not be stored. The reason comes from the system.
notice-proxy-password-not-kept = Impossibile conservare la password del proxy. Inseriscila di nuovo per provare a salvarla. { $reason }

# Toast when a show's setting was given a value it does not take. The value is what was given.
notice-show-setting-refused = Impossibile salvare questa impostazione. { $value } non è un valore valido per { $setting }.

# Toast when resetting a show's settings failed. The reason comes from the local database.
notice-show-not-reset = Impossibile ripristinare le impostazioni di questa serie. { $reason }

# Toast when a subtitle choice names subtitles the show has not used.
notice-show-no-such-subtitles = Impossibile salvare questa scelta di sottotitoli. Questa serie non ha mai usato quei sottotitoli.

# Toast while torrents are held until the connection check passes.
notice-torrents-waiting-for-check = I torrent attendono che il controllo della connessione torni positivo.

# Toast when the mapping data downloads work again after a failure.
notice-mapping-data-refreshed = Dati di mappatura aggiornati.

# Toast when the mapping data could not be downloaded. It is said once; the retries are silent.
notice-mapping-data-failed = Impossibile aggiornare i dati di mappatura ({ $datasets }). Nuovo tentativo tra { $wait }. { $cause }

# Toast, and desktop notification, for one episode that aired while the app was closed.
notice-episode-aired = { $title }, episodio { $episode }, è andato in onda mentre eri via.

# Toast, and desktop notification, for several episodes that aired while the app was closed.
notice-episodes-aired =
    { $count ->
        [one] È andato in onda un nuovo episodio di una serie che segui. Il calendario lo mostra.
        [many] Sono andati in onda { $count } nuovi episodi di serie che segui. Il calendario li mostra.
       *[other] Sono andati in onda { $count } nuovi episodi di serie che segui. Il calendario li mostra.
    }

# Toast when a new release of anistream is out, on the terminal app. The command is not translated. Terminal only: the engine never sends it to the apps.
notice-update-available = È disponibile { $tag }. Esegui anistream --update per installarla.

# The reason a setting was refused until the person confirms having no protection.
cause-confirm-no-protection = Conferma prima che non vuoi alcuna protezione.

# The reason a setting was refused until the person confirms the "warn only" choice.
cause-confirm-warn-only = Conferma prima che vuoi solo un avviso.

# The reason a proxy was refused: it has no host or no port.
cause-proxy-needs-address = Un proxy richiede un host e una porta.

# The reason a proxy could not be checked: its address is not one the check can use.
cause-proxy-address-unusable = L'indirizzo del proxy non è utilizzabile per un controllo.

# The reason a request failed: it never reached the server.
cause-server-unreachable = Impossibile raggiungere il server.

# Toast after a setting is stored. The label is the setting's name.
notice-saved = Impostazione salvata: { $label }.

# Toast when a setting could not be stored. The reason comes from the system.
notice-not-saved = Impossibile salvare l'impostazione. { $reason }

# Toast when a title's details did not load.
notice-title-load-failed = Impossibile caricare questo titolo. Controlla la connessione e riprova.

# Toast when playback stops with an error.
notice-playback-failed = La riproduzione non è riuscita. Prova un'altra fonte.

# Toast when something went wrong inside the engine and it carried on.
notice-engine-fault = Qualcosa non ha funzionato in anistream. Ha continuato a funzionare, ma se una schermata sembra bloccata, esci e riaprila.

# Toast at launch when the database was damaged, so a fresh one was started. The path is where the damaged file was moved, kept for recovery. Watch history and downloads start over; what the trackers hold comes back with the next sync.
notice-database-set-aside = Il database era danneggiato, quindi anistream ne ha creato uno nuovo. Il file vecchio è conservato in { $path }. I tuoi tracker ripristineranno ciò che contengono alla prossima sincronizzazione.

# Message when anistream could not start because a folder could not be made. The path is the folder, the reason comes from the system.
start-failed-folder = anistream non riesce a creare la cartella { $path }. Controlla che il disco abbia spazio e che la cartella sia scrivibile, poi riprova. { $reason }

# Message when anistream could not start because the config file has a setting it can't use. The path is the file; the problem names the line where it can.
start-failed-config = { $path } contiene un'impostazione che anistream non può usare: { $problem }. Correggila o rimuovila, poi riprova.

# Message when anistream could not start because its database could not be opened. The path is the database file, the reason comes from the system.
start-failed-database = anistream non riesce ad aprire il suo database in { $path }. Se un'altra app anistream è aperta in questa cartella, chiudila e riprova. { $reason }

# Message when anistream could not start its network connection from the network settings.
start-failed-network = anistream non riesce a configurare la connessione di rete con le impostazioni di rete in config.toml. { $reason }

# Message when anistream itself could not start. The reason comes from the system or the engine.
start-failed = anistream non riesce ad avviarsi. Chiudi e riapri. { $reason }

# Message when the TV remote could not start listening or could not forget a phone.
start-failed-remote = Il telecomando non è riuscito ad avviarsi. { $reason }

# Message when the built-in player could not start.
start-failed-player = Il player non è riuscito ad avviarsi. { $reason }

# Toast after episodes are added to the download queue.
notice-episodes-queued =
    { $count ->
        [one] Messo in coda un episodio.
        [many] Messi in coda { $count } episodi.
       *[other] Messi in coda { $count } episodi.
    }

# Note under the connection-check group of the torrents dialog: what the check does.
torrents-linux-check-note = anistream controlla da dove esce il traffico torrent all'avvio di un torrent e ogni minuto mentre è in corso, e mette in pausa i torrent se il controllo fallisce. La tua VPN o il tuo proxy è ciò che ti protegge.

# Confirmation text when choosing "Warn only" for a failed check.
torrents-linux-warn-confirm = anistream ti avviserà invece di mettere in pausa. Se la VPN o il proxy è disattivato, altre persone possono vedere il tuo indirizzo IP.

# Status line once the protection has been checked and saved.
torrents-linux-protection-saved = Protezione dei torrent salvata

# Title of the dialog that turns torrents on.
torrents-linux-turn-on-title = Attiva i torrent

# Title of the dialog that changes what protects torrents.
torrents-linux-protect-title = Proteggi i torrent

# Title of the dialog that edits the proxy.
torrents-linux-edit-proxy-title = Modifica proxy

# Button that turns torrents on in the dialog.
torrents-linux-turn-on-button = Attiva

# Seeding row: time left until the goal, in a span already worded ("18h", "1d 6h").
downloads-linux-seed-left = Mancano { $span }

# Seeding row: less than an hour left until the goal.
downloads-linux-seed-left-soon = Manca meno di un'ora

# Storage row: free space, the disk's size and what downloads take. All three are sizes already formatted.
downloads-linux-space-free = { $free } liberi su { $total } · i download occupano { $taken }

# Placeholder of the search field. It also finds settings.
search-linux-placeholder = Cerca titoli e impostazioni

# Tooltip of the button that clears the recent searches.
search-linux-clear-recent = Cancella le ricerche recenti

# Title of the state when a browse with no filters lists nothing.
search-linux-nothing-found = Nessun risultato

# Title of the state when a typed search waits for Enter.
search-linux-press-enter = Premi Invio per cercare

# Line under the Enter title: why results do not come as you type. The tracker is a name.
search-linux-paused = La ricerca mentre scrivi è in pausa per un momento, per restare nei limiti di { $tracker }.

# Menu title over the sort choices of the filter row.
filter-linux-sort-by = Ordina per

# Sort choice: what is rising now.
filter-linux-sort-trending = Di tendenza

# Sort choice: the most recent first.
filter-linux-sort-newest = Più recenti

# Sort choice: the earliest first.
filter-linux-sort-oldest = Meno recenti

# Sort choice: the most favourited first.
filter-linux-sort-favourites = Più amati

# Genre filter button when several genres are set.
filter-linux-genres-count =
    { $count ->
        [one] { $count } genere
        [many] { $count } generi
       *[other] { $count } generi
    }

# Format filter button when several formats are set.
filter-linux-formats-count =
    { $count ->
        [one] { $count } formato
        [many] { $count } formati
       *[other] { $count } formati
    }

# Status filter button when several statuses are set.
filter-linux-statuses-count =
    { $count ->
        [one] { $count } stato
        [many] { $count } stati
       *[other] { $count } stati
    }

# Chip for a genre that is left out of the results. The genre is already named.
filter-linux-not = Non { $genre }

# Button that takes off every filter chip.
filter-linux-clear-all = Rimuovi tutti i filtri

# Tooltip of the arrow that scrolls the filter row back.
filter-linux-earlier = Filtri precedenti

# Tooltip of the arrow that scrolls the filter row on.
filter-linux-more = Altri filtri

# What a screen reader says for a broadcast whose time is an estimate. The time is already formatted.
calendar-linux-about = circa { $time }

# What a screen reader says for a broadcast that is the dub's.
calendar-linux-dubbed = doppiato

# Title of the menu, and tooltip of its button, that orders a list.
library-linux-order = Ordina

# A list's tab: its name and how many titles it holds.
library-linux-list-count = { $list } { $count }

# Description read by a screen reader on the button that plays the shown episode on a TV.
title-linux-play-on-tv-help = Riproduci questo episodio su un TV con anistream

# Description read by a screen reader on an episode's watched check box.
title-linux-episode-watched = Episodio { $episode } visto

# Line in a day's column when nothing airs that day.
calendar-linux-day-empty = Nessuna uscita

# Accessible label of the line that says how the watch party form is getting on.
party-status = Stato della watch party

# Accessible label of the list of people in the watch party, in the player's panel.
party-members = Membri

# Title of the dialog that lists the sources that have the watch party's episode.
party-choose-a-source = Scegli una fonte

# Line when no source lists the watch party's episode. A plugin store adds plugins, which add sources.
party-sources-none-listed = Nessuna fonte elenca l'episodio { $episode }. Le Fonti arrivano dai plugin che un negozio di plugin aggiunge.

# Line above the list of sources that have the watch party's episode.
party-sources-found-line =
    { $count ->
        [one] Una fonte ce l'ha. Quella che scegli viene riprodotta con la watch party.
        [many] { $count } fonti ce l'hanno. Quella che scegli viene riprodotta con la watch party.
       *[other] { $count } fonti ce l'hanno. Quella che scegli viene riprodotta con la watch party.
    }

# Notice when the player could not start, or could not be reached to add a track.
player-could-not-start = Il player non è riuscito ad avviarsi. Riprova oppure scegli un'altra fonte.

# Notice when the file chosen for a subtitle or audio track has no path the app can read.
player-file-unreadable = Impossibile leggere quel file. Prova un altro.

# The reason the system gives for keeping the screen awake and the computer from sleeping while an episode plays. Other apps and the desktop may show it.
player-inhibit-reason = Riproduzione di un episodio

# Accessible description of the time left in the episode, beside the countdown.
player-time-left = { $time } rimanenti

# Line on the starting screen after a note from the engine, with the seconds waited.
player-note-waited = { $note } · { $seconds } s

# Starting screen's line before the episode is known.
player-starting-plain = Avvio in corso

# Tooltip of the Undo button on the card that says an opening was skipped. The letter is the key that does the same.
player-undo-tooltip = Annulla (U)

# Over the timeline: the time under the pointer, when it is inside an opening.
player-time-opening = { $clock } · Apertura

# Over the timeline: the time under the pointer, when it is inside an ending.
player-time-ending = { $clock } · Chiusura

# Name of a one-channel audio track in the audio menu.
player-channels-mono = Mono

# Name of a two-channel audio track in the audio menu.
player-channels-stereo = Stereo

# Name of an audio track with some other number of channels.
player-channels =
    { $count ->
        [one] Un canale
        [many] { $count } canali
       *[other] { $count } canali
    }

# Accessible label of the two buttons that switch between subbed and dubbed audio.
player-translation-label = Sottotitolato o doppiato

# Tooltip on the button that opens a setting's preview on a page of its own, and accessible name of the preview.
settings-preview = Anteprima

# Tooltip on the button that steps a setting to its previous value.
settings-previous-value = Valore precedente

# Tooltip on the button that steps a setting to its next value.
settings-next-value = Valore successivo

# Line after the legal line under the sources settings: where sources come from.
settings-sources-come-from = Le fonti arrivano dai negozi di plugin a cui ti unisci.

# Label on the left half of the upscaling preview: the video before processing.
settings-preview-source = Fonte a 480p

# Preview note under the upscaling frame when upscaling is off.
settings-upscaling-note-off = La fonte a 480p, adattata alla finestra senza elaborazione.

# A line of sample subtitle over the preview frame. Any short sentence will do.
settings-caption-sample = La strada della lanterna prosegue oltre l'ultimo paese.

# Preview note under the subtitle frame. The language is a language name.
settings-caption-note = I sottotitoli semplici hanno questo aspetto, in { $language } quando un episodio li include. I sottotitoli con stile mantengono il proprio aspetto.

# Preview note for new-episode notifications when they are on. The tracker is a name such as AniList.
settings-notify-note-on = Una notifica quando esce un episodio di una serie nella lista delle serie che guardi, all'orario indicato da { $tracker }. Prevale l'impostazione della serie.

# Preview note for new-episode notifications when they are off.
settings-notify-note-off = Disattivate. Solo le serie attivate nelle loro impostazioni inviano notifiche.

# Heading of the preview note beside the sources settings while torrents are on.
settings-connection-check-title = Controllo della connessione

# Preview note beside the sources settings while torrents are on.
settings-connection-check-note = anistream controlla da dove esce il traffico torrent all'avvio di un torrent e ogni minuto mentre è attivo, e mette in pausa i torrent se il controllo fallisce. A proteggerti sono la tua VPN o il tuo proxy.

# Preview note beside the accounts settings.
settings-accounts-note = anistream funziona senza account. La cronologia resta su questo computer quando esci.

# Preview note beside the Discord settings when presence is on.
settings-presence-note-on = Il tuo profilo Discord mostra cosa guardi mentre un episodio è in riproduzione.

# Preview note beside the Discord settings when presence is off.
settings-presence-note-off = Disattivata. Se attiva, il tuo profilo Discord mostra cosa guardi mentre un episodio è in riproduzione.

# Preview note beside the advanced settings.
settings-advanced-note = Un'opzione qui può annullare un'impostazione di riproduzione, come l'upscaling o la modalità notturna. La maggior parte delle persone non ne ha mai bisogno.

# Button that opens the page of the new version of the app.
updates-view-version = Vedi la versione

# Accessible name of the progress bar while the new version downloads.
updates-progress-label = Avanzamento dell'aggiornamento

# Line under AniList's name on the Accounts page.
accounts-sync-detail = Avanzamenti e modifiche alle liste si sincronizzano con { $tracker }. La Libreria e la Mia lista del Calendario mostrano le tue liste di { $tracker }.

# Line under a signed-in account while changes wait for the connection.
accounts-changes-waiting-offline =
    { $count ->
        [one] Una modifica in attesa della connessione
        [many] { $count } modifiche in attesa della connessione
       *[other] { $count } modifiche in attesa della connessione
    }

# Footnote on the Accounts page: where sign-in tokens are kept, when it is the system's keyring.
accounts-tokens-keyring = I token di accesso sono conservati nel portachiavi di questo dispositivo.

# Reason an update stopped: the downloaded file could not be read. The reason is the system's own words.
updates-why-read = Impossibile leggere il download: { $reason }

# Reason an update stopped: the new version is in place but did not open.
updates-why-reopen = La nuova versione è installata ma non si è aperta. Apri di nuovo anistream.

# Accessible description of the mascot's picture. Nagare is the mascot's name.
nagare-description = Nagare, la mascotte di anistream: una figura con un caschetto di seta, una sciarpa ambra e un mantello indaco, che regge un bastone con un amuleto d'acqua.

# Note under the Play trailers setting: what the trailers are and when they do not play.
settings-note-trailers-linux = I trailer vengono riprodotti senza audio da YouTube, che vede il tuo indirizzo IP. Non partono con una connessione a consumo, con le animazioni disattivate, in modalità risparmio energia o con uno screen reader attivo.

# Settings row: whether a connected game controller drives the app.
settings-label-controller-input = Usa un controller

# Settings row: swaps the A and B buttons, for a controller laid out as Nintendo's are.
settings-label-swap-face-buttons = Scambia A e B

# Heading of the Settings group for game controllers.
settings-group-controller = Controller

# Settings row that names the controller in use.
settings-controller-device = Controller

# Value of the controller row when no controller is connected.
settings-controller-none = Nessun controller trovato. Le tastiere di Steam Input continuano a funzionare.

# Notice when a controller connects for the first time in a session.
controller-connected = Controller connesso · { $name }

# Notice when the controller in use disconnects.
controller-disconnected = Controller disconnesso

# Title of the window that lists what the controller's buttons do.
controller-help-title = Controller

# Accessible name of the list of controller buttons in the help window.
controller-help-buttons = Pulsanti del controller

# Button on a notice that asks to open the plugin stores.
shell-open-stores = Apri i negozi di plugin

# Button on an update notice that restarts the app to install it.
