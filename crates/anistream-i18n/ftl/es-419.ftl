# Generated by tools/i18n from i18n/. Do not edit.

# What the TV's loading screen and its own controls show under the show's name.
cast-episode = Episodio { $episode }

# What the TV's loading screen and its own controls show under the show's name, with the episode's own title.
cast-episode-titled = Episodio { $episode } · { $title }

# The episode opens in another app, which this device can't cast.
notice-cast-deep-link = Este episodio se abre en otra app, así que no se puede transmitir.

# The TV picked to cast to has left the network.
notice-cast-no-device = Ese televisor ya no está en la red.

# This build of the app has no casting.
notice-cast-unavailable = Esta versión de anistream no puede transmitir a televisores.

# A comment's age, beside its author, when it was written under a minute ago.
discussion-age-now = ahora

# A comment's age, beside its author, in minutes. Abbreviated, as a timeline shows it.
discussion-age-minutes = { $minutes } min

# A comment's age, beside its author, in hours. Abbreviated, as a timeline shows it.
discussion-age-hours = { $hours } h

# A comment's age, beside its author, in days. Abbreviated, as a timeline shows it.
discussion-age-days = { $days } d

# A comment's age, beside its author, in weeks. Abbreviated, as a timeline shows it.
discussion-age-weeks = { $weeks } sem

# A comment's age, beside its author, in years. Abbreviated, as a timeline shows it.
discussion-age-years = { $years } a

# Toast when a like on a comment did not reach AniList. The like is taken back.
notice-comment-like-failed = No se pudo dar me gusta al comentario. Inténtalo de nuevo.

# Toast when a comment could not be deleted on AniList. The comment stays.
notice-comment-delete-failed = No se pudo borrar el comentario. Inténtalo de nuevo.

# Toast when the viewer tried to like or post in a discussion without signing in to AniList.
notice-discussion-sign-in = Inicia sesión con AniList para dar me gusta y responder.

# A reason on its own, as a toast or a failed play's explanation. The reason is one of the engine's own reasons, so it is translated.
notice-reason = { $reason }

# Reason: no source is set up, so nothing can be played or downloaded. Shown in a toast.
cause-no-sources = No hay fuentes configuradas. Añade una en la pantalla Fuentes.

# A play's explanation: the episode's broadcast is still ahead. The "when" says today, tomorrow or a date.
notice-not-aired = El episodio { $episode } se emite { $when }.

# A play's explanation: the episode is after the next one to air. The "when" says when that one airs.
notice-not-aired-yet = El episodio { $episode } aún no se ha emitido. El episodio { $next } se emite { $when }.

# Part of an air time: the broadcast is later today. The time is the viewer's local time.
cause-airs-today = hoy a las { $time }

# Part of an air time: the broadcast is tomorrow. The time is the viewer's local time.
cause-airs-tomorrow = mañana a las { $time }

# Part of an air time: the broadcast is within the next week.
cause-airs-in-days =
    { $days ->
        [one] dentro de un día a las { $time }
        [many] dentro de { $days } días a las { $time }
       *[other] dentro de { $days } días a las { $time }
    }

# Part of an air time: the broadcast is more than a week away. The date is year-month-day.
cause-airs-on-date = el { $date } a las { $time }

# Reason: the source answered but gave nothing to play.
cause-no-playable-stream = La fuente respondió, pero no tiene nada que reproducir. Prueba con otra.

# Reason: no source could be matched to the title. The detail is what each source said.
cause-title-no-match = No hay coincidencias para este título: { $detail }

# Reason: the source the person picked is no longer installed or enabled.
cause-source-gone = La fuente { $source } ya no está disponible. Elige otra.

# Reason: the release the person picked would not start. The detail comes from the source.
cause-release-failed = No se pudo iniciar ese lanzamiento: { $detail }

# Reason: a play waited too long for its sources to give it a stream, and gave up.
cause-sources-timed-out = Las fuentes tardaron demasiado en responder. Inténtalo de nuevo o elige otra fuente.

# Reason: every source matched the title but none has the episode. The detail is what each said.
cause-no-source-has-episode = Ninguna fuente tiene el episodio { $episode }: { $detail }

# Reason: the source streams episodes but only torrents can be downloaded.
cause-source-cannot-download = Esta fuente transmite episodios, pero no permite descargarlos.

# Reason: the title was never listed by a source, so it can't be downloaded.
cause-no-source-could-list-show = Ninguna fuente pudo listar esta serie, así que no se puede descargar.

# Part of a finished download's toast: subtitle files were merged into the video.
cause-subtitles-merged =
    { $tracks ->
        [one] Se añadió una pista de subtítulos al video.
        [many] Se añadieron { $tracks } pistas de subtítulos al video.
       *[other] Se añadieron { $tracks } pistas de subtítulos al video.
    }

# Part of a finished download's toast: merging failed, so the subtitles stay as files beside it.
cause-subtitles-left-apart = Los subtítulos quedan como archivos separados. { $reason }

# Part of a download toast: how many episodes of the range were in the queue already.
cause-already-in-downloads =
    { $count ->
        [one] Un episodio ya está en descargas.
        [many] { $count } episodios ya están en descargas.
       *[other] { $count } episodios ya están en descargas.
    }

# Job note while a play looks the title up.
status-looking-up-title = Buscando el título…

# Job note while a play waits for the sources to arrive.
status-loading-sources = Cargando fuentes…

# Job note while the sources are asked for an episode. The episode is its label, often a number.
status-searching-sources = Buscando fuentes del episodio { $episode }…

# Toast when the player cannot be started. The reason comes from the system.
notice-player-failed-to-start = No se pudo iniciar mpv. Comprueba que mpv se abra por sí solo. ({ $reason })

# Toast when a stream never showed a frame and the next one is tried.
notice-stream-no-video = Esa transmisión no muestra video. Probando la transmisión { $next } de { $total }.

# Toast when mpv gave up on a file. The reason is mpv's own line.
notice-player-could-not-play = mpv no pudo reproducir esto. { $reason }

# Toast when mpv closed without playing and without saying why.
notice-player-exited-silently = mpv se cerró sin reproducir nada ni dar un motivo. Prueba con otra fuente.

# Toast when no picture has appeared a while after the player opened.
notice-player-not-playing = mpv no empezó a reproducir después de { $seconds } s. La fuente puede no tener datos. Comprueba que mpv reproduzca un archivo por sí solo.

# Toast when a play is asked for in a build with no player.
notice-no-player = Esta versión de anistream no puede reproducir video.

# Toast at launch when the mpv program is missing. The binary is the name the settings give it. Terminal only: the engine never sends it to the apps.
notice-mpv-missing = No se encontró { $binary }. Instala mpv para reproducir episodios.

# Toast at launch when mpv is too old for anistream's own player. Terminal only: the engine never sends it to the apps.
notice-mpv-old = mpv { $version } puede reproducir, pero el reproductor de anistream necesita mpv 0.36 o más reciente para su botón de saltar, la tarjeta Siguiente, los menús y las miniaturas.

# Toast when an episode plays with no subtitles because none of the source's subtitle files could be downloaded.
notice-subtitles-unavailable = No se pudieron cargar los subtítulos de esta fuente. Elige otra fuente para intentarlo de nuevo.

# Toast after a link was handed to the browser.
notice-opened-in-browser = Abierto en tu navegador.

# Toast when a link could not be opened. The reason comes from the system.
notice-could-not-open = No se pudo abrir eso. { $reason }

# Toast when a trailer plays in mpv.
notice-trailer-playing = El tráiler se reproduce en mpv.

# Toast when a trailer opens in the browser.
notice-trailer-opened = El tráiler se abrió en tu navegador.

# Toast when a trailer could not be opened. The reason comes from the system.
notice-trailer-failed = No se pudo abrir el tráiler. { $reason }

# Toast when the next episode is not the one after this because filler was skipped.
notice-filler-skipped = Se omitieron episodios de relleno. Siguiente es el episodio { $episode }.

# Toast after switching the audio while playing.
notice-audio-now-subbed = El audio ahora está subtitulado.

# Toast after switching the audio while playing.
notice-audio-now-dubbed = El audio ahora está doblado.

# Toast when the previous-episode control is used on the first episode.
notice-already-first-episode = Ya estás en el primer episodio.

# Toast when the next-episode control is used on the last known episode.
notice-last-episode = No hay más episodios. El episodio { $episode } es el último.

# Toast when the next-episode control is used and the next episode is not known.
notice-no-next-episode = No hay más episodios.

# Toast when the previous-episode control finds no previous episode.
notice-no-previous-episode = No hay episodio anterior.

# Toast when the title's episode match could not be cleared. The reason comes from the system.
notice-match-reset-failed = No se pudo restablecer la coincidencia. { $reason }

# Toast when the chosen match could not be saved. The reason comes from the system.
notice-match-save-failed = No se pudo guardar esa coincidencia. { $reason }

# Toast when a chosen match still left the title undecided.
notice-match-did-not-stick = Esa coincidencia no se mantuvo. Puede que la fuente haya cambiado. Intenta elegirla otra vez.

# Toast when a search of the sources for a title found nothing.
notice-source-search-empty = No se encontró nada para “{ $query }”. Prueba con otra búsqueda.

# Toast after the person picked a source for one title.
notice-source-pinned = { $source } se usará para este título.

# Toast after the person went back to automatic source selection for one title.
notice-source-automatic = Se volvió a la selección automática de fuentes.

# Toast when the source choice for a title could not be saved. The reason comes from the system.
notice-source-choice-failed = No se pudo guardar esa elección. { $reason }

# Toast when no source could list a show's episodes. The reason is what the sources said.
notice-no-source-could-list = Ninguna fuente pudo listar esta serie: { $reason }

# Why a title's episodes could not be loaded at all, shown on its page and as a toast. The reason comes from AniList or the network.
notice-episodes-failed = No se pudieron cargar los episodios. { $reason }

# Toast when a source found several shows that could be this one and could not tell which. The episodes shown are AniList's until one is picked. The source is its name.
notice-match-uncertain = { $source } encontró más de una serie que podría ser esta, así que por ahora los episodios vienen de AniList.

# Toast when a title cannot be taken off the Continue row. The reason comes from the system.
notice-continue-hide-failed = No se pudo quitar eso de Continuar viendo. { $reason }

# Toast after an episode was added to the download queue.
notice-download-queued = Se añadió el episodio { $episode } de { $title } a la cola.

# Toast when an episode asked for is in downloads already.
notice-download-already-queued = El episodio { $episode } de { $title } ya está en descargas.

# Toast when a waiting or paused download was moved to the front and started.
notice-download-starting-now = Iniciando ahora mismo el episodio { $episode } de { $title }.

# Toast after a download was cancelled.
notice-download-cancelled = Descarga cancelada.

# Toast after a download and its file were deleted.
notice-download-file-deleted = Descarga y archivo eliminados.

# Toast after a download was removed whose file was already gone.
notice-download-removed-file-gone = Descarga quitada. Su archivo ya no existía.

# Toast after a download was removed but its file could not be deleted. The reason comes from the system.
notice-download-removed-file-kept = Se quitó la descarga, pero no se pudo borrar su archivo. { $reason }

# Toast after a download with no file was removed.
notice-download-removed = Descarga quitada.

# Toast after finished downloads were cleared from the list.
notice-downloads-cleared =
    { $count ->
        [one] Se quitó una descarga terminada.
        [many] Se quitaron { $count } descargas terminadas.
       *[other] Se quitaron { $count } descargas terminadas.
    }

# Toast when an episode finished downloading.
notice-download-finished = Se descargó el episodio { $episode } de { $title }.

# Toast when an episode finished downloading and the note says what happened to its subtitles.
notice-download-finished-note = Se descargó el episodio { $episode } de { $title }. { $note }

# Toast when a download could not start. The reason comes from the torrent client.
notice-download-failed = No se pudo descargar el episodio { $episode } de { $title }. { $reason }

# Toast after a range was asked for and nothing was queued.
notice-downloads-none-queued = No se añadió nada a la cola.

# Toast after a range was asked for and nothing was queued, and the reason it stopped.
notice-downloads-none-queued-stopped = No se añadió nada a la cola. { $reason }

# Toast after a range was asked for and every episode was in the queue already. `existing` is the sentence of `cause-already-in-downloads`.
notice-downloads-none-new = No se añadió nada nuevo a la cola. { $existing }

# Toast as above, with the reason the range stopped. `existing` is the sentence of `cause-already-in-downloads`; `reason` is a sentence saying why the range stopped.
notice-downloads-none-new-stopped = No se añadió nada nuevo a la cola. { $existing } { $reason }

# Toast after a range was asked for, some episodes were queued and some were there already. `existing` is the sentence of `cause-already-in-downloads`.
notice-episodes-queued-existing =
    { $count ->
        [one] Se añadió un episodio a la cola. { $existing }
        [many] Se añadieron { $count } episodios a la cola. { $existing }
       *[other] Se añadieron { $count } episodios a la cola. { $existing }
    }

# Toast as above, with the reason the range stopped.
notice-episodes-queued-stopped =
    { $count ->
        [one] Se añadió un episodio a la cola y luego se detuvo. { $reason }
        [many] Se añadieron { $count } episodios a la cola y luego se detuvo. { $reason }
       *[other] Se añadieron { $count } episodios a la cola y luego se detuvo. { $reason }
    }

# Toast as above, with some episodes in the queue already and the reason the range stopped. `existing` is the sentence of `cause-already-in-downloads`; `reason` is a sentence saying why the range stopped.
notice-episodes-queued-existing-stopped =
    { $count ->
        [one] Se añadió un episodio a la cola y luego se detuvo. { $existing } { $reason }
        [many] Se añadieron { $count } episodios a la cola y luego se detuvo. { $existing } { $reason }
       *[other] Se añadieron { $count } episodios a la cola y luego se detuvo. { $existing } { $reason }
    }

# Toast when keep next found no room for another episode.
notice-keep-next-full = No hay suficiente espacio libre para mantener descargados los siguientes episodios. Libera espacio para descargar más.

# Message when a watch party was asked for with no server chosen. The names are a suggested server and who runs it. Terminal only: the engine never sends it to the apps.
party-needs-server = Primero elige un servidor para la watch party, en el ajuste syncplay.server. { $server } es operado por { $operator }.

# Message when an app asked for a watch party with no server chosen. The names are a suggested server and who runs it.
party-choose-server = Primero elige un servidor para la watch party. { $server } es operado por { $operator }.

# Toast when a watch party is asked for in a build without watch parties.
notice-no-party = Las watch parties no están disponibles en esta versión de anistream.

# Message when a watch party was asked for with no room named.
party-needs-room = La watch party necesita una sala para reunirse. Elige una primero.

# Message in a watch party when its server connection dropped and is retried.
party-server-lost = Se perdió el servidor de la watch party. Intentando de nuevo.

# Message in a watch party when the connection came back.
party-rejoined = De vuelta en la watch party.

# Message when the person left a watch party.
party-left = Saliste de la watch party.

# Toast after joining a plugin store with an invite that names this device's owner.
store-joined = Te uniste a { $store } como { $member }.

# Toast after joining a plugin store with its open link, which keeps no name.
store-joined-unnamed = Te uniste a { $store } sin nombre.

# Toast after leaving a plugin store.
store-left = Saliste de { $store }. Sus complementos siguen instalados.

# Toast after a plugin is deleted from this device.
plugin-removed = Se quitó { $plugin }.

# Toast after a store owner removes a member.
store-member-removed = Se quitó al miembro. Sus dispositivos dejaron de funcionar con esta tienda de complementos.

# Toast after a store owner cancels an invite.
store-invite-cancelled = Invitación cancelada. El enlace ya no funciona.

# Toast after a store owner lets anyone with the store's link join.
store-open-join-on = Cualquiera con el enlace de la tienda de complementos puede unirse ahora. Cópialo desde la pantalla de miembros.

# Toast after a store owner turns off joining with the link, when no device joined that way.
store-open-join-off = Ahora solo pueden unirse las personas a las que invitas.

# Toast after a store owner turns off joining with the link, when some devices joined that way.
store-open-join-off-devices =
    { $devices ->
        [one] Ahora solo pueden unirse las personas a las que invitas. El dispositivo que se unió con el enlace sigue funcionando hasta que lo quites.
        [many] Ahora solo pueden unirse las personas a las que invitas. Los { $devices } dispositivos que se unieron con el enlace siguen funcionando hasta que los quites.
       *[other] Ahora solo pueden unirse las personas a las que invitas. Los { $devices } dispositivos que se unieron con el enlace siguen funcionando hasta que los quites.
    }

# Toast after one device that joined with the store's link is removed.
store-device-removed = Ese dispositivo ya no funciona con esta tienda de complementos.

# Toast after every device that joined with the store's link is removed.
store-devices-removed = Se quitaron todos los dispositivos que se unieron con el enlace.

# Toast after a plugin is published to a store.
plugin-published = Se publicó { $plugin } { $version }.

# Toast after a plugin stops being offered in a store.
plugin-unpublished = { $plugin } ya no se ofrece.

# Toast after the store's admin page opens in the browser.
store-admin-opened = Se abrió la página de administración en tu navegador. El enlace funciona una vez, durante 10 minutos.

# Toast when the browser could not be opened for the store's admin page. The reason comes from the system. The command is typed as it is run.
store-admin-open-failed = No se pudo abrir el navegador ({ $reason }). En el equipo de la tienda de complementos, ejecuta "anistream store admin" para imprimir un enlace.

# Toast after a plugin is installed while plugins are switched off in the source order.
plugin-installed-unused = Se instaló { $plugin } { $version }, pero los complementos están desactivados en el orden de las fuentes, así que no se usa.

# Toast after a plugin is installed under the name of a built-in source, so it was not loaded.
plugin-installed-name-clash = Se instaló { $plugin }, pero { $id } es el nombre de una fuente integrada, así que no se cargó.

# Toast after a plugin is installed and ready to use.
plugin-installed = Se instaló { $plugin } { $version }.

# Toast after a plugin is installed but could not be loaded. The reason comes from the plugin host.
plugin-installed-not-loaded = Se instaló { $plugin }, pero no se cargó. { $reason }

# Toast at launch when joined plugin stores offer newer versions of installed plugins.
plugin-updates-ready =
    { $count ->
        [one] Actualización de Complemento lista: { $names }.
        [many] Actualizaciones de Complemento listas: { $names }.
       *[other] Actualizaciones de Complemento listas: { $names }.
    }

# Note on the sources screen when the plugins could not be loaded. The reason comes from the plugin host.
plugins-load-failed = No se pudieron cargar los complementos. { $reason }

# Error: the store was joined once, but this device has no saved token for it.
store-token-missing = No hay token para { $store } en este dispositivo. Vuelve a unirte con una invitación nueva.

# Error: the store the record points to is gone from the saved list.
store-not-joined = Ya no estás en esa tienda de complementos.

# Error: a store's signing key is unreadable. Shown as the reason a store is offline.
store-key-damaged = La clave de esta tienda de complementos en este dispositivo está dañada. Sal de la tienda de complementos y vuelve a unirte con una invitación nueva.

# Error: a store rejected this device's token.
store-device-refused = { $store } ya no acepta este dispositivo. Vuelve a unirte con una invitación nueva.

# Error: a store could not be reached. The reason comes from the network.
store-unreachable = No se pudo conectar con { $store }. { $reason }

# Error: an invite link names a store this device already joined, but at another address.
store-moved = Ya te uniste a { $store } en { $current }, pero este enlace apunta a { $target }. Si la tienda de complementos cambió de dirección, sal primero y vuelve a unirte.

# Error: an open link would replace the named membership this device already has.
store-join-would-unname = Te uniste a { $store } como { $member }. Este enlace te uniría otra vez sin tu nombre, así que no se cambió nada.

# Error: the server at a link's address could not prove it is the store the invite named.
store-not-the-invited = { $url } no es la tienda de complementos de la invitación ({ $reason }). No te uniste a nada.

# Error: the token for a joined store could not be saved on this device. The reason comes from the system.
store-token-not-kept = No se pudo guardar el token de esta tienda de complementos. { $reason }

# Error: an invite that cannot be used any more.
store-invite-unusable = Esa invitación ya se usó, se canceló o venció. Pide una nueva.

# Error: an open link that no longer lets anyone join.
store-open-link-unusable = Este enlace ya no deja unirse a nadie. Pídele al responsable de la tienda de complementos un enlace nuevo o una invitación.

# Error: a plugin takes the name of a built-in source.
plugin-reserved-name = { $plugin } es el nombre de una fuente integrada, así que no puede ser un complemento.

# Error: a store stopped offering a plugin between listing it and installing it.
store-plugin-withdrawn = { $store } ya no ofrece { $plugin }.

# Error: a store changed a plugin after the person agreed to what was shown.
store-plugin-changed = { $store } cambió { $plugin } desde que se mostró. Revísalo otra vez antes de instalarlo.

# Error: a plugin installed from one store is offered by another.
plugin-from-other-store = { $plugin } se instaló desde { $store }, que lo mantiene actualizado.

# Error: a plugin file added by hand already declares the same name.
plugin-duplicate-file = { $path } ya declara { $plugin }. Quita ese archivo primero, o correrían dos copias.

# Error: a plugin could not be downloaded or installed. The reason comes from the store or the system.
plugin-install-failed = No se pudo instalar { $plugin }. { $reason }

# Error: a plugin could not be published. The reason comes from the store or the system.
plugin-publish-failed = No se pudo publicar { $plugin }. { $reason }

# Error: a plugin to publish is no longer in the plugin folder.
plugin-missing-locally = { $plugin } ya no está en la carpeta de complementos.

# Error: an invite for another device cannot be made from a device that joined with the open link.
store-invite-needs-link = Este dispositivo se unió a { $store } con su enlace. Pega el mismo enlace en el otro dispositivo.

# Error: the store sent an invite link that does not parse. The reason comes from the link parser.
store-link-malformed = La tienda de complementos envió un enlace que no funciona. Pídele al responsable que revise la tienda de complementos. { $reason }

# Error: the store sent a link carrying another store's key.
store-link-wrong-key = La tienda de complementos creó un enlace con otra clave. Revisa la dirección con la que se inició.

# Error: the store's server has no admin page.
store-admin-missing = { $store } no tiene página de administración. Su servidor puede ser más antiguo.

# Error: the store sent an admin link that points somewhere else.
store-admin-link-foreign = { $store } envió un enlace de administración a otra dirección.

# Error: the store's server is too old for joining with a link.
store-open-join-unsupported = El servidor de { $store } es más antiguo y no puede dejar que cualquiera se una con un enlace. Actualízalo primero.

# Toast after a source (plugin) is switched off. It is skipped when looking for episodes.
source-switched-off = { $name } está desactivado. Se omite al buscar episodios.

# Toast after a source (plugin) is switched on.
source-switched-on = { $name } está activado.

# Error: a command named a plugin that is not loaded.
plugin-not-loaded = { $id } no está cargado. Revisa que esté instalado en Fuentes.

# Toast after a release is chosen for a title. The name is the release's title.
release-pinned = { $name } se usará para este título.

# Toast when the chosen source or release for a title could not be saved. The reason comes from the database.
notice-choice-not-saved = No se pudo guardar esa elección. { $reason }

# Toast while torrents are running but the connection check failed, and the settings say to warn only.
torrent-check-failed-running = La revisión de la conexión falló. Los torrents siguen activos.

# Note on the sources screen: torrents are waiting for the VPN guard. The reason comes from the guard.
torrent-vpn-waiting = Los torrents empiezan cuando pase la protección de VPN. { $reason }

# Note on the sources screen: the VPN guard has no verdict yet.
torrent-vpn-unverified = Los torrents empiezan cuando pase la protección de VPN. Todavía no se verificó la conexión.

# Error: the torrent session did not start because the interface closed first.
torrent-interface-closed = anistream se cerró antes de que empezaran los torrents.

# Error: the torrent session could not start. The reason comes from the torrent engine.
torrent-session-failed = No se pudo iniciar la sesión de torrents. { $reason }

# Toast when torrents are up but no operating-system firewall rule backs the VPN guard. Terminal only: the engine never sends it to the apps.
torrent-no-kill-switch = Nada en este dispositivo detiene el tráfico de torrents si cae la VPN. Ejecuta "anistream --doctor" para configurarlo.

# Toast when the connection check could not run. The reason comes from the VPN settings.
torrent-not-checked = No se pudo revisar la conexión. { $reason }

# Note on the sources screen after the source chain is rebuilt with torrents on.
sources-reloaded-torrents-pending = Fuentes recargadas. Los torrents empiezan cuando pase la protección de VPN.

# Note on the sources screen after the source chain is rebuilt with torrents off.
sources-reloaded-torrents-off = Los torrents están desactivados. La sesión se detuvo.

# Note on a running job: requests to AniList are being slowed to stay within its limit. A countdown follows.
job-anilist-limit = Esperando por el límite de solicitudes de AniList

# Toast when there is no job to carry the wait for AniList's rate limit.
notice-anilist-limit = Esperando { $wait } por el límite de solicitudes de AniList.

# Toast when the AniList fallback takes over because AniList cannot be reached.
notice-anilist-unreachable = AniList no responde. Por ahora se muestran datos de otro servicio.

# Toast when no metadata service answered and the last cached data is shown.
notice-metadata-cached = Ningún servicio de metadatos respondió. Se muestra lo último que se guardó en caché.

# Toast when AniList answers again.
notice-anilist-back = AniList volvió.

# Toast when a command needs watch parties but this app was built without them.
notice-party-not-built = Las watch parties no están incluidas en esta app.

# Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList.
notice-signed-in = Sesión iniciada en { $tracker }.

# Toast after a sign-in succeeded and the token went into the system keychain.
notice-signed-in-keychain = Sesión iniciada en { $tracker }. El token está en el llavero del sistema.

# Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows.
notice-signed-in-file = Sesión iniciada en { $tracker }. No hay llavero disponible, así que el token está en un archivo privado de este dispositivo.

# Toast when a sign-in worked but the token could not be stored. The reason comes from the system.
notice-signed-in-unsaved = Sesión iniciada en { $tracker }, pero el token no se guardó, así que tendrás que volver a iniciar sesión la próxima vez. { $reason }

# Toast when a sign-in token could not be stored. The reason comes from the system.
notice-token-not-saved = No se pudo guardar el token de inicio de sesión. Vuelve a iniciar sesión. { $reason }

# Toast when a sign-in did not finish. The reason comes from the tracker or the network.
notice-sign-in-failed = No se pudo iniciar sesión en { $tracker }. Inténtalo de nuevo. { $reason }

# Toast when the wait for a sign-in ended early. The reason comes from the system.
notice-sign-in-stopped = El inicio de sesión en { $tracker } se detuvo antes de terminar. Inténtalo de nuevo. { $reason }

# Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker.
notice-token-exchange-failed = No se pudo obtener un token de { $tracker }. Vuelve a iniciar sesión. { $reason }

# Toast when no browser could be opened for a sign-in. The reason comes from the system.
notice-browser-not-opened = No se pudo abrir un navegador para iniciar sesión. Revisa que haya uno instalado e inténtalo de nuevo. { $reason }

# Toast when a sign-in redirect arrives and no sign-in is waiting for it.
notice-sign-in-not-waiting = No hay ningún inicio de sesión en { $tracker } esperando eso. Vuelve a empezar el inicio de sesión.

# Toast when a sign-in redirect does not match the request that was made.
notice-sign-in-wrong-request = Ese inicio de sesión en { $tracker } no volvió desde esta solicitud. Vuelve a empezar el inicio de sesión.

# Toast when a tracker sent the person back without a token.
notice-sign-in-no-token = El inicio de sesión en { $tracker } volvió sin token. Inténtalo de nuevo.

# Toast when this build has no MyAnimeList client to finish a sign-in with.
notice-mal-client-missing-build = No se pudo terminar el inicio de sesión en MyAnimeList: esta versión no tiene un cliente para hacerlo.

# Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.
notice-kitsu-signs-in-on-accounts = Kitsu inicia sesión desde la pantalla de Cuentas.

# Toast when a tracker has no way to sign in yet.
notice-sign-in-unsupported = Todavía no se admite iniciar sesión en { $tracker }.

# Toast on an app that cannot receive a browser redirect.
notice-sign-in-needs-redirect = Iniciar sesión en { $tracker } necesita una redirección del navegador, que esta app no puede recibir.

# Toast when AniList is set to a sign-in method only the anistream app can finish. The setting name is a key of the config file and is not translated.
notice-anilist-implicit-flow = Este método de inicio de sesión de AniList solo funciona en la app de anistream. Para iniciar sesión aquí, pon { $setting } en "loopback" en el archivo de configuración.

# Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated.
notice-anilist-client-missing = AniList necesita un id de cliente y un secreto. Pon { $client } y { $secret } en el archivo de configuración, y luego inicia sesión otra vez. Para obtener la dirección de inicio de sesión, ejecuta anistream --login-url.

# Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.
notice-anilist-paste-flow = No se puede pegar un código aquí. Cierra anistream y ejecuta anistream --login en su lugar.

# Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated.
notice-mal-client-missing = MyAnimeList necesita un id de cliente. Registra una app con el tipo "other" en myanimelist.net/apiconfig y luego pon { $setting } en el archivo de configuración.

# Job note while the browser sign-in is open and the terminal app waits for it to come back.
status-waiting-for-redirect = Esperando a que { $tracker } redirija de vuelta…

# Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.
notice-mal-no-refresh-token = MyAnimeList no emitió un token de actualización. Tendrás que volver a iniciar sesión en un mes aproximadamente.

# Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated.
notice-client-id-missing = Primero pon { $setting } en el archivo de configuración.

# Toast after signing out of a tracker with nothing waiting to send.
notice-signed-out = Sesión cerrada en { $tracker }.

# Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in.
notice-signed-out-queue =
    { $count ->
        [one] Sesión cerrada en { $tracker }. Un cambio en cola se conserva para el próximo inicio de sesión.
        [many] Sesión cerrada en { $tracker }. { $count } cambios en cola se conservan para el próximo inicio de sesión.
       *[other] Sesión cerrada en { $tracker }. { $count } cambios en cola se conservan para el próximo inicio de sesión.
    }

# Toast when signing out of a tracker failed. The reason comes from the system.
notice-sign-out-failed = No se pudo cerrar la sesión en { $tracker }. Inténtalo de nuevo. { $reason }

# Toast when a setting could not be stored. The cause says why and what to do.
notice-not-saved-because = No se pudo guardar esa configuración. { $cause }

# Toast when the torrent protection choice was saved.
notice-protection-saved = Protección de torrents guardada.

# Toast when the torrent protection could not be checked. The cause says why.
notice-protection-not-checked = No se pudo revisar la protección de torrents. { $cause }

# Toast when the proxy's password could not be stored. The reason comes from the system.
notice-proxy-password-not-kept = No se pudo guardar la contraseña del proxy. Escríbela otra vez para intentar guardarla. { $reason }

# Toast when a show's setting was given a value it does not take. The value is what was given.
notice-show-setting-refused = No se pudo guardar esa configuración. { $value } no es un valor válido para { $setting }.

# Toast when resetting a show's settings failed. The reason comes from the local database.
notice-show-not-reset = No se pudo restablecer la configuración de esta serie. { $reason }

# Toast when a subtitle choice names subtitles the show has not used.
notice-show-no-such-subtitles = No se pudo guardar esa elección de subtítulos. Esta serie no ha usado esos subtítulos antes.

# Toast while torrents are held until the connection check passes.
notice-torrents-waiting-for-check = Los torrents esperan a que vuelva a pasar la revisión de conexión.

# Toast when the mapping data downloads work again after a failure.
notice-mapping-data-refreshed = Datos de mapeo actualizados.

# Toast when the mapping data could not be downloaded. It is said once; the retries are silent.
notice-mapping-data-failed = No se pudieron actualizar los datos de mapeo ({ $datasets }). Se intentará otra vez en { $wait }. { $cause }

# Toast, and desktop notification, for one episode that aired while the app was closed.
notice-episode-aired = { $title }, episodio { $episode }, salió al aire mientras no estabas.

# Toast, and desktop notification, for several episodes that aired while the app was closed.
notice-episodes-aired =
    { $count ->
        [one] Salió al aire un episodio nuevo de una serie que ves. El calendario lo tiene.
        [many] Salieron al aire { $count } episodios nuevos de series que ves. El calendario los tiene.
       *[other] Salieron al aire { $count } episodios nuevos de series que ves. El calendario los tiene.
    }

# Toast when a new release of anistream is out, on the terminal app. The command is not translated. Terminal only: the engine never sends it to the apps.
notice-update-available = Ya está disponible { $tag }. Ejecuta anistream --update para instalarlo.

# The reason a setting was refused until the person confirms having no protection.
cause-confirm-no-protection = Primero confirma que quieres no tener protección.

# The reason a setting was refused until the person confirms the "warn only" choice.
cause-confirm-warn-only = Primero confirma que solo quieres recibir avisos.

# The reason a proxy was refused: it has no host or no port.
cause-proxy-needs-address = Un proxy necesita un host y un puerto.

# The reason a proxy could not be checked: its address is not one the check can use.
cause-proxy-address-unusable = La dirección del proxy no es una que la revisión pueda usar.

# The reason a request failed: it never reached the server.
cause-server-unreachable = No se pudo contactar con el servidor.

# Toast after a setting is stored. The label is the setting's name.
notice-saved = Se guardó { $label }.

# Toast when a setting could not be stored. The reason comes from the system.
notice-not-saved = No se pudo guardar ese ajuste. { $reason }

# Toast when a title's details did not load.
notice-title-load-failed = No se pudo cargar este título. Revisa tu conexión e inténtalo de nuevo.

# Toast when playback stops with an error.
notice-playback-failed = La reproducción falló. Prueba con otra fuente.

# Toast when something went wrong inside the engine and it carried on.
notice-engine-fault = Algo salió mal dentro de anistream. Siguió funcionando, pero si una pantalla parece trabada, ciérrala y ábrela de nuevo.

# Toast at launch when the database was damaged, so a fresh one was started. The path is where the damaged file was moved, kept for recovery. Watch history and downloads start over; what the trackers hold comes back with the next sync.
notice-database-set-aside = La base de datos estaba dañada, así que anistream creó una nueva. El archivo anterior se guardó en { $path }. Tus servicios de seguimiento recuperan lo que tienen en la próxima sincronización.

# Message when anistream could not start because a folder could not be made. The path is the folder, the reason comes from the system.
start-failed-folder = anistream no pudo crear la carpeta { $path }. Revisa que el disco tenga espacio y que se pueda escribir en la carpeta, y luego inténtalo de nuevo. { $reason }

# Message when anistream could not start because the config file has a setting it can't use. The path is the file; the problem names the line where it can.
start-failed-config = { $path } tiene un ajuste que anistream no puede usar: { $problem }. Corrígelo o quítalo, y luego inténtalo de nuevo.

# Message when anistream could not start because its database could not be opened. The path is the database file, the reason comes from the system.
start-failed-database = anistream no pudo abrir su base de datos en { $path }. Si otra app de anistream está abierta en esta carpeta, ciérrala e inténtalo de nuevo. { $reason }

# Message when anistream could not start its network connection from the network settings.
start-failed-network = anistream no pudo preparar su conexión de red con los ajustes de red de config.toml. { $reason }

# Message when anistream itself could not start. The reason comes from the system or the engine.
start-failed = anistream no pudo iniciarse. Ciérrala y ábrela de nuevo. { $reason }

# Message when the TV remote could not start listening or could not forget a phone.
start-failed-remote = El control remoto no pudo iniciarse. { $reason }

# Message when the built-in player could not start.
start-failed-player = El reproductor no pudo iniciarse. { $reason }

# Toast after episodes are added to the download queue.
notice-episodes-queued =
    { $count ->
        [one] Se puso un episodio en cola.
        [many] Se pusieron { $count } episodios en cola.
       *[other] Se pusieron { $count } episodios en cola.
    }

# Note under the connection-check group of the torrents dialog: what the check does.
torrents-linux-check-note = anistream revisa por dónde sale el tráfico de torrents cuando empieza un torrent y cada minuto mientras está en marcha, y pausa los torrents si esa revisión falla. Tu VPN o proxy es lo que te protege.

# Confirmation text when choosing "Warn only" for a failed check.
torrents-linux-warn-confirm = anistream te avisará en lugar de pausar. Si tu VPN o proxy está caído, otras personas pueden ver tu dirección IP.

# Status line once the protection has been checked and saved.
torrents-linux-protection-saved = Protección de torrents guardada

# Title of the dialog that turns torrents on.
torrents-linux-turn-on-title = Activar torrents

# Title of the dialog that changes what protects torrents.
torrents-linux-protect-title = Proteger torrents

# Title of the dialog that edits the proxy.
torrents-linux-edit-proxy-title = Editar proxy

# Button that turns torrents on in the dialog.
torrents-linux-turn-on-button = Activar

# Seeding row: time left until the goal, in a span already worded ("18h", "1d 6h").
downloads-linux-seed-left = Faltan { $span }

# Seeding row: less than an hour left until the goal.
downloads-linux-seed-left-soon = Falta menos de una hora

# Storage row: free space, the disk's size and what downloads take. All three are sizes already formatted.
downloads-linux-space-free = { $free } libres de { $total } · las descargas ocupan { $taken }

# Placeholder of the search field. It also finds settings.
search-linux-placeholder = Buscar títulos y ajustes

# Tooltip of the button that clears the recent searches.
search-linux-clear-recent = Borrar búsquedas recientes

# Title of the state when a browse with no filters lists nothing.
search-linux-nothing-found = No se encontró nada

# Title of the state when a typed search waits for Enter.
search-linux-press-enter = Presiona Intro para buscar

# Line under the Enter title: why results do not come as you type. The tracker is a name.
search-linux-paused = La búsqueda mientras escribes se pausa un momento para respetar los límites de { $tracker }.

# Menu title over the sort choices of the filter row.
filter-linux-sort-by = Ordenar por

# Sort choice: what is rising now.
filter-linux-sort-trending = Tendencia

# Sort choice: the most recent first.
filter-linux-sort-newest = Más recientes

# Sort choice: the earliest first.
filter-linux-sort-oldest = Más antiguos

# Sort choice: the most favourited first.
filter-linux-sort-favourites = Favoritos

# Genre filter button when several genres are set.
filter-linux-genres-count =
    { $count ->
        [one] { $count } género
        [many] { $count } géneros
       *[other] { $count } géneros
    }

# Format filter button when several formats are set.
filter-linux-formats-count =
    { $count ->
        [one] { $count } formato
        [many] { $count } formatos
       *[other] { $count } formatos
    }

# Status filter button when several statuses are set.
filter-linux-statuses-count =
    { $count ->
        [one] { $count } estado
        [many] { $count } estados
       *[other] { $count } estados
    }

# Chip for a genre that is left out of the results. The genre is already named.
filter-linux-not = Sin { $genre }

# Button that takes off every filter chip.
filter-linux-clear-all = Quitar filtros

# Tooltip of the arrow that scrolls the filter row back.
filter-linux-earlier = Filtros anteriores

# Tooltip of the arrow that scrolls the filter row on.
filter-linux-more = Más filtros

# What a screen reader says for a broadcast whose time is an estimate. The time is already formatted.
calendar-linux-about = aprox. { $time }

# What a screen reader says for a broadcast that is the dub's.
calendar-linux-dubbed = doblado

# Title of the menu, and tooltip of its button, that orders a list.
library-linux-order = Orden

# A list's tab: its name and how many titles it holds.
library-linux-list-count = { $list } { $count }

# Description read by a screen reader on the button that plays the shown episode on a TV.
title-linux-play-on-tv-help = Reproducir este episodio en un televisor con anistream

# Description read by a screen reader on an episode's watched check box.
title-linux-episode-watched = Episodio { $episode } visto

# Line in a day's column when nothing airs that day.
calendar-linux-day-empty = No se emite nada

# Accessible label of the line that says how the watch party form is getting on.
party-status = Estado de la watch party

# Accessible label of the list of people in the watch party, in the player's panel.
party-members = Miembros

# Title of the dialog that lists the sources that have the watch party's episode.
party-choose-a-source = Elige una fuente

# Line when no source lists the watch party's episode. A plugin store adds plugins, which add sources.
party-sources-none-listed = Ninguna fuente lista el episodio { $episode }. Las fuentes vienen de los complementos que agrega una tienda de complementos.

# Line above the list of sources that have the watch party's episode.
party-sources-found-line =
    { $count ->
        [one] Una fuente lo tiene. La que elijas se reproduce con la watch party.
        [many] { $count } fuentes lo tienen. La que elijas se reproduce con la watch party.
       *[other] { $count } fuentes lo tienen. La que elijas se reproduce con la watch party.
    }

# Notice when the player could not start, or could not be reached to add a track.
player-could-not-start = No se pudo iniciar el reproductor. Inténtalo de nuevo o elige otra fuente.

# Notice when the file chosen for a subtitle or audio track has no path the app can read.
player-file-unreadable = No se pudo leer ese archivo. Prueba con otro.

# The reason the system gives for keeping the screen awake and the computer from sleeping while an episode plays. Other apps and the desktop may show it.
player-inhibit-reason = Reproduciendo un episodio

# Accessible description of the time left in the episode, beside the countdown.
player-time-left = Quedan { $time }

# Line on the starting screen after a note from the engine, with the seconds waited.
player-note-waited = { $note } · { $seconds } s

# Starting screen's line before the episode is known.
player-starting-plain = Iniciando

# Tooltip of the Undo button on the card that says an opening was skipped. The letter is the key that does the same.
player-undo-tooltip = Deshacer (U)

# Over the timeline: the time under the pointer, when it is inside an opening.
player-time-opening = { $clock } · Apertura

# Over the timeline: the time under the pointer, when it is inside an ending.
player-time-ending = { $clock } · Créditos

# Name of a one-channel audio track in the audio menu.
player-channels-mono = Mono

# Name of a two-channel audio track in the audio menu.
player-channels-stereo = Estéreo

# Name of an audio track with some other number of channels.
player-channels =
    { $count ->
        [one] Un canal
        [many] { $count } canales
       *[other] { $count } canales
    }

# Accessible label of the two buttons that switch between subbed and dubbed audio.
player-translation-label = Subtitulado o doblado

# Tooltip on the button that opens a setting's preview on a page of its own, and accessible name of the preview.
settings-preview = Vista previa

# Tooltip on the button that steps a setting to its previous value.
settings-previous-value = Valor anterior

# Tooltip on the button that steps a setting to its next value.
settings-next-value = Valor siguiente

# Line after the legal line under the sources settings: where sources come from.
settings-sources-come-from = Fuentes vienen de las tiendas de complementos a las que te unes.

# Label on the left half of the upscaling preview: the video before processing.
settings-preview-source = Fuente 480p

# Preview note under the upscaling frame when upscaling is off.
settings-upscaling-note-off = La fuente de 480p, ajustada a la pantalla sin procesar.

# A line of sample subtitle over the preview frame. Any short sentence will do.
settings-caption-sample = El camino del farol sigue más allá del último pueblo.

# Preview note under the subtitle frame. The language is a language name.
settings-caption-note = Los subtítulos simples se ven así, en { $language } cuando el episodio los tiene. Los subtítulos con estilo mantienen su propio aspecto.

# Preview note for new-episode notifications when they are on. The tracker is a name such as AniList.
settings-notify-note-on = Un aviso cuando sale un episodio de una serie de tu lista Viendo, a la hora que da { $tracker }. El ajuste propio de cada serie tiene prioridad.

# Preview note for new-episode notifications when they are off.
settings-notify-note-off = Desactivado. Solo avisan las series activadas en sus propios ajustes.

# Heading of the preview note beside the sources settings while torrents are on.
settings-connection-check-title = Verificación de conexión

# Preview note beside the sources settings while torrents are on.
settings-connection-check-note = anistream comprueba desde dónde sale el tráfico de torrents al iniciar uno y cada minuto mientras se ejecuta, y pausa los torrents si esa comprobación falla. Tu VPN o proxy es lo que te protege.

# Preview note beside the accounts settings.
settings-accounts-note = anistream funciona sin cuenta. Tu historial se queda en este equipo al cerrar sesión.

# Preview note beside the Discord settings when presence is on.
settings-presence-note-on = Tu perfil de Discord muestra lo que ves mientras se reproduce un episodio.

# Preview note beside the Discord settings when presence is off.
settings-presence-note-off = Desactivado. Cuando esté activado, tu perfil de Discord muestra lo que ves mientras se reproduce un episodio.

# Preview note beside the advanced settings.
settings-advanced-note = Una opción de aquí puede anular un ajuste de Reproducción, como el escalado o el modo nocturno. Casi nadie necesita este panel.

# Button that opens the page of the new version of the app.
updates-view-version = Ver versión

# Accessible name of the progress bar while the new version downloads.
updates-progress-label = Progreso de la actualización

# Line under AniList's name on the Accounts page.
accounts-sync-detail = Los cambios de progreso y de lista se sincronizan con { $tracker }. Biblioteca y Mi lista del Calendario muestran tus listas de { $tracker }.

# Line under a signed-in account while changes wait for the connection.
accounts-changes-waiting-offline =
    { $count ->
        [one] Un cambio espera a que haya conexión
        [many] { $count } cambios esperan a que haya conexión
       *[other] { $count } cambios esperan a que haya conexión
    }

# Footnote on the Accounts page: where sign-in tokens are kept, when it is the system's keyring.
accounts-tokens-keyring = Los tokens de inicio de sesión se guardan en el llavero de este dispositivo.

# Reason an update stopped: the downloaded file could not be read. The reason is the system's own words.
updates-why-read = No se pudo leer la descarga: { $reason }

# Reason an update stopped: the new version is in place but did not open.
updates-why-reopen = La nueva versión está instalada, pero no se pudo abrir. Abre anistream de nuevo.

# Accessible description of the mascot's picture. Nagare is the mascot's name.
nagare-description = Nagare, la mascota de anistream: una figura con peinado bob de seda, una bufanda ámbar y una capa índigo, con un bastón que lleva un amuleto de agua.

# Note under the Play trailers setting: what the trailers are and when they do not play.
settings-note-trailers-linux = Los tráilers se reproducen sin sonido desde YouTube, que ve tu dirección IP. No se reproducen con conexión medida, con animaciones desactivadas, en modo de ahorro de energía ni con un lector de pantalla activo.

# Settings row: whether a connected game controller drives the app.
settings-label-controller-input = Usar un control

# Settings row: swaps the A and B buttons, for a controller laid out as Nintendo's are.
settings-label-swap-face-buttons = Intercambiar A y B

# Heading of the Settings group for game controllers.
settings-group-controller = Control

# Settings row that names the controller in use.
settings-controller-device = Control

# Value of the controller row when no controller is connected.
settings-controller-none = No se encontró ningún control. Los diseños de teclado de Steam Input siguen funcionando.

# Notice when a controller connects for the first time in a session.
controller-connected = Control conectado · { $name }

# Notice when the controller in use disconnects.
controller-disconnected = Control desconectado

# Title of the window that lists what the controller's buttons do.
controller-help-title = Control

# Accessible name of the list of controller buttons in the help window.
controller-help-buttons = Botones del control

# Button on a notice that asks to open the plugin stores.
shell-open-stores = Abrir tiendas

# Button on an update notice that restarts the app to install it.
shell-restart = Reiniciar

# Button on a notice that a newer version is out: opens its page.
