# Job note while a play waits for the sources to arrive.
status-loading-sources = Đang tải các nguồn…

# Job note while the sources are asked for an episode. The episode is its label, often a number.
status-searching-sources = Đang tìm trong các nguồn tập { $episode }…

# Toast when the player cannot be started. The reason comes from the system.
notice-player-failed-to-start = Không khởi chạy được mpv. Hãy kiểm tra mpv chạy được khi mở riêng. ({ $reason })

# Toast when a stream never showed a frame and the next one is tried.
notice-stream-no-video = Luồng này không có hình. Đang thử { $next } trên { $total }.

# Toast when mpv gave up on a file. The reason is mpv's own line.
notice-player-could-not-play = mpv không phát được tệp này. { $reason }

# Toast when mpv closed without playing and without saying why.
notice-player-exited-silently = mpv đã đóng mà không phát gì và không nêu lý do. Hãy thử nguồn khác.

# Toast when no picture has appeared a while after the player opened.
notice-player-not-playing = mpv chưa bắt đầu phát sau { $seconds } giây. Nguồn có thể không có dữ liệu. Hãy kiểm tra mpv có phát được một tệp khi chạy riêng không.

# Toast when a play is asked for in a build with no player.
