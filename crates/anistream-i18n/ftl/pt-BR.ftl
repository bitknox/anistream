# A Library segment in the strip across the top.
lists-segment-planning = Planejado

# A Library segment in the strip across the top.
lists-segment-completed = Concluído

# A Library segment in the strip across the top.
lists-segment-paused = Pausado

# A Library segment in the strip across the top.
lists-segment-dropped = Abandonado

# An episode in a list row.
