# Under the heading when a { -source } listed no episodes. The keys search by hand and pick another { -source }.
episodes-empty-none-listed-hint = A fonte não listou episódios para este título. Pressione { $search } para pesquisar a correspondência certa, ou { $pick } para escolher outra fonte.

# Toast when an episode has no { -release } to pick from.
episodes-no-releases = Não há versões disponíveis para escolher neste episódio.

# Toast when a download is asked for from a table listed from AniList alone. The key opens the { -source-pl } screen.
episodes-add-source-to-download = Adicione uma fonte antes de baixar. Pressione { $key } para abrir a tela de Fontes.

# Toast when marking the episodes before the highlighted one and the table is empty.
episodes-mark-none-listed = Nenhum episódio listado para marcar.

# Toast when marking the episodes before the first one.
episodes-mark-nothing-before = Nada vem antes do primeiro episódio.

# Toast when every episode before the highlighted one is already watched.
episodes-mark-already-watched = Todos os episódios antes do episódio { $episode } já estão assistidos.

# Toast after the episodes before the highlighted one are marked watched.
episodes-marked-watched =
    { $count ->
        [one] Marcado { $count } episódio como assistido.
        [many] Marcados { $count } episódios como assistidos.
       *[other] Marcados { $count } episódios como assistidos.
    }

# Toast when the range typed for a download is not understood. The examples are typed as they are.
episodes-range-invalid = Não foi possível entender esse intervalo. Use um episódio (4), um intervalo (1-12) ou tudo a partir de um (7-).

# Toast when no episode falls in the range typed for a download.
episodes-range-empty = Nenhum episódio nesse intervalo. Tente outro intervalo.

# Toast after a range is queued for download.
episodes-queueing =
    { $count ->
        [one] Adicionando { $count } episódio à fila de download.
        [many] Adicionando { $count } episódios à fila de download.
       *[other] Adicionando { $count } episódios à fila de download.
    }

# Toast when a match is fixed from a list.
episodes-match-off-page = Abra a página do título para corrigir a correspondência.

# Toast when a match is fixed and no title is highlighted.
episodes-match-nothing = Nenhum título selecionado para refazer a correspondência.

# Toast after a match is picked. The title is the candidate's own.
episodes-matched = Vinculado a { $title }.

# After a { -release } in the picker: it holds both the subbed and the dubbed audio.
