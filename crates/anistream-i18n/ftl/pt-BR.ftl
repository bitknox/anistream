# Generated by tools/i18n from i18n/. Do not edit.

# What the TV's loading screen and its own controls show under the show's name.
cast-episode = Episódio { $episode }

# What the TV's loading screen and its own controls show under the show's name, with the episode's own title.
cast-episode-titled = Episódio { $episode } · { $title }

# The TV can't decode the stream's video, and nothing on this device can convert it. The codec is a technical name such as HEVC Main 10.
notice-cast-video-codec = A TV não consegue reproduzir este vídeo ({ $codec }). Tente outra fonte.

# The TV can't play the stream's audio, and this device can't convert it. The codec is a technical name such as DTS.
notice-cast-audio-codec = A TV não consegue reproduzir este áudio ({ $codec }), e este dispositivo não consegue convertê-lo. Tente outra fonte.

# The stream comes in a kind of file the TV can't read.
notice-cast-container = A TV não consegue reproduzir este tipo de arquivo. Tente outra fonte.

# The episode opens in another app, which this device can't cast.
notice-cast-deep-link = Este episódio abre em outro app, por isso não pode ser transmitido.

# The TV accepted the stream but never started reading it.
notice-cast-never-fetches = A TV não começou a ler o stream. Verifique se este dispositivo e a TV estão na mesma rede, sem VPN no meio.

# The TV tried every way of playing the stream and played none of them.
notice-cast-refused = A TV não conseguiu reproduzir este stream. Tente outra fonte.

# Someone started something else on the TV, which ends the cast.
notice-cast-taken-over = Outro dispositivo iniciou algo na TV, então a transmissão parou.

# This device isn't on the TV's network, or reaches it through a VPN.
notice-cast-not-same-network = Este dispositivo não está na rede da TV, ou acessa a TV por uma VPN. Para transmitir, os dois precisam estar na mesma rede.

# The TV stopped answering mid-cast.
notice-cast-lost = A conexão com a TV foi perdida, e a transmissão parou.

# The TV picked to cast to has left the network.
notice-cast-no-device = Essa TV não está mais na rede.

# This build of the app has no casting.
notice-cast-unavailable = Esta compilação do anistream não consegue transmitir para TVs.

# A comment's age, beside its author, when it was written under a minute ago.
discussion-age-now = agora

# A comment's age, beside its author, in minutes. Abbreviated, as a timeline shows it.
discussion-age-minutes = { $minutes } min

# A comment's age, beside its author, in hours. Abbreviated, as a timeline shows it.
discussion-age-hours = { $hours } h

# A comment's age, beside its author, in days. Abbreviated, as a timeline shows it.
discussion-age-days = { $days } d

# A comment's age, beside its author, in weeks. Abbreviated, as a timeline shows it.
discussion-age-weeks = { $weeks } sem

# A comment's age, beside its author, in years. Abbreviated, as a timeline shows it.
discussion-age-years = { $years } a

# Toast when a like on a comment did not reach AniList. The like is taken back.
notice-comment-like-failed = Não foi possível curtir o comentário. Tente de novo.

# Toast when a comment could not be deleted on AniList. The comment stays.
notice-comment-delete-failed = Não foi possível excluir o comentário. Tente de novo.

# Toast when the viewer tried to like or post in a discussion without signing in to AniList.
notice-discussion-sign-in = Entre com AniList para curtir e responder.

# A reason on its own, as a toast or a failed play's explanation. The reason is one of the engine's own reasons, so it is translated.
notice-reason = { $reason }

# Reason: no source is set up, so nothing can be played or downloaded. Shown in a toast.
cause-no-sources = Não há fontes configuradas. Adicione uma na tela Fontes.

# A play's explanation: the episode's broadcast is still ahead. The "when" says today, tomorrow or a date.
notice-not-aired = O episódio { $episode } vai ao ar { $when }.

# A play's explanation: the episode is after the next one to air. The "when" says when that one airs.
notice-not-aired-yet = O episódio { $episode } ainda não foi ao ar. O episódio { $next } vai ao ar { $when }.

# Part of an air time: the broadcast is later today. The time is the viewer's local time.
cause-airs-today = hoje às { $time }

# Part of an air time: the broadcast is tomorrow. The time is the viewer's local time.
cause-airs-tomorrow = amanhã às { $time }

# Part of an air time: the broadcast is within the next week.
cause-airs-in-days =
    { $days ->
        [one] em um dia às { $time }
        [many] em { $days } dias às { $time }
       *[other] em { $days } dias às { $time }
    }

# Part of an air time: the broadcast is more than a week away. The date is year-month-day.
cause-airs-on-date = em { $date } às { $time }

# Reason: the source answered but gave nothing to play.
cause-no-playable-stream = A fonte respondeu, mas não enviou nada para reproduzir. Tente outra.

# Reason: no source could be matched to the title. The detail is what each source said.
cause-title-no-match = Não foi possível localizar este título nas fontes: { $detail }

# Reason: the source the person picked is no longer installed or enabled.
cause-source-gone = A fonte { $source } não está mais disponível. Escolha outra.

# Reason: the release the person picked would not start. The detail comes from the source.
cause-release-failed = Não foi possível iniciar essa versão: { $detail }

# Reason: a play waited too long for its sources to give it a stream, and gave up.
cause-sources-timed-out = As fontes demoraram demais para responder. Tente de novo ou escolha outra fonte.

# Reason: every source matched the title but none has the episode. The detail is what each said.
cause-no-source-has-episode = Nenhuma fonte tem o episódio { $episode }: { $detail }

# Reason: the source streams episodes but only torrents can be downloaded.
cause-source-cannot-download = Esta fonte transmite episódios, mas não é possível baixá-los.

# Reason: the title was never listed by a source, so it can't be downloaded.
cause-no-source-could-list-show = Nenhuma fonte conseguiu listar esta série, então ela não pode ser baixada.

# Part of a finished download's toast: subtitle files were merged into the video.
cause-subtitles-merged =
    { $tracks ->
        [one] Uma faixa de legenda foi incorporada ao vídeo.
        [many] { $tracks } faixas de legenda foram incorporadas ao vídeo.
       *[other] { $tracks } faixas de legenda foram incorporadas ao vídeo.
    }

# Part of a finished download's toast: merging failed, so the subtitles stay as files beside it.
cause-subtitles-left-apart = As legendas ficam como arquivos separados. { $reason }

# Part of a download toast: how many episodes of the range were in the queue already.
cause-already-in-downloads =
    { $count ->
        [one] Um episódio já está nos downloads.
        [many] { $count } episódios já estão nos downloads.
       *[other] { $count } episódios já estão nos downloads.
    }

# Job note while a play looks the title up.
status-looking-up-title = Procurando o título…

# Job note while a play waits for the sources to arrive.
status-loading-sources = Carregando fontes…

# Job note while the sources are asked for an episode. The episode is its label, often a number.
status-searching-sources = Buscando o episódio { $episode } em fontes…

# Toast when the player cannot be started. The reason comes from the system.
notice-player-failed-to-start = Não foi possível iniciar o mpv. Verifique se ele roda sozinho. ({ $reason })

# Toast when a stream never showed a frame and the next one is tried.
notice-stream-no-video = Nenhum vídeo nesta transmissão. Tentando a transmissão { $next } de { $total }.

# Toast when mpv gave up on a file. The reason is mpv's own line.
notice-player-could-not-play = O mpv não conseguiu reproduzir isto. { $reason }

# Toast when mpv closed without playing and without saying why.
notice-player-exited-silently = O mpv fechou sem reproduzir nada e sem informar o motivo. Tente outra fonte.

# Toast when no picture has appeared a while after the player opened.
notice-player-not-playing = O mpv ainda não começou a reproduzir depois de { $seconds } s. A fonte pode não ter dados. Verifique se o mpv reproduz um arquivo sozinho.

# Toast when a play is asked for in a build with no player.
notice-no-player = Esta compilação do anistream não consegue reproduzir vídeo.

# Toast at launch when the mpv program is missing. The binary is the name the settings give it. Terminal only: the engine never sends it to the apps.
notice-mpv-missing = { $binary } não foi encontrado. Instale o mpv para reproduzir episódios.

# Toast at launch when mpv is too old for anistream's own player. Terminal only: the engine never sends it to the apps.
notice-mpv-old = O mpv { $version } pode reproduzir, mas o player do anistream precisa do mpv 0.36 ou mais recente para o botão de pular, o cartão de Próximo, os menus e as miniaturas.

# Toast when an episode plays with no subtitles because none of the source's subtitle files could be downloaded.
notice-subtitles-unavailable = As legendas desta fonte não puderam ser carregadas. Escolha outra fonte para tentar de novo.

# Toast after a link was handed to the browser.
notice-opened-in-browser = Aberto no seu navegador.

# Toast when a link could not be opened. The reason comes from the system.
notice-could-not-open = Não foi possível abrir isso. { $reason }

# Toast when a trailer plays in mpv.
notice-trailer-playing = Trailer sendo reproduzido no mpv.

# Toast when a trailer opens in the browser.
notice-trailer-opened = Trailer aberto no seu navegador.

# Toast when a trailer could not be opened. The reason comes from the system.
notice-trailer-failed = Não foi possível abrir o trailer. { $reason }

# Toast when the next episode is not the one after this because filler was skipped.
notice-filler-skipped = Episódio de enchimento pulado. O Próximo é o episódio { $episode }.

# Toast after switching the audio while playing.
notice-audio-now-subbed = O áudio agora é legendado.

# Toast after switching the audio while playing.
notice-audio-now-dubbed = O áudio agora é dublado.

# Toast when the previous-episode control is used on the first episode.
notice-already-first-episode = Já está no primeiro episódio.

# Toast when the next-episode control is used on the last known episode.
notice-last-episode = Não há episódio seguinte. O episódio { $episode } é o último.

# Toast when the next-episode control is used and the next episode is not known.
notice-no-next-episode = Não há episódio seguinte.

# Toast when the previous-episode control finds no previous episode.
notice-no-previous-episode = Não há episódio anterior.

# Toast when the title's episode match could not be cleared. The reason comes from the system.
notice-match-reset-failed = Não foi possível redefinir a correspondência. { $reason }

# Toast when the chosen match could not be saved. The reason comes from the system.
notice-match-save-failed = Não foi possível salvar essa correspondência. { $reason }

# Toast when a chosen match still left the title undecided.
notice-match-did-not-stick = Essa correspondência não foi salva. A fonte pode ter mudado. Tente escolher de novo.

# Toast when a search of the sources for a title found nothing.
notice-source-search-empty = Nada encontrado para “{ $query }”. Tente uma busca diferente.

# Toast after the person picked a source for one title.
notice-source-pinned = A fonte { $source } será usada para este título.

# Toast after the person went back to automatic source selection for one title.
notice-source-automatic = Voltou à seleção automática de fonte para este título.

# Toast when the source choice for a title could not be saved. The reason comes from the system.
notice-source-choice-failed = Não foi possível salvar essa escolha. { $reason }

# Toast when no source could list a show's episodes. The reason is what the sources said.
notice-no-source-could-list = Nenhuma fonte conseguiu listar esta série: { $reason }

# Why a title's episodes could not be loaded at all, shown on its page and as a toast. The reason comes from AniList or the network.
notice-episodes-failed = Não foi possível carregar os episódios. { $reason }

# Toast when a source found several shows that could be this one and could not tell which. The episodes shown are AniList's until one is picked. The source is its name.
notice-match-uncertain = { $source } encontrou mais de uma série que pode ser esta, então, por enquanto, os episódios vêm do AniList.

# Toast when a title cannot be taken off the Continue row. The reason comes from the system.
notice-continue-hide-failed = Não foi possível remover isso de Continuar assistindo. { $reason }

# Toast after an episode was added to the download queue.
notice-download-queued = Episódio { $episode } de { $title } adicionado à fila.

# Toast when an episode asked for is in downloads already.
notice-download-already-queued = O episódio { $episode } de { $title } já está nos downloads.

# Toast when a waiting or paused download was moved to the front and started.
notice-download-starting-now = Iniciando o episódio { $episode } de { $title } agora.

# Toast after a download was cancelled.
notice-download-cancelled = Download cancelado.

# Toast after a download and its file were deleted.
notice-download-file-deleted = Download e arquivo excluídos.

# Toast after a download was removed whose file was already gone.
notice-download-removed-file-gone = Download removido. O arquivo já não existia.

# Toast after a download was removed but its file could not be deleted. The reason comes from the system.
notice-download-removed-file-kept = Download removido, mas não foi possível excluir o arquivo. { $reason }

# Toast after a download with no file was removed.
notice-download-removed = Download removido.

# Toast after finished downloads were cleared from the list.
notice-downloads-cleared =
    { $count ->
        [one] Um download concluído foi removido da lista.
        [many] { $count } downloads concluídos foram removidos da lista.
       *[other] { $count } downloads concluídos foram removidos da lista.
    }

# Toast when an episode finished downloading.
notice-download-finished = Episódio { $episode } de { $title } baixado.

# Toast when an episode finished downloading and the note says what happened to its subtitles.
notice-download-finished-note = Episódio { $episode } de { $title } baixado. { $note }

# Toast when a download could not start. The reason comes from the torrent client.
