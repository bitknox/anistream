# What the TV's loading screen and its own controls show under the show's name.
cast-episode = Épisode { $episode }

# What the TV's loading screen and its own controls show under the show's name, with the episode's own title.
cast-episode-titled = Épisode { $episode } · { $title }

# The episode opens in another app, which this device can't cast.
notice-cast-deep-link = Cet épisode s’ouvre dans une autre application, donc il ne peut pas être diffusé.

# The TV picked to cast to has left the network.
notice-cast-no-device = Cette télévision n’est plus sur le réseau.

# This build of the app has no casting.
notice-cast-unavailable = Cette version de anistream ne peut pas diffuser sur les télévisions.

# A comment's age, beside its author, when it was written under a minute ago.
discussion-age-now = À l’instant

# A comment's age, beside its author, in minutes. Abbreviated, as a timeline shows it.
discussion-age-minutes = { $minutes } min

# A comment's age, beside its author, in hours. Abbreviated, as a timeline shows it.
discussion-age-hours = { $hours } h

# A comment's age, beside its author, in days. Abbreviated, as a timeline shows it.
discussion-age-days = { $days } j

# A comment's age, beside its author, in weeks. Abbreviated, as a timeline shows it.
discussion-age-weeks = { $weeks } sem

# A comment's age, beside its author, in years. Abbreviated, as a timeline shows it.
discussion-age-years = { $years } ans

# Toast when a like on a comment did not reach AniList. The like is taken back.
notice-comment-like-failed = Impossible d’aimer le commentaire. Réessayez.

# Toast when a comment could not be deleted on AniList. The comment stays.
notice-comment-delete-failed = Impossible de supprimer le commentaire. Réessayez.

# Toast when the viewer tried to like or post in a discussion without signing in to AniList.
notice-discussion-sign-in = Connectez-vous à AniList pour aimer et répondre.

# A reason on its own, as a toast or a failed play's explanation. The reason is one of the engine's own reasons, so it is translated.
notice-reason = { $reason }

# Reason: no source is set up, so nothing can be played or downloaded. Shown in a toast.
cause-no-sources = Aucune sources n'est configurée. Ajoutez-en une dans l'écran Sources.

# A play's explanation: the episode's broadcast is still ahead. The "when" says today, tomorrow or a date.
notice-not-aired = L'épisode { $episode } est diffusé { $when }.

# A play's explanation: the episode is after the next one to air. The "when" says when that one airs.
notice-not-aired-yet = L'épisode { $episode } n'est pas encore diffusé. L'épisode { $next } est diffusé { $when }.

# Part of an air time: the broadcast is later today. The time is the viewer's local time.
cause-airs-today = aujourd'hui à { $time }

# Part of an air time: the broadcast is tomorrow. The time is the viewer's local time.
cause-airs-tomorrow = demain à { $time }

# Part of an air time: the broadcast is within the next week.
cause-airs-in-days =
    { $days ->
        [one] dans un jour à { $time }
        [many] dans { $days } jours à { $time }
       *[other] dans { $days } jours à { $time }
    }

# Part of an air time: the broadcast is more than a week away. The date is year-month-day.
cause-airs-on-date = le { $date } à { $time }

# Reason: the source answered but gave nothing to play.
cause-no-playable-stream = La source a répondu, mais sans rien à lire. Essayez une autre source.

# Reason: no source could be matched to the title. The detail is what each source said.
cause-title-no-match = Impossible de faire correspondre ce titre : { $detail }

# Reason: the source the person picked is no longer installed or enabled.
cause-source-gone = La source { $source } n'est plus disponible. Choisissez-en une autre.

# Reason: the release the person picked would not start. The detail comes from the source.
cause-release-failed = Impossible de lancer cette release : { $detail }

# Reason: a play waited too long for its sources to give it a stream, and gave up.
cause-sources-timed-out = Les sources ont mis trop de temps à répondre. Réessayez, ou choisissez une autre source.

# Reason: every source matched the title but none has the episode. The detail is what each said.
cause-no-source-has-episode = Aucune source n'a l'épisode { $episode } : { $detail }

# Reason: the source streams episodes but only torrents can be downloaded.
cause-source-cannot-download = Cette source permet de regarder des épisodes, mais pas de les télécharger.

# Reason: the title was never listed by a source, so it can't be downloaded.
cause-no-source-could-list-show = Aucune source n'a pu répertorier cette série, elle ne peut donc pas être téléchargée.

# Part of a finished download's toast: subtitle files were merged into the video.
cause-subtitles-merged =
    { $tracks ->
        [one] Une piste de sous-titres a été intégrée.
        [many] { $tracks } pistes de sous-titres ont été intégrées.
       *[other] { $tracks } pistes de sous-titres ont été intégrées.
    }

# Part of a finished download's toast: merging failed, so the subtitles stay as files beside it.
cause-subtitles-left-apart = Les sous-titres restent dans des fichiers séparés. { $reason }

# Part of a download toast: how many episodes of the range were in the queue already.
cause-already-in-downloads =
    { $count ->
        [one] Un épisode est déjà dans les téléchargements.
        [many] { $count } épisodes sont déjà dans les téléchargements.
       *[other] { $count } épisodes sont déjà dans les téléchargements.
    }

# Job note while a play looks the title up.
status-looking-up-title = Recherche du titre…

# Job note while a play waits for the sources to arrive.
status-loading-sources = Chargement des sources…

# Job note while the sources are asked for an episode. The episode is its label, often a number.
status-searching-sources = Recherche dans les sources de l'épisode { $episode }…

# Toast when the player cannot be started. The reason comes from the system.
notice-player-failed-to-start = Impossible de lancer mpv. Vérifiez qu'il démarre seul. ({ $reason })

# Toast when a stream never showed a frame and the next one is tried.
notice-stream-no-video = Aucune image sur ce flux. Essai { $next } sur { $total }.

# Toast when mpv gave up on a file. The reason is mpv's own line.
notice-player-could-not-play = mpv n'a pas pu lire ce fichier. { $reason }

# Toast when mpv closed without playing and without saying why.
notice-player-exited-silently = mpv s'est fermé sans rien lire et sans donner de raison. Essayez une autre source.

# Toast when no picture has appeared a while after the player opened.
notice-player-not-playing = mpv n'a pas commencé la lecture après { $seconds } s. La source n'a peut-être pas de données. Vérifiez que mpv lit un fichier tout seul.

# Toast when a play is asked for in a build with no player.
notice-no-player = Cette version de anistream ne peut pas lire de vidéo.

# Toast at launch when the mpv program is missing. The binary is the name the settings give it. Terminal only: the engine never sends it to the apps.
notice-mpv-missing = { $binary } est introuvable. Installez mpv pour lire les épisodes.

# Toast at launch when mpv is too old for anistream's own player. Terminal only: the engine never sends it to the apps.
notice-mpv-old = mpv { $version } peut lire des vidéos, mais le lecteur de anistream demande mpv 0.36 ou plus récent pour son bouton Passer, la carte À suivre, les menus et les miniatures.

# Toast when an episode plays with no subtitles because none of the source's subtitle files could be downloaded.
