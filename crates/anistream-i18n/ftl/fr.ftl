# Toast after the filter changes.
episodes-showing-no-filler = Affichage des épisodes sans filler.

# Top right of the episode table: how far the dub goes, for a dub that stops short of what has aired.
episodes-dub-through = Doublage jusqu’à l’épisode { $through }

# Top right of the episode table: the dub has every episode.
episodes-dub-complete = Doublé

# Heading of the empty episode table when the filter hides every episode.
episodes-empty-filtered = Aucun épisode ne correspond au filtre

# Under the heading when the filter hides every episode. The key is the filter key.
episodes-empty-filtered-hint = Le filtre masque tous les épisodes. Appuyez sur { $key } pour le modifier.

# Heading of the empty episode table when no { -source } is ready.
episodes-empty-no-source = Pas encore d’épisodes

# Under the heading when no { -source } is ready. The key opens the { -source-pl } screen.
episodes-empty-no-source-hint = AniList ne liste pas encore d’épisodes pour ce titre, et aucune source n’est prête. Appuyez sur { $key } pour ouvrir l’écran Sources.

# Heading of the empty episode table when the title has not aired yet.
episodes-empty-unaired = Rien n’a encore été diffusé

# Under the heading when the title has not aired yet. The span is short, such as 2d 3h.
episodes-empty-unaired-hint = L’épisode { $episode } sort dans { $span }.

# Heading of the empty episode table when a { -source } matched the title and listed nothing.
episodes-empty-none-listed = Aucun épisode listé

# Under the heading when a { -source } listed no episodes. The keys search by hand and pick another { -source }.
episodes-empty-none-listed-hint = La source n’a listé aucun épisode pour ce titre. Appuyez sur { $search } pour chercher la bonne correspondance, ou sur { $pick } pour choisir une autre source.

# Toast when an episode has no { -release } to pick from.
episodes-no-releases = Aucune release n’est disponible pour cet épisode.

# Toast when a download is asked for from a table listed from AniList alone. The key opens the { -source-pl } screen.
episodes-add-source-to-download = Ajoutez une source avant de télécharger. Appuyez sur { $key } pour ouvrir l’écran Sources.

# Toast when marking the episodes before the highlighted one and the table is empty.
episodes-mark-none-listed = Aucun épisode n’est listé à marquer.

# Toast when marking the episodes before the first one.
episodes-mark-nothing-before = Rien ne précède le premier épisode.

# Toast when every episode before the highlighted one is already watched.
episodes-mark-already-watched = Tous les épisodes avant l’épisode { $episode } sont déjà vus.

# Toast after the episodes before the highlighted one are marked watched.
episodes-marked-watched =
    { $count ->
        [one] { $count } épisode marqué comme vu.
        [many] { $count } épisodes marqués comme vus.
       *[other] { $count } épisodes marqués comme vus.
    }

# Toast when the range typed for a download is not understood. The examples are typed as they are.
episodes-range-invalid = Impossible de lire cette plage. Utilisez un épisode (4), une plage (1-12) ou tous les épisodes à partir d’un numéro (7-).

# Toast when no episode falls in the range typed for a download.
episodes-range-empty = Aucun épisode dans cette plage. Essayez une autre plage.

# Toast after a range is queued for download.
episodes-queueing =
    { $count ->
        [one] Ajout de { $count } épisode à la file de téléchargement.
        [many] Ajout de { $count } épisodes à la file de téléchargement.
       *[other] Ajout de { $count } épisodes à la file de téléchargement.
    }

# Toast when a match is fixed from a list.
episodes-match-off-page = Ouvrez la page du titre pour corriger sa correspondance.

# Toast when a match is fixed and no title is highlighted.
episodes-match-nothing = Aucune sélection à associer à nouveau.

# Toast after a match is picked. The title is the candidate's own.
episodes-matched = Associé à { $title }.

# After a { -release } in the picker: it holds both the subbed and the dubbed audio.
episodes-release-dual = Sous-titré et doublé

# After a { -release } in the picker: it is dubbed.
episodes-release-dub = Doublé

# After a { -release } in the picker: it is the one anistream would play on its own.
episodes-release-current-pick = Choix actuel

