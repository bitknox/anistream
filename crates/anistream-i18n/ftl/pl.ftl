# A calendar day heading.
lists-day-today = Dziś

# A calendar day heading.
lists-day-yesterday = Wczoraj

# A calendar day heading.
lists-day-tomorrow = Jutro

# The line in the preview that says where the person stopped. The mark in front is added by the screen.
lists-preview-continue-percent = Kontynuuj oglądanie odc. { $episode } na { $clock } ({ $percent }%)

# The same line when the fraction is not known.
lists-preview-continue = Kontynuuj oglądanie odc. { $episode } na { $clock }

# Beside the progress meter: episodes watched out of the total.
lists-progress-aired =
    { $total ->
        [one] { $done } z { $total } odcinek wyemitowany
        [few] { $done } z { $total } odcinki wyemitowane
        [many] { $done } z { $total } odcinków wyemitowanych
       *[other] { $done } z { $total } odcinków wyemitowanych
    }

# Beside the progress meter when there is nothing to count against.
lists-progress-watched =
    { $count ->
