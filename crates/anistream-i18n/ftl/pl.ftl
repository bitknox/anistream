# Error: the store was joined once, but this device has no saved token for it.
store-token-missing = Urządzenie nie ma zapisanego tokenu dla { $store }. Dołącz ponownie nowym zaproszeniem.

# Error: the store the record points to is gone from the saved list.
store-not-joined = Sklep z wtyczkami nie jest już dołączony.

# Error: a store's signing key is unreadable. Shown as the reason a store is offline.
store-key-damaged = Sklep z wtyczkami ma uszkodzony klucz podpisu. Opuść go i dołącz ponownie nowym zaproszeniem.

# Error: a store rejected this device's token.
store-device-refused = { $store } nie przyjmuje już to urządzenie. Dołącz ponownie nowym zaproszeniem.

# Error: a store could not be reached. The reason comes from the network.
store-unreachable = Nie udało się połączyć z { $store }. { $reason }

# Error: an invite link names a store this device already joined, but at another address.
store-moved = { $store } jest dołączony pod adresem { $current }, ale ten link wskazuje na { $target }. Jeśli sklep z wtyczkami się przeniósł, najpierw go opuść i dołącz ponownie.

# Error: an open link would replace the named membership this device already has.
store-join-would-unname = Dołączono do { $store } jako { $member }. Ten link dołączyłby ponownie bez podanej nazwy, więc nic nie zmieniono.

# Error: the server at a link's address could not prove it is the store the invite named.
store-not-the-invited = Nie udało się potwierdzić, że pod { $url } jest sklep z wtyczkami z zaproszenia ({ $reason }). Nic nie dołączono.

# Error: the token for a joined store could not be saved on this device. The reason comes from the system.
store-token-not-kept = Sklep z wtyczkami: nie udało się zapisać tokenu. { $reason }

# Error: an invite that cannot be used any more.
store-invite-unusable = To zaproszenie zostało już użyte, anulowane lub wygasło. Poproś o nowe.

# Error: an open link that no longer lets anyone join.
store-open-link-unusable = Ten link nie pozwala już nikomu dołączyć. Poproś właściciela o nowy link albo zaproszenie.

# Error: a plugin takes the name of a built-in source.
plugin-reserved-name = Wtyczka nie może nazywać się { $plugin }, bo tak nazywa się źródło wbudowane.

# Error: a store stopped offering a plugin between listing it and installing it.
store-plugin-withdrawn = { $store } nie oferuje już { $plugin }.

# Error: a store changed a plugin after the person agreed to what was shown.
store-plugin-changed = { $store } zmienił { $plugin } od chwili pokazania. Sprawdź to ponownie przed instalacją.

# Error: a plugin installed from one store is offered by another.
plugin-from-other-store = Zainstalowano { $plugin } z { $store }. { $store } zapewnia aktualizacje.

# Error: a plugin file added by hand already declares the same name.
plugin-duplicate-file = { $path } już deklaruje { $plugin }. Najpierw usuń ten plik, bo uruchomią się dwie kopie.

# Error: a plugin could not be downloaded or installed. The reason comes from the store or the system.
plugin-install-failed = Nie udało się zainstalować { $plugin }. { $reason }

# Error: a plugin could not be published. The reason comes from the store or the system.
plugin-publish-failed = Nie udało się opublikować { $plugin }. { $reason }

# Error: a plugin to publish is no longer in the plugin folder.
plugin-missing-locally = { $plugin } nie ma w folderze, w którym są wtyczki.

# Error: an invite for another device cannot be made from a device that joined with the open link.
store-invite-needs-link = To urządzenie dołączyło do { $store } linkiem. Wklej ten sam link na drugim urządzenie.

# Error: the store sent an invite link that does not parse. The reason comes from the link parser.
store-link-malformed = Sklep z wtyczkami wysłał link, który nie daje się odczytać. Poproś o sprawdzenie. { $reason }

# Error: the store sent a link carrying another store's key.
store-link-wrong-key = Sklep z wtyczkami wysłał link z innym kluczem. Sprawdź adres, z którego zaczęto.

# Error: the store's server has no admin page.
store-admin-missing = { $store } nie ma strony administracyjnej. Jego serwer może być starszy.

# Error: the store sent an admin link that points somewhere else.
store-admin-link-foreign = { $store } wysłał link administracyjny do innego adresu.

# Error: the store's server is too old for joining with a link.
store-open-join-unsupported = Serwer { $store } jest starszy i nie pozwala nikomu dołączyć linkiem. Najpierw go zaktualizuj.

# Toast after a source (plugin) is switched off. It is skipped when looking for episodes.
source-switched-off = Wyłączono { $name }. Przy szukaniu odcinków pomija się to źródło.

# Toast after a source (plugin) is switched on.
source-switched-on = Włączono { $name }.

# Error: a command named a plugin that is not loaded.
plugin-not-loaded = Nie wczytano { $id }. Sprawdź instalację.

# Toast after a release is chosen for a title. The name is the release's title.
release-pinned = Dla tego tytułu wybrano: { $name }.

# Toast when the chosen source or release for a title could not be saved. The reason comes from the database.
notice-choice-not-saved = Nie udało się zapisać wyboru. { $reason }

# Toast while torrents are running but the connection check failed, and the settings say to warn only.
torrent-check-failed-running = Sprawdzenie połączenia nie powiodło się. Torrenty działają dalej.

# Note on the sources screen: torrents are waiting for the VPN guard. The reason comes from the guard.
torrent-vpn-waiting = Torrenty ruszą po przejściu kontroli VPN. { $reason }

# Note on the sources screen: the VPN guard has no verdict yet.
torrent-vpn-unverified = Torrenty ruszą po przejściu kontroli VPN. Połączenie nie zostało jeszcze sprawdzone.

# Error: torrents are on, but no torrent index is set.
torrent-no-index = Torrenty wymagają indeks torrentów. anistream nie dołącza żadnego, więc dodaj własny adres w ustawieniach.

# Error: the torrent session did not start because the interface closed first.
torrent-interface-closed = Zamknięto anistream, zanim ruszyły torrenty.

# Error: the torrent session could not start. The reason comes from the torrent engine.
torrent-session-failed = Nie udało się uruchomić sesji torrentów. { $reason }

# Toast when torrents are up but no operating-system firewall rule backs the VPN guard. Terminal only: the engine never sends it to the apps.
torrent-no-kill-switch = Żadna reguła zapory nie zatrzyma ruchu torrentów, jeśli VPN się rozłączy. Uruchom „anistream --doctor”, aby to skonfigurować.

# Toast when the connection check could not run. The reason comes from the VPN settings.
torrent-not-checked = Nie udało się sprawdzić połączenia. { $reason }

# Note on the sources screen after the source chain is rebuilt with torrents on.
sources-reloaded-torrents-pending = Źródła ponownie wczytane. Torrenty ruszą po przejściu kontroli VPN.

# Note on the sources screen after the source chain is rebuilt with torrents off.
sources-reloaded-torrents-off = Torrenty są wyłączone. Sesja została zatrzymana.

# Note on a running job: requests to AniList are being slowed to stay within its limit. A countdown follows.
job-anilist-limit = Czekanie na limit zapytań AniList

# Toast when there is no job to carry the wait for AniList's rate limit.
notice-anilist-limit = Czekanie { $wait } na limit zapytań AniList.

# Toast when the AniList fallback takes over because AniList cannot be reached.
notice-anilist-unreachable = AniList nie odpowiada. Na razie pokazano dane z innego serwisu.

# Toast when no metadata service answered and the last cached data is shown.
notice-metadata-cached = Żadna usługa metadanych nie odpowiedziała. Pokazano ostatnie zapisane dane.

# Toast when AniList answers again.
notice-anilist-back = AniList znowu odpowiada.

# Toast when a command needs watch parties but this app was built without them.
notice-party-not-built = Wspólne oglądania nie są w tej wersji aplikacji.

# Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList.
notice-signed-in = Zalogowano do { $tracker }.

# Toast after a sign-in succeeded and the token went into the system keychain.
notice-signed-in-keychain = Zalogowano do { $tracker }. Token zapisano w pęku kluczy systemu.

# Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows.
notice-signed-in-file = Zalogowano do { $tracker }. Pęk kluczy jest niedostępny, więc token zapisano w prywatnym pliku na tym komputerze.

# Toast when a sign-in worked but the token could not be stored. The reason comes from the system.
notice-signed-in-unsaved = Zalogowano do { $tracker }, ale token nie został zapisany, więc przy następnym uruchomieniu trzeba będzie zalogować się ponownie. { $reason }

# Toast when a sign-in token could not be stored. The reason comes from the system.
notice-token-not-saved = Nie udało się zapisać tokenu logowania. Spróbuj zalogować się ponownie. { $reason }

# Toast when a sign-in did not finish. The reason comes from the tracker or the network.
notice-sign-in-failed = Nie udało się zalogować do { $tracker }. Spróbuj ponownie. { $reason }

# Toast when the wait for a sign-in ended early. The reason comes from the system.
notice-sign-in-stopped = Logowanie do { $tracker } zostało przerwane, zanim się zakończyło. Spróbuj ponownie. { $reason }

# Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker.
notice-token-exchange-failed = Nie udało się otrzymać tokenu od { $tracker }. Spróbuj zalogować się ponownie. { $reason }

# Toast when no browser could be opened for a sign-in. The reason comes from the system.
notice-browser-not-opened = Nie udało się otworzyć przeglądarki do logowania. Sprawdź, czy któraś jest zainstalowana, i spróbuj ponownie. { $reason }

# Toast when a sign-in redirect arrives and no sign-in is waiting for it.
notice-sign-in-not-waiting = Żadne logowanie do { $tracker } nie czeka na tę odpowiedź. Rozpocznij logowanie od nowa.

# Toast when a sign-in redirect does not match the request that was made.
notice-sign-in-wrong-request = Logowanie do { $tracker } nie wróciło w odpowiedzi na to żądanie. Rozpocznij logowanie od nowa.

# Toast when a tracker sent the person back without a token.
notice-sign-in-no-token = Logowanie do { $tracker } wróciło bez tokenu. Spróbuj ponownie.

# Toast when this build has no MyAnimeList client to finish a sign-in with.
notice-mal-client-missing-build = Nie udało się dokończyć logowania do MyAnimeList: ta wersja nie zawiera klienta dla tej usługi.

# Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.
notice-kitsu-signs-in-on-accounts = Logowanie do Kitsu odbywa się z ekranu kont.

# Toast when a tracker has no way to sign in yet.
notice-sign-in-unsupported = Logowanie do { $tracker } nie jest jeszcze obsługiwane.

# Toast on an app that cannot receive a browser redirect.
notice-sign-in-needs-redirect = Logowanie do { $tracker } wymaga przekierowania w przeglądarce, którego ta aplikacja nie może odebrać.

# Toast when AniList is set to a sign-in method only the anistream app can finish. The setting name is a key of the config file and is not translated.
notice-anilist-implicit-flow = Ta metoda logowania AniList działa tylko w aplikacji anistream. Aby zalogować się tutaj, ustaw { $setting } na „loopback” w pliku konfiguracyjnym.

# Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated.
notice-anilist-client-missing = AniList wymaga identyfikatora klienta i sekretu. Ustaw { $client } i { $secret } w pliku konfiguracyjnym, a potem zaloguj się ponownie. Adres logowania podaje polecenie: anistream --login-url.

# Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.
notice-anilist-paste-flow = Wklejanie kodu nie jest tu możliwe. Zakończ działanie i uruchom zamiast tego anistream --login.

# Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated.
notice-mal-client-missing = MyAnimeList wymaga identyfikatora klienta. Zarejestruj aplikację z typem „other” na myanimelist.net/apiconfig, a potem ustaw { $setting } w pliku konfiguracyjnym.

# Job note while the browser sign-in is open and the terminal app waits for it to come back.
status-waiting-for-redirect = Czekanie, aż { $tracker } przekieruje z powrotem…

# Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.
notice-mal-no-refresh-token = MyAnimeList nie wydało tokenu odświeżania. Logowanie wygaśnie za około miesiąc i trzeba będzie zalogować się ponownie.

# Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated.
notice-client-id-missing = Najpierw ustaw { $setting } w pliku konfiguracyjnym.

# Toast after signing out of a tracker with nothing waiting to send.
notice-signed-out = Wylogowano z { $tracker }.

# Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in.
notice-signed-out-queue =
    { $count ->
        [one] Wylogowano z { $tracker }. Jedna zmiana w kolejce zostanie zachowana na następne logowanie.
        [few] Wylogowano z { $tracker }. { $count } zmiany w kolejce zostaną zachowane na następne logowanie.
        [many] Wylogowano z { $tracker }. { $count } zmian w kolejce zostanie zachowanych na następne logowanie.
       *[other] Wylogowano z { $tracker }. { $count } zmian w kolejce zostanie zachowanych na następne logowanie.
    }

# Toast when signing out of a tracker failed. The reason comes from the system.
notice-sign-out-failed = Nie udało się wylogować z { $tracker }. Spróbuj ponownie. { $reason }

# Toast when a setting could not be stored. The cause says why and what to do.
notice-not-saved-because = Nie udało się zapisać tego ustawienia. { $cause }

# Toast when the torrent protection choice was saved.
notice-protection-saved = Zapisano ustawienie ochrony torrentów.

# Toast when the torrent protection could not be checked. The cause says why.
notice-protection-not-checked = Nie udało się sprawdzić ochrony torrentów. { $cause }

# Toast when the proxy's password could not be stored. The reason comes from the system.
notice-proxy-password-not-kept = Nie udało się zachować hasła do proxy. Wpisz je ponownie, aby spróbować zapisać. { $reason }

# Toast when a show's setting was given a value it does not take. The value is what was given.
notice-show-setting-refused = Nie udało się zapisać tego ustawienia. { $value } nie jest prawidłową wartością dla { $setting }.

# Toast when resetting a show's settings failed. The reason comes from the local database.
notice-show-not-reset = Nie udało się zresetować ustawień tego tytułu. { $reason }

# Toast when a subtitle choice names subtitles the show has not used.
notice-show-no-such-subtitles = Nie udało się zapisać tego wyboru napisów. Ten tytuł nie używał wcześniej tych napisów.

# Toast while torrents are held until the connection check passes.
notice-torrents-waiting-for-check = Torrenty czekają, aż kontrola połączenia znów przejdzie.

# Toast when the mapping data downloads work again after a failure.
notice-mapping-data-refreshed = Odświeżono dane mapowania.

# Toast when the mapping data could not be downloaded. It is said once; the retries are silent.
notice-mapping-data-failed = Nie udało się odświeżyć danych mapowania ({ $datasets }). Ponowna próba za { $wait }. { $cause }

# Toast, and desktop notification, for one episode that aired while the app was closed.
notice-episode-aired = { $title }, odcinek { $episode }, został wyemitowany, gdy aplikacja była zamknięta.

# Toast, and desktop notification, for several episodes that aired while the app was closed.
notice-episodes-aired =
    { $count ->
        [one] Jeden nowy odcinek z listy tytułów został wyemitowany. Jest w kalendarzu.
        [few] { $count } nowe odcinki z listy tytułów zostały wyemitowane. Są w kalendarzu.
        [many] { $count } nowych odcinków z listy tytułów zostało wyemitowanych. Są w kalendarzu.
       *[other] { $count } nowych odcinków z listy tytułów zostało wyemitowanych. Są w kalendarzu.
    }

# Toast when a new release of anistream is out, on the terminal app. The command is not translated. Terminal only: the engine never sends it to the apps.
notice-update-available = Wydano { $tag }. Uruchom anistream --update, aby zainstalować aktualizację.

# The reason a setting was refused until the person confirms having no protection.
cause-confirm-no-protection = Najpierw trzeba potwierdzić, że ochrona ma być wyłączona.

# The reason a setting was refused until the person confirms the "warn only" choice.
cause-confirm-warn-only = Najpierw trzeba potwierdzić wybór „tylko ostrzeżenie”.

# The reason a proxy was refused: it has no host or no port.
cause-proxy-needs-address = Proxy wymaga hosta i portu.

# The reason a proxy could not be checked: its address is not one the check can use.
cause-proxy-address-unusable = Adres proxy nie nadaje się do sprawdzenia.

# The reason a request failed: it never reached the server.
cause-server-unreachable = Nie udało się połączyć z serwerem.

# Toast after a setting is stored. The label is the setting's name.
notice-saved = Zapisano: { $label }.

# Toast when a setting could not be stored. The reason comes from the system.
notice-not-saved = Nie udało się zapisać tego ustawienia. { $reason }

# Toast when a title's details did not load.
notice-title-load-failed = Nie udało się wczytać tego tytułu. Sprawdź połączenie i spróbuj ponownie.

# Toast when playback stops with an error.
notice-playback-failed = Odtwarzanie się nie powiodło. Wybierz inne źródło.

# Toast when something went wrong inside the engine and it carried on.
notice-engine-fault = Coś poszło nie tak w anistream. Program działa dalej, ale jeśli ekran wygląda na zawieszony, zamknij go i otwórz ponownie.

# Toast at launch when the database was damaged, so a fresh one was started. The path is where the damaged file was moved, kept for recovery. Watch history and downloads start over; what the trackers hold comes back with the next sync.
notice-database-set-aside = Baza danych była uszkodzona, więc anistream utworzył nową. Stary plik zachowano w: { $path }. Trackery przywrócą swoje dane przy następnej synchronizacji.

# Message when anistream could not start because a folder could not be made. The path is the folder, the reason comes from the system.
start-failed-folder = anistream nie mógł utworzyć folderu { $path }. Sprawdź, czy na dysku jest miejsce i czy do folderu można zapisywać, a potem spróbuj ponownie. { $reason }

# Message when anistream could not start because the config file has a setting it can't use. The path is the file; the problem names the line where it can.
start-failed-config = { $path } zawiera ustawienie, którego anistream nie może użyć: { $problem }. Popraw je lub usuń, a potem spróbuj ponownie.

# Message when anistream could not start because its database could not be opened. The path is the database file, the reason comes from the system.
start-failed-database = anistream nie mógł otworzyć bazy danych w: { $path }. Jeśli w tym folderze jest otwarta inna aplikacja anistream, zamknij ją i spróbuj ponownie. { $reason }

# Message when anistream could not start its network connection from the network settings.
start-failed-network = anistream nie mógł skonfigurować połączenia sieciowego według ustawień w config.toml. { $reason }

# Message when anistream itself could not start. The reason comes from the system or the engine.
start-failed = anistream nie mógł się uruchomić. Zamknij go i otwórz ponownie. { $reason }

# Message when the TV remote could not start listening or could not forget a phone.
start-failed-remote = Pilot nie mógł zacząć nasłuchiwania ani usunąć telefonu. { $reason }

# Message when the built-in player could not start.
start-failed-player = Odtwarzacz nie mógł się uruchomić. { $reason }

# Toast after episodes are added to the download queue.
notice-episodes-queued =
    { $count ->
        [one] Dodano do kolejki { $count } odcinek.
        [few] Dodano do kolejki { $count } odcinki.
        [many] Dodano do kolejki { $count } odcinków.
       *[other] Dodano do kolejki { $count } odcinków.
    }

# Note under the connection-check group of the torrents dialog: what the check does.
torrents-linux-check-note = anistream sprawdza, skąd wychodzi ruch torrentów, gdy torrent się uruchamia i co minutę podczas działania, a jeśli sprawdzenie się nie powiedzie, wstrzymuje torrenty. Ochronę zapewnia VPN lub proxy.

# Confirmation text when choosing "Warn only" for a failed check.
torrents-linux-warn-confirm = anistream ostrzeże zamiast wstrzymać. Jeśli VPN lub proxy nie działa, inni mogą zobaczyć adres IP.

# Status line once the protection has been checked and saved.
torrents-linux-protection-saved = Ochrona torrentów zapisana

# Title of the dialog that turns torrents on.
torrents-linux-turn-on-title = Włącz torrenty

# Title of the dialog that changes what protects torrents.
torrents-linux-protect-title = Ochrona torrentów

# Title of the dialog that edits the proxy.
torrents-linux-edit-proxy-title = Edytuj proxy

# Button that turns torrents on in the dialog.
torrents-linux-turn-on-button = Włącz

# Seeding row: time left until the goal, in a span already worded ("18h", "1d 6h").
downloads-linux-seed-left = Zostało { $span }

# Seeding row: less than an hour left until the goal.
downloads-linux-seed-left-soon = Zostało mniej niż godzina

# Storage row: free space, the disk's size and what downloads take. All three are sizes already formatted.
downloads-linux-space-free = Wolne { $free } z { $total } · pobrane zajmują { $taken }

# Placeholder of the search field. It also finds settings.
search-linux-placeholder = Szukaj tytułów i ustawień

# Tooltip of the button that clears the recent searches.
search-linux-clear-recent = Wyczyść ostatnie wyszukiwania

# Title of the state when a browse with no filters lists nothing.
search-linux-nothing-found = Nic nie znaleziono

# Title of the state when a typed search waits for Enter.
search-linux-press-enter = Naciśnij Enter, aby szukać

# Line under the Enter title: why results do not come as you type. The tracker is a name.
search-linux-paused = Wyszukiwanie podczas pisania jest na chwilę wstrzymane, aby nie przekroczyć limitów { $tracker }.

# Menu title over the sort choices of the filter row.
filter-linux-sort-by = Sortuj według

# Sort choice: what is rising now.
filter-linux-sort-trending = Popularne teraz

# Sort choice: the most recent first.
filter-linux-sort-newest = Najnowsze

# Sort choice: the earliest first.
filter-linux-sort-oldest = Najstarsze

# Sort choice: the most favourited first.
filter-linux-sort-favourites = Ulubione

# Genre filter button when several genres are set.
filter-linux-genres-count =
    { $count ->
        [one] { $count } gatunek
        [few] { $count } gatunki
        [many] { $count } gatunków
       *[other] { $count } gatunków
    }

# Format filter button when several formats are set.
filter-linux-formats-count =
    { $count ->
        [one] { $count } format
        [few] { $count } formaty
        [many] { $count } formatów
       *[other] { $count } formatów
    }

# Status filter button when several statuses are set.
filter-linux-statuses-count =
    { $count ->
        [one] { $count } status
        [few] { $count } statusy
        [many] { $count } statusów
       *[other] { $count } statusów
    }

# Chip for a genre that is left out of the results. The genre is already named.
filter-linux-not = Bez: { $genre }

# Button that takes off every filter chip.
filter-linux-clear-all = Wyczyść wszystko

# Tooltip of the arrow that scrolls the filter row back.
filter-linux-earlier = Wcześniejsze filtry

# Tooltip of the arrow that scrolls the filter row on.
filter-linux-more = Kolejne filtry

# What a screen reader says for a broadcast whose time is an estimate. The time is already formatted.
calendar-linux-about = około { $time }

# What a screen reader says for a broadcast that is the dub's.
calendar-linux-dubbed = z dubbingiem

# Title of the menu, and tooltip of its button, that orders a list.
library-linux-order = Kolejność

# A list's tab: its name and how many titles it holds.
library-linux-list-count = { $list } { $count }

# Description read by a screen reader on the button that plays the shown episode on a TV.
title-linux-play-on-tv-help = Odtwórz ten odcinek w telewizorze z anistream

# Description read by a screen reader on an episode's watched check box.
title-linux-episode-watched = Odcinek { $episode } obejrzany

# Line in a day's column when nothing airs that day.
calendar-linux-day-empty = Nic nie jest emitowane

# Accessible label of the line that says how the watch party form is getting on.
party-status = Stan: Wspólne oglądanie

# Accessible label of the list of people in the watch party, in the player's panel.
party-members = Uczestnicy

# Title of the dialog that lists the sources that have the watch party's episode.
party-choose-a-source = Wybierz źródło

# Line when no source lists the watch party's episode. A plugin store adds plugins, which add sources.
party-sources-none-listed = Żadne źródło nie ma odcinka { $episode }. Źródła dodają wtyczki, które sklep z wtyczkami dostarcza.

# Line above the list of sources that have the watch party's episode.
party-sources-found-line =
    { $count ->
        [one] Jedno źródło ma go. Wybrane odtwarza się: wspólne oglądanie.
        [few] { $count } źródła mają go. Wybrane odtwarza się: wspólne oglądanie.
        [many] { $count } źródeł ma go. Wybrane odtwarza się: wspólne oglądanie.
       *[other] { $count } źródła mają go. Wybrane odtwarza się: wspólne oglądanie.
    }

# Notice when the player could not start, or could not be reached to add a track.
player-could-not-start = Odtwarzacz nie wystartował. Spróbuj ponownie albo wybierz inne źródło.

# Notice when the file chosen for a subtitle or audio track has no path the app can read.
player-file-unreadable = Nie udało się odczytać tego pliku. Wybierz inny.

# The reason the system gives for keeping the screen awake and the computer from sleeping while an episode plays. Other apps and the desktop may show it.
player-inhibit-reason = Odtwarzanie odcinka

# Accessible description of the time left in the episode, beside the countdown.
player-time-left = Zostało { $time }

# Line on the starting screen after a note from the engine, with the seconds waited.
player-note-waited = { $note } · { $seconds } s

# Starting screen's line before the episode is known.
player-starting-plain = Uruchamianie

# Tooltip of the Undo button on the card that says an opening was skipped. The letter is the key that does the same.
