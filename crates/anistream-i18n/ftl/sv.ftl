# Shortcut: quit the app.
shortcuts-quit = Avsluta

# Shortcut: play the title that has focus in a list.
shortcuts-play-selected = Spela upp den valda titeln

# Shortcut: small steps in the player.
shortcuts-seek-5 = Bakåt eller framåt 5 sekunder

# Shortcut: larger steps in the player.
shortcuts-seek-30 = Bakåt eller framåt 30 sekunder

# Shortcut: steps of ten seconds in the player.
shortcuts-seek-10 = Bakåt eller framåt 10 sekunder

# Shortcut: change the volume.
shortcuts-volume = Höj eller sänk volymen

# Shortcut: skip the opening or the ending.
shortcuts-skip = Hoppa över öppningen eller slutet

# Shortcut: undo a skip the player made by itself.
shortcuts-undo-skip = Ångra ett automatiskt hopp

# Shortcut: change the playback speed.
shortcuts-speed = Snabbare eller långsammare

# Shortcut: answer the card that shows in the corner of the player.
shortcuts-answer-card = Svara på kortet i hörnet

# Shortcut: Escape closes the topmost thing in the player, one step at a time.
shortcuts-escape = Stäng kort, minispelaren, helskärmen och sedan spelaren

# Response of the close question: stop what runs and close.
close-stop-and-close = Stoppa och stäng

# Body of the close question when episodes download.
close-body-downloading =
    { $count ->
        [one] Ett avsnitt laddas ner eller väntar. Ska det fortsätta när fönstret stängs, eller stoppas?
       *[other] { $count } avsnitt laddas ner eller väntar. Ska de fortsätta när fönstret stängs, eller stoppas?
    }

# Body of the close question when episodes seed.
close-body-seeding =
    { $count ->
        [one] Ett avsnitt seedas. Ska det fortsätta när fönstret stängs, eller stoppas?
       *[other] { $count } avsnitt seedas. Ska de fortsätta när fönstret stängs, eller stoppas?
    }

# Body of the close question when some episodes download and others seed.
close-body-both = Avsnitt: { $downloading } laddas ner eller väntar och { $seeding } seedas. Ska de fortsätta när fönstret stängs, eller stoppas?

# Status in the sidebar and on the remote: the TV was not found again.
tv-status-not-found = { $name } hittades inte

# Title of the dialog that wants a code to be typed: no name known yet.
tv-connecting-title = Ansluter till tv:n

# Heading of a problem when the pairing code ran out.
tv-code-expired = Koden har gått ut

# Under a TV in the list: what choosing it does, for a screen reader.
tv-row-pairs-with = Parkopplar med den här tv:n

# Under a TV in the list: paired, but not seen on the network.
tv-row-away = Parkopplad, inte sedd på det här nätverket

# Under a TV in the list: found, not paired yet.
tv-row-new = Inte parkopplad än

# What a screen reader hears when a heading and its problem show together.
tv-problem-announce = { $heading }. { $problem }

# What a screen reader hears when no TV was found, then what to check.
tv-none-found-announce = Ingen tv hittades. { $detail }

# Line on the picker while the episode to play is known: the show, then the episode.
tv-title-episode = { $title }, avsnitt { $episode }

# Line under the show on the remote and the picker: which episode.
tv-episode = Avsnitt { $episode }

# Line on the remote under the show: the episode, then its title.
tv-episode-titled = Avsnitt { $episode } · { $title }

# Explains the code a TV lists this computer by, above the paired TVs in the settings.
tv-fingerprint-note = En tv listar den här enheten med koden { $code }. Om du glömmer en tv här glöms även den här enheten.

# Settings line of a paired TV: paired on a date, reached in the last minute.
tv-paired-seen-now = { $paired } · sedd just nu

# Accessible name of a track menu: the row, then the track chosen.
tv-track-choice = { $row }, { $track }

# The name this computer goes by in lists of a person's devices, such as a plugin store's.
shell-device-label = Linux-dator

# Count of devices on a member's row in the members dialog, and after "Owner ·".
stores-device-count =
    { $count ->
        [one] { $count } enhet
       *[other] { $count } enheter
    }

# Accessible name of an owner's dialog: what the dialog does, then the plugin store it is for.
stores-dialog-title = { $title }, { $store }

# Title of the status page in an owner's dialog when the plugin store could not be reached. The reason is not shown here.
stores-owner-unreachable = Det gick inte att nå tilläggsbutik

# Title of the status page in an owner's dialog when the plugin store did not answer in time.
stores-owner-no-answer = tilläggsbutik svarade inte

# Line under it.
stores-owner-no-answer-detail = Den kanske är upptagen, eller så är datorn den körs på avstängd.

# Title of the status page in an owner's dialog when this device is offline.
stores-owner-needs-connection = tilläggsbutik behöver en anslutning

# Line under it.
stores-owner-needs-connection-detail = Försök igen när den här enheten är online igen.

# Red line in the invite dialog when this device is offline and a link cannot be made.
stores-owner-link-offline = För att skapa en länk behövs en anslutning till tilläggsbutik.

# Line over a new invite link made for a named person. The time is the one the link stops working.
stores-send-link-until = Skicka länken. Den fungerar en gång, till { $until }.

# Row title in who-can-join: switching on lets anyone with the link join. Shown while it is on.
stores-open-on-detail = De går med utan namn. Stänger du av det upphör länken. Slår du på det igen skapas en ny.

# Row subtitle in who-can-join while it is off.
stores-open-off-detail = Bara personer du bjuder in kan gå med. När det är på kan vem som helst med länken gå med, utan namn.

# Line on the summary row of devices that joined with the link, when joining is on.
stores-open-no-names = Inga namn sparas.

# Line on the summary row of devices that joined with the link, when joining is off.
stores-open-keep-working = De fortsätter fungera tills du tar bort dem.

# Line under a device that joined with the link: when the store last saw it.
stores-device-seen = Sedd { $when }

# Line under a device that joined with the link and has not been seen since.
stores-device-never-seen = Inte sedd sedan anslutningen

# Short title of the publish dialog, over the plugin store's name.
stores-publish-short = Publicera ett tillägg

# Line in the publish dialog when this device has no plugin to offer. Follows stores-publish-none.
stores-publish-none-hint = Ett tillägg du bygger eller installerar visas här.

# Line under a plugin in the publish dialog that the store does not have yet.
stores-not-published = Inte i tilläggsbutik än

# Line under a plugin in the publish dialog that the store has in another version.
stores-store-offers = tilläggsbutik har { $version }

# Line under a plugin in the publish dialog whose version the store already has.
stores-published-current = Uppdaterad i tilläggsbutik

# Word at the end of that row.
stores-published-state = Publicerad

# Accessible name of a row's Publish button.
stores-publish-label = Publicera { $name } { $version }

# Under a release in the source picker: how many people share it right now.
source-picker-seeders-linux =
    { $count ->
        [one] En seeder
       *[other] { $count } seeders
    }

# Tooltip on the header bar button that shows the sidebar while the window is narrow.
sidebar-show = Visa sidofältet

# Faint line over Continue's placeholders while it loads.
activity-continue = Läser in det du tittar på

# Faint line over the calendar's placeholders while it loads.
activity-calendar = Läser in kalendern

# Faint line over a title page's episode placeholders while they load.
activity-episodes = Läser in avsnitt

# Faint line over the Sources page while the sources are checked.
activity-sources = Kontrollerar källor

# Faint line over the Downloads page while it loads.
activity-downloads = Läser in hämtningar

# Faint line over Search's placeholders while it lists titles with no query typed.
activity-browse = Läser in titlar

# A transfer rate: a size already worded, per second.
size-per-second = { $size }/s

# A wait that is over.
time-now = Nu

# How long ago, when it was inside the last minute.
time-just-now = Just nu

# A length of time said for a screen reader, in hours.
spoken-hours =
    { $count ->
        [one] { $count } timme
       *[other] { $count } timmar
    }

# A length of time said for a screen reader, in minutes.
spoken-minutes =
    { $count ->
        [one] { $count } minut
       *[other] { $count } minuter
    }

# A length of time said for a screen reader, in seconds.
spoken-seconds =
    { $count ->
        [one] { $count } sekund
       *[other] { $count } sekunder
    }

# Continue row: nothing new to watch, and the next episode airs at a known time. The time is already worded: "in 2d 3h".
continue-row-caught-up-airs = Du är ikapp · avsnitt { $episode } sänds { $when }

# Continue row: nothing new to watch, and the next episode has no date.
continue-row-caught-up-not-out = Ikapp · E{ $episode } har inte släppts än

# Name of a language, in a list of subtitle languages.
language-name-english = Engelska

# Name of a language, in a list of subtitle languages.
language-name-japanese = Japanska

# Name of a language, in a list of subtitle languages.
language-name-spanish = Spanska

# Name of a language, in a list of subtitle languages.
language-name-portuguese = Portugisiska

# Name of a language, in a list of subtitle languages.
language-name-french = Franska

# Name of a language, in a list of subtitle languages.
language-name-german = Tyska

# Name of a language, in a list of subtitle languages.
language-name-italian = Italienska

# Name of a language, in a list of subtitle languages.
language-name-russian = Ryska

# Name of a language, in a list of subtitle languages.
language-name-arabic = Arabiska

# Name of a language, in a list of subtitle languages.
language-name-indonesian = Indonesiska

# Name of a language, in a list of subtitle languages.
language-name-korean = Koreanska

# Name of a language, in a list of subtitle languages.
language-name-chinese = Kinesiska

# Seasonal's format toggle: every format.
seasonal-format-all = Alla

# Seasonal's format toggle: ONA, OVA and specials together.
seasonal-format-ona-ova = ONA och OVA

# Accessible name of a title's banner, which opens its page.
title-open-named = Öppna { $title }

# Accessible name of a card or row in Continue: the title, then what is said under it.
continue-row-spoken = { $title }, { $detail }

# Accessible name of the pane beside Continue's queue that previews the selected title.
continue-preview = Förhandsvisning

# Under a suggestion that airs later today when no episode number is known: the time it airs.
up-next-airs-at = Sänds kl. { $time }

# Header title on a terminal too narrow for the rail: the product name, then the section on screen.
chrome-header-section = anistream · { $section }

# Header chip while the metadata sources are degraded. The mark is a status glyph. Shown beside the { -source } chips, which are short.
chrome-meta-chip = Metadata { $mark }

# Activity row: how many more running jobs there are than fit. It follows the last job shown.
chrome-activity-more = +{ $count }

# Activity row: a running job that is held up (a rate-limit pause), with the wait counting down. The note says what it waits on; the countdown is a clock such as 0:12.
chrome-job-held = { $note }, { $countdown }

# Heading of an overlay that lists the lines of a long table: which lines are in view.
overlays-window-position = { $from }–{ $to } av { $total }

# Heading of the help overlay when its table does not fit on one page.
overlays-help-page = Sida { $page } av { $pages }

# The log overlay, when nothing has been logged this session.
overlays-logs-empty = Inget loggat ännu

# Prompt hint under the manual search heading. The footer names its keys.
overlays-hint-manual-query = Skriv vad du vill söka efter, eller lämna tomt för automatisk matchning.

# Prompt hint for the first step of signing in to Kitsu.
overlays-hint-kitsu-username = E-post eller användarnamn.

# Prompt hint for the second step of signing in to Kitsu. The password is shown as dots.
overlays-hint-kitsu-password = Ditt lösenord byts mot en token och sparas inte.

# Prompt hint for the download range. The examples are episode numbers and stay as written.
overlays-hint-download-range = 4 för ett avsnitt, 1-12 för ett intervall, 7- för allt därifrån.

# Prompt hint for editing a setting: its label on the Settings screen. The footer names the keys.
overlays-hint-edit-setting = Skriv ett nytt värde för { $setting }.

# Prompt hint for joining a { -plugin-store }.
overlays-hint-join-store = Klistra in inbjudan eller länken till butik som du fick.

# Prompt hint for naming the person an invite link is for.
overlays-hint-invite-name = Namnet, så som medlemslistan visar det.

# Overlay heading after the title: the plugin's version and the { -plugin-store } it comes from. The plugin's name leads the heading.
overlays-heading-plugin = { $name }   { $version }  ·  från { $store }

# Overlay heading, after the title "Invite link": whom the link is for.
overlays-heading-invite-for = För { $name }

# Title of the invite link overlay when the link is not for a named person.
overlays-title-link-device = Länka en annan enhet

# Overlay heading, after the title of the store's link: which { -plugin-store } it opens.
overlays-heading-open-link-of = { $store }

# Overlay heading, after the title of the publish list: where the plugin goes.
overlays-heading-publish-to = Till { $store }

# Overlay heading, after the title "Which one": the title being matched.
overlays-heading-disambiguate = Matchning för { $name }

# Overlay heading, after the title "Watch order": the title the order is built around.
overlays-heading-watch-order = Kring { $name }

# Overlay heading, after the title "Recommended": the title the list came from.
overlays-heading-recommendations = För att du gillade { $name }

# Overlay heading, after the title of the release list.
overlays-heading-release = De andra källor fyller i det som saknas.

# Overlay heading, after the title of the { -source } list: the choice is kept for this title.
overlays-heading-source = { $name }

# Overlay heading, after the title of the releases list: the episode it is for.
overlays-heading-releases = Avsnitt { $episode }. Enter spelar ditt val.

# Same, when no episode is known.
overlays-heading-releases-bare = Enter spelar ditt val.

# Toast: a download that is finished cannot be cancelled, only deleted. The key is the delete key.
toast-download-done = Redan nedladdat. Tryck { $delete } för att ta bort det och dess fil.

# Toast: a command needs a title and none is selected.
toast-nothing-selected = Inget är valt. Välj en titel först.

# Toast: the download-range key was pressed away from the episode table.
toast-ranges-elsewhere = Intervall köas från avsnittstabellen.

# Toast: the filter key was pressed on a screen without filters.
toast-filters-elsewhere = Filter finns i sökningen och avsnittstabellen.

# Toast: a watched-mark key was pressed away from the episode table.
toast-watched-elsewhere = Markeringar för sedda finns i avsnittstabellen.

# Toast: Back was pressed at the top of a section. The key is the quit key.
toast-at-top = Du är överst. Tryck { $quit } för att avsluta.

# Toast: an action was run that does nothing on this screen. The action is its label, such as "Mark all previous watched"; the place says where it works, such as "in the episode table".
toast-works-elsewhere = { $action } fungerar { $place }.

# Toast: the bug report is being opened.
toast-bug-report-opening = Öppnar en felrapport i webbläsaren. Länken finns i loggen.

# Log line holding the whole bug report link, for a terminal that cannot open it.
tui-log-bug-report-link = Felrapport: { $url }

# Toast: a key binding in the config file was refused. The problem says which and why.
toast-keybinding-not-applied = Tangentbindningen tillämpades inte: { $problem }. Kontrollera tangentavsnittet i konfigurationsfilen.

# Standing notice: the config file did not load. The problem is the parser's own text.
tui-config-problem = { $file }: { $what }. Standardinställningarna används tills det är åtgärdat.

# Same, when the problem is on a known line.
tui-config-problem-at-line = { $file } rad { $line }: { $what }. Standardinställningarna används tills det är åtgärdat.

# Log line for the same problem. The path is the whole path of the config file.
tui-config-problem-logged = { $path }: { $problem }. Standardinställningarna används.

# The status line at the foot of the screen when nothing is being said: the source in use, the audio and the quality.
chrome-status-state = { $source } · { $audio } · { $quality }p

# Heading of the title page when no title is highlighted.
title-heading = Titel

# Under the heading of the title page and the episode table when no title is highlighted.
title-nothing-selected-note = Inget valt

# Toast when a title action is asked for and no title is highlighted.
title-nothing-selected = Inget är valt. Markera en titel och försök igen.

# Toast when something that needs a title's full page is asked from a list.
title-trailer-off-page = Öppna titelsidan för att hitta trailern.

# Toast when something that needs a title's full page is asked from a list.
title-recommendations-off-page = Öppna titelsidan för att se rekommendationerna.

# Toast when something that needs a title's full page is asked from a list.
title-seasons-off-page = Öppna titelsidan för att se de kopplade säsongerna.

# Toast when a title has no trailer on record.
title-no-trailer = Ingen trailer finns registrerad för den här titeln.

# Toast when a title has no recommendations.
title-no-recommendations = Inga rekommendationer finns för den här titeln.

# Toast when a title has no connected seasons.
title-no-seasons = Inga kopplade säsonger finns för den här titeln.

# Toast when the { -source } picker is asked for from a list.
title-pin-off-page = Öppna titelsidan för att välja en källa för den.

# Toast when the { -source } picker is asked for and no { -source } is registered. They register a moment after launch.
title-no-sources-yet = Inga källor är registrerade än. Försök igen om en stund.

# Toast when a list status or rating is asked for and no { -tracker } is signed in. The command is typed as it is.
title-status-needs-tracker = Din liststatus sparas hos en tracker, och ingen är inloggad. Använd :accounts för att logga in på en.

# Toast when a rating is asked for and no { -tracker } is signed in. The command is typed as it is.
title-rating-needs-tracker = Betyg sparas hos en tracker, och ingen är inloggad. Använd :accounts för att logga in på en.

# Toast after a list status is picked. The status is one of the status names; the trackers are a comma separated list.
title-status-set = Status ändrad till { $status }. Köad för { $trackers }.

# Toast after a rating is picked.
title-rated = Betyg { $score }/10. Köad för { $trackers }.

# List status in the status picker and in the toast after picking one.
title-status-watching = Tittar

# List status in the status picker and in the toast after picking one.
title-status-planning = Planerar

# List status in the status picker and in the toast after picking one.
title-status-completed = Klar

# List status in the status picker and in the toast after picking one.
title-status-paused = Pausad

# List status in the status picker and in the toast after picking one.
title-status-dropped = Avbruten

# Beside the Completed status in the status picker, when the title has progress: what choosing it does.
title-status-completed-hint = Sätter framsteget till sista avsnittet

# A rating in the rating picker, beside the number 10.
title-rating-10 = Mästerverk

# A rating in the rating picker, beside the number 9.
title-rating-9 = Utmärkt

# A rating in the rating picker, beside the number 8.
title-rating-8 = Mycket bra

# A rating in the rating picker, beside the number 7.
title-rating-7 = Bra

# A rating in the rating picker, beside the number 6.
title-rating-6 = Godkänd

# A rating in the rating picker, beside the number 5.
title-rating-5 = Medel

# A rating in the rating picker, beside the number 4.
title-rating-4 = Svag

# A rating in the rating picker, beside the number 3.
title-rating-3 = Dålig

# A rating in the rating picker, beside the number 2.
title-rating-2 = Usel

# A rating in the rating picker, beside the number 1.
title-rating-1 = Förfärlig

# Place of a title in the watch order: the nth season of its franchise. Sits in a narrow column.
title-season = Säsong { $number }

# Place of a title in the watch order: it comes before this one.
title-relation-prequel = Föregångare

# Place of a title in the watch order: it is the story this one comes from.
title-relation-parent = Ursprung

# Place of a title in the watch order: it comes after this one.
title-relation-sequel = Uppföljare

# First choice in the { -source } picker: let anistream pick.
title-source-automatic = Automatiskt (bästa tillgängliga källa)

# Beside a { -source } in the picker when it is failing and so not used.
title-source-failing = Fungerar inte

# First choice in the { -release } picker: the { -source } decides.
title-release-first = Den utgåva som källa rankar först

# Beside a { -release } in the picker: how many people share it.
title-release-seeders =
    { $count ->
        [one] { $count } seedare
       *[other] { $count } seedare
    }

# The services a title is available on, under its metadata. The list is already joined.
title-available-on = Finns på { $services }

# Beside the progress meter on the title page: the episode that follows what has been watched.
title-up-next = Nästa: avsnitt { $next }

# Beside the progress meter when the watched count is against the episodes that have aired so far.
title-progress-aired = { $done } av { $aired } har sänts

# Beside the progress meter when there is nothing to count against.
title-progress-watched = { $done } sedda

# Heading of the episode table when the title is not known.
episodes-heading = Avsnitt

# Column heading over the episode titles.
episodes-column-title = Titel

# Column heading over the running time of each episode.
episodes-column-run = Längd

# Column heading over how much of each episode is watched.
episodes-column-watched = Sett

# Beside a finished episode, in the last column.
episodes-done = Klar

# In the last column for an episode that is not out yet. The span is short, such as 2d 3h.
episodes-airs-in = Om { $span }

# Episode kind in the last column: the story episodes.
episodes-kind-canon = Kanon

# Episode kind in the last column: part story, part filler.
episodes-kind-mixed = Blandat

# Episode kind in the last column: filler, which can be skipped.
episodes-kind-filler = Fyllnad

# Episode kind in the last column: made for the anime and not in the book it comes from.
episodes-kind-anime-canon = Animekanon

# The episode filter shown when nothing is filtered, and named at the top right of the table.
episodes-filter-all = Alla avsnitt

# The episode filter that hides the episodes already watched.
episodes-filter-unwatched = Osedda

# The episode filter that hides filler.
episodes-filter-no-filler = Utan fyllnad

# Toast after the filter changes.
episodes-showing-all = Visar alla avsnitt.

# Toast after the filter changes.
episodes-showing-unwatched = Visar osedda avsnitt.

# Toast after the filter changes.
episodes-showing-no-filler = Visar avsnitt utan fyllnad.

# Top right of the episode table: how far the dub goes, for a dub that stops short of what has aired.
episodes-dub-through = Dubbat till avsnitt { $through }

# Top right of the episode table: the dub has every episode.
episodes-dub-complete = Dubbat

# Heading of the empty episode table when the filter hides every episode.
episodes-empty-filtered = Inget matchar filtret

# Under the heading when the filter hides every episode. The key is the filter key.
episodes-empty-filtered-hint = Filtret döljer alla avsnitt. Tryck { $key } för att ändra det.

# Heading of the empty episode table when no { -source } is ready.
episodes-empty-no-source = Inga avsnitt än

# Under the heading when no { -source } is ready. The key opens the { -source-pl } screen.
episodes-empty-no-source-hint = AniList listar inga avsnitt för den här titeln än, och ingen källa är klar. Tryck { $key } för att öppna skärmen för Källor.

# Heading of the empty episode table when the title has not aired yet.
episodes-empty-unaired = Inget har sänts än

# Under the heading when the title has not aired yet. The span is short, such as 2d 3h.
episodes-empty-unaired-hint = Avsnitt { $episode } sänds om { $span }.

# Heading of the empty episode table when a { -source } matched the title and listed nothing.
episodes-empty-none-listed = Inga avsnitt listade

# Under the heading when a { -source } listed no episodes. The keys search by hand and pick another { -source }.
episodes-empty-none-listed-hint = källan listade inga avsnitt för den här titeln. Tryck { $search } för att söka efter rätt matchning, eller { $pick } för att välja en annan källa.

# Toast when an episode has no { -release } to pick from.
episodes-no-releases = Det finns inga utgåvor att välja mellan för det här avsnittet.

# Toast when a download is asked for from a table listed from AniList alone. The key opens the { -source-pl } screen.
episodes-add-source-to-download = Lägg till en källa innan du laddar ner. Tryck { $key } för att öppna skärmen för Källor.

# Toast when marking the episodes before the highlighted one and the table is empty.
episodes-mark-none-listed = Inga avsnitt är listade att markera.

# Toast when marking the episodes before the first one.
