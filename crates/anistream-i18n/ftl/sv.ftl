# Tooltip on the button that steps a setting to its previous value.
settings-previous-value = Föregående värde

# Tooltip on the button that steps a setting to its next value.
settings-next-value = Nästa värde

# Line after the legal line under the sources settings: where sources come from.
settings-sources-come-from = Källor kommer från de tilläggsbutiker du går med i.

# Label on the left half of the upscaling preview: the video before processing.
settings-preview-source = 480p källa

# Preview note under the upscaling frame when upscaling is off.
settings-upscaling-note-off = 480p-källan, skalad för att passa utan bearbetning.

# A line of sample subtitle over the preview frame. Any short sentence will do.
settings-caption-sample = Vägen vid lyktan fortsätter förbi den sista byn.

# Preview note under the subtitle frame. The language is a language name.
settings-caption-note = Vanlig textning ser ut så här, på { $language } när ett avsnitt har den. Formaterad textning behåller sitt eget utseende.

# Preview note for new-episode notifications when they are on. The tracker is a name such as AniList.
settings-notify-note-on = En avisering när ett avsnitt av en serie på din lista över det du tittar på släpps, vid den tid { $tracker } anger. Seriens egen inställning går först.

# Preview note for new-episode notifications when they are off.
settings-notify-note-off = Av. Bara serier som är påslagna i sina egna inställningar aviserar.

# Heading of the preview note beside the sources settings while torrents are on.
settings-connection-check-title = Anslutningskontroll

# Preview note beside the sources settings while torrents are on.
settings-connection-check-note = anistream kontrollerar var torrenttrafiken lämnar när en torrent startar och varje minut medan den körs, och pausar torrents om kontrollen misslyckas. Det är din VPN eller proxy som skyddar dig.

# Preview note beside the accounts settings.
