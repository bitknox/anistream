# Toast as above, with the reason the range stopped. `existing` is the sentence of `cause-already-in-downloads`; `reason` is a sentence saying why the range stopped.
notice-downloads-none-new-stopped = Inget nytt lades i kön. { $existing } { $reason }

# Toast after a range was asked for, some episodes were queued and some were there already. `existing` is the sentence of `cause-already-in-downloads`.
notice-episodes-queued-existing =
    { $count ->
        [one] Ett avsnitt lades i kön. { $existing }
       *[other] { $count } avsnitt lades i kön. { $existing }
    }

# Toast as above, with the reason the range stopped.
notice-episodes-queued-stopped =
    { $count ->
        [one] Ett avsnitt lades i kön, sedan stoppade det. { $reason }
       *[other] { $count } avsnitt lades i kön, sedan stoppade det. { $reason }
    }

# Toast as above, with some episodes in the queue already and the reason the range stopped. `existing` is the sentence of `cause-already-in-downloads`; `reason` is a sentence saying why the range stopped.
notice-episodes-queued-existing-stopped =
    { $count ->
        [one] Ett avsnitt lades i kön, sedan stoppade det. { $existing } { $reason }
       *[other] { $count } avsnitt lades i kön, sedan stoppade det. { $existing } { $reason }
    }

# Toast when keep next found no room for another episode.
notice-keep-next-full = Inte tillräckligt med ledigt utrymme för att hålla kommande avsnitt nedladdade. Frigör lite utrymme för att ladda ner fler.

# Message when a watch party was asked for with no server chosen. The names are a suggested server and who runs it. Terminal only: the engine never sends it to the apps.
party-needs-server = Välj först en server för watch party, som syncplay.server. { $server } drivs av { $operator }.

# Message when an app asked for a watch party with no server chosen. The names are a suggested server and who runs it.
party-choose-server = Välj först en server för watch party. { $server } drivs av { $operator }.

# Toast when a watch party is asked for in a build without watch parties.
notice-no-party = Watch partyn finns inte i den här versionen av anistream.

# Message when a watch party was asked for with no room named.
party-needs-room = En watch party behöver ett rum att träffas i. Välj ett först.

# Message in a watch party when its server connection dropped and is retried.
party-server-lost = Servern för watch party tappades. Försöker igen.

# Message in a watch party when the connection came back.
party-rejoined = Tillbaka i watch party.

# Message when the person left a watch party.
party-left = Lämnade watch party.

# Toast after joining a plugin store with an invite that names this device's owner.
store-joined = Gick med i { $store } som { $member }.

# Toast after joining a plugin store with its open link, which keeps no name.
store-joined-unnamed = Gick med i { $store } utan namn.

# Toast after leaving a plugin store.
store-left = Lämnade { $store }. Dess tillägg finns kvar installerade.

# Toast after a plugin is deleted from this device.
plugin-removed = Tog bort { $plugin }.

# Toast after a store owner removes a member.
store-member-removed = Togs bort. Deras enheter slutade fungera med den här tilläggsbutiken.

# Toast after a store owner cancels an invite.
store-invite-cancelled = Inbjudan avbröts. Länken fungerar inte längre.

# Toast after a store owner lets anyone with the store's link join.
store-open-join-on = Vem som helst med länken till tilläggsbutik kan gå med nu. Kopiera den från medlemssidan.

# Toast after a store owner turns off joining with the link, when no device joined that way.
store-open-join-off = Bara personer du bjuder in kan gå med nu.

# Toast after a store owner turns off joining with the link, when some devices joined that way.
store-open-join-off-devices =
    { $devices ->
        [one] Bara personer du bjuder in kan gå med nu. Den enhet som gick med via länken fortsätter fungera tills du tar bort den.
       *[other] Bara personer du bjuder in kan gå med nu. De { $devices } enheter som gick med via länken fortsätter fungera tills du tar bort dem.
    }

# Toast after one device that joined with the store's link is removed.
store-device-removed = Den enhet fungerar inte längre med den här tilläggsbutiken.

# Toast after every device that joined with the store's link is removed.
store-devices-removed = Tog bort alla enheter som gick med via länken.

# Toast after a plugin is published to a store.
plugin-published = Publicerade { $plugin } { $version }.

# Toast after a plugin stops being offered in a store.
plugin-unpublished = { $plugin } erbjuds inte längre.

# Toast after the store's admin page opens in the browser.
store-admin-opened = Öppnade administrationssidan i webbläsaren. Länken fungerar en gång, i 10 minuter.

# Toast when the browser could not be opened for the store's admin page. The reason comes from the system. The command is typed as it is run.
store-admin-open-failed = Det gick inte att öppna en webbläsare ({ $reason }). På datorn där tilläggsbutik körs kör du "anistream store admin" för att skriva ut en länk.

# Toast after a plugin is installed while plugins are switched off in the source order.
plugin-installed-unused = Installerade { $plugin } { $version }, men tillägg är avstängda i ordningen för källor, så det används inte.

# Toast after a plugin is installed under the name of a built-in source, so it was not loaded.
plugin-installed-name-clash = Installerade { $plugin }, men { $id } är namnet på en inbyggd källa, så det laddades inte.

# Toast after a plugin is installed and ready to use.
plugin-installed = Installerade { $plugin } { $version }, redo att använda.

# Toast after a plugin is installed but could not be loaded. The reason comes from the plugin host.
plugin-installed-not-loaded = Installerade { $plugin }, men det gick inte att läsa in. { $reason }

# Toast at launch when joined plugin stores offer newer versions of installed plugins.
plugin-updates-ready =
    { $count ->
        [one] Uppdatering klar för tillägg: { $names }.
       *[other] Uppdateringar klara för tillägg: { $names }.
    }

# Note on the sources screen when the plugins could not be loaded. The reason comes from the plugin host.
plugins-load-failed = Det gick inte att läsa in tillägg. { $reason }

# Error: the store was joined once, but this device has no saved token for it.
store-token-missing = Det finns ingen token för { $store } på den här enheten. Gå med igen med en ny inbjudan.

# Error: the store the record points to is gone from the saved list.
store-not-joined = Du är inte längre ansluten till den tilläggsbutik.

# Error: a store's signing key is unreadable. Shown as the reason a store is offline.
store-key-damaged = Nyckeln för den här tilläggsbutiken på den här enheten är skadad. Lämna tilläggsbutik och gå med igen med en ny inbjudan.

# Error: a store rejected this device's token.
store-device-refused = { $store } godtar inte längre den här enheten. Gå med igen med en ny inbjudan.

# Error: a store could not be reached. The reason comes from the network.
store-unreachable = Det gick inte att nå { $store }. { $reason }

# Error: an invite link names a store this device already joined, but at another address.
store-moved = { $store } är ansluten på { $current }, men länken pekar på { $target }. Om tilläggsbutik har flyttats lämnar du den först och går med igen.

# Error: an open link would replace the named membership this device already has.
store-join-would-unname = Du gick med i { $store } som { $member }. Den här länken skulle gå med igen utan ditt namn, så ingenting ändrades.

# Error: the server at a link's address could not prove it is the store the invite named.
store-not-the-invited = { $url } är inte den tilläggsbutik som finns i inbjudan ({ $reason }). Ingen anslutning gjordes.

# Error: the token for a joined store could not be saved on this device. The reason comes from the system.
store-token-not-kept = Det gick inte att spara token för den här tilläggsbutiken. { $reason }

# Error: an invite that cannot be used any more.
store-invite-unusable = Inbjudan har redan använts, avbrutits eller gått ut. Be om en ny.

# Error: an open link that no longer lets anyone join.
store-open-link-unusable = Den här länken släpper inte in någon längre. Be ägaren av tilläggsbutik om en ny länk eller en inbjudan.

# Error: a plugin takes the name of a built-in source.
plugin-reserved-name = { $plugin } är namnet på en inbyggd källa, så det kan inte vara ett tillägg.

# Error: a store stopped offering a plugin between listing it and installing it.
store-plugin-withdrawn = { $store } erbjuder inte längre { $plugin }.

# Error: a store changed a plugin after the person agreed to what was shown.
store-plugin-changed = { $store } ändrade { $plugin } efter att det visades. Titta på det igen innan du installerar.

# Error: a plugin installed from one store is offered by another.
plugin-from-other-store = { $plugin } är installerad från { $store }, som håller den uppdaterad.

# Error: a plugin file added by hand already declares the same name.
plugin-duplicate-file = { $path } deklarerar redan { $plugin }. Ta bort den filen först, annars körs två kopior.

# Error: a plugin could not be downloaded or installed. The reason comes from the store or the system.
plugin-install-failed = Det gick inte att installera { $plugin }. { $reason }

# Error: a plugin could not be published. The reason comes from the store or the system.
plugin-publish-failed = Det gick inte att publicera { $plugin }. { $reason }

# Error: a plugin to publish is no longer in the plugin folder.
plugin-missing-locally = { $plugin } finns inte längre i tilläggmappen.

# Error: an invite for another device cannot be made from a device that joined with the open link.
store-invite-needs-link = Den här enheten gick med i { $store } via länken. Klistra in samma länk på den andra enheten.

# Error: the store sent an invite link that does not parse. The reason comes from the link parser.
store-link-malformed = Länken från tilläggsbutik fungerar inte. Be ägaren kontrollera den. { $reason }

# Error: the store sent a link carrying another store's key.
store-link-wrong-key = Länken från tilläggsbutik bär en annan nyckel. Kontrollera adressen den startades med.

# Error: the store's server has no admin page.
store-admin-missing = { $store } har ingen administrationssida. Dess server kan vara äldre.

# Error: the store sent an admin link that points somewhere else.
store-admin-link-foreign = { $store } skickade en administrationslänk för en annan adress.

# Error: the store's server is too old for joining with a link.
store-open-join-unsupported = Servern för { $store } är äldre och kan inte släppa in någon med en länk. Uppdatera den först.

# Toast after a source (plugin) is switched off. It is skipped when looking for episodes.
source-switched-off = { $name } är av. Den hoppas över när avsnitt söks.

# Toast after a source (plugin) is switched on.
source-switched-on = { $name } är på.

# Error: a command named a plugin that is not loaded.
plugin-not-loaded = { $id } är inte inläst. Kontrollera att den är installerad under Källor.

# Toast after a release is chosen for a title. The name is the release's title.
release-pinned = { $name } används för den här titeln.

# Toast when the chosen source or release for a title could not be saved. The reason comes from the database.
notice-choice-not-saved = Det gick inte att spara valet. { $reason }

# Toast while torrents are running but the connection check failed, and the settings say to warn only.
torrent-check-failed-running = Anslutningskontrollen misslyckades. Torrenterna fortsätter att köra.

# Note on the sources screen: torrents are waiting for the VPN guard. The reason comes from the guard.
torrent-vpn-waiting = Torrenterna startar när VPN-skyddet godkänns. { $reason }

# Note on the sources screen: the VPN guard has no verdict yet.
torrent-vpn-unverified = Torrenterna startar när VPN-skyddet godkänns. Anslutningen har inte verifierats än.

# Error: torrents are on, but no torrent index is set.
torrent-no-index = Torrenter kräver ett torrentindex. anistream levererar inget, så lägg till din egen adress i inställningarna.

# Error: the torrent session did not start because the interface closed first.
torrent-interface-closed = anistream stängdes innan torrenterna startade.

# Error: the torrent session could not start. The reason comes from the torrent engine.
torrent-session-failed = Det gick inte att starta torrentsessionen. { $reason }

# Toast when torrents are up but no operating-system firewall rule backs the VPN guard. Terminal only: the engine never sends it to the apps.
torrent-no-kill-switch = Ingenting på den här enheten stoppar torrenttrafiken om VPN:en tappas. Kör "anistream --doctor" för att ställa in det.

# Toast when the connection check could not run. The reason comes from the VPN settings.
torrent-not-checked = Det gick inte att kontrollera anslutningen. { $reason }

# Note on the sources screen after the source chain is rebuilt with torrents on.
sources-reloaded-torrents-pending = Källor lästes in på nytt. Torrenterna startar när VPN-skyddet godkänns.

# Note on the sources screen after the source chain is rebuilt with torrents off.
sources-reloaded-torrents-off = Torrenterna är av. Sessionen stoppades.

# Note on a running job: requests to AniList are being slowed to stay within its limit. A countdown follows.
job-anilist-limit = Väntar på AniLists hastighetsgräns

# Toast when there is no job to carry the wait for AniList's rate limit.
notice-anilist-limit = Väntar { $wait } på AniLists hastighetsgräns.

# Toast when the AniList fallback takes over because AniList cannot be reached.
notice-anilist-unreachable = AniList svarar inte. Visar data från en annan tjänst tills vidare.

# Toast when no metadata service answered and the last cached data is shown.
notice-metadata-cached = Ingen metadatatjänst svarade. Visar det senast sparade.

# Toast when AniList answers again.
notice-anilist-back = AniList är tillbaka.

# Toast when a command needs watch parties but this app was built without them.
notice-party-not-built = Watch partyn ingår inte i den här appen.

# Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList.
notice-signed-in = Inloggad på { $tracker }.

# Toast after a sign-in succeeded and the token went into the system keychain.
notice-signed-in-keychain = Inloggad på { $tracker }. Token sparades i systemets nyckelring.

# Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows.
notice-signed-in-file = Inloggad på { $tracker }. Ingen nyckelring finns, så token ligger i en privat fil på den här enheten.

# Toast when a sign-in worked but the token could not be stored. The reason comes from the system.
notice-signed-in-unsaved = Inloggad på { $tracker }, men token sparades inte, så du måste logga in på nytt senare. { $reason }

# Toast when a sign-in token could not be stored. The reason comes from the system.
notice-token-not-saved = Det gick inte att spara inloggningstoken. Försök logga in igen. { $reason }

# Toast when a sign-in did not finish. The reason comes from the tracker or the network.
notice-sign-in-failed = Det gick inte att logga in på { $tracker }. Försök igen. { $reason }

# Toast when the wait for a sign-in ended early. The reason comes from the system.
notice-sign-in-stopped = Inloggningen på { $tracker } avbröts innan den var klar. Försök igen. { $reason }

# Toast when a tracker would not give a token for the sign-in. The reason comes from the tracker.
notice-token-exchange-failed = Det gick inte att få en token från { $tracker }. Försök logga in igen. { $reason }

# Toast when no browser could be opened for a sign-in. The reason comes from the system.
notice-browser-not-opened = Det gick inte att öppna en webbläsare för inloggningen. Kontrollera att en är installerad och försök igen. { $reason }

# Toast when a sign-in redirect arrives and no sign-in is waiting for it.
notice-sign-in-not-waiting = Ingen inloggning till { $tracker } väntar på det. Starta inloggningen igen.

# Toast when a sign-in redirect does not match the request that was made.
notice-sign-in-wrong-request = Inloggningen till { $tracker } kom inte tillbaka från den här begäran. Starta inloggningen igen.

# Toast when a tracker sent the person back without a token.
notice-sign-in-no-token = Inloggningen till { $tracker } kom tillbaka utan token. Försök igen.

# Toast when this build has no MyAnimeList client to finish a sign-in with.
notice-mal-client-missing-build = Det gick inte att slutföra inloggningen till MyAnimeList: den här versionen har ingen klient för det.

# Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.
notice-kitsu-signs-in-on-accounts = Kitsu loggar in från skärmen Konton.

# Toast when a tracker has no way to sign in yet.
notice-sign-in-unsupported = Inloggning till { $tracker } stöds inte än.

# Toast on an app that cannot receive a browser redirect.
notice-sign-in-needs-redirect = Inloggning till { $tracker } kräver en omdirigering i webbläsaren, och den här appen kan inte ta emot den.

# Toast when AniList is set to a sign-in method only the anistream app can finish. The setting name is a key of the config file and is not translated.
notice-anilist-implicit-flow = Den här AniList-inloggningsmetoden fungerar bara i appen anistream. För att logga in här sätter du { $setting } till "loopback" i konfigurationsfilen.

# Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated.
notice-anilist-client-missing = AniList behöver ett klient-id och en hemlighet. Ange { $client } och { $secret } i konfigurationsfilen och logga sedan in igen. För att få inloggningsadressen kör du anistream --login-url.

# Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.
notice-anilist-paste-flow = Det går inte att klistra in en kod här. Avsluta och kör anistream --login i stället.

# Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated.
notice-mal-client-missing = MyAnimeList behöver ett klient-id. Registrera en app med typen "other" på myanimelist.net/apiconfig och sätt sedan { $setting } i konfigurationsfilen.

# Job note while the browser sign-in is open and the terminal app waits for it to come back.
status-waiting-for-redirect = Väntar på att { $tracker } ska skicka tillbaka…

# Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.
notice-mal-no-refresh-token = MyAnimeList utfärdade ingen uppdateringstoken. Du behöver logga in igen om ungefär en månad.

# Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated.
notice-client-id-missing = Sätt { $setting } i konfigurationsfilen först.

# Toast after signing out of a tracker with nothing waiting to send.
notice-signed-out = Utloggad från { $tracker }.

# Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in.
notice-signed-out-queue =
    { $count ->
        [one] Utloggad från { $tracker }. En köad ändring sparas till den kommande inloggningen.
       *[other] Utloggad från { $tracker }. { $count } köade ändringar sparas till den kommande inloggningen.
    }

# Toast when signing out of a tracker failed. The reason comes from the system.
notice-sign-out-failed = Det gick inte att logga ut från { $tracker }. Försök igen. { $reason }

# Toast when a setting could not be stored. The cause says why and what to do.
notice-not-saved-because = Det gick inte att spara inställningen. { $cause }

# Toast when the torrent protection choice was saved.
notice-protection-saved = Skyddet för torrenter sparades.

# Toast when the torrent protection could not be checked. The cause says why.
notice-protection-not-checked = Det gick inte att kontrollera skyddet för torrenter. { $cause }

# Toast when the proxy's password could not be stored. The reason comes from the system.
notice-proxy-password-not-kept = Det gick inte att spara proxyns lösenord. Ange det igen för att försöka spara det. { $reason }

# Toast when a show's setting was given a value it does not take. The value is what was given.
notice-show-setting-refused = Det gick inte att spara inställningen. { $value } är inte ett värde för { $setting }.

# Toast when resetting a show's settings failed. The reason comes from the local database.
notice-show-not-reset = Det gick inte att återställa den här seriens inställningar. { $reason }

# Toast when a subtitle choice names subtitles the show has not used.
notice-show-no-such-subtitles = Det gick inte att spara det undertextvalet. Den här serien har inte använt de undertexterna förut.

# Toast while torrents are held until the connection check passes.
notice-torrents-waiting-for-check = Torrenterna väntar på att anslutningskontrollen godkänns igen.

# Toast when the mapping data downloads work again after a failure.
notice-mapping-data-refreshed = Mappningsdatan uppdaterades.

# Toast when the mapping data could not be downloaded. It is said once; the retries are silent.
notice-mapping-data-failed = Det gick inte att uppdatera mappningsdatan ({ $datasets }). Försöker igen om { $wait }. { $cause }

# Toast, and desktop notification, for one episode that aired while the app was closed.
notice-episode-aired = { $title }, avsnitt { $episode }, sändes medan du var borta.

# Toast, and desktop notification, for several episodes that aired while the app was closed.
notice-episodes-aired =
    { $count ->
        [one] Ett nytt avsnitt av en serie du följer sändes. Kalendern visar det.
       *[other] { $count } nya avsnitt av serier du följer sändes. Kalendern visar dem.
    }

# Toast when a new release of anistream is out, on the terminal app. The command is not translated. Terminal only: the engine never sends it to the apps.
notice-update-available = { $tag } är ute. Kör anistream --update för att installera den.

# The reason a setting was refused until the person confirms having no protection.
cause-confirm-no-protection = Bekräfta först att du vill ha inget skydd.

# The reason a setting was refused until the person confirms the "warn only" choice.
cause-confirm-warn-only = Bekräfta först att du bara vill få en varning.

# The reason a proxy was refused: it has no host or no port.
cause-proxy-needs-address = En proxy behöver en värd och en port.

# The reason a proxy could not be checked: its address is not one the check can use.
cause-proxy-address-unusable = Proxyns adress kan inte användas för en kontroll.

# The reason a request failed: it never reached the server.
cause-server-unreachable = Det gick inte att nå servern.

# Toast after a setting is stored. The label is the setting's name.
notice-saved = Sparade { $label }.

# Toast when a setting could not be stored. The reason comes from the system.
notice-not-saved = Det gick inte att spara inställningen. { $reason }

# Toast when a title's details did not load.
notice-title-load-failed = Det gick inte att läsa in titeln. Kontrollera anslutningen och försök igen.

# Toast when playback stops with an error.
notice-playback-failed = Uppspelningen misslyckades. Prova en annan källa.

# Toast when something went wrong inside the engine and it carried on.
notice-engine-fault = Något gick fel i anistream. Appen fortsatte, men om en skärm verkar fast avslutar du och öppnar den igen.

# Toast at launch when the database was damaged, so a fresh one was started. The path is where the damaged file was moved, kept for recovery. Watch history and downloads start over; what the trackers hold comes back with the next sync.
notice-database-set-aside = Databasen var skadad, så anistream startade en ny. Den gamla filen sparas på { $path }. Dina trackers hämtar tillbaka det de har när synken körs igen.

# Message when anistream could not start because a folder could not be made. The path is the folder, the reason comes from the system.
start-failed-folder = anistream kunde inte skapa mappen { $path }. Kontrollera att disken har plats och att mappen går att skriva i, och försök igen. { $reason }

# Message when anistream could not start because the config file has a setting it can't use. The path is the file; the problem names the line where it can.
start-failed-config = { $path } har en inställning som anistream inte kan använda: { $problem }. Rätta till den eller ta bort den och försök igen.

# Message when anistream could not start because its database could not be opened. The path is the database file, the reason comes from the system.
start-failed-database = anistream kunde inte öppna sin databas på { $path }. Om en annan app från anistream är öppen i den här mappen avslutar du den och försöker igen. { $reason }

# Message when anistream could not start its network connection from the network settings.
start-failed-network = anistream kunde inte skapa sin nätverksanslutning med nätverksinställningarna i config.toml. { $reason }

# Message when anistream itself could not start. The reason comes from the system or the engine.
start-failed = anistream kunde inte starta. Avsluta och öppna den igen. { $reason }

# Message when the TV remote could not start listening or could not forget a phone.
start-failed-remote = Fjärrkontrollen kunde inte starta. { $reason }

# Message when the built-in player could not start.
start-failed-player = Spelaren kunde inte starta. { $reason }

# Toast after episodes are added to the download queue.
notice-episodes-queued =
    { $count ->
        [one] Lade till ett avsnitt i kön.
       *[other] Lade till { $count } avsnitt i kön.
    }

# Note under the connection-check group of the torrents dialog: what the check does.
torrents-linux-check-note = anistream kontrollerar var torrenttrafiken lämnar när en torrent startar och varje minut medan den körs, och pausar torrents om kontrollen misslyckas. Det är din VPN eller proxy som skyddar dig.

# Confirmation text when choosing "Warn only" for a failed check.
torrents-linux-warn-confirm = anistream varnar dig i stället för att pausa. Om din VPN eller proxy är nere kan andra se din IP-adress.

# Status line once the protection has been checked and saved.
torrents-linux-protection-saved = Torrentskyddet sparades

# Title of the dialog that turns torrents on.
torrents-linux-turn-on-title = Slå på torrents

# Title of the dialog that changes what protects torrents.
torrents-linux-protect-title = Skydda torrents

# Title of the dialog that edits the proxy.
torrents-linux-edit-proxy-title = Redigera proxy

# Button that turns torrents on in the dialog.
torrents-linux-turn-on-button = Slå på

# Seeding row: time left until the goal, in a span already worded ("18h", "1d 6h").
downloads-linux-seed-left = { $span } kvar

# Seeding row: less than an hour left until the goal.
downloads-linux-seed-left-soon = Mindre än en timme kvar

# Storage row: free space, the disk's size and what downloads take. All three are sizes already formatted.
downloads-linux-space-free = { $free } av { $total } ledigt · hämtningar tar { $taken }

# Placeholder of the search field. It also finds settings.
search-linux-placeholder = Sök titlar och inställningar

# Tooltip of the button that clears the recent searches.
search-linux-clear-recent = Rensa senaste sökningarna

# Title of the state when a browse with no filters lists nothing.
search-linux-nothing-found = Inget hittades

# Title of the state when a typed search waits for Enter.
search-linux-press-enter = Tryck på Enter för att söka

# Line under the Enter title: why results do not come as you type. The tracker is a name.
search-linux-paused = Sökning medan du skriver är pausad en stund, för att hålla sig inom { $tracker }s gränser.

# Menu title over the sort choices of the filter row.
filter-linux-sort-by = Sortera efter

# Sort choice: what is rising now.
filter-linux-sort-trending = Trendar just nu

# Sort choice: the most recent first.
filter-linux-sort-newest = Nyast först

# Sort choice: the earliest first.
filter-linux-sort-oldest = Äldst först

# Sort choice: the most favourited first.
filter-linux-sort-favourites = Flest favoriter

# Genre filter button when several genres are set.
filter-linux-genres-count =
    { $count ->
        [one] { $count } genre
       *[other] { $count } genrer
    }

# Format filter button when several formats are set.
filter-linux-formats-count =
    { $count ->
        [one] { $count } format
       *[other] { $count } format
    }

# Status filter button when several statuses are set.
filter-linux-statuses-count =
    { $count ->
        [one] { $count } status
       *[other] { $count } statusar
    }

# Chip for a genre that is left out of the results. The genre is already named.
filter-linux-not = Inte { $genre }

# Button that takes off every filter chip.
filter-linux-clear-all = Rensa alla

# Tooltip of the arrow that scrolls the filter row back.
filter-linux-earlier = Tidigare filter

# Tooltip of the arrow that scrolls the filter row on.
filter-linux-more = Fler filter

# What a screen reader says for a broadcast whose time is an estimate. The time is already formatted.
calendar-linux-about = ungefär { $time }

# What a screen reader says for a broadcast that is the dub's.
calendar-linux-dubbed = dubbat

# Title of the menu, and tooltip of its button, that orders a list.
library-linux-order = Ordning

# A list's tab: its name and how many titles it holds.
library-linux-list-count = { $list } { $count }

# Description read by a screen reader on the button that plays the shown episode on a TV.
title-linux-play-on-tv-help = Spela upp det här avsnittet på en TV med anistream

# Description read by a screen reader on an episode's watched check box.
title-linux-episode-watched = Avsnitt { $episode } sett

# Line in a day's column when nothing airs that day.
calendar-linux-day-empty = Inget sänds

# Accessible label of the line that says how the watch party form is getting on.
party-status = Status för watch party

# Accessible label of the list of people in the watch party, in the player's panel.
party-members = Deltagare

# Title of the dialog that lists the sources that have the watch party's episode.
party-choose-a-source = Välj en källa

# Line when no source lists the watch party's episode. A plugin store adds plugins, which add sources.
