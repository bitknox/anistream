---
import '../../styles/theme.css';
import '../../styles/landing.css';
import '../../styles/apps.css';
import '../../styles/features.css';
import FeatureVideo from '../../components/FeatureVideo.astro';
import Shot from '../../components/Shot.astro';
import LanguageSuggest from '../../components/site/LanguageSuggest.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import SiteHead from '../../components/site/SiteHead.astro';
import SiteNav from '../../components/site/SiteNav.astro';
import UpscaleCompare from '../../components/UpscaleCompare.astro';
import StoreDiagram from '../../components/features/StoreDiagram.astro';
import SyncDiagram from '../../components/features/SyncDiagram.astro';
import TerminalStill from '../../components/features/TerminalStill.astro';
import shots from '../../data/shots.json';
import videos from '../../data/videos.json';
import { APPS, INSTALL_GUIDE } from '../../data/site';
import { localePaths, useSite } from '../../i18n/site';

export const getStaticPaths = localePaths;

const { t, href, lang, dir } = useSite(Astro);
const OPAP = 'https://opap.jp/';
const CC = 'https://creativecommons.org/licenses/by/4.0/';

// Each highlight's picture sits in a .hl-media slot, and a FeatureVideo in each slot plays a short
// loop of the task in place of a picture once scripts/videos/record.sh has recorded it. Until
// then the picture stays.

/** Whether a recorded clip shows the episode in the player, which the page then credits. */
const episodeShown = Object.values(videos as Record<string, { episode: boolean }>).some((v) => v.episode);

/** A screenshot's width over its height, for a row of pictures at one height. */
const ratio = (name: keyof typeof shots) => shots[name].w / shots[name].h;
/** The terminal still's viewBox, from TerminalStill.astro. */
const TERMINAL = 640 / 382;

// The rest, by task: each group a heading over short labels. The words are under
// `features.also.<group>` in the language files.
const ALSO: Record<string, string[]> = {
	watching: ['skip', 'resume', 'source', 'dub', 'tracks', 'pip', 'parties'],
	titles: ['trailers', 'facts', 'more', 'discussions', 'upnext', 'again'],
	downloads: ['next', 'now', 'offline'],
	alerts: ['alerts', 'widgets', 'handoff', 'live'],
	other: ['updates', 'torrents', 'titles', 'cli'],
};
const also = Object.entries(ALSO).map(([group, ids]) => ({
	title: t(`features.also.${group}.group`),
	items: ids.map((id) => [t(`features.also.${group}.${id}.name`), t(`features.also.${group}.${id}.text`)]),
}));

const platforms = ['Mac', 'iPhone', 'iPad', 'Android', 'Android TV', 'Windows', 'Linux', t('features.apps.terminal')];

// From docs/parity.md, which says where in each app's code a cell comes from. Rows every app has
// are named in the line above the table instead. Y: the app does it. D: in development. N: not on
// this platform. Any other text: what the app does, where it does part of it.
type Cell = 'Y' | 'D' | 'N' | (string & {});
const matrix: [string, [string, Cell[]][]][] = [
	[
		t('features.matrix.group.watching'),
		[
			[t('features.matrix.row.mpv'), ['Y', 'Y', 'Y', 'Y', 'Y', 'Y', 'Y', t('features.matrix.cell.yourMpv')]],
			[t('features.matrix.row.upscaling'), ['Y', 'Y', 'Y', 'Y', 'N', 'Y', 'Y', 'Y']],
			[t('features.matrix.row.marks'), ['Y', 'Y', 'Y', 'Y', 'Y', 'Y', 'Y', t('features.matrix.cell.mpvs')]],
			[t('features.matrix.row.subfile'), ['Y', 'N', 'N', 'N', 'N', 'Y', 'Y', t('features.matrix.cell.mpvs')]],
			[t('features.matrix.row.pip'), ['Y', 'Y', 'Y', 'Y', 'N', t('features.matrix.cell.miniPlayer'), t('features.matrix.cell.miniPlayer'), 'N']],
			[t('features.matrix.row.parties'), ['Y', 'Y', 'Y', 'N', 'N', 'Y', 'Y', 'Y']],
		],
	],
	[
		t('features.matrix.group.titles'),
		[
			[t('features.matrix.row.discussions'), ['Y', 'Y', 'Y', 'Y', t('features.matrix.cell.readOnly'), 'Y', 'Y', 'N']],
			[t('features.matrix.row.moreAbout'), ['Y', 'Y', 'Y', 'Y', 'N', 'Y', 'Y', t('features.matrix.cell.similar')]],
			[t('features.matrix.row.upNext'), ['D', 'D', 'D', 'D', 'D', 'Y', 'Y', 'Y']],
			[t('features.matrix.row.again'), ['D', 'D', 'D', 'Y', 'Y', 'Y', 'Y', 'N']],
		],
	],
	[
		t('features.matrix.group.tracking'),
		[
			[t('features.matrix.row.mal'), ['Y', 'Y', 'Y', 'Y', t('features.matrix.cell.kitsuOnly'), 'Y', 'Y', 'Y']],
			[t('features.matrix.row.pershow'), ['Y', 'Y', 'Y', 'Y', 'Y', 'Y', 'Y', t('features.matrix.cell.sourceOnly')]],
			[t('features.matrix.row.download'), ['Y', 'Y', 'Y', 'Y', 'N', 'Y', 'Y', 'Y']],
			[t('features.matrix.row.keep'), ['Y', 'Y', 'Y', 'Y', 'N', 'Y', 'Y', t('features.matrix.cell.inConfig')]],
		],
	],
	[
		t('features.matrix.group.devices'),
		[
			[t('features.matrix.row.tv'), ['Y', 'Y', 'Y', 'Y', t('features.matrix.cell.receives'), 'Y', 'Y', 'D']],
			[t('features.matrix.row.alerts'), ['Y', 'Y', 'Y', 'Y', 'N', 'Y', t('features.matrix.cell.atLaunch'), t('features.matrix.cell.inConfig')]],
			[t('features.matrix.row.widgets'), ['Y', 'Y', 'Y', 'Y', 'N', 'D', 'N', 'N']],
			[t('features.matrix.row.live'), ['N', 'Y', 'N', 'N', 'N', 'N', 'N', 'N']],
			[t('features.matrix.row.handoff'), ['Y', 'Y', 'Y', 'N', 'N', 'N', 'N', 'N']],
			[t('features.matrix.row.updates'), ['Y', t('features.matrix.cell.sideStore'), t('features.matrix.cell.sideStore'), 'Y', 'Y', 'Y', 'Y', 'Y']],
		],
	],
];

const MARK: Record<string, [string, string]> = {
	Y: ['mk-yes', t('features.matrix.yes')],
	D: ['mk-dev', t('features.matrix.dev')],
	N: ['mk-none', t('features.matrix.none')],
};
---

<html lang={lang} dir={dir}>
	<head>
		<SiteHead title={t('features.title')} description={t('features.description')} />
	</head>
	<body class="landing apps-page features-page">
		<SiteNav current="features" />

		<main>
			<header class="wrap apps-head feat-head">
				<h1>{t('features.h1')}</h1>
			</header>

			<section class="wrap hl hl-wide" aria-labelledby="native-h">
				<div class="hl-text">
					<h2 id="native-h">{t('features.apps.title')}</h2>
					<p>{t('features.apps.text', { platforms: t('site.platforms') })}</p>
				</div>
				<div class="hl-media devices">
					<div class="ratio-row dev-row">
						<figure class="dev dev-flat" style={`--ratio: ${ratio('mac-continue')}`}>
							<FeatureVideo name="mac-continue" frame="window" alt={t('features.apps.macVideoAlt')}>
								<Shot name="mac-continue" frame="window" sizes="(min-width: 1200px) 734px, 60vw" alt={t('features.apps.macAlt')} />
							</FeatureVideo>
							<figcaption>Mac</figcaption>
						</figure>
						<figure class="dev" style={`--ratio: ${ratio('iphone-title')}`}>
							<FeatureVideo name="iphone-title" frame="phone" alt={t('features.apps.iphoneVideoAlt')}>
								<Shot name="iphone-title" frame="phone" sizes="(min-width: 1200px) 212px, 18vw" alt={t('features.apps.iphoneAlt')} />
							</FeatureVideo>
							<figcaption>iPhone</figcaption>
						</figure>
						<figure class="dev" style={`--ratio: ${ratio('android-continue')}`}>
							<FeatureVideo name="android-title" frame="phone" alt={t('features.apps.androidVideoAlt')}>
								<Shot name="android-continue" frame="phone" sizes="(min-width: 1200px) 208px, 18vw" alt={t('features.apps.androidAlt')} />
							</FeatureVideo>
							<figcaption>Android</figcaption>
						</figure>
					</div>
					<div class="dev-row dev-row-small">
						<div class="ratio-row" style={`--ratio: ${ratio('windows-title') + ratio('linux-continue')}`}>
							<figure class="dev dev-flat" style={`--ratio: ${ratio('windows-title')}`}>
								<Shot name="windows-title" frame="window" sizes="(min-width: 1200px) 290px, 48vw" alt={t('features.apps.windowsAlt')} />
								<figcaption>Windows</figcaption>
							</figure>
							<figure class="dev dev-flat" style={`--ratio: ${ratio('linux-continue')}`}>
								<Shot name="linux-continue" frame="window" sizes="(min-width: 1200px) 280px, 48vw" alt={t('features.apps.linuxAlt')} />
								<figcaption>Linux</figcaption>
							</figure>
						</div>
						<div class="ratio-row" style={`--ratio: ${ratio('tv-continue') + TERMINAL}`}>
							<figure class="dev" style={`--ratio: ${ratio('tv-continue')}`}>
								<Shot name="tv-continue" frame="screen" sizes="(min-width: 1200px) 300px, 48vw" alt={t('features.apps.tvAlt')} />
								<figcaption>Android TV</figcaption>
							</figure>
							<figure class="dev dev-flat dev-term" style={`--ratio: ${TERMINAL}`}>
								<TerminalStill />
								<figcaption>{t('features.apps.terminal')}</figcaption>
							</figure>
						</div>
					</div>
				</div>
			</section>

			<section class="wrap hl" aria-labelledby="find-h">
				<div class="hl-text">
					<h2 id="find-h">{t('features.find.title')}</h2>
					<p>{t('features.find.text1')}</p>
					<p>{t('features.find.text2')}</p>
				</div>
				<div class="hl-media find-stage">
					<FeatureVideo name="mac-search" frame="window" class="find-mac" alt={t('features.find.macVideoAlt')}>
						<Shot name="mac-search" frame="window" class="find-mac" sizes="(min-width: 1200px) 757px, calc(100vw - 32px)" alt={t('features.find.macAlt')} />
					</FeatureVideo>
					<FeatureVideo name="iphone-calendar" frame="phone" class="find-phone" alt={t('features.find.phoneVideoAlt')}>
						<Shot name="iphone-calendar" frame="phone" class="find-phone" sizes="(min-width: 1200px) 182px, 24vw" alt={t('features.find.phoneAlt')} />
					</FeatureVideo>
				</div>
			</section>

			<section class="wrap hl hl-flip" aria-labelledby="player-h">
				<div class="hl-text">
					<h2 id="player-h">{t('features.player.title')}</h2>
					<p>{t('features.player.text')}</p>
				</div>
				<div class="hl-media">
					<UpscaleCompare
						alt={t('player.compareAlt')}
						off="/player/compare-off.webp"
						looks={[
							{ id: 'natural', label: t('player.look.natural'), note: 'ArtCNN', src: '/player/compare-natural.webp' },
							{ id: 'sharp', label: t('player.look.sharp'), note: 'Anime4K', src: '/player/compare-sharp.webp' },
							{ id: 'original', label: t('player.look.original'), note: '1080p', src: '/player/compare-original.webp' },
						]}
						width={720}
						height={480}
					>
						<Fragment set:html={t('features.player.credit', { opap: OPAP, licence: CC })} />
					</UpscaleCompare>
				</div>
			</section>

			<section class="wrap hl" aria-labelledby="tv-h">
				<div class="hl-text">
					<h2 id="tv-h">{t('features.tv.title')}</h2>
					<p>{t('features.tv.text')}</p>
				</div>
				<div class="hl-media tv-stage">
					<FeatureVideo name="iphone-tv-remote" frame="phone" class="tv-phone" alt={t('features.tv.phoneVideoAlt')}>
						<Shot name="iphone-tv-remote" frame="phone" class="tv-phone" sizes="(min-width: 1200px) 160px, 21vw" alt={t('features.tv.phoneAlt')} />
					</FeatureVideo>
					<svg class="tv-link" viewBox="0 0 1000 470" aria-hidden="true" focusable="false">
						<circle cx="236" cy="235" r="4" class="tv-link-end"></circle>
						<path d="M248 235 H306 M298 228 L306 235 L298 242" class="tv-link-line"></path>
					</svg>
					<FeatureVideo name="tv-resume" frame="screen" class="tv-screen" alt={t('features.tv.screenVideoAlt')}>
						<Shot name="tv-title" frame="screen" class="tv-screen" sizes="(min-width: 1200px) 520px, 68vw" alt={t('features.tv.screenAlt')} />
					</FeatureVideo>
				</div>
			</section>

			<section class="wrap hl hl-flip" aria-labelledby="sync-h">
				<div class="hl-text">
					<h2 id="sync-h">{t('features.sync.title')}</h2>
					<p>{t('features.sync.text')}</p>
				</div>
				<div class="hl-media">
					<SyncDiagram />
				</div>
			</section>

			<section class="wrap hl" aria-labelledby="plugins-h">
				<div class="hl-text">
					<h2 id="plugins-h">{t('features.plugins.title')}</h2>
					<p>{t('features.plugins.text')}</p>
					<p class="legal-lead">{t('site.legal')}</p>
				</div>
				<div class="hl-media">
					<StoreDiagram />
				</div>
			</section>

			{
				episodeShown && (
					<p class="wrap apps-credit feat-credit" set:html={t('features.credit', { opap: OPAP, licence: CC })} />
				)
			}

			<section class="wrap feat-sect" aria-labelledby="also-h">
				<h2 id="also-h">{t('features.also.title')}</h2>
				{
					also.map(({ title, items }) => (
						<div class="also-group">
							<h3>{title}</h3>
							<dl class="also">
								{items.map(([name, text]) => (
									<div>
										<dt>{name}</dt>
										<dd>{text}</dd>
									</div>
								))}
							</dl>
						</div>
					))
				}
			</section>

			<section class="wrap feat-sect" id="platforms" aria-labelledby="platforms-h">
				<h2 id="platforms-h">{t('features.matrix.title')}</h2>
				<p class="lede">{t('features.matrix.lede')}</p>
				<ul class="matrix-key" aria-label={t('features.matrix.key')}>
					<li><span class="mk mk-yes" aria-hidden="true"></span>{t('features.matrix.yes')}</li>
					<li><span class="mk mk-dev" aria-hidden="true"></span>{t('features.matrix.dev')}</li>
					<li><span class="mk mk-none" aria-hidden="true"></span>{t('features.matrix.none')}</li>
				</ul>
				<div class="matrix-scroll" tabindex="0" role="region" aria-labelledby="platforms-h">
					<table class="matrix">
						<caption class="sr-only">{t('features.matrix.caption')}</caption>
						<thead>
							<tr>
								<th scope="col"><span class="sr-only">{t('features.matrix.feature')}</span></th>
								{platforms.map((p) => <th scope="col">{p}</th>)}
							</tr>
						</thead>
						{
							matrix.map(([group, rows]) => (
								<tbody>
									<tr class="m-group">
										<th scope="colgroup" colspan={platforms.length + 1}>{group}</th>
									</tr>
									{rows.map(([name, cells]) => (
										<tr>
											<th scope="row">{name}</th>
											{cells.map((c) =>
												MARK[c] ? (
													<td>
														<span class:list={['mk', MARK[c][0]]} aria-hidden="true" />
														<span class="sr-only">{MARK[c][1]}</span>
													</td>
												) : (
													<td class="m-part">{c}</td>
												),
											)}
										</tr>
									))}
								</tbody>
							))
						}
					</table>
				</div>
				<p class="caption matrix-note">{t('features.matrix.note')}</p>
				<div class="actions sect-actions">
					<a class="btn btn-primary" href={href(APPS)}>{t('features.matrix.getApps')}</a>
					<a class="btn" href={href(INSTALL_GUIDE)}>{t('features.matrix.guide')}</a>
				</div>
			</section>
		</main>

		<SiteFooter />
		<LanguageSuggest />
	</body>
</html>
