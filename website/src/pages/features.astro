---
import '../styles/theme.css';
import '../styles/landing.css';
import '../styles/apps.css';
import '../styles/features.css';
import Shot from '../components/Shot.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHead from '../components/site/SiteHead.astro';
import SiteNav from '../components/site/SiteNav.astro';
import UpscaleCompare from '../components/UpscaleCompare.astro';
import StoreDiagram from '../components/features/StoreDiagram.astro';
import SyncDiagram from '../components/features/SyncDiagram.astro';
import TerminalStill from '../components/features/TerminalStill.astro';
import shots from '../data/shots.json';
import { APPS, INSTALL_GUIDE, LEGAL } from '../data/site';

// Each highlight's picture sits in a .hl-media slot. A short video can take a slot's place later,
// as a <video> with a poster, and the text beside it stays where it is.

/** A screenshot's width over its height, for a row of pictures at one height. */
const ratio = (name: keyof typeof shots) => shots[name].w / shots[name].h;
/** The terminal still's viewBox, from TerminalStill.astro. */
const TERMINAL = 640 / 382;

const also: [string, string][] = [
	['Downloads ahead', 'The next episodes, ready offline.'],
	['Widgets', 'Continue and Airing today on your home screen.'],
	['New-episode alerts', 'Off until you turn them on, per show.'],
	['Picture in Picture', 'Keep watching while you browse.'],
	['Syncplay parties', 'Everyone’s player in step.'],
	['Skip and Up Next', 'Skip the opening, then straight to the next episode.'],
	['Resume', 'Back where you stopped, to the second.'],
	['Sub or dub per show', 'Each show can keep its own choice.'],
	['Handoff, Spotlight, Shortcuts', 'Pick up a show on another Apple device.'],
	['Self-updates', 'Mac, Android and terminal apps update themselves.'],
	['A CLI with JSON', '--json output for your scripts.'],
];

const platforms = ['Mac', 'iPhone', 'iPad', 'Android', 'Android TV', 'Windows', 'Linux', 'Terminal'];

// From docs/parity.md, which says where in each app's code a cell comes from. Rows every app has
// are named in the line above the table instead. Y: the app does it. D: in development. N: not on
// this platform. Any other text: what the app does, where it does part of it.
type Cell = 'Y' | 'D' | 'N' | (string & {});
const matrix: [string, [string, Cell[]][]][] = [
	[
		'Finding and watching',
		[
			['Browse with filters', ['Y', 'Y', 'Y', 'Y', 'D', 'D', 'Y', 'Y']],
			['Seasons on the title page', ['Y', 'Y', 'Y', 'Y', 'Related titles', 'Related titles', 'Y', 'Y']],
			['Built-in mpv', ['Y', 'Y', 'Y', 'Y', 'Y', 'Y', 'Y', 'Your mpv']],
			['Upscaling', ['Y', 'Y', 'Y', 'Y', 'N', 'Y', 'Y', 'Y']],
			['Subtitle and audio tracks', ['Y', 'Y', 'Y', 'Y', 'Y', 'D', 'D', 'Y']],
			['Picture in Picture', ['Y', 'Y', 'Y', 'Y', 'N', 'Mini player', 'Mini player', 'N']],
			['Syncplay parties', ['D', 'N', 'N', 'N', 'N', 'D', 'D', 'Y']],
		],
	],
	[
		'Tracking and downloads',
		[
			['MyAnimeList and Kitsu', ['Y', 'Y', 'Y', 'Y', 'Kitsu only', 'Y', 'D', 'Y']],
			['Simkl and Trakt', ['Y', 'Y', 'Y', 'Y', 'Y', 'D', 'D', 'Y']],
			['Per-show settings', ['Y', 'Y', 'Y', 'Y', 'Audio and skips', 'D', 'Y', 'Source only']],
			['Download an episode', ['Y', 'Y', 'Y', 'Y', 'N', 'D', 'Y', 'Y']],
			['Keep the next episodes', ['Y', 'Y', 'Y', 'Y', 'N', 'Y', 'Y', 'In config']],
		],
	],
	[
		'Around the apps',
		[
			['Play on TV and remote', ['Y', 'Y', 'Y', 'Y', 'Receives', 'D', 'D', 'D']],
			['Join plugin stores', ['Y', 'Y', 'Y', 'Y', 'Y', 'Y', 'Y', 'Y']],
			['Home screen widgets', ['Y', 'Y', 'Y', 'Y', 'N', 'D', 'N', 'N']],
			['New-episode alerts', ['Y', 'Y', 'Y', 'Y', 'N', 'D', 'Y', 'In config']],
			['Handoff, Spotlight, Shortcuts', ['Y', 'Y', 'Y', 'N', 'N', 'N', 'N', 'N']],
			['Updates from the app', ['Y', 'Via SideStore', 'Via SideStore', 'Y', 'D', 'D', 'D', 'Y']],
		],
	],
];

const MARK: Record<string, [string, string]> = {
	Y: ['mk-yes', 'Available'],
	D: ['mk-dev', 'In development'],
	N: ['mk-none', 'Not on this platform'],
};
---

<html lang="en">
	<head>
		<SiteHead
			title="anistream features"
			description="What anistream does: native apps on every platform over one engine, browsing with no account, mpv with upscaling, Play on TV, history synced to your trackers, and plugins from private stores. Then which app does what."
		/>
	</head>
	<body class="landing apps-page features-page">
		<SiteNav current="features" />

		<main>
			<header class="wrap apps-head feat-head">
				<h1>Features</h1>
				<p class="lede">What anistream does, and which app does it.</p>
			</header>

			<section class="wrap hl hl-wide" aria-labelledby="native-h">
				<div class="hl-text">
					<h2 id="native-h">Native on every platform, one engine</h2>
					<p>Each app uses its platform’s own toolkit, over one Rust engine shared with the terminal app.</p>
				</div>
				<div class="hl-media devices">
					<div class="ratio-row dev-row">
						<figure class="dev dev-flat" style={`--ratio: ${ratio('mac-continue')}`}>
							<Shot name="mac-continue" frame="window" sizes="(min-width: 1200px) 734px, 60vw" alt="The Mac app on Continue, with a button to resume the show in progress" />
							<figcaption>Mac</figcaption>
						</figure>
						<figure class="dev" style={`--ratio: ${ratio('iphone-title')}`}>
							<Shot name="iphone-title" frame="phone" sizes="(min-width: 1200px) 212px, 18vw" alt="The iPhone app on a title page, with a button to resume episode 7" />
							<figcaption>iPhone</figcaption>
						</figure>
						<figure class="dev" style={`--ratio: ${ratio('android-continue')}`}>
							<Shot name="android-continue" frame="phone" sizes="(min-width: 1200px) 208px, 18vw" alt="The Android app on Continue" />
							<figcaption>Android</figcaption>
						</figure>
					</div>
					<div class="dev-row dev-row-small">
						<div class="ratio-row" style={`--ratio: ${ratio('windows-title') + ratio('linux-continue')}`}>
							<figure class="dev dev-flat" style={`--ratio: ${ratio('windows-title')}`}>
								<Shot name="windows-title" frame="window" sizes="(min-width: 1200px) 290px, 48vw" alt="The Windows app on a title page" />
								<figcaption>Windows</figcaption>
							</figure>
							<figure class="dev dev-flat" style={`--ratio: ${ratio('linux-continue')}`}>
								<Shot name="linux-continue" frame="window" sizes="(min-width: 1200px) 280px, 48vw" alt="The Linux app on Continue" />
								<figcaption>Linux</figcaption>
							</figure>
						</div>
						<div class="ratio-row" style={`--ratio: ${ratio('tv-continue') + TERMINAL}`}>
							<figure class="dev" style={`--ratio: ${ratio('tv-continue')}`}>
								<Shot name="tv-continue" frame="screen" sizes="(min-width: 1200px) 300px, 48vw" alt="The Android TV app on Continue, with a large button to resume episode 7" />
								<figcaption>Android TV</figcaption>
							</figure>
							<figure class="dev dev-flat dev-term" style={`--ratio: ${TERMINAL}`}>
								<TerminalStill />
								<figcaption>Terminal</figcaption>
							</figure>
						</div>
					</div>
				</div>
			</section>

			<section class="wrap hl" aria-labelledby="find-h">
				<div class="hl-text">
					<h2 id="find-h">Find something to watch</h2>
					<p>Browse by genre, year and season, or follow the seasonal charts and the week’s calendar, with no account.</p>
				</div>
				<div class="hl-media find-stage">
					<Shot name="mac-search" frame="window" class="find-mac" sizes="(min-width: 1200px) 757px, calc(100vw - 32px)" alt="The Mac app’s search, with a query, its two results and the filters panel open: genres, tags, years and length" />
					<Shot name="iphone-search" frame="phone" class="find-phone" sizes="(min-width: 1200px) 182px, 24vw" alt="The iPhone app’s search with no query: sort and filter buttons, then Trending now and Popular this season" />
				</div>
			</section>

			<section class="wrap hl hl-flip" aria-labelledby="player-h">
				<div class="hl-text">
					<h2 id="player-h">The mpv player, upscaled</h2>
					<p>Episodes play in mpv, upscaled by ArtCNN or Anime4K. Drag the line to compare a 480p stream.</p>
				</div>
				<div class="hl-media">
					<UpscaleCompare
						alt="A close-up of a character's face from a 480p stream, shown at 1080p"
						off="/player/compare-off.webp"
						looks={[
							{ id: 'natural', label: 'Natural', note: 'ArtCNN', src: '/player/compare-natural.webp' },
							{ id: 'sharp', label: 'Sharp', note: 'Anime4K', src: '/player/compare-sharp.webp' },
							{ id: 'original', label: 'Original', note: '1080p', src: '/player/compare-original.webp' },
						]}
						width={720}
						height={480}
					>
						From <a href="https://opap.jp/">こうしす！ #3.2</a> by OPAP-JP contributors,{' '}
						<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
					</UpscaleCompare>
				</div>
			</section>

			<section class="wrap hl" aria-labelledby="tv-h">
				<div class="hl-text">
					<h2 id="tv-h">Play on TV, phone as the remote</h2>
					<p>Send an episode to the Android TV app, then pause, seek and switch subtitles from your phone.</p>
				</div>
				<div class="hl-media tv-stage">
					<Shot name="iphone-tv-remote" frame="phone" class="tv-phone" sizes="(min-width: 1200px) 160px, 21vw" alt="The iPhone app as the TV’s remote: the episode playing, play and seek buttons, subtitles, audio and the TV’s volume" />
					<svg class="tv-link" viewBox="0 0 1000 470" aria-hidden="true" focusable="false">
						<circle cx="236" cy="235" r="4" class="tv-link-end"></circle>
						<path d="M248 235 H306 M298 228 L306 235 L298 242" class="tv-link-line"></path>
					</svg>
					<Shot name="tv-title" frame="screen" class="tv-screen" sizes="(min-width: 1200px) 520px, 68vw" alt="The Android TV app on a title page, with a button to resume episode 7 and the episode list" />
				</div>
			</section>

			<section class="wrap hl hl-flip" aria-labelledby="sync-h">
				<div class="hl-text">
					<h2 id="sync-h">Your history, synced everywhere</h2>
					<p>History lives on your device and needs no account. An outbox sends changes to your trackers in order, even after a week offline.</p>
				</div>
				<div class="hl-media">
					<SyncDiagram />
				</div>
			</section>

			<section class="wrap hl" aria-labelledby="plugins-h">
				<div class="hl-text">
					<h2 id="plugins-h">Plugins and private stores</h2>
					<p>Sources are sandboxed plugins. A friend can run a small store and invite you, and its plugin list arrives signed.</p>
					<p class="legal-lead">{LEGAL}</p>
				</div>
				<div class="hl-media">
					<StoreDiagram />
				</div>
			</section>

			<section class="wrap feat-sect" aria-labelledby="also-h">
				<h2 id="also-h">Also in anistream</h2>
				<dl class="also">
					{
						also.map(([name, text]) => (
							<div>
								<dt>{name}</dt>
								<dd>{text}</dd>
							</div>
						))
					}
				</dl>
			</section>

			<section class="wrap feat-sect" id="platforms" aria-labelledby="platforms-h">
				<h2 id="platforms-h">Compare the apps</h2>
				<p class="lede">
					Every app searches, follows the seasonal charts and the calendar, syncs with AniList, and
					skips, resumes and plays the next episode.
				</p>
				<ul class="matrix-key" aria-label="Key">
					<li><span class="mk mk-yes" aria-hidden="true"></span>Available</li>
					<li><span class="mk mk-dev" aria-hidden="true"></span>In development</li>
					<li><span class="mk mk-none" aria-hidden="true"></span>Not on this platform</li>
				</ul>
				<div class="matrix-scroll" tabindex="0" role="region" aria-labelledby="platforms-h">
					<table class="matrix">
						<caption class="sr-only">Which app does each feature</caption>
						<thead>
							<tr>
								<th scope="col"><span class="sr-only">Feature</span></th>
								{platforms.map((p) => <th scope="col">{p}</th>)}
							</tr>
						</thead>
						{
							matrix.map(([group, rows]) => (
								<tbody>
									<tr class="m-group">
										<th scope="colgroup" colspan={platforms.length + 1}>{group}</th>
									</tr>
									{rows.map(([name, cells]) => (
										<tr>
											<th scope="row">{name}</th>
											{cells.map((c) =>
												MARK[c] ? (
													<td>
														<span class:list={['mk', MARK[c][0]]} aria-hidden="true" />
														<span class="sr-only">{MARK[c][1]}</span>
													</td>
												) : (
													<td class="m-part">{c}</td>
												),
											)}
										</tr>
									))}
								</tbody>
							))
						}
					</table>
				</div>
				<p class="caption matrix-note">The Windows and Linux apps come with the next release.</p>
				<div class="actions sect-actions">
					<a class="btn btn-primary" href={APPS}>Get the apps</a>
					<a class="btn" href={INSTALL_GUIDE}>Installation guide</a>
				</div>
			</section>
		</main>

		<SiteFooter />
	</body>
</html>
