---
import '../styles/theme.css';
import '../styles/landing.css';
import FeatureVideo from '../components/FeatureVideo.astro';
import Shot from '../components/Shot.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHead from '../components/site/SiteHead.astro';
import SiteNav from '../components/site/SiteNav.astro';
import TerminalDemo from '../components/TerminalDemo.astro';
import UpscaleCompare from '../components/UpscaleCompare.astro';
import { APP_DOWNLOADS, APPS, FEATURES, GITHUB, INSTALL_GUIDE, LATEST, LEGAL } from '../data/site';

const terminalRows: [string, string][] = [
	['Vim keys', 'hjkl or the arrow keys, and you can rebind them.'],
	['Watch parties', 'Press y and the episode plays in a party room instead, with everyone’s player in step. A party leaves your saved position alone.'],
	['Command line', '--search, --stats and --random print JSON with --json, and --continue resumes the episode you left half watched.'],
];

const sources: [string, string][] = [
	['AniList', 'Public data for browsing, search, the calendar and title pages, with a pointer to where each title is licensed.'],
	['Plugins', 'For APIs you have the right to use, self-hosted servers and your own media. anistream never circumvents DRM, so a licensed stream opens in its own service.'],
	['Plugin stores', 'Run by someone you know, for the people they invite. anistream lists none of them.'],
];

const installHtml = [
	'<span class="c-d"># mpv plays, ffmpeg muxes subtitles</span>',
	'<span class="c-d">$</span> brew install mpv ffmpeg',
	'<span class="c-d"># browse with no account, no config</span>',
	'<span class="c-d">$</span> anistream',
	'<span class="c-d"># checked against its SHA-256</span>',
	'<span class="c-d">$</span> anistream <span class="c-n">--update</span>',
].join('\n');
---

<html lang="en">
	<head>
		<SiteHead
			title="anistream · an open-source anime client"
			description="anistream is an open-source anime client with native apps for Mac, iPhone, iPad, Android, Android TV, Windows and Linux, and a terminal app, for browsing, watching, tracking and syncing, with sources as plugins you add. It hosts no content."
		/>
	</head>
	<body class="landing">
		<div class="ambient" aria-hidden="true"></div>

		<SiteNav overScene />

		<header class="hero">
			<div
				class="scene"
				data-scene
				role="img"
				aria-label="A rooftop at dusk over a lit city, meteors crossing the sky, and Nagare, anistream’s mascot, looking up at them, drawn in terminal halfblocks"
			>
				<canvas data-plane="sky"></canvas>
				<canvas data-plane="far"></canvas>
				<canvas data-plane="near"></canvas>
				<canvas data-plane="front"></canvas>
			</div>
			<div class="wrap hero-copy">
				<div class="hero-text">
					<h1>Browse, watch, track and sync anime <span class="hero-claim">in one client.</span></h1>
					<div class="hero-side">
						<p class="hero-sub">
							Native apps for Mac, iPhone, iPad, Android, Android TV, Windows and Linux, each in its
							platform’s own toolkit, and one for your terminal. Sources come from plugins you add.
						</p>
						<div class="actions">
							<a class="btn btn-primary" href={APPS}>Get the apps</a>
							<a class="btn" href="/docs/">Read the docs</a>
						</div>
						<p class="hero-note">MIT licence · Browsing needs no account</p>
					</div>
				</div>
				<div class="hero-apps">
					<div class="hero-devices">
						<Shot
							name="mac-continue"
							frame="window"
							class="hero-mac"
							sizes="(min-width: 1200px) 584px, (min-width: 900px) 700px, calc(100vw - 32px)"
							loading="eager"
							alt="The Mac app’s Continue screen, with a banner for the show in progress and a button to resume its episode"
						/>
						<Shot
							name="iphone-title"
							frame="phone"
							class="hero-phone"
							sizes="(min-width: 1200px) 160px, (min-width: 900px) 190px, 28vw"
							loading="eager"
							alt="The iPhone app on a title page, with the show’s banner, a button to resume episode 7 and the episode list"
						/>
					</div>
					<p class="caption">
						The Mac app on Continue, with the iPhone app on a title page in front. Every title and
						picture in these screenshots is made up.
					</p>
				</div>
			</div>
		</header>


		<main>
			<section class="wrap sect" aria-label="Continue, the calendar and Play on TV">
				<div class="glance">
					<figure>
						<div class="glance-media">
							<FeatureVideo name="android-title" frame="phone" alt="The Android app opening a show from Continue, switching to Season 2 and back, scrolling its episodes, then swiping back to Continue">
								<Shot name="android-continue" frame="phone" sizes="240px" alt="The Android app on Continue" />
							</FeatureVideo>
						</div>
						<figcaption>
							<h3>Continue watching</h3>
							<p>Continue keeps the shows you’re partway through, one tap from the next episode.</p>
						</figcaption>
					</figure>
					<figure>
						<div class="glance-media">
							<FeatureVideo name="iphone-calendar" frame="phone" alt="The iPhone app’s calendar: the days of the week, then every show airing">
								<Shot name="iphone-title" frame="phone" sizes="240px" alt="The iPhone app on a title page" />
							</FeatureVideo>
						</div>
						<figcaption>
							<h3>Keep up with the season</h3>
							<p>The calendar shows what airs each day, and your progress syncs to AniList, MyAnimeList, Kitsu, Simkl and Trakt.</p>
						</figcaption>
					</figure>
					<figure>
						<div class="glance-media">
							<FeatureVideo name="iphone-tv-remote" frame="phone" alt="The iPhone app sending an episode to a TV, then pausing it as the remote">
								<Shot name="iphone-tv-remote" frame="phone" sizes="240px" alt="The iPhone app as the TV’s remote" />
							</FeatureVideo>
						</div>
						<figcaption>
							<h3>Play on TV</h3>
							<p>Send an episode to the Android TV app, then use your phone or computer as the remote.</p>
						</figcaption>
					</figure>
				</div>
				<div class="actions sect-actions">
					<a class="btn" href={FEATURES}>See all features</a>
				</div>
			</section>

			<section class="wrap sect" aria-labelledby="apps-h">
				<h2 id="apps-h">Apps</h2>
				<p class="lede">
					Every app is built with its platform’s own toolkit and controls. They share one engine,
					written in Rust.
				</p>
				<p class="toolkit-line">
					SwiftUI on Apple, Jetpack Compose on Android, WinUI 3 on Windows, GTK 4 on Linux and
					Ratatui in the terminal.
				</p>
				<div class="ratio-row app-strip">
					<Shot name="linux-continue" frame="window" sizes="(min-width: 1200px) 490px, (min-width: 900px) 42vw, 490px" alt="The Linux app on Continue, with the shows in progress beside the one picked and a button to resume its episode" />
					<Shot name="tv-continue" frame="screen" sizes="(min-width: 1200px) 540px, (min-width: 900px) 46vw, 540px" alt="The Android TV app on Continue, with a large button to resume episode 7 and a row of shows in progress" />
					<Shot name="android-continue" frame="phone" sizes="(min-width: 1200px) 140px, (min-width: 900px) 12vw, 140px" alt="The Android app on Continue, with the show in progress and the shows that came out this week" />
				</div>
				<div class="actions sect-actions">
					<a class="btn" href={APPS}>More about the apps</a>
				</div>
			</section>

			<section class="wrap sect" aria-labelledby="player-h">
				<h2 id="player-h">The player</h2>
				<p class="lede">
					Episodes play in mpv, with a button to skip the opening and the next episode ready at the
					end. Drag the line to compare a 480p stream as it is, upscaled, and the 1080p original.
				</p>
				<div class="player-block">
					<UpscaleCompare
						alt="A close-up of a character's face from a 480p stream, shown at 1080p"
						off="/player/compare-off.webp"
						looks={[
							{ id: 'natural', label: 'Natural', note: 'ArtCNN', src: '/player/compare-natural.webp' },
							{ id: 'sharp', label: 'Sharp', note: 'Anime4K', src: '/player/compare-sharp.webp' },
							{ id: 'original', label: 'Original', note: '1080p', src: '/player/compare-original.webp' },
						]}
						width={720}
						height={480}
					>
						Natural keeps the line work as it was drawn and comes closest to the original. Sharp
						draws the lines crisper and bolder than they were.
					</UpscaleCompare>
					<div class="player-shots">
						<figure>
							<a href="/player/player-skip.webp">
								<img src="/player/player-skip.webp" alt="The show's logo during its opening, with a Skip opening button in the corner" width="1920" height="1080" loading="lazy" decoding="async" />
							</a>
							<figcaption>The opening, taken from the file's chapters, with a button to skip it.</figcaption>
						</figure>
						<figure>
							<a href="/player/player-menu.webp">
								<img src="/player/player-menu.webp" alt="The anistream menu inside the player: episodes, sources, sub or dub, upscaling, night mode, subtitles, audio" width="1920" height="1080" loading="lazy" decoding="async" />
							</a>
							<figcaption>Episodes, sources, sub or dub, upscaling and tracks, in one menu.</figcaption>
						</figure>
						<figure>
							<a href="/player/player-up-next.webp">
								<img src="/player/player-up-next.webp" alt="An Up Next card over the ending credits, naming episode 3.2 with a still from its preview" width="1920" height="1080" loading="lazy" decoding="async" />
							</a>
							<figcaption>Up Next at the ending, and the next episode in the same window.</figcaption>
						</figure>
					</div>
					<p class="player-credit">
						These three are the terminal app’s player. Player frames from{' '}
						<a href="https://opap.jp/">こうしす！ #3.1</a>{' '}
						and the comparison from #3.2, by OPAP-JP contributors, licensed{' '}
						<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
					</p>
				</div>
			</section>

			<section class="wrap sect" aria-labelledby="terminal-h">
				<h2 id="terminal-h">The terminal app</h2>
				<p class="lede">
					anistream also runs in a terminal on macOS, Linux and Windows. On a Mac it shares its
					history and config with the Mac app.
				</p>
				<div class="term-block">
					<div class="term-demo">
						<TerminalDemo />
						<p class="caption">
							The home screen, search, an episode list and playback. Covers show as real images in
							terminals with Kitty, Sixel or iTerm2 graphics.
						</p>
					</div>
					<dl class="term-rows">
						{
							terminalRows.map(([title, text]) => (
								<div class="term-row">
									<dt>{title}</dt>
									<dd>{text}</dd>
								</div>
							))
						}
					</dl>
				</div>
				<pre class="code-block" tabindex="0" set:html={installHtml} />
				<p class="caption">Best in a terminal with a graphics protocol: Ghostty, Kitty, iTerm2 or WezTerm.</p>
			</section>

			<section class="wrap sect" aria-labelledby="sources-h">
				<h2 id="sources-h">Sources</h2>
				<p class="legal-lead">{LEGAL}</p>
				<dl class="rows sources">
					{
						sources.map(([name, text]) => (
							<div class="row">
								<dt>{name}</dt>
								<dd>{text}</dd>
							</div>
						))
					}
				</dl>
				<p class="lede">
					Torrent support exists too, off by default and unreachable until you set up the VPN guard.
					What you point any source at is your decision, at your own risk, under the laws that apply to
					you, and every source is a config edit away from being removed.
				</p>
			</section>

			<section class="wrap sect" aria-labelledby="install-h">
				<h2 id="install-h">Installation</h2>
				<p class="lede">Every release has the apps and the terminal app, each file with a .sha256 beside it.</p>
				<div class="actions get-apps">
					{
						APP_DOWNLOADS.map((a) => (
							<a class="btn" href={LATEST} data-asset={a.files[0].suffix}>
								{a.platform}
							</a>
						))
					}
				</div>
				<p class="get-more">
					Windows and Linux get the x64 builds here. <a href={LATEST}>All downloads</a> has the Arm
					builds and the terminal app, and the <a href={INSTALL_GUIDE}>installation guide</a> has
					the first start on each.
				</p>
			</section>

			<section class="wrap sect" aria-labelledby="next-h">
				<h2 id="next-h">Open source</h2>
				<p class="lede">
					anistream is MIT licensed and developed on GitHub. New sources come as plugins, and a
					plugin store shares them with the people you invite.
				</p>
				<div class="actions sect-actions">
					<a class="btn" href={GITHUB}>Follow on GitHub</a>
					<a class="btn" href="/docs/plugins/authoring/">Write a plugin</a>
					<a class="btn" href="/docs/plugins/running-a-store/">Run a store</a>
				</div>
			</section>
		</main>

		<SiteFooter />

		<script>
			import '../scripts/landing-motion.ts';
			import '../scripts/latest-release.ts';
		</script>
	</body>
</html>
