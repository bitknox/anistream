---
import '../styles/theme.css';
import '../styles/landing.css';
import Nagare from '../components/Nagare.astro';
import TerminalDemo from '../components/TerminalDemo.astro';
import UpscaleCompare from '../components/UpscaleCompare.astro';

const RELEASES = 'https://github.com/bitknox/anistream/releases';
const GITHUB = 'https://github.com/bitknox/anistream';
const INSTALL_GUIDE = '/docs/getting-started/installation/';
const LEGAL = 'anistream ships no sources of its own and hosts no content. Every source is external.';

const features: [string, [string, string][]][] = [
	[
		'Browse',
		[
			['Browse without an account', 'Search, seasonal charts and an airing calendar laid out by day, from AniList’s public API. Watch order untangles prequels and sequels in place.'],
			['Real images in the terminal', 'Covers render over the Kitty, Sixel and iTerm2 protocols and are decoded off the event loop, so scrolling does not wait on them. Elsewhere they fall back to halfblocks.'],
			['Vim keys you can rebind', 'hjkl everywhere, with the arrow keys working too. The help overlay is built from your resolved keymap, so it matches what you set.'],
		],
	],
	[
		'Watch',
		[
			['mpv does the playing', 'Seekbar thumbnails, a skip button, Up Next and one menu for episodes, sources and tracks, in one window for a whole binge. Resume is to the second.'],
			['Upscaling built in', 'ArtCNN for a natural look or Anime4K for a sharp one, chosen per file for the source, the display and the battery.'],
			['Ranked source picks', 'Automatic selection is ranked and gives its reason in one line. One key lists every candidate, and the release you choose plays with no failover behind it.'],
			['Watch parties over Syncplay', 'Press y and the episode opens in a Syncplay room instead, with everyone’s player in step. Pauses in the room stay out of your watch history.'],
			['Downloads with history and resume', 'Queue one episode or a range, watch it with full history and resume, and subtitles mux in when a file completes.'],
		],
	],
	[
		'Track',
		[
			['History stays on your disk', 'Watch history is a SQLite database on your machine and works with no account. Trackers receive a copy of it, and a pull from one only moves your progress forward.'],
			['Sync that works offline', 'AniList, MyAnimeList, Kitsu, Simkl and Trakt through a durable outbox. Watch offline for a week and it pushes in order when you return.'],
		],
	],
	[
		'Extend',
		[
			['Sources as plugins', 'Sandboxed WebAssembly components in Rust, JavaScript or any language that builds for WASI 0.2. The host lends fetch, and only to the hosts a plugin declares.'],
			['Plugin stores by invite', 'Run a small private plugin store and invite the people you choose. Each device gets its own token, and every plugin list is signed with the store’s key.'],
		],
	],
];

const bandItems = [
	'Browse, watch, track, sync, extend',
	'Real images in the terminal',
	'Local history in SQLite',
	'Sandboxed WebAssembly plugins',
	'Plugin stores by invite',
	'Syncplay watch parties',
	'ArtCNN and Anime4K upscaling',
	'AniList, MyAnimeList, Kitsu, Simkl and Trakt',
	'No hosted content; every source is external',
	'MIT, prebuilt for macOS, Linux and Windows',
];

const sources: [string, string][] = [
	['AniList', 'Public data for browsing, search, the calendar and title pages, with a pointer to where each title is licensed.'],
	['Plugins', 'For APIs you have the right to use, self-hosted servers and your own media. anistream never circumvents DRM, so a licensed stream opens in its own service.'],
	['Plugin stores', 'Run by someone you know, for the people they invite. anistream lists none of them.'],
];

const releaseFiles = [
	{ platform: 'macOS', note: 'Apple silicon and Intel', installer: '.pkg', archive: '.tar.gz', deps: 'brew install mpv ffmpeg', depsIsCode: true },
	{ platform: 'Linux', note: 'x86-64, glibc 2.28 or newer', installer: '.deb, AppImage', archive: '.tar.gz', deps: 'Your distro’s packages', depsIsCode: false },
	{ platform: 'Windows', note: 'x86-64', installer: 'setup.exe', archive: '.zip', deps: 'winget, as in the docs', depsIsCode: false },
];

const installHtml = [
	'<span class="c-d"># mpv plays, ffmpeg muxes subtitles</span>',
	'<span class="c-d">$</span> brew install mpv ffmpeg',
	'<span class="c-d"># browse with no account, no config</span>',
	'<span class="c-d">$</span> anistream',
	'<span class="c-d"># checked against its SHA-256</span>',
	'<span class="c-d">$</span> anistream <span class="c-n">--update</span>',
].join('\n');

const platforms: [string, string, boolean][] = [
	['Terminal app', 'macOS, Linux and Windows, prebuilt with every release', true],
	['Plugin stores', 'Invite links, a token per device, signed plugin lists', true],
	['Mac, iPhone and iPad', 'One native app on the same engine as the terminal app', false],
	['Android', 'Phones, tablets and foldables, on the same engine', false],
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>anistream · an open-source anime client</title>
		<meta
			name="description"
			content="anistream is an open-source anime client for browsing, watching, tracking and syncing, in your terminal today and in native apps in development. It ships no sources of its own and hosts no content."
		/>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161a2e" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f0ede4" />
		<script is:inline>
			document.documentElement.classList.add('js');
			try {
				var t = localStorage.getItem('starlight-theme');
				var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.dataset.theme =
					t === 'light' || t === 'dark' ? t : dark ? 'dark' : 'light';
			} catch (e) {
				document.documentElement.dataset.theme = 'dark';
			}
		</script>
	</head>
	<body class="landing">
		<div class="ambient" aria-hidden="true"></div>

		<nav class="l-nav" aria-label="Main">
			<a class="l-brand" href="/">
				<svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true">
					<rect x="3" y="1" width="6" height="14" fill="#f2a64b"></rect>
					<rect x="11" y="1" width="1.5" height="14" fill="#f2a64b" opacity="0.55"></rect>
				</svg>
				<span>anistream</span>
			</a>
			<div class="l-nav-links">
				<a href="/docs/">Docs</a>
				<a class="l-nav-releases" href={RELEASES}>Releases</a>
				<a href={GITHUB}>GitHub</a>
			</div>
		</nav>

		<header class="hero">
			<div
				class="scene"
				data-scene
				role="img"
				aria-label="A rooftop at dusk over a lit city, meteors crossing the sky, and Nagare, anistream’s mascot, looking up at them, drawn in terminal halfblocks"
			>
				<canvas data-plane="sky"></canvas>
				<canvas data-plane="far"></canvas>
				<canvas data-plane="near"></canvas>
				<canvas data-plane="front"></canvas>
			</div>
			<div class="wrap hero-copy">
				<div class="hero-text">
					<h1>Browse, watch, track and sync anime <span class="hero-claim">in one client.</span></h1>
					<div class="hero-side">
						<p class="hero-sub">
							It runs in your terminal today, prebuilt for macOS, Linux and Windows. Native apps for
							Mac, iPhone, iPad and Android are in development. Sources come from plugins, and
							anistream ships none of its own.
						</p>
						<div class="actions">
							<a class="btn btn-primary" href={INSTALL_GUIDE}>Install anistream</a>
							<a class="btn" href="/docs/">Read the docs</a>
						</div>
						<p class="hero-note">MIT licence · mpv and ffmpeg are installed separately</p>
					</div>
				</div>
				<div class="hero-term">
					<TerminalDemo />
					<p class="caption">
						The terminal app, going from the home screen to search, the episode list and playback.
						Covers render as real images over the Kitty, Sixel and iTerm2 protocols, and as
						halfblocks elsewhere.
					</p>
				</div>
			</div>
		</header>

		<div class="band" role="note" aria-label={bandItems.join(', ')}>
			<div class="band-track" aria-hidden="true">
				{
					[0, 1].map(() => (
						<span class="band-run">
							{bandItems.map((item) => (
								<>
									<span>{item}</span>
									<span class="band-dot">·</span>
								</>
							))}
						</span>
					))
				}
			</div>
		</div>

		<main>
			<section class="wrap sect" aria-labelledby="features-h">
				<h2 id="features-h">What is in the app today</h2>
				<p class="lede">
					anistream covers finding a show, playing it, keeping your lists in step and adding
					sources. Each part that depends on an outside service sits behind an interface, so a
					source can change or disappear without changes to the rest of the client.
				</p>
				<div class="feat-list">
					<span class="spine" aria-hidden="true">アニストリーム</span>
					{
						features.map(([group, rows]) => (
							<div class="feat-group" role="group" aria-label={group}>
								<p class="caps feat-label feat-label-above">{group}</p>
								{rows.map(([title, body], i) => (
									<div class="feat-row">
										{i === 0 ? <p class="caps feat-label feat-label-beside">{group}</p> : <span />}
										<h3>{title}</h3>
										<p>{body}</p>
									</div>
								))}
							</div>
						))
					}
				</div>
			</section>

			<section class="wrap sect" aria-labelledby="player-h">
				<h2 id="player-h">Inside the player</h2>
				<p class="lede">
					mpv plays every episode in anistream’s own interface, with seekbar thumbnails, a skip
					button while the opening runs, one menu for episodes, sources and tracks, and an Up Next
					card at the ending. Drag the line to compare a 480p stream shown at 1080p as it is,
					upscaled, or against the 1080p original it was made from.
				</p>
				<div class="player-block">
					<UpscaleCompare
						alt="A close-up of a character's face from a 480p stream, shown at 1080p"
						off="/player/compare-off.webp"
						looks={[
							{ id: 'natural', label: 'Natural', note: 'ArtCNN', src: '/player/compare-natural.webp' },
							{ id: 'sharp', label: 'Sharp', note: 'Anime4K', src: '/player/compare-sharp.webp' },
							{ id: 'original', label: 'Original', note: '1080p', src: '/player/compare-original.webp' },
						]}
						width={720}
						height={480}
					>
						Natural keeps the line work as it was drawn, and comes closest to the original. Sharp
						draws the lines crisper and bolder than they were. The network is chosen per file, for
						the source, the display and the battery.
					</UpscaleCompare>
					<div class="player-shots">
						<figure>
							<a href="/player/player-skip.webp">
								<img src="/player/player-skip.webp" alt="The show's logo during its opening, with a Skip opening button in the corner" width="1920" height="1080" loading="lazy" decoding="async" />
							</a>
							<figcaption>The opening, taken from the file's chapters, with a button to skip it.</figcaption>
						</figure>
						<figure>
							<a href="/player/player-menu.webp">
								<img src="/player/player-menu.webp" alt="The anistream menu inside the player: episodes, sources, sub or dub, upscaling, night mode, subtitles, audio" width="1920" height="1080" loading="lazy" decoding="async" />
							</a>
							<figcaption>Episodes, sources, sub or dub, upscaling and tracks, in one menu.</figcaption>
						</figure>
						<figure>
							<a href="/player/player-up-next.webp">
								<img src="/player/player-up-next.webp" alt="An Up Next card over the ending credits, naming episode 3.2 with a still from its preview" width="1920" height="1080" loading="lazy" decoding="async" />
							</a>
							<figcaption>Up Next at the ending, and the next episode in the same window.</figcaption>
						</figure>
					</div>
					<p class="player-credit">
						Player frames from{' '}
						<a href="https://opap.jp/">こうしす！ #3.1</a>{' '}
						and the comparison from #3.2, by OPAP-JP contributors, licensed{' '}
						<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
					</p>
				</div>
			</section>

			<section class="wrap sect" aria-labelledby="sources-h">
				<h2 id="sources-h">Where episodes come from</h2>
				<p class="legal-lead">{LEGAL}</p>
				<dl class="rows sources">
					{
						sources.map(([name, text]) => (
							<div class="row">
								<dt>{name}</dt>
								<dd>{text}</dd>
							</div>
						))
					}
				</dl>
				<p class="lede">
					Torrent support exists too, off by default and unreachable until you set up the VPN guard.
					What you point any external source at is your decision, at your own risk, under the laws that
					apply to you, and every source is a config edit away from being removed.
				</p>
			</section>

			<section class="wrap sect" aria-labelledby="install-h">
				<h2 id="install-h">Installation</h2>
				<p class="lede">
					Every release ships an installer and an archive for each platform, each with a .sha256
					worth checking first. mpv and ffmpeg are not bundled, and the player’s own interface
					wants mpv 0.36 or newer.
				</p>
				<table class="release-files">
					<caption class="sr-only">Release files</caption>
					<thead>
						<tr>
							<th scope="col">Platform</th>
							<th scope="col"><span class="sr-only">Builds</span></th>
							<th scope="col">Installer</th>
							<th scope="col">Archive</th>
							<th scope="col">mpv and ffmpeg</th>
						</tr>
					</thead>
					<tbody>
						{
							releaseFiles.map((f) => (
								<tr>
									<th scope="row">
										{f.platform}
										<span class="rf-note-inline">{f.note}</span>
									</th>
									<td class="rf-note">{f.note}</td>
									<td class="rf-file">{f.installer}</td>
									<td class="rf-file">
										<span class="rf-sep" aria-hidden="true">· </span>
										{f.archive}
									</td>
									<td class={f.depsIsCode ? 'rf-deps rf-code' : 'rf-deps'}>
										<span class="rf-deps-label">mpv and ffmpeg: </span>
										{f.deps}
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
				<div class="actions">
					<a class="btn btn-primary" href={RELEASES}>Download a release</a>
					<a class="btn" href={INSTALL_GUIDE}>Installation guide</a>
				</div>
				<pre class="code-block" tabindex="0" set:html={installHtml} />
				<p class="caption">Best in a terminal with a graphics protocol: Ghostty, Kitty, iTerm2 or WezTerm.</p>
			</section>

			<section class="wrap sect" aria-labelledby="next-h">
				<h2 id="next-h">Building in the open</h2>
				<p class="lede">
					anistream is under active development, in the open on GitHub. New sources arrive as
					plugins, and plugin stores share them with the people you choose.
				</p>
				<ul class="platforms">
					{
						platforms.map(([name, text, available]) => (
							<li>
								<span class="platform-name">{name}</span>
								<span class="platform-text">{text}</span>
								<span class="status">
									<span class:list={['status-dot', { 'is-available': available }]} aria-hidden="true" />
									{available ? 'Available' : 'In development'}
								</span>
							</li>
						))
					}
				</ul>
				<div class="actions">
					<a class="btn" href={GITHUB}>Follow on GitHub</a>
					<a class="btn" href="/docs/plugins/authoring/">Write a plugin</a>
					<a class="btn" href="/docs/plugins/running-a-store/">Run a store</a>
				</div>
			</section>
		</main>

		<footer class="wrap l-footer">
			<div class="footer-mascot">
				<Nagare cell={5} class="footer-nagare" />
				<p>Nagare 流 is anistream’s mascot, an original character.</p>
			</div>
			<div class="footer-legal">
				<p>{LEGAL}</p>
				<p class="footer-licence">anistream is open source under the MIT licence.</p>
			</div>
			<nav aria-label="Footer">
				<a href="/docs/">Docs</a>
				<a href={RELEASES}>Releases</a>
				<a href={GITHUB}>GitHub</a>
			</nav>
		</footer>

		<script>
			import '../scripts/landing-motion.ts';
		</script>
	</body>
</html>
