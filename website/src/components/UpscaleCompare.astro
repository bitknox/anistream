---
// One frame, upscaled two ways: the source as it is on the left, a chosen look on the right,
// and a divider to drag between them. The divider is a range input laid over the picture, so
// it works from the keyboard and reads as a slider to a screen reader without any of its own
// event handling.

interface Look {
	id: string;
	label: string;
	note: string;
	src: string;
}

interface Props {
	/** What the frame shows, for anyone who cannot see it. */
	alt: string;
	/** The frame with no upscaling. */
	off: string;
	looks: Look[];
	width: number;
	height: number;
}

const { alt, off, looks, width, height } = Astro.props;
---

<figure class="compare" data-compare>
	<div class="compare-choice" role="radiogroup" aria-label="Compare with">
		{
			looks.map((look, i) => (
				<button
					type="button"
					role="radio"
					aria-checked={i === 0 ? 'true' : 'false'}
					tabindex={i === 0 ? 0 : -1}
					data-src={look.src}
					data-label={look.label}
				>
					{look.label} <span class="compare-note">{look.note}</span>
				</button>
			))
		}
	</div>
	<div class="compare-frame" style={`aspect-ratio: ${width} / ${height}`}>
		<img class="compare-off" src={off} alt={`${alt}, with no upscaling`} width={width} height={height} loading="lazy" decoding="async" />
		<img
			class="compare-look"
			src={looks[0].src}
			alt={`${alt}, upscaled`}
			width={width}
			height={height}
			loading="lazy"
			decoding="async"
		/>
		<span class="compare-tag compare-tag-off" aria-hidden="true">Off</span>
		<span class="compare-tag compare-tag-look" aria-hidden="true">{looks[0].label}</span>
		<span class="compare-divider" aria-hidden="true">
			<span class="compare-handle">
				<svg width="16" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
					<path d="M5 2 L1.5 6 L5 10 M11 2 L14.5 6 L11 10"></path>
				</svg>
			</span>
		</span>
		<input
			class="compare-range"
			type="range"
			min="0"
			max="100"
			value="50"
			step="0.5"
			aria-label={`Divide the picture between no upscaling and ${looks[0].label}`}
		/>
	</div>
	<figcaption><slot /></figcaption>
</figure>

<style>
	.compare {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
		--pos: 50%;
	}

	/* The look picker is the segmented capsule the docs' tabs use. */
	.compare-choice {
		display: inline-flex;
		align-self: flex-start;
		height: 36px;
		padding: 2px;
		border-radius: 18px;
		background: var(--ani-raised);
	}

	.compare-choice button {
		height: 32px;
		padding: 0 14px;
		border: 0;
		border-radius: 16px;
		background: transparent;
		color: var(--ani-dim);
		font: inherit;
		font-size: 14px;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color var(--ani-quick) var(--ani-spring),
			color var(--ani-quick) var(--ani-spring);
	}

	.compare-choice button[aria-checked='true'] {
		background: var(--ani-raised-selected);
		color: var(--ani-text);
		font-weight: 600;
	}

	.compare-note {
		margin-left: 6px;
		font-weight: 400;
		color: var(--ani-dim);
	}

	.compare-frame {
		position: relative;
		overflow: hidden;
		border-radius: var(--ani-r-banner);
		background: var(--ani-raised);
		user-select: none;
		touch-action: pan-y;
	}

	.compare-frame img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	.compare-look {
		clip-path: inset(0 0 0 var(--pos));
	}

	/* A picture: the line, the handle and the chips keep their dark-mode colours in both modes. */
	.compare-divider {
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--pos);
		width: 2px;
		margin-left: -1px;
		background: #e4e0d6;
		pointer-events: none;
	}

	.compare-handle {
		position: absolute;
		top: 50%;
		left: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 16px;
		transform: translate(-50%, -50%);
		background: var(--ani-obi-fill);
		color: #161a2e;
	}

	.compare-tag {
		position: absolute;
		top: 14px;
		display: flex;
		align-items: center;
		height: 26px;
		padding: 0 11px;
		box-sizing: border-box;
		border: 1px solid var(--ani-over-art-edge);
		border-radius: 13px;
		background: var(--ani-over-art);
		color: #e4e0d6;
		font-size: 13px;
		font-weight: 500;
		pointer-events: none;
	}

	.compare-tag-off {
		left: 14px;
	}

	.compare-tag-look {
		right: 14px;
	}

	.compare-range {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		opacity: 0;
		cursor: ew-resize;
	}

	.compare-frame:has(.compare-range:focus-visible) {
		outline: 2px solid var(--ani-obi);
		outline-offset: 2px;
	}

	figcaption {
		max-width: 792px;
		font-size: 14px;
		line-height: 20px;
		color: var(--ani-dim);
	}

	@media (max-width: 599px) {
		.compare-choice button {
			padding: 0 16px;
		}

		.compare-note {
			display: none;
		}

		.compare-tag {
			top: 10px;
		}

		.compare-tag-off {
			left: 10px;
		}

		.compare-tag-look {
			right: 10px;
		}
	}
</style>

<script>
	for (const figure of document.querySelectorAll<HTMLElement>('[data-compare]')) {
		const range = figure.querySelector<HTMLInputElement>('.compare-range')!;
		const look = figure.querySelector<HTMLImageElement>('.compare-look')!;
		const tag = figure.querySelector<HTMLElement>('.compare-tag-look')!;
		const buttons = [...figure.querySelectorAll<HTMLButtonElement>('.compare-choice button')];

		const place = () => figure.style.setProperty('--pos', `${range.value}%`);
		range.addEventListener('input', place);
		place();

		const choose = (button: HTMLButtonElement) => {
			for (const b of buttons) {
				b.setAttribute('aria-checked', String(b === button));
				b.tabIndex = b === button ? 0 : -1;
			}
			look.src = button.dataset.src!;
			tag.textContent = button.dataset.label!;
			range.setAttribute('aria-label', `Divide the picture between no upscaling and ${button.dataset.label}`);
		};
		buttons.forEach((button, i) => {
			button.addEventListener('click', () => choose(button));
			// A radio group moves with the arrow keys.
			button.addEventListener('keydown', (event) => {
				const step = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 0;
				if (!step) return;
				event.preventDefault();
				const next = buttons[(i + step + buttons.length) % buttons.length];
				next.focus();
				choose(next);
			});
		});
	}
</script>
