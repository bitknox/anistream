---
// The foot of the landing page and the apps page: Nagare, the legal line, the licence and links.
import Nagare from '../Nagare.astro';
import { useSite } from '../../i18n/site';
import { APPS, FEATURES, GITHUB, PRIVACY, RELEASES } from '../../data/site';

const { t, href } = useSite(Astro);
---

<footer class="l-footer">
	<div class="footer-mascot">
		<Nagare cell={5} class="footer-nagare" />
		<p>{t('site.footer.mascot')}</p>
	</div>
	<div class="footer-legal">
		<p>{t('site.legal')}</p>
		<p class="footer-licence">{t('site.footer.licence')}</p>
	</div>
	<nav aria-label={t('site.footer.label')}>
		<a href={href(APPS)}>{t('site.nav.apps')}</a>
		<a href={href(FEATURES)}>{t('site.nav.features')}</a>
		<a href={href('/docs/')}>{t('site.nav.docs')}</a>
		<a href={href(PRIVACY)}>{t('site.footer.privacy')}</a>
		<a href={RELEASES}>{t('site.nav.releases')}</a>
		<a href={GITHUB}>GitHub</a>
	</nav>
</footer>
