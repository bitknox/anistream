<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group the app writes the widgets' snapshot into: ANISTREAM_APP_GROUP
	     (Config/Base.xcconfig). The Fixtures app has none, so it never writes over the app's. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(ANISTREAM_APP_GROUP)</string>
	</array>
</dict>
</plist>
