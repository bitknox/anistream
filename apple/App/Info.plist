<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group the widgets' snapshot is written into, from ANISTREAM_APP_GROUP
	     (Config/Base.xcconfig). The Fixtures app has none, so it never writes over the app's. -->
	<key>AnistreamAppGroup</key>
	<string>$(ANISTREAM_APP_GROUP)</string>
	<!-- What Xcode does not generate from the INFOPLIST_KEY settings: the anistream:// links the
	     app opens, for store invites, the trackers' sign-in and the widgets. The Fixtures app has
	     none. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>tv.anistream.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>anistream</string>
			</array>
		</dict>
	</array>
	<!-- iPhone and iPad: the episode's audio plays on when the screen locks or the app goes to
	     the background, with the video track off meanwhile. Free signing allows this mode. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
