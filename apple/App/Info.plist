<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What Xcode does not generate from the INFOPLIST_KEY settings: the anistream:// links the
	     app opens, for store invites and the trackers' sign-in. The Fixtures app has none. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>tv.anistream.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>anistream</string>
			</array>
		</dict>
	</array>
	<!-- iPhone and iPad: the episode's audio plays on when the screen locks or the app goes to
	     the background, with the video track off meanwhile. Free signing allows this mode. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Handoff: a title's page, and the episode playing (native-spec/native-layer.md). The
	     Fixtures app has types of its own, so it and the app never take each other's. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>tv.anistream.title</string>
		<string>tv.anistream.playing</string>
	</array>
</dict>
</plist>
