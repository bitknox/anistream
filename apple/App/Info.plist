<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group the widgets' snapshot is written into, from ANISTREAM_APP_GROUP
	     (Config/Base.xcconfig). The Fixtures app has none, so it never writes over the app's. -->
	<key>AnistreamAppGroup</key>
	<string>$(ANISTREAM_APP_GROUP)</string>
	<!-- What Xcode does not generate from the INFOPLIST_KEY settings: the anistream:// links the
	     app opens, for store invites, the trackers' sign-in and the widgets. The Fixtures app has
	     none. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>tv.anistream.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>anistream</string>
			</array>
		</dict>
		<!-- The QR code on a TV's Pair a phone screen, read by the system's camera. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>tv.anistream.remote</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>anistream-remote</string>
			</array>
		</dict>
	</array>
	<!-- Play on TV: finding the TVs that run anistream on the network, which asks for local
	     network access the first time, and the camera for the code a TV shows to pair. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>anistream looks for TVs running anistream on your network, so you can play episodes on them and use this device as their remote.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_anistream._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>anistream reads the code a TV shows, to pair with it.</string>
	<!-- iPhone and iPad: the episode's audio plays on when the screen locks or the app goes to
	     the background, with the video track off meanwhile. Free signing allows this mode. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- The app refresh task that keeps new-episode notifications scheduled. -->
		<string>fetch</string>
		<!-- Downloads going on after the app leaves, in a continued-processing task. -->
		<string>processing</string>
	</array>
	<!-- Handoff: a title's page, and the episode playing (native-spec/native-layer.md). The
	     Fixtures app has types of its own, so it and the app never take each other's. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>tv.anistream.title</string>
		<string>tv.anistream.playing</string>
	</array>
	<!-- iPhone and iPad: the launch screen, the ground with Nagare whole at 4 pt a cell
	     (LaunchNagare, drawn on whole pixels by scripts/icon.sh), nothing animated. The Mac has
	     none and ignores this. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchGround</string>
		<key>UIImageName</key>
		<string>LaunchNagare</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<!-- The Mac's updater, Sparkle (MacUpdater.swift): the feed each release publishes, the
	     public half of the key its .dmg and the feed are signed with, and no checks or installs of
	     its own. iPhone and iPad have no Sparkle and ignore these; the Fixtures app has none. -->
	<key>SUFeedURL</key>
	<string>https://github.com/bitknox/anistream/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>PQ5AUO8TwXyY94naXJw856LWoLiHc6goFN+scXCf2RQ=</string>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<!-- iPhone and iPad: the background refresh, which checks for new episodes, schedules the
	     week's notifications and writes the widgets' record. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>tv.anistream.refresh</string>
		<!-- Downloads after the app leaves: each window's identifier has a suffix of its own. -->
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).downloads.*</string>
	</array>
</dict>
</plist>
