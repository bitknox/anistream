<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What Xcode does not generate from the INFOPLIST_KEY settings: the anistream:// links the
	     app opens, for store invites and the trackers' sign-in. The Fixtures app has none. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>tv.anistream.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>anistream</string>
			</array>
		</dict>
	</array>
	<!-- iPhone and iPad: the episode's audio plays on when the screen locks or the app goes to
	     the background, with the video track off meanwhile. Free signing allows this mode. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<!-- The app refresh task that keeps new-episode notifications scheduled. -->
		<string>fetch</string>
	</array>
	<!-- Handoff: a title's page, and the episode playing (native-spec/native-layer.md). The
	     Fixtures app has types of its own, so it and the app never take each other's. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>tv.anistream.title</string>
		<string>tv.anistream.playing</string>
	</array>
	<!-- iPhone and iPad: the launch screen, the ground with Nagare whole at 4 pt a cell
	     (LaunchNagare, drawn on whole pixels by scripts/icon.sh), nothing animated. The Mac has
	     none and ignores this. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchGround</string>
		<key>UIImageName</key>
		<string>LaunchNagare</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<!-- iPhone and iPad: the background refresh, which checks for new episodes, schedules the
	     week's notifications and writes the widgets' record. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>tv.anistream.refresh</string>
	</array>
	<!-- The App Group the app writes the widgets' record into, from ANISTREAM_APP_GROUP. The
	     Fixtures app has none, so it never writes over the app's. -->
	<key>AnistreamAppGroup</key>
	<string>$(ANISTREAM_APP_GROUP)</string>
</dict>
</plist>
