<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Play on TV: finding the TVs that run anistream on the network, which asks for local
	     network access the first time, and the camera for the code a TV shows to pair. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>anistream looks for TVs running anistream on your network, so you can play episodes on them and use this device as their remote.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_anistream._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>anistream reads the code a TV shows, to pair with it.</string>
	<!-- What Xcode does not generate for the Fixtures app: the background audio the app has, so
	     its player is tried as the app's plays. No anistream:// links: the app opens those. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Handoff: a title's page, and the episode playing (native-spec/native-layer.md). The
	     Fixtures app has types of its own, so it and the app never take each other's. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>tv.anistream.fixtures.title</string>
		<string>tv.anistream.fixtures.playing</string>
	</array>
	<!-- iPhone and iPad: the launch screen, the ground with Nagare whole at 4 pt a cell
	     (LaunchNagare, drawn on whole pixels by scripts/icon.sh), nothing animated. The Mac has
	     none and ignores this. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchGround</string>
		<key>UIImageName</key>
		<string>LaunchNagare</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
