    "stores-leave-detail" : {
      "comment" : "Line under it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät kann keine Plugins mehr installieren oder aktualisieren. Bereits installierte Plugins bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device can no longer install or update its plugins. Plugins already installed stay."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo ya no puede instalar ni actualizar sus complementos. Los complementos ya instalados se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne peut plus installer ni mettre à jour ses plugins. Les plugins déjà installés restent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "perangkat ini tidak lagi dapat memasang atau memperbarui plugin-plugin. Plugin-plugin yang sudah terpasang tidak ikut dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non può più installare o aggiornare i suoi plugin. I Plugin già installati restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは、プラグインのインストールや更新ができなくなります。すでにインストールされているプラグインはそのまま残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczki zainstalowane wcześniej zostają. Instalowanie i aktualizowanie jest już wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não pode mais instalar nem atualizar os plugins. Os plugins já instalados continuam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство больше не может устанавливать или обновлять свои плагины. Уже установленные плагины остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten kan inte längre installera eller uppdatera sina tillägg. Tillägg som redan är installerade finns kvar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihaz artık eklentiler yükleyemez ya da güncelleyemez. Zaten yüklü eklentiler kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không còn có thể cài đặt hoặc cập nhật các plugin trên thiết bị này. Các plugin đã cài vẫn được giữ lại."
          }
        }
      }
    },
    "stores-leave-rejoin" : {
