    "stores-remove-member-detail" : {
      "comment" : "Line under it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Geräte verlieren den Zugriff auf diesen Plugin-Store. Plugins, die sie installiert haben, funktionieren weiter, werden aber nicht mehr aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Their devices lose access to this plugin store. Plugins they installed keep working but stop updating."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus dispositivos pierden acceso a esta tienda de complementos. Los complementos que instalaron siguen funcionando, pero dejan de actualizarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses appareils perdent l'accès à cette boutique de plugins. Les plugins qu'ils ont installés continuent de fonctionner, mais ne se mettent plus à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I loro dispositivi perdono l'accesso a questo negozio di plugin. I Plugin che hanno installato continuano a funzionare, ma smettono di aggiornarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この人のデバイスは、このプラグインストアにアクセスできなくなります。インストール済みのプラグインは引き続き動作しますが、更新は停止されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich urządzenia tracą dostęp. Wtyczki zainstalowane przez nich działają dalej, ale przestają się aktualizować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dispositivos da pessoa perdem o acesso a esta loja de plugins. Os plugins instalados continuam funcionando, mas param de ser atualizados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Их устройства теряют доступ к этому магазину. Плагины, которые они установили, продолжают работать, но перестают обновляться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deras enheter förlorar åtkomst till den här tilläggsbutiken. Tillägg som de installerat fungerar fortfarande men uppdateras inte längre."
          }
        }
      }
    },
