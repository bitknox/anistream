          }
        }
      }
    },
    "notice-player-failed-to-start" : {
      "comment" : "Toast when the player cannot be started. The reason comes from the system. Argument 1: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv konnte nicht gestartet werden. Prüfe, ob es allein läuft. (%1$@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't start mpv. Check that it runs on its own. (%1$@)"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo iniciar mpv. Comprueba que mpv se abra por sí solo. (%1$@)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lancer mpv. Vérifiez qu'il démarre seul. (%1$@)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak bisa memulai mpv. Pastikan mpv bisa berjalan sendiri. (%1$@)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile avviare mpv. Verifica che si avvii da solo. (%1$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpvを起動できませんでした。mpvが単独で起動するか確認してください。（%1$@）"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się uruchomić mpv. Sprawdź, czy działa samodzielnie. (%1$@)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar o mpv. Verifique se ele roda sozinho. (%1$@)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось запустить mpv. Проверьте, что mpv запускается сам по себе. (%1$@)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att starta mpv. Kontrollera att den startar på egen hand. (%1$@)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv başlatılamadı. Tek başına çalışıp çalışmadığını kontrol edin. (%1$@)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không khởi chạy được mpv. Hãy kiểm tra mpv chạy được khi mở riêng. (%1$@)"
          }
        }
      }
    },
    "notice-player-not-playing" : {
      "comment" : "Toast when no picture has appeared a while after the player opened. Argument 1: seconds (Int).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv hat nach %1$lld s noch nicht mit der Wiedergabe begonnen. Die Quelle hat vielleicht keine Daten. Prüfe, ob mpv allein eine Datei abspielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv hasn't started playing after %1$lld s. The source may have no data. Check that mpv plays a file on its own."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv no empezó a reproducir después de %1$lld s. La fuente puede no tener datos. Comprueba que mpv reproduzca un archivo por sí solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv n'a pas commencé la lecture après %1$lld s. La source n'a peut-être pas de données. Vérifiez que mpv lit un fichier tout seul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv belum mulai memutar setelah %1$lld dtk. sumber ini mungkin tidak punya data. Pastikan mpv bisa memutar file sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv non ha iniziato a riprodurre dopo %1$lld s. La fonte potrebbe non avere dati. Verifica che mpv riproduca un file da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld秒経っても、mpvで再生が始まりません。ソースにデータがない可能性があります。mpvが単独でファイルを再生できるか確認してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv nie zaczął odtwarzać po %1$lld s. Źródło może nie mieć danych. Sprawdź, czy mpv odtwarza plik samodzielnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mpv ainda não começou a reproduzir depois de %1$lld s. A fonte pode não ter dados. Verifique se o mpv reproduz um arquivo sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv не начал воспроизведение через %1$lld с. У источника может не быть данных. Проверьте, что mpv сам воспроизводит файлы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv har inte börjat spela efter %1$lld s. Den här källan kan sakna data. Kontrollera att mpv spelar upp en fil på egen hand."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$lld sn geçmesine rağmen oynatmaya başlamadı. Bu kaynak veri içermiyor olabilir. mpv'nin bir dosyayı tek başına oynatıp oynatmadığını kontrol edin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv chưa bắt đầu phát sau %1$lld giây. Nguồn có thể không có dữ liệu. Hãy kiểm tra mpv có phát được một tệp khi chạy riêng không."
          }
        }
      }
    },
