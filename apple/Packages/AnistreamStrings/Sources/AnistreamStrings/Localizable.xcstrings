    "stores-open-join-off-detail" : {
      "comment" : "Line under the switch of the who-can-join sheet while only invited people can join.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur eingeladene Personen können beitreten. Wenn eingeschaltet, treten alle mit dem Link ohne Namen bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only people you invite can join. Turned on, anyone with the link joins, without a name."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo pueden unirse las personas que invitas. Si lo activas, cualquiera con el enlace se une, sin nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les personnes que vous invitez peuvent rejoindre. Activé, toute personne disposant du lien peut rejoindre, sans nom."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya orang yang Anda undang yang bisa bergabung. Jika dinyalakan, siapa pun dengan tautan bisa bergabung tanpa nama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possono unirsi solo le persone che invito. Se lo attivi, chiunque abbia il link si unisce, senza nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "招待した人だけが参加できます。オンにすると、リンクを持つ人は名前なしで参加できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mogą dołączać tylko zaproszone osoby. Po włączeniu każdy z linkiem może dołączyć bez nazwy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só entram pessoas que você convidar. Ao ligar, quem tiver o link entra, sem nome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключаются только приглашённые. Если включить, по ссылке сможет зайти любой, без имени."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara personer du bjuder in kan gå med. Slår du på det kan alla med länken gå med, utan namn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca davet ettiğiniz kişiler katılabilir. Açarsanız bağlantısı olan herkes ad girmeden katılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ những người được mời mới tham gia được. Khi bật, bất kỳ ai có liên kết đều tham gia, không cần tên."
          }
        }
      }
    },
    "stores-open-join-on-detail" : {
      "comment" : "Line under the switch of the who-can-join sheet while anyone with the link can join.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie treten ohne Namen bei. Wenn du das ausschaltest, wird der Link gestoppt. Wenn du ihn wieder einschaltest, entsteht ein neuer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They join without a name. Turning this off stops the link; turning it on again makes a new one."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se unen sin nombre. Al desactivarlo, el enlace deja de funcionar; al activarlo otra vez, se crea uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils rejoignent sans nom. Désactiver ce réglage arrête le lien ; le réactiver en crée un nouveau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mereka bergabung tanpa nama. Jika dimatikan, tautan berhenti berfungsi. Jika dinyalakan lagi, tautan baru akan dibuat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si uniscono senza nome. Se lo disattivi, il link smette di funzionare; se lo riattivi, ne viene creato uno nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前なしで参加できます。オフにするとリンクは使えなくなり、再びオンにすると新しいリンクが作られます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołączają bez nazwy. Wyłączenie zamyka link, a ponowne włączenie tworzy nowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entram sem nome. Desligar isso interrompe o link; ligar de novo cria um novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они подключаются без имени. Если выключить, ссылка перестанет работать. Если включить снова, будет создана новая."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De går med utan namn. Stänger du av det slutar länken fungera. Slår du på det igen skapas en ny."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad girmeden katılırlar. Kapatırsanız bağlantı durur. Yeniden açarsanız yeni bir bağlantı oluşturulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Họ tham gia mà không cần nhập tên. Tắt sẽ ngừng liên kết; bật lại sẽ tạo liên kết mới."
          }
        }
      }
    },
