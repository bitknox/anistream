    "torrent-no-kill-switch" : {
      "comment" : "Toast when torrents are up but no operating-system firewall rule backs the VPN guard. Terminal only: the engine never sends it to the apps.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät stoppt nichts den Torrent-Verkehr, wenn das VPN ausfällt. Führe „anistream --doctor“ aus, um das einzurichten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing on this device stops torrent traffic if the VPN drops. Run \"anistream --doctor\" to set that up."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en este dispositivo detiene el tráfico de torrents si cae la VPN. Ejecuta \"anistream --doctor\" para configurarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien sur cet appareil n’arrête le trafic torrent si le VPN tombe. Lancez « anistream --doctor » pour le configurer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla su questo dispositivo ferma il traffico torrent se la VPN cade. Esegui \"anistream --doctor\" per configurarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPNが切断された場合にトレントの通信を止める仕組みが、このデバイスにはありません。「anistream --doctor」を実行すると設定できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żadna reguła zapory nie zatrzyma ruchu torrentów, jeśli VPN się rozłączy. Uruchom „anistream --doctor”, aby to skonfigurować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada neste dispositivo interrompe o tráfego de torrents se a VPN cair. Rode \"anistream --doctor\" para configurar isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничто не останавливает торрент-трафик, если VPN отключится. Запустите «anistream --doctor», чтобы настроить защиту."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting på den här enheten stoppar torrenttrafiken om VPN:en tappas. Kör \"anistream --doctor\" för att ställa in det."
          }
        }
      }
    },
