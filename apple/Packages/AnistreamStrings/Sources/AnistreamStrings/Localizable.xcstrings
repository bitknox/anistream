      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New this week"
          }
        }
      }
    },
    "language-draft-label" : {
      "comment" : "Label beside a language whose text a person has not reviewed yet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draft translation"
          }
        }
      }
    },
    "language-draft-note" : {
      "comment" : "Note under the language row and in the language list, for a draft language.",
