          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att återställa matchningen. %1$@"
          }
        }
      }
    },
    "notice-match-save-failed" : {
      "comment" : "Toast when the chosen match could not be saved. The reason comes from the system. Argument 1: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
