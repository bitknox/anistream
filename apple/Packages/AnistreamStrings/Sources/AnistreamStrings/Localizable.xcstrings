    "notice-match-uncertain" : {
      "comment" : "Toast when a source found several shows that could be this one and could not tell which. The episodes shown are AniList's until one is picked. The source is its name. Argument 1: source (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ found more than one show that could be this one, so these episodes are from AniList for now."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@で、この作品の候補になりうる作品が複数見つかりました。候補を選ぶまでは、エピソードはAniListの情報を表示しています。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hittade fler än en serie som kan vara den här, så avsnitten kommer från AniList tills vidare."
          }
        }
      }
    },
    "notice-metadata-cached" : {
      "comment" : "Toast when no metadata service answered and the last cached data is shown.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No metadata service answered. Showing what was last cached."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのメタデータサービスも応答しませんでした。最後にキャッシュされた内容を表示しています。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen metadatatjänst svarade. Visar det senast sparade."
          }
        }
      }
    },
    "notice-mpv-missing" : {
      "comment" : "Toast at launch when the mpv program is missing. The binary is the name the settings give it. Terminal only: the engine never sends it to the apps. Argument 1: binary (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wasn't found. Install mpv to play episodes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が見つかりませんでした。エピソードを再生するには、mpvをインストールしてください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hittades inte. Installera mpv för att spela avsnitt."
          }
        }
      }
    },
    "notice-mpv-old" : {
      "comment" : "Toast at launch when mpv is too old for anistream's own player. Terminal only: the engine never sends it to the apps. Argument 1: version (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ can play, but anistream's player needs mpv 0.36 or newer for its skip button, Up next card, menus and thumbnails."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@では再生できますが、anistreamのプレーヤーは、スキップボタン、次のエピソードカード、メニュー、サムネイルのためにmpv 0.36以降が必要です。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mpv %1$@ kan spela, men anistreams spelare kräver mpv 0.36 eller nyare för hoppknappen, kortet Nästa, menyerna och miniatyrerna."
          }
        }
      }
    },
    "notice-no-next-episode" : {
      "comment" : "Toast when the next-episode control is used and the next episode is not known.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no next episode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のエピソードはありません。"
          }
