      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This translation has not been reviewed yet. Some text may be wrong."
          }
        }
      }
    },
    "language-follow-system" : {
      "comment" : "First choice in the language list: use the device's language.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow system language"
          }
        }
      }
    },
    "language-restart-note" : {
      "comment" : "Shown after changing the language on Windows, Linux and in the terminal, which read it at start.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restart anistream to use the new language."
          }
        }
      }
    },
    "legal-hosts-no-content" : {
      "comment" : "The legal line. It exists once, so no translation can paraphrase it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream hosts no content."
          }
        }
      }
    },
    "menu-show-library" : {
      "comment" : "Mac menu bar item. Title Case, as Apple's guidelines ask for the menu bar only.",
