      "comment" : "Note under the language row and in the language list, for a draft language.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This translation has not been reviewed yet. Some text may be wrong."
          }
        }
      }
    },
    "language-follow-system" : {
      "comment" : "First choice in the language list: use the device's language.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow system language"
          }
        }
      }
    },
    "language-restart-note" : {
      "comment" : "Shown after changing the language on Windows, Linux and in the terminal, which read it at start.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restart anistream to use the new language."
          }
        }
      }
    },
    "legal-hosts-no-content" : {
      "comment" : "The legal line. It exists once, so no translation can paraphrase it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream hosts no content."
          }
        }
      }
    },
    "menu-show-library" : {
      "comment" : "Mac menu bar item. Title Case, as Apple's guidelines ask for the menu bar only.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Library"
          }
        }
      }
    },
    "notice-anilist-client-missing" : {
      "comment" : "Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated. Argument 1: client (Text). Argument 2: secret (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList needs a client id and secret. Set %1$@ and %2$@ in the config file, then sign in again. To get the sign-in address, run anistream --login-url."
          }
        }
      }
    },
    "notice-anilist-implicit-flow" : {
      "comment" : "Toast when AniList is set to a sign-in method only the anistream app can finish. The setting name is a key of the config file and is not translated. Argument 1: setting (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This AniList sign-in method works only in the anistream app. To sign in here, set %1$@ to \"loopback\" in the config file."
          }
        }
      }
    },
    "notice-anilist-paste-flow" : {
      "comment" : "Toast when AniList is set to paste the code by hand, which a running terminal app cannot take.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasting a code isn't possible here. Quit and run anistream --login instead."
          }
        }
      }
    },
    "notice-browser-not-opened" : {
      "comment" : "Toast when no browser could be opened for a sign-in. The reason comes from the system. Argument 1: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't open a browser for the sign-in. Check that one is installed and try again. %1$@"
          }
        }
      }
    },
    "notice-client-id-missing" : {
      "comment" : "Toast when a device-code sign-in needs a client id in the config file. The setting name is a key of the config file and is not translated. Argument 1: setting (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set %1$@ in the config file first."
          }
        }
      }
    },
    "notice-episode-aired" : {
      "comment" : "Toast, and desktop notification, for one episode that aired while the app was closed. Argument 1: title (Text). Argument 2: episode (Int).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, episode %2$lld, aired while you were away."
          }
        }
      }
    },
    "notice-episodes-aired" : {
      "comment" : "Toast, and desktop notification, for several episodes that aired while the app was closed. Argument 1: count (Int).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
