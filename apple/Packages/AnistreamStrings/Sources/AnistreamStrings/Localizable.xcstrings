        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第%1$lld話はまだ放送されていません。第%2$lld話は%3$@に放送予定です。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsnitt %1$lld har inte sänts än. Avsnitt %2$lld sänds %3$@."
          }
        }
      }
    },
    "notice-not-saved" : {
