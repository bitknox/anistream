    "notice-mal-client-missing" : {
      "comment" : "Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated. Argument 1: setting (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList braucht eine Client-ID. Registriere auf myanimelist.net/apiconfig eine App vom Typ „other“ und setze dann %1$@ in der Konfigurationsdatei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList needs a client id. Register an app with the type \"other\" at myanimelist.net/apiconfig, then set %1$@ in the config file."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList necesita un id de cliente. Registra una app con el tipo \"other\" en myanimelist.net/apiconfig y luego pon %1$@ en el archivo de configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList a besoin d'un identifiant de client. Enregistrez une application de type « other » sur myanimelist.net/apiconfig, puis réglez %1$@ dans le fichier de configuration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList richiede un id client. Registra un'app di tipo \"other\" su myanimelist.net/apiconfig, poi imposta %1$@ nel file di configurazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeListにはクライアントIDが必要です。myanimelist.net/apiconfigで種類を「other」としてアプリを登録し、設定ファイルで%1$@を設定してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList wymaga identyfikatora klienta. Zarejestruj aplikację z typem „other” na myanimelist.net/apiconfig, a potem ustaw %1$@ w pliku konfiguracyjnym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MyAnimeList precisa de um ID de cliente. Registre um app do tipo \"other\" em myanimelist.net/apiconfig e defina %1$@ no arquivo de configuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList требует идентификатор клиента. Зарегистрируйте приложение с типом «other» на myanimelist.net/apiconfig, затем задайте %1$@ в файле настроек."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList behöver ett klient-id. Registrera en app med typen \"other\" på myanimelist.net/apiconfig och sätt sedan %1$@ i konfigurationsfilen."
          }
        }
      }
    },
