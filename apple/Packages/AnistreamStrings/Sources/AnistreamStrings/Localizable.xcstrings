    "torrents-risk" : {
      "comment" : "Line explaining the risk, before torrents start.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere können deine IP-Adresse sehen, während du einen Torrent herunterlädst und teilst. Wähle vor dem Start der Torrents, was sie schützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other people can see your IP address while you download and share a torrent. Choose what protects it before torrents start."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otras personas pueden ver tu dirección IP mientras descargas y compartes un torrent. Elige qué lo protege antes de que los torrents empiecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’autres personnes peuvent voir votre adresse IP pendant que vous téléchargez et partagez un torrent. Choisissez ce qui la protège avant le démarrage des torrents."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang lain dapat melihat alamat IP Anda saat Anda mengunduh dan membagikan torrent. Pilih apa yang melindunginya sebelum torrent dimulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altre persone possono vedere il tuo indirizzo IP mentre scarichi e condividi un torrent. Scegli cosa lo protegge prima che i torrent partano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレントのダウンロードと共有中は、ほかの人があなたのIPアドレスを見ることができます。トレントを開始する前に、保護方法を選んでください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas pobierania i udostępniania torrenta inni mogą zobaczyć adres IP. Wybierz ochronę, zanim torrenty ruszą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outras pessoas podem ver o seu endereço IP enquanto você baixa e compartilha um torrent. Escolha uma proteção antes de os torrents começarem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие люди могут видеть ваш IP-адрес, пока вы скачиваете и раздаёте торрент. Выберите защиту до начала работы торрентов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andra kan se din IP-adress medan du laddar ner och delar en torrent. Välj vad som skyddar den innan torrenter startar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir torrenti indirip paylaşırken başkaları IP adresinizi görebilir. Torrentler başlamadan önce bu adresi neyin koruyacağını seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người khác có thể thấy địa chỉ IP của bạn khi bạn tải và chia sẻ một torrent. Hãy chọn cách bảo vệ trước khi torrent bắt đầu."
          }
        }
      }
    },
