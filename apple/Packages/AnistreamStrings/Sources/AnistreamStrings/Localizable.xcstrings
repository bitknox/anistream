      "comment" : "Error: an open link that no longer lets anyone join.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link lässt niemanden mehr beitreten. Frag den Besitzer des Plugin-Stores nach einem neuen Link oder einer Einladung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That link no longer lets anyone join. Ask the plugin store's owner for a new link or an invite."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este enlace ya no deja unirse a nadie. Pídele al responsable de la tienda de complementos un enlace nuevo o una invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien ne permet plus à personne de rejoindre. Demandez au propriétaire de la boutique de plugins un nouveau lien ou une invitation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo link non permette più a nessuno di unirsi. Chiedi al proprietario del negozio di plugin un nuovo link o un invito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリンクでは、もう誰も参加できません。プラグインストアの所有者に、新しいリンクか招待を依頼してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
