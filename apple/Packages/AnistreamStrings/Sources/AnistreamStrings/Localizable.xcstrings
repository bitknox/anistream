    "plugin-risk-warning" : {
      "comment" : "Warning at install and in onboarding, in the same words in both.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins are written by other people and run on your device. Install only from people you trust."
