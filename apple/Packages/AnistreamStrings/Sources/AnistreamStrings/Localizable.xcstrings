      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow system language"
          }
        }
      }
    },
    "language-restart-note" : {
      "comment" : "Shown after changing the language on Windows, Linux and in the terminal, which read it at start.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restart anistream to use the new language."
          }
        }
      }
    },
    "legal-hosts-no-content" : {
      "comment" : "The legal line. It exists once, so no translation can paraphrase it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream hosts no content."
          }
        }
      }
    },
    "menu-show-library" : {
      "comment" : "Mac menu bar item. Title Case, as Apple's guidelines ask for the menu bar only.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Library"
          }
        }
      }
    },
    "menu-source-for-title" : {
      "comment" : "Mac menu bar item that opens the source picker for the title on screen. Title Case, as the menu bar's items are. Everywhere else the picker is called source-picker-title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Source for This Title"
          }
        }
      }
    },
    "notice-episodes-queued" : {
      "comment" : "Toast after episodes are added to the download queue. Argument 1: count (Int).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Queued one episode."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Queued %1$lld episodes."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "notice-not-saved" : {
      "comment" : "Toast when a setting could not be stored. The reason comes from the system. Argument 1: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't save that setting. %1$@"
          }
        }
      }
    },
    "notice-playback-failed" : {
      "comment" : "Toast when playback stops with an error.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback failed. Try another source."
          }
        }
      }
    },
    "notice-saved" : {
      "comment" : "Toast after a setting is stored. The label is the setting's name. Argument 1: label (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved %1$@."
          }
        }
      }
    },
    "notice-title-load-failed" : {
      "comment" : "Toast when a title's details did not load.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load this title. Check your connection and try again."
          }
        }
      }
    },
    "player-up-next" : {
