    "tv-problem-unreachable" : {
      "comment" : "The TV did not answer.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher ist nicht erreichbar. Prüf, ob er eingeschaltet ist, anistream geöffnet ist und er im selben Netzwerk hängt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach the TV. Check that it's on, with anistream open, on the same network."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede contactar la TV. Revisa que esté encendida, con anistream abierta, en la misma red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre la TV. Vérifiez qu’elle est allumée, que anistream est ouvert et qu’elle est sur le même réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere la TV. Controlla che sia accesa, con anistream in esecuzione, sulla stessa rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビに接続できません。電源が入っていて、anistreamが開いており、同じネットワークにあることを確認してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć się z telewizorem. Sprawdź, czy jest włączony, czy anistream jest otwarta i czy jesteś w tej samej sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar a TV. Verifique se ela está ligada, com o anistream aberto, na mesma rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся связаться с телевизором. Проверьте, что он включён, anistream открыт и всё подключено к одной сети."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det går inte att nå TV:n. Kontrollera att den är på, att anistream är öppen och att den är på samma nätverk."
          }
        }
      }
    },
