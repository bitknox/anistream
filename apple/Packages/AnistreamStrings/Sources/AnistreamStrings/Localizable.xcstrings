    "party-no-source-lists" : {
      "comment" : "Line when no source lists the episode. Argument 1: episode (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Quelle listet Folge %1$@ auf. Quellen kommen von Plugins, die ein Plugin-Store hinzufügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No source lists episode %1$@. Sources come from plugins, which a plugin store adds."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna fuente lista el episodio %1$@. Las fuentes vienen de complementos que se instalan desde una tienda de complementos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune source ne propose l'épisode %1$@. Les Sources viennent de plugins, qu'ajoute une boutique de plugins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna fonte elenca l'episodio %1$@. Fonti arrivano dai plugin, che un negozio di plugin aggiunge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのソースも第%1$@話を一覧に載せていません。ソースはプラグインから提供されます。プラグインはプラグインストアで追加できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żadne źródło nie ma odcinka %1$@. Źródła dostarczają wtyczki, które dodaje sklep z wtyczkami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma fonte lista o episódio %1$@. As fontes vêm de plugins, que uma loja de plugins adiciona."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни один источник не содержит серию %1$@. Источники появляются через плагины, которые ставит магазин плагинов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen källa listar avsnitt %1$@. Källor kommer från tillägg, som en tilläggsbutik lägger till."
          }
        }
      }
    },
    "party-nosource-missing-detail" : {
      "comment" : "Line under it. `why` is the reason as a complete sentence without its full stop, and this message adds the stop. `what` is the name of what the room is watching, such as a show's title, and it starts the next sentence. Argument 1: why (Text). Argument 2: what (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@ wird mit dem Raum abgespielt, sobald du eine Quelle wählst, die sie hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@ plays with the room once you choose a source that has it."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@ se reproduce con la sala cuando elijas una fuente que lo tenga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@ sera partagé avec le salon dès que vous choisirez une source qui le propose."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@ viene riprodotto nella stanza quando scegli una fonte che lo ha."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@。%2$@は、このエピソードを持つソースを選ぶと、ルームと一緒に再生されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@ odtwarza się w pokoju, gdy zostanie wybrane źródło, które go ma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@ será reproduzido com a sala quando você escolher uma fonte que tenha o episódio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@ будет воспроизводиться в комнате, как только вы выберете источник, который её содержит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@ spelas med rummet när du väljer en källa som har det."
          }
        }
      }
    },
