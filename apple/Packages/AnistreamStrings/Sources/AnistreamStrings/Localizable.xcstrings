    "notice-not-aired" : {
      "comment" : "A play's explanation: the episode's broadcast is still ahead. The \"when\" says today, tomorrow or a date. Argument 1: episode (Int). Argument 2: when (Cause).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
