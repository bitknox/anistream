    "start-failed-config" : {
      "comment" : "Message when anistream could not start because the config file has a setting it can't use. The path is the file; the problem names the line where it can. Argument 1: path (Text). Argument 2: problem (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ has a setting anistream can't use: %2$@. Fix or remove it, then try again."
          }
        }
      }
    },
    "start-failed-database" : {
      "comment" : "Message when anistream could not start because its database could not be opened. The path is the database file, the reason comes from the system. Argument 1: path (Text). Argument 2: reason (Text).",
