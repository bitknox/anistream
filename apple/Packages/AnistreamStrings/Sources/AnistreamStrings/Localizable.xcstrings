        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez d'abord un serveur pour le visionnage en groupe, dans syncplay.server. %1$@ est géré par %2$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih server untuk nonton bareng dulu, sebagai syncplay.server. %1$@ dijalankan oleh %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli prima un server per il watch party, come syncplay.server. %1$@ è gestito da %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先に同時視聴のサーバーを選んでください（syncplay.server）。%1$@は%2$@が運営しています。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw wybierz serwer, zanim rozpoczniesz wspólne oglądanie (syncplay.server). %1$@ jest prowadzony przez %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
