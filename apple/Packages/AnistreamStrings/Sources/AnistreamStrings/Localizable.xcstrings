    "tv-settings-footnote" : {
      "comment" : "Line under the settings group of paired TVs. The code is a short fingerprint. Argument 1: code (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fernseher führt dieses Gerät mit dem Code %1$@ auf. Entfernst du hier einen Fernseher, vergisst er auch dieses Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A TV lists this device with the code %1$@. Forget a TV here and it forgets this device too."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un televisor registra este dispositivo con el código %1$@. Si olvidas un televisor aquí, también olvida este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une TV liste cet appareil avec le code %1$@. Si vous oubliez une TV ici, elle oublie aussi cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV mencantumkan perangkat ini dengan kode %1$@. Jika Anda menghapus TV di sini, TV itu juga melupakan perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una TV elenca questo dispositivo con il codice %1$@. Se dimentichi una TV qui, dimentica anche questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビには、このデバイスがコード%1$@で表示されます。ここでテレビを削除すると、このデバイスの記録も消えます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telewizor widzi to urządzenie z kodem %1$@. Zapomnienie telewizora tutaj usuwa też to urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma TV lista este dispositivo com o código %1$@. Se você esquecer uma TV aqui, ela também esquece este dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телевизор видит это устройство под кодом %1$@. Если забыть телевизор здесь, он забудет и это устройство."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En TV listar den här enheten med koden %1$@. Glömmer du en TV här glöms också den här enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir TV, bu cihazı %1$@ koduyla listeler. Burada bir TV'yi unutursanız bu cihazı da unutur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một TV hiển thị thiết bị này với mã %1$@. Quên TV tại đây thì TV đó cũng quên thiết bị này."
          }
        }
      }
    },
