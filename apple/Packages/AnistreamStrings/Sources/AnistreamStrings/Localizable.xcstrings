    "cause-airs-in-days" : {
      "comment" : "Part of an air time: the broadcast is within the next week. Argument 1: days (Int). Argument 2: time (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@days@"
          },
          "substitutions" : {
            "days" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "in one day at %2$@"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "in %1$lld days at %2$@"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "cause-airs-on-date" : {
      "comment" : "Part of an air time: the broadcast is more than a week away. The date is year-month-day. Argument 1: date (Text). Argument 2: time (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "on %1$@ at %2$@"
          }
        }
      }
    },
    "cause-airs-today" : {
      "comment" : "Part of an air time: the broadcast is later today. The time is the viewer's local time. Argument 1: time (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "today at %1$@"
