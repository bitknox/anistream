    "stores-empty-detail" : {
      "comment" : "Line under the empty title.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin-Stores werden von Leuten betrieben, die du kennst. Tritt einem bei, indem du den Einladungslink einfügst, den dir die betreibende Person schickt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugin stores are run by people you know. Join one with the invite link its owner sends you."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiendas de complementos las administran personas que conoces. Únete con el enlace de invitación que te envíe su propietario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boutiques de plugins sont gérées par des personnes que vous connaissez. Rejoignez-en une avec le lien d'invitation que son propriétaire vous envoie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Negozi di plugin sono gestiti da persone che conosci. Unisciti con il link di invito che ti manda il proprietario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインストアは、知り合いが運営しています。運営者から届いた招待リンクで参加できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sklepy z wtyczkami prowadzą osoby, które znasz. Dołącz do jednego z nich linkiem z zaproszeniem od właściciela."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lojas de plugins são mantidas por pessoas que você conhece. Entre em uma com o link de convite que o dono enviar para você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Магазины плагинов ведут люди, которых вы знаете. Подключиться можно по пригласительной ссылке, которую присылает владелец."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilläggsbutiker drivs av personer du känner. Gå med i en av dem med inbjudningslänken som ägaren skickar till dig."
          }
        }
      }
    },
