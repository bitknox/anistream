          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList yanıt vermiyor. Şimdilik başka bir hizmetten veriler gösteriliyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
