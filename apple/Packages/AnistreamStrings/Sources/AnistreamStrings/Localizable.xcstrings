    "settings-accounts-sync-note" : {
      "comment" : "Footnote of the AniList group in Accounts. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortschritt und Änderungen an Listen werden mit %1$@ abgeglichen. Mediathek und „Meine Liste“ im Kalender zeigen deine %1$@-Listen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress and list changes sync to %1$@. Library and the Calendar's My list show your %1$@ lists."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios de progreso y de lista se sincronizan con %1$@. Biblioteca y Mi lista del Calendario muestran tus listas de %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La progression et les changements de liste se synchronisent avec %1$@. Bibliothèque et la liste du calendrier affichent vos listes %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanzamenti e modifiche alle liste si sincronizzano con %1$@. La Libreria e la Mia lista del Calendario mostrano le tue liste di %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進捗とリストの変更は%1$@に同期されます。ライブラリとカレンダーの「マイリスト」には、%1$@のリストが表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postęp i zmiany na liście są synchronizowane z %1$@. Biblioteka i Moja lista w kalendarzu pokazują twoje listy z %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O progresso e as mudanças de lista são sincronizados com %1$@. A Biblioteca e a Minha lista do Calendário mostram suas listas de %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогресс и изменения списков синхронизируются с %1$@. Библиотека и «Мой список» в календаре показывают ваши списки %1$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
