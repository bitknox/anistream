        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen kommen von Plugins, die ein Plugin-Store hinzufügt. %1$@ wird mit dem Raum abgespielt, sobald eine davon die Folge hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources come from plugins, which a plugin store adds. %1$@ plays with the room once one of them has it."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes vienen de complementos que se instalan desde una tienda de complementos. %1$@ se reproduce con la sala cuando una de ellas lo tenga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Sources viennent de plugins, qu'ajoute une boutique de plugins. %1$@ sera partagé avec le salon dès que l'une d'elles le proposera."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber-sumber berasal dari plugin-plugin yang ditambahkan lewat toko plugin. %1$@ akan diputar bersama ruang setelah salah satunya tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonti arrivano dai plugin, che un negozio di plugin aggiunge. %1$@ viene riprodotto nella stanza quando una di queste ce l'ha."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソースはプラグインから提供されます。プラグインはプラグインストアで追加できます。%1$@は、どれかのソースがエピソードを持つと、ルームと一緒に再生されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródła dostarczają wtyczki, które dodaje sklep z wtyczkami. %1$@ odtwarza się w pokoju, gdy będzie dostępny w jednym z nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fontes vêm de plugins que uma loja de plugins adiciona. %1$@ será reproduzido com a sala assim que uma delas tiver o episódio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источники появляются через плагины, которые ставит магазин плагинов. %1$@ будет воспроизводиться в комнате, как только появится один из них."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Källor kommer från tillägg, som en tilläggsbutik lägger till. %1$@ spelas med rummet när någon av dem har det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynaklar, bir eklenti mağazası tarafından eklenen eklentilerden gelir. %1$@, bunlardan birinde bulunduğunda odayla birlikte oynatılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các nguồn đến từ các plugin, do một cửa hàng plugin thêm vào. %1$@ sẽ phát cùng phòng khi một trong số đó có tập này."
          }
        }
      }
    },
