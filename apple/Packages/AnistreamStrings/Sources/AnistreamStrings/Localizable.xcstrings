    "notice-anilist-paste-flow" : {
      "comment" : "Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Code einzufügen ist hier nicht möglich. Beende das Programm und starte anistream stattdessen mit --login."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasting a code isn't possible here. Quit and run anistream --login instead."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede pegar un código aquí. Cierra anistream y ejecuta anistream --login en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coller un code n'est pas possible ici. Quittez et lancez anistream --login à la place."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menempel kode tidak dapat dilakukan di sini. Keluar lalu jalankan anistream --login."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui non è possibile incollare un codice. Esci ed esegui anistream --login."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここではコードを貼り付けてサインインできません。終了して、代わりにanistream --loginを実行してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklejanie kodu nie jest tu możliwe. Zakończ działanie i uruchom zamiast tego anistream --login."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível colar um código aqui. Saia e execute anistream --login em vez disso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставить код здесь нельзя. Закройте программу и запустите anistream --login."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det går inte att klistra in en kod här. Avsluta och kör anistream --login i stället."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada kod yapıştırmak mümkün değil. Çıkıp bunun yerine anistream --login komutunu çalıştırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không dán được mã ở đây. Hãy thoát rồi chạy anistream --login."
          }
        }
      }
    },
    "notice-anilist-unreachable" : {
      "comment" : "Toast when the AniList fallback takes over because AniList cannot be reached.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList antwortet nicht. Vorerst werden Daten von einem anderen Dienst angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList isn't answering. Showing data from another service for now."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList no responde. Por ahora se muestran datos de otro servicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList ne répond pas. Affichage des données d’un autre service pour l’instant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList tidak menjawab. Untuk sementara menampilkan data dari layanan lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList non risponde. Per ora vengono mostrati dati di un altro servizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniListが応答していません。当面は、別のサービスのデータを表示しています。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList nie odpowiada. Na razie pokazano dane z innego serwisu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AniList não está respondendo. Por enquanto, mostrando dados de outro serviço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
