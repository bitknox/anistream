        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se unen sin nombre. Al desactivarlo, el enlace deja de funcionar; al activarlo otra vez, se crea uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
