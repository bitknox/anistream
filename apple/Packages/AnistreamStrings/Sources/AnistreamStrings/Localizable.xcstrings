          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList utfärdade ingen uppdateringstoken. Du behöver logga in igen om ungefär en månad."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
