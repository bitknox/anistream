    "notice-filler-skipped" : {
      "comment" : "Toast when the next episode is not the one after this because filler was skipped. Argument 1: episode (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skipped filler. Up next is episode %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィラーをスキップしました。次のエピソードはエピソード%1$@です。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyllnadsavsnitt hoppades över. Nästa är avsnitt %1$@."
          }
        }
      }
    },
    "notice-hidden-preview" : {
      "comment" : "What the system shows instead of the body when previews are hidden.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New episode"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいエピソード"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nytt avsnitt"
          }
        }
      }
    },
    "notice-keep-next-full" : {
      "comment" : "Toast when keep next found no room for another episode.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough free space to keep the next episodes downloaded. Free up some space to download more."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のエピソードを保存するための空き容量が足りません。ダウンロードするには、空き容量を確保してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte tillräckligt med ledigt utrymme för att hålla kommande avsnitt nedladdade. Frigör lite utrymme för att ladda ner fler."
          }
        }
      }
    },
    "notice-kitsu-signs-in-on-accounts" : {
      "comment" : "Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitsu signs in from the Accounts screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitsuへのサインインは、アカウント画面から行います。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitsu loggar in från skärmen Konton."
          }
        }
      }
    },
    "notice-last-episode" : {
      "comment" : "Toast when the next-episode control is used on the last known episode. Argument 1: episode (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no next episode. Episode %1$@ is the last."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のエピソードはありません。エピソード%1$@が最後です。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns inget avsnitt efter det här. Avsnitt %1$@ är det sista."
          }
        }
      }
    },
    "notice-mal-client-missing" : {
      "comment" : "Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated. Argument 1: setting (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList needs a client id. Register an app with the type \"other\" at myanimelist.net/apiconfig, then set %1$@ in the config file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeListにはクライアントIDが必要です。myanimelist.net/apiconfigで種類を「other」としてアプリを登録し、設定ファイルで%1$@を設定してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList behöver ett klient-id. Registrera en app med typen \"other\" på myanimelist.net/apiconfig och sätt sedan %1$@ i konfigurationsfilen."
          }
        }
      }
    },
    "notice-mal-client-missing-build" : {
      "comment" : "Toast when this build has no MyAnimeList client to finish a sign-in with.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't finish signing in to MyAnimeList: this build has no client for it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeListへのサインインを完了できませんでした。このビルドにはMyAnimeList用のクライアントが含まれていません。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att slutföra inloggningen till MyAnimeList: den här versionen har ingen klient för det."
          }
        }
      }
    },
    "notice-mal-no-refresh-token" : {
      "comment" : "Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList didn't issue a refresh token. You'll need to sign in again in about a month."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeListはリフレッシュトークンを発行しませんでした。約1か月後に、再度サインインが必要になります。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList utfärdade ingen uppdateringstoken. Du behöver logga in igen om ungefär en månad."
          }
        }
      }
    },
    "notice-mapping-data-failed" : {
      "comment" : "Toast when the mapping data could not be downloaded. It is said once; the retries are silent. Argument 1: datasets (Text). Argument 2: wait (Seconds). Argument 3: cause (Cause).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't refresh the mapping data (%1$@). Trying again in %2$@. %3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マッピングデータを更新できませんでした（%1$@）。%2$@後に再試行します。%3$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att uppdatera mappningsdatan (%1$@). Försöker igen om %2$@. %3$@"
          }
        }
      }
    },
    "notice-mapping-data-refreshed" : {
      "comment" : "Toast when the mapping data downloads work again after a failure.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapping data refreshed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マッピングデータを更新しました。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappningsdatan uppdaterades."
          }
        }
      }
    },
    "notice-match-did-not-stick" : {
      "comment" : "Toast when a chosen match still left the title undecided.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That match didn't stick. The source may have changed. Try choosing it again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この一致は反映されませんでした。ソースが変わった可能性があります。もう一度選び直してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matchningen höll inte. Den källa kan ha ändrats. Försök välja den igen."
          }
        }
      }
    },
    "notice-match-reset-failed" : {
      "comment" : "Toast when the title's episode match could not be cleared. The reason comes from the system. Argument 1: reason (Text).",
      "extractionState" : "manual",
