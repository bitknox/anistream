    "notice-last-episode" : {
      "comment" : "Toast when the next-episode control is used on the last known episode. Argument 1: episode (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine nächste Folge. Folge %1$@ ist die letzte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no next episode. Episode %1$@ is the last."
          }
        },
        "es-419" : {
          "stringUnit" : {
