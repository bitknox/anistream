    "party-needs-connection" : {
      "comment" : "Foot of the watch party form while the device is offline.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für eine Watchparty brauchst du eine Verbindung. Du bist offline."
