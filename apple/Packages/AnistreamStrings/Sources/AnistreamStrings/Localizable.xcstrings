    "settings-presence-note" : {
      "comment" : "Footnote of the Discord group. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rich Presence zeigt das Cover, einen Fortschrittsbalken und einen Link zur Serie bei %1$@. Discord lädt das Cover selbst von %1$@. Dafür muss der Titel angezeigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rich presence shows the cover, a progress bar and a link to the show on %1$@. Discord fetches the cover from %1$@ itself. It needs the title shown."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La presencia enriquecida muestra la portada, una barra de progreso y un enlace a la serie en %1$@. Discord obtiene la portada directamente de %1$@. Necesita que se muestre el título."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’activité enrichie affiche la jaquette, une barre de progression et un lien vers la série sur %1$@. Discord récupère la jaquette depuis %1$@ lui-même. Le titre doit être affiché."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehadiran kaya menampilkan sampul, bilah kemajuan, dan tautan ke tayangan di %1$@. Discord mengambil sampul dari %1$@ sendiri. Judul harus ditampilkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La presenza su Discord mostra la copertina, una barra di avanzamento e un link alla serie su %1$@. Discord prende la copertina direttamente da %1$@. Serve che il titolo sia visibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リッチプレゼンスには、カバー画像、進捗バー、%1$@での作品へのリンクが表示されます。Discordは%1$@からカバー画像を直接取得します。タイトルを表示する設定が必要です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status aktywności w Discordzie pokazuje okładkę, pasek postępu i link do tytułu w %1$@. Discord sam pobiera okładkę z %1$@. Wymaga pokazywania tytułu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rich Presence mostra a capa, uma barra de progresso e um link para a série em %1$@. O Discord busca a capa no próprio %1$@. Ele precisa que o título esteja visível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расширенный статус показывает обложку, полосу прогресса и ссылку на сериал на %1$@. Discord сам загружает обложку с %1$@. Для этого нужно показывать название."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Närvaro visar omslaget, en förloppsmätare och en länk till serien på %1$@. Discord hämtar omslaget från %1$@ själv. Titeln måste visas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zengin durum, kapağı, bir ilerleme çubuğunu ve %1$@ üzerindeki gösteri bağlantısını gösterir. Discord kapağı %1$@ üzerinden kendisi alır. Başlığın gösterilmesi gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoạt động chi tiết hiển thị ảnh bìa, thanh tiến độ và liên kết tới tựa trên %1$@. Discord tự tải ảnh bìa từ %1$@. Cần bật hiển thị tên tựa."
          }
        }
      }
    },
