    "notice-match-did-not-stick" : {
      "comment" : "Toast when a chosen match still left the title undecided.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zuordnung hat nicht gehalten. Vielleicht hat sich die Quelle geändert. Wähle sie erneut aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That match didn't stick. The source may have changed. Try choosing it again."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa coincidencia no se mantuvo. Puede que la fuente haya cambiado. Intenta elegirla otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette correspondance n'a pas été retenue. La source a peut-être changé. Essayez de la choisir à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo abbinamento non è stato applicato. La fonte potrebbe essere cambiata. Prova a sceglierlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この一致は反映されませんでした。ソースが変わった可能性があります。もう一度選び直してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasowanie się nie utrzymało. Źródło mogło się zmienić. Spróbuj wybrać źródło ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa correspondência não foi salva. A fonte pode ter mudado. Tente escolher de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сопоставление не закрепилось. Источник мог измениться. Попробуйте выбрать источник ещё раз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matchningen höll inte. Den källa kan ha ändrats. Försök välja den igen."
          }
        }
      }
    },
    "notice-match-reset-failed" : {
      "comment" : "Toast when the title's episode match could not be cleared. The reason comes from the system. Argument 1: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zuordnung konnte nicht zurückgesetzt werden. %1$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reset the match. %1$@"
          }
        },
        "es-419" : {
          "stringUnit" : {
