    "notice-cast-never-fetches" : {
      "comment" : "The TV accepted the stream but never started reading it. The card offers Try again and Play here beside it. The name is the TV's own. Argument 1: name (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
