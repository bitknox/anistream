        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインは他の人が作成したもので、デバイス上で実行されます。信頼できる相手からのみインストールしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczki tworzą inne osoby i działają na twoim sprzęcie. Instaluj tylko od osób, którym ufasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins são escritos por outras pessoas e rodam no seu dispositivo. Instale somente de pessoas em quem você confia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плагины пишут другие люди, и они запускаются в ваше устройство. Устанавливайте только у тех, кому доверяете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillägg skrivs av andra och körs på din enhet. Installera bara från personer du litar på."
          }
        }
      }
