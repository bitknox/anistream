    "cause-confirm-no-protection" : {
      "comment" : "The reason a setting was refused until the person confirms having no protection.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm that you want no protection first."
          }
        }
      }
    },
    "cause-confirm-warn-only" : {
      "comment" : "The reason a setting was refused until the person confirms the \"warn only\" choice.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirm that you want to be warned only first."
          }
        }
      }
    },
    "cause-proxy-address-unusable" : {
      "comment" : "The reason a proxy could not be checked: its address is not one the check can use.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The proxy's address is not one a check can use."
          }
        }
      }
    },
    "cause-proxy-needs-address" : {
      "comment" : "The reason a proxy was refused: it has no host or no port.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A proxy needs a host and a port."
          }
        }
      }
    },
    "cause-server-unreachable" : {
      "comment" : "The reason a request failed: it never reached the server.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server couldn't be reached."
          }
        }
      }
    },
    "duration-days" : {
      "comment" : "A span of time in whole days. The unit letter belongs to the language. Argument 1: days (Int).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lldd"
          }
        }
      }
    },
    "duration-days-hours" : {
      "comment" : "A span of time to the next episode, in days and hours. The unit letters belong to the language. Argument 1: days (Int). Argument 2: hours (Int).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lldd %2$lldh"
          }
        }
      }
    },
    "duration-hours" : {
      "comment" : "A span of time in whole hours. Argument 1: hours (Int).",
