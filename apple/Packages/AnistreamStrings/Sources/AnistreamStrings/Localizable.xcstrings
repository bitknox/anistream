          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV ya no conoce este dispositivo. Vincúlala de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La TV ne connaît plus cet appareil. Appairez-la de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
