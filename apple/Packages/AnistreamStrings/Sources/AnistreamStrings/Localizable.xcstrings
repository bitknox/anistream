        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マッピングデータを更新できませんでした（%1$@）。%2$@後に再試行します。%3$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odświeżyć danych mapowania (%1$@). Ponowna próba za %2$@. %3$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
