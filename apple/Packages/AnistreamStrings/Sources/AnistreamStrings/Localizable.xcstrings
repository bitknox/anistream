    "party-privacy" : {
      "comment" : "Line under the form: what the server learns and what each person plays. The app shows legal-hosts-no-content after it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server sieht deinen Namen, den Raum und wann jemand abspielt, pausiert oder spult. Jede Person spielt die Folge aus ihren eigenen Quellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server sees your name, the room, and when anyone plays, pauses or seeks. Each of you plays the episode from your own sources."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ve tu nombre, la sala y cuándo alguien reproduce, pausa o avanza. Cada uno reproduce el episodio desde sus propias fuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur voit votre nom, le salon, et quand quelqu'un lit, met en pause ou avance dans l'épisode. Chacun lit l'épisode depuis ses propres sources."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server vede il tuo nome, la stanza e quando qualcuno avvia, mette in pausa o cerca un punto del video. Ciascuno riproduce l'episodio dalle proprie fonti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーに伝わるのは、あなたの名前、ルーム、そして誰かが再生、一時停止、シークしたタイミングです。エピソードは、参加者それぞれが自分のソースから再生します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer widzi nazwę, pokój oraz moment, w którym ktoś odtwarza, pauzuje lub przewija. Każdy odtwarza odcinek, a jego źródła są jego własne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor vê o seu nome, a sala e quando alguém reproduz, pausa ou avança. Cada um de vocês reproduz o episódio pela própria fontes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер видит ваше имя, комнату и то, когда кто-то включает, ставит на паузу или перематывает. Каждый из вас смотрит серию через свои источники."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern ser ditt namn, rummet och när någon spelar, pausar eller spolar. Var och en spelar avsnittet från sina egna källor."
          }
        }
      }
    },
