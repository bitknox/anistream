    "store-moved" : {
      "comment" : "Error: an invite link names a store this device already joined, but at another address. Argument 1: store (Text). Argument 2: current (Text). Argument 3: target (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist %1$@ unter %2$@ beigetreten, aber der Link zeigt auf %3$@. Wenn der Plugin-Store umgezogen ist, verlasse ihn zuerst und tritt erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is joined at %2$@, but this link points to %3$@. If the plugin store has moved, leave it first and join again."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya te uniste a %1$@ en %2$@, pero este enlace apunta a %3$@. Si la tienda de complementos cambió de dirección, sal primero y vuelve a unirte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez rejoint %1$@ à l’adresse %2$@, mais ce lien pointe vers %3$@. Si la boutique de plugins a changé d’adresse, quittez-la d’abord, puis rejoignez-la."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sudah bergabung di %2$@, tetapi tautan ini mengarah ke %3$@. Jika toko plugin sudah pindah, keluar dulu, lalu bergabung lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei unito a %1$@ su %2$@, ma questo link punta a %3$@. Se il negozio di plugin è stato spostato, lascialo prima e unisciti di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%2$@に参加していますが、このリンクは%3$@を指しています。プラグインストアの場所が変わった場合は、先に退出してから参加し直してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ jest dołączony pod adresem %2$@, ale ten link wskazuje na %3$@. Jeśli sklep z wtyczkami się przeniósł, najpierw go opuść i dołącz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está salva em %2$@, mas este link aponta para %3$@. Se a loja de plugins mudou, saia dela antes e entre de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ подключён по адресу %2$@, а эта ссылка ведёт на %3$@. Если магазин плагинов переехал, сначала выйдите из него и подключитесь снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ är ansluten på %2$@, men länken pekar på %3$@. Om tilläggsbutik har flyttats lämnar du den först och går med igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ adresinde katılmış durumda, ama bu bağlantı %3$@ adresini gösteriyor. Bu eklenti mağazası taşındıysa önce onu bırakıp yeniden katılın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đã tham gia ở %2$@, nhưng liên kết này trỏ tới %3$@. Nếu cửa hàng plugin đã chuyển đi, hãy rời khỏi trước rồi tham gia lại."
          }
        }
      }
    },
