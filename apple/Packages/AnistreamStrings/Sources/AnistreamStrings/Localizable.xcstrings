    "settings-notify-explain-on" : {
      "comment" : "Under the notification preview while New episodes is on. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Benachrichtigung, wenn eine Folge einer Serie aus deiner Liste „Wird geschaut“ erscheint, zu der Zeit, die %1$@ angibt. Die eigene Einstellung einer Serie hat Vorrang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One notification when an episode of a show in your Watching list comes out, at the time %1$@ gives. A show's own setting comes first."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aviso cuando sale un episodio de una serie de tu lista Viendo, a la hora que da %1$@. El ajuste propio de cada serie tiene prioridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une notification quand un épisode d’une série de votre liste En cours sort, à l’heure donnée par %1$@. Le réglage propre à une série passe avant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu pemberitahuan saat episode dari tayangan dalam daftar Menonton Anda tayang, pada jam yang diberikan %1$@. Pengaturan tayangan itu didahulukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notifica quando esce un episodio di una serie nella lista delle serie che guardi, all'orario indicato da %1$@. Prevale l'impostazione della serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が伝える時刻に、「視聴中」リストの作品のエピソードが公開されると1件通知します。作品ごとの設定が優先されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno powiadomienie, gdy wyjdzie odcinek tytułu, który oglądasz, o godzinie podanej przez %1$@. Ustawienie danego tytułu ma pierwszeństwo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma notificação quando um episódio de uma série da sua lista Assistindo sair, no horário que %1$@ informa. A configuração própria de cada série vem primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно уведомление, когда выходит новая серия сериала из списка «Смотрю». Время выхода берётся из %1$@. Сначала действует настройка самого сериала."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En notis när ett avsnitt av en serie i listan Tittar på kommer, vid den tid %1$@ anger. Seriens egen inställning går först."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlediklerim listenizdeki bir gösterinin yeni bölümü yayınlandığında, %1$@'in verdiği saatte tek bildirim gelir. Gösterinin kendi ayarı önceliklidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thông báo khi một tập của tựa trong danh sách Đang xem của bạn ra, vào giờ %1$@ đưa ra. Cài đặt riêng của tựa được ưu tiên trước."
          }
        }
      }
    },
