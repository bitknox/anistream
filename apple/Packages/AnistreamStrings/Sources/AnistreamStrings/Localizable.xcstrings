    "notice-engine-fault" : {
      "comment" : "Toast when something went wrong inside the engine and it carried on.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In anistream ist etwas schiefgelaufen. Es läuft weiter, aber wenn ein Bildschirm hängen bleibt, beende anistream und öffne es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong inside anistream. It carried on, but if a screen looks stuck, quit and open it again."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo salió mal dentro de anistream. Siguió funcionando, pero si una pantalla parece trabada, ciérrala y ábrela de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur s’est produite dans anistream. L’application a continué, mais si un écran semble bloqué, quittez-la et ouvrez-la à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa non ha funzionato in anistream. Ha continuato a funzionare, ma se una schermata sembra bloccata, esci e riaprila."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistreamの内部で問題が発生しました。処理は続行されましたが、画面が止まっているように見える場合は、終了してから開き直してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś poszło nie tak w anistream. Program działa dalej, ale jeśli ekran wygląda na zawieszony, zamknij go i otwórz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo deu errado dentro do anistream. Ele continuou funcionando, mas se alguma tela parecer travada, saia e abra de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внутри anistream что-то пошло не так. Работа продолжилась, но если экран завис, закройте приложение и откройте его снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något gick fel i anistream. Appen fortsatte, men om en skärm verkar fast avslutar du och öppnar den igen."
          }
        }
      }
    },
