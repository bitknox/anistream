    "torrents-not-a-plugin" : {
      "comment" : "Line in the Apple sources screen: torrents belong to the app, not to a plugin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrents gehören zu anistream, nicht zu einem Plugin. Was ihren Datenverkehr schützt, die Verbindungsprüfung und das Seeding werden unter Quellen in den Einstellungen festgelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrents are part of anistream, not a plugin. What protects their traffic, the connection check and seeding are set in Settings, under Sources."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los torrents son parte de anistream, no de un complemento. Lo que protege su tráfico, la comprobación de la conexión y compartir se configura en Configuración, en Fuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les torrents font partie de anistream, pas d’un plugin. La protection du trafic, la vérification de la connexion et le partage se règlent dans les réglages, sous Sources."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I torrent fanno parte di anistream, non di un plugin. Protezione del traffico, controllo della connessione e condivisione si impostano in Impostazioni, sotto Fonti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレントはプラグインではなく、anistreamの機能です。通信の保護、接続の確認、シーディングは、設定のソースで設定します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrenty są częścią anistream, a nie dodatkiem. Ochronę ich ruchu, sprawdzanie połączenia i udostępnianie ustawia się w Ustawieniach, w sekcji Źródła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os torrents fazem parte do anistream, não de um plugin. A proteção do tráfego, a verificação da conexão e o compartilhamento são definidos em Configurações, em Fontes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торренты входят в anistream, а не в плагин. Защита их трафика, проверка соединения и раздача настраиваются в разделе «Источники»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrenter ingår i anistream, inte i ett tillägg. Skyddet för trafiken, anslutningskontrollen och seedningen ställs in i Inställningar under Källor."
          }
        }
      }
    },
