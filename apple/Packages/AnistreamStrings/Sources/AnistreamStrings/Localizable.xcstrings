                      "state" : "translated",
                      "value" : "in one day at %2$@"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "in %1$lld days at %2$@"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "cause-airs-on-date" : {
