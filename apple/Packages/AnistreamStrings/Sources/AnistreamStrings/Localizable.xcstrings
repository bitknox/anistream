    "plugin-risk-warning" : {
      "comment" : "Warning at install and in onboarding, in the same words in both.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins stammen von anderen Leuten und laufen auf deinem Gerät. Installiere nur von Leuten, denen du vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins are written by other people and run on your device. Install only from people you trust."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los complementos los escriben otras personas y se ejecutan en tu dispositivo. Instala solo los que vengan de personas en las que confíes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins sont écrits par d'autres personnes et s'exécutent sur votre appareil. N'installez que des plugins de personnes de confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Plugin sono scritti da altre persone e girano sul tuo dispositivo. Installa solo da persone di cui ti fidi."
