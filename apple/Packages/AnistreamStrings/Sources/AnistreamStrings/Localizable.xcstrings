    "party-leave-detail" : {
      "comment" : "Line under it. The room is a name. Argument 1: room (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du anistream schließt, verlässt du %1$@. Alle anderen machen ohne dich weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closing anistream leaves %1$@. Everyone else carries on without you."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar anistream te saca de %1$@. Los demás siguen sin ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer anistream quitte %1$@. Les autres continuent sans vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menutup anistream akan membuat Anda keluar dari %1$@. Yang lain tetap melanjutkan tanpa Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudendo anistream esci da %1$@. Gli altri continuano senza di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistreamを閉じると、%1$@から退出します。ほかの参加者は、あなた抜きで続けます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknięcie anistream opuszcza pokój %1$@. Pozostali uczestnicy oglądają dalej bez tej osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechar o anistream tira você de %1$@. Os outros continuam sem você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрытие anistream покинет %1$@. Остальные продолжат без вас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att stänga anistream lämnar %1$@. Alla andra fortsätter utan dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream kapatılınca %1$@ odasından ayrılırsınız. Diğerleri sizsiz devam eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đóng anistream sẽ rời %1$@. Những người khác vẫn tiếp tục mà không có bạn."
          }
        }
      }
    },
