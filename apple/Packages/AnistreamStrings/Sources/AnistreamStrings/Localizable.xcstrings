    "torrents-warn-only-detail" : {
      "comment" : "Line under the question that asks whether torrents may keep running when a check fails.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream warnt dich, statt anzuhalten. Wenn dein VPN oder Proxy ausgefallen ist, können andere deine IP-Adresse sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream will warn you instead of pausing. If your VPN or proxy is down, other people can see your IP address."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream te avisará en vez de pausar. Si tu VPN o tu proxy se caen, otras personas pueden ver tu dirección IP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream vous avertira au lieu de mettre en pause. Si votre VPN ou votre proxy est coupé, d’autres personnes peuvent voir votre adresse IP."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream akan memberi peringatan, bukan menjeda. Jika VPN atau proxy Anda mati, orang lain bisa melihat alamat IP Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream ti avvisa invece di mettersi in pausa. Se la VPN o il proxy non funzionano, altre persone possono vedere il tuo indirizzo IP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistreamは一時停止する代わりに警告します。VPNまたはプロキシが停止していると、他の人からIPアドレスが見えてしまう場合があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream ostrzeże zamiast wstrzymać. Jeśli VPN lub proxy nie działa, inni mogą zobaczyć adres IP."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A anistream vai avisar em vez de pausar. Se sua VPN ou proxy cair, outras pessoas podem ver o seu endereço IP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream будет предупреждать вместо паузы. Если VPN или прокси отключится, другие смогут увидеть ваш IP-адрес."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream varnar dig i stället för att pausa. Om din VPN eller proxy är nere kan andra se din IP-adress."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream duraklatmak yerine sizi uyarır. VPN'iniz ya da proxy'niz kapalıysa diğer kişiler IP adresinizi görebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream sẽ cảnh báo thay vì tạm dừng. Nếu VPN hoặc proxy của bạn ngừng hoạt động, người khác có thể thấy địa chỉ IP của bạn."
          }
        }
      }
    },
