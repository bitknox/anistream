              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "One new episode of a show you watch aired. The calendar has it."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$lld new episodes of shows you watch aired. The calendar has them."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "notice-episodes-queued" : {
      "comment" : "Toast after episodes are added to the download queue. Argument 1: count (Int).",
