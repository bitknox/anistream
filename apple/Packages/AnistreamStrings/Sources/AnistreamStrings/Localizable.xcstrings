    "start-failed" : {
      "comment" : "Message when anistream itself could not start. The reason comes from the system or the engine. Argument 1: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream couldn't start. Quit and open it again. %1$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistreamを起動できませんでした。一度終了してから、開き直してください。%1$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream kunde inte starta. Avsluta och öppna den igen. %1$@"
          }
        }
      }
    },
    "start-failed-config" : {
      "comment" : "Message when anistream could not start because the config file has a setting it can't use. The path is the file; the problem names the line where it can. Argument 1: path (Text). Argument 2: problem (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ has a setting anistream can't use: %2$@. Fix or remove it, then try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に、anistreamでは使用できない設定があります: %2$@。修正するか削除してから、もう一度お試しください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ har en inställning som anistream inte kan använda: %2$@. Rätta till den eller ta bort den och försök igen."
          }
        }
      }
    },
    "start-failed-database" : {
      "comment" : "Message when anistream could not start because its database could not be opened. The path is the database file, the reason comes from the system. Argument 1: path (Text). Argument 2: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream couldn't open its database at %1$@. If another anistream app is open on this folder, quit it and try again. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistreamは%1$@のデータベースを開けませんでした。同じフォルダで別のanistreamアプリが開いている場合は、終了してからもう一度お試しください。%2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream kunde inte öppna sin databas på %1$@. Om en annan app från anistream är öppen i den här mappen avslutar du den och försöker igen. %2$@"
          }
        }
      }
    },
    "start-failed-folder" : {
      "comment" : "Message when anistream could not start because a folder could not be made. The path is the folder, the reason comes from the system. Argument 1: path (Text). Argument 2: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream couldn't create the folder %1$@. Check that the disk has room and the folder can be written to, then try again. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistreamはフォルダ %1$@を作成できませんでした。ディスクに空きがあり、フォルダに書き込めることを確認してから、もう一度お試しください。%2$@"
          }
        },
        "sv" : {
          "stringUnit" : {
