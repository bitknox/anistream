      "comment" : "Line under the heading.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quellen werden von oben nach unten ausprobiert. Ziehe eine am Griff, um die Reihenfolge zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
