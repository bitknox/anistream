        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン用のブラウザを開けませんでした。ブラウザがインストールされているか確認して、もう一度試してください。%1$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się otworzyć przeglądarki do logowania. Sprawdź, czy któraś jest zainstalowana, i spróbuj ponownie. %1$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
