            "state" : "translated",
            "value" : "Cancel"
          }
        }
      }
    },
    "action-not-now" : {
      "comment" : "Button that puts a question off until later.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not now"
          }
        }
      }
    },
    "action-try-again" : {
      "comment" : "Button that runs a failed action again.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try again"
          }
        }
      }
    },
