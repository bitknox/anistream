    "notice-mal-no-refresh-token" : {
      "comment" : "Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList hat kein Refresh-Token ausgegeben. In etwa einem Monat musst du dich erneut anmelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList didn't issue a refresh token. You'll need to sign in again in about a month."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList no emitió un token de actualización. Tendrás que volver a iniciar sesión en un mes aproximadamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList n'a pas fourni de jeton de renouvellement. Vous devrez vous reconnecter dans un mois environ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList non ha rilasciato un token di aggiornamento. Dovrai accedere di nuovo tra circa un mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeListはリフレッシュトークンを発行しませんでした。約1か月後に、再度サインインが必要になります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList nie wydało tokenu odświeżania. Logowanie wygaśnie za około miesiąc i trzeba będzie zalogować się ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MyAnimeList não emitiu um token de atualização. Será preciso conectar de novo em cerca de um mês."
