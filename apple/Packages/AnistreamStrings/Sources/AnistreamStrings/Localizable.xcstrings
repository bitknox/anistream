    "settings-torrents-warn-note" : {
      "comment" : "Footnote of the Torrents group while torrents are on.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Nur warnen“ wirst du nur zur Bestätigung gefragt, genau wie bei „Kein Schutz“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choosing Warn only asks you to confirm first, as No protection does."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegir Advertir solo pide confirmar primero, igual que Sin protección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir Avertir seulement demande d’abord une confirmation, comme Aucune protection."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memilih Peringatan saja hanya meminta konfirmasi terlebih dahulu, sama seperti Tanpa perlindungan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegliendo Avvisa viene chiesta solo una conferma prima, come con Nessuna protezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「警告のみ」を選ぶと、「保護なし」と同様に、まず確認を求めます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybranie opcji Tylko ostrzegaj pyta najpierw o potwierdzenie, tak samo jak Brak ochrony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolher Apenas avisar pede confirmação antes, assim como Sem proteção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим «Предупреждать» только просит подтвердить действие, как и режим «Без защиты»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att välja Bara varna frågar först om bekräftelse, precis som Inget skydd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca uyar seçeneği, Koruma yok gibi, önce onay ister."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ cảnh báo chỉ hỏi xác nhận trước, giống như Không bảo vệ."
          }
        }
      }
    },
