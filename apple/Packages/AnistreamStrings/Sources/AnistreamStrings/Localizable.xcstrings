    "downloads-seeding-note" : {
      "comment" : "Line under the seeding heading.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesehene Folgen werden geteilt, während anistream geöffnet ist, bis das Verhältnis oder die Zeitgrenze aus den Einstellungen unter Quellen erreicht ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watched episodes are shared back while anistream is open, until the ratio or the time limit set in Settings, under Sources, is reached."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los episodios vistos se comparten mientras anistream está abierto, hasta llegar al límite de proporción o de tiempo que se define en Configuración, en Fuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les épisodes vus sont partagés pendant que anistream est ouvert, jusqu’à ce que le ratio ou la durée limite réglée dans les réglages, sous Sources, soit atteint."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episode yang sudah ditonton dibagikan kembali saat anistream terbuka, sampai rasio atau batas waktu di Pengaturan, di bawah Sumber-sumber, tercapai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli episodi visti vengono condivisi mentre anistream è aperto, finché non si raggiungono il rapporto o il limite di tempo impostati in Impostazioni, sotto Fonti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴済みのエピソードは、anistreamを開いている間に共有されます。設定のソースで指定した比率か時間の上限に達するまで続きます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obejrzane odcinki są udostępniane zwrotnie, gdy anistream jest otwarte, aż do osiągnięcia współczynnika lub limitu czasu ustawionego w Ustawieniach, w sekcji: Źródła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episódios assistidos são compartilhados de volta enquanto anistream estiver aberto, até o limite de proporção ou de tempo definido em Configurações, em Fontes, ser atingido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просмотренные эпизоды раздаются обратно, пока открыт anistream, до достижения коэффициента или лимита времени, заданных в разделе «Источники» настроек."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedda avsnitt delas tillbaka medan anistream är öppen, tills kvoten eller tidsgränsen som satts i inställningarna under Källor nås."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlenen bölümler, anistream açıkken ve Kaynaklar altında belirlenen oran ya da süre sınırına ulaşılana kadar paylaşılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tập đã xem được chia sẻ lại khi anistream đang mở, cho đến khi đạt tỉ lệ hoặc thời gian đặt trong Cài đặt, mục Các nguồn."
          }
        }
      }
    },
