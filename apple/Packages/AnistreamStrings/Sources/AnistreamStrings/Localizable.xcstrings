            "value" : "%1$@ jest dołączony pod adresem %2$@, ale ten link wskazuje na %3$@. Jeśli sklep z wtyczkami się przeniósł, najpierw go opuść i dołącz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está salva em %2$@, mas este link aponta para %3$@. Se a loja de plugins mudou, saia dela antes e entre de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ подключён по адресу %2$@, а эта ссылка ведёт на %3$@. Если магазин плагинов переехал, сначала выйдите из него и подключитесь снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ är ansluten på %2$@, men länken pekar på %3$@. Om tilläggsbutik har flyttats lämnar du den först och går med igen."
          }
        }
      }
    },
