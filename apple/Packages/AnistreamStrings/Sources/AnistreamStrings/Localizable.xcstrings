    "settings-aside-accounts" : {
      "comment" : "Side note in Accounts.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anistream funktioniert ohne Konto. Dein Sehverlauf bleibt beim Abmelden auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
