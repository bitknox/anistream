    "notice-anilist-client-missing" : {
      "comment" : "Toast when AniList sign-in needs a client id and secret in the config file. The setting names and the command are not translated. Argument 1: client (Text). Argument 2: secret (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AniList needs a client id and secret. Set %1$@ and %2$@ in the config file, then sign in again. To get the sign-in address, run anistream --login-url."
          }
        }
      }
    },
    "notice-anilist-implicit-flow" : {
      "comment" : "Toast when AniList is set to a sign-in method only the anistream app can finish. The setting name is a key of the config file and is not translated. Argument 1: setting (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This AniList sign-in method works only in the anistream app. To sign in here, set %1$@ to \"loopback\" in the config file."
          }
        }
      }
    },
    "notice-anilist-limit" : {
      "comment" : "Toast when there is no job to carry the wait for AniList's rate limit. Argument 1: wait (Seconds).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting %1$@ on the AniList rate limit."
          }
        }
      }
    },
    "notice-anilist-paste-flow" : {
      "comment" : "Toast when AniList is set to paste the code by hand, which a running terminal app cannot take. Terminal only: the engine never sends it to the apps.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasting a code isn't possible here. Quit and run anistream --login instead."
          }
        }
      }
    },
    "notice-anilist-unreachable" : {
      "comment" : "Toast when the AniList fallback takes over because AniList cannot be reached.",
