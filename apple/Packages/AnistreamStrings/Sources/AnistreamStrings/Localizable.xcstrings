        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ już deklaruje %2$@. Najpierw usuń ten plik, bo uruchomią się dwie kopie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
