    "updates-allow-once" : {
      "comment" : "Line the first time. The path is the Android settings path. Argument 1: path (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android fragt das nur einmal. Wenn sich die Seite nicht öffnet, findest du den Schalter unter %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android asks this once. If its page doesn't open, the switch is under %1$@."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android pide esto una sola vez. Si no se abre su página, el interruptor está en %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android ne demande cela qu’une fois. Si sa page ne s’ouvre pas, l’interrupteur se trouve sous %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android lo chiede una volta sola. Se la sua pagina non si apre, l'interruttore è in %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidはこの操作を一度だけ確認します。画面が開かない場合は、スイッチは%1$@にあります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android pyta o to raz. Jeśli jego strona się nie otworzy, przełącznik jest w: %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Android pede isto uma vez. Se a página não abrir, a chave fica em %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android спрашивает это один раз. Если его страница не открылась, переключатель находится в разделе %1$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android frågar bara en gång. Om sidan inte öppnas finns reglaget under %1$@."
          }
        }
      }
    },
    "updates-allow-step-1" : {
      "comment" : "Step one.",
      "extractionState" : "manual",
      "localizations" : {
