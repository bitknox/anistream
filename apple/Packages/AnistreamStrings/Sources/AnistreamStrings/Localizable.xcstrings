    "stores-leave-detail" : {
      "comment" : "Line under it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät kann keine Plugins mehr installieren oder aktualisieren. Bereits installierte Plugins bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device can no longer install or update its plugins. Plugins already installed stay."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo ya no puede instalar ni actualizar sus complementos. Los complementos ya instalados se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne peut plus installer ni mettre à jour ses plugins. Les plugins déjà installés restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo non può più installare o aggiornare i suoi plugin. I Plugin già installati restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは、プラグインのインストールや更新ができなくなります。すでにインストールされているプラグインはそのまま残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wtyczki zainstalowane wcześniej zostają. Instalowanie i aktualizowanie jest już wyłączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo não pode mais instalar nem atualizar os plugins. Os plugins já instalados continuam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство больше не может устанавливать или обновлять свои плагины. Уже установленные плагины остаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här enheten kan inte längre installera eller uppdatera sina tillägg. Tillägg som redan är installerade finns kvar."
          }
        }
      }
    },
    "stores-leave-rejoin" : {
      "comment" : "Line under it, when a new invite is needed to return.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins, die daraus installiert wurden, bleiben installiert. Um wieder beizutreten, brauchst du eine neue Einladung von der betreibenden Person."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plugins installed from it stay installed. To join again, you need a new invite from its owner."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los complementos instalados desde ella se quedan instalados. Para volver a unirte, necesitas una invitación nueva de su propietario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plugins installés depuis cette boutique restent installés. Pour revenir, il faut une nouvelle invitation de son propriétaire."
