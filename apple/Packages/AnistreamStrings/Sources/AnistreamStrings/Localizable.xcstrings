    "tv-status-cant-reach" : {
      "comment" : "Status of the remote: the link was lost and the TV is not answering any more. Argument 1: name (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist nicht erreichbar. Prüfe, ob er eingeschaltet ist und im selben Netzwerk wie dieses Handy ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't reach %1$@. Check that it is on and on the same network."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con %1$@. Revisa que esté encendido y en la misma red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre %1$@. Vérifiez qu’elle est allumée et sur le même réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere %1$@. Controlla che sia accesa e sulla stessa rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に接続できませんでした。電源が入っていて、同じネットワークにあるかご確認ください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć się z %1$@. Sprawdź, czy jest włączony i w tej samej sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar %1$@. Confira se ela está ligada e na mesma rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет связи с %1$@. Проверьте, что он включён и подключён к этой же сети."
