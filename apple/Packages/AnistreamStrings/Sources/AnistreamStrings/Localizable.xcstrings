      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Benachrichtigung, wenn eine Folge einer Serie aus deiner Liste „Wird geschaut“ erscheint, zu der Zeit, die %1$@ angibt. Die eigene Einstellung einer Serie hat Vorrang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One notification when an episode of a show in your Watching list comes out, at the time %1$@ gives. A show's own setting comes first."
