    "notice-match-uncertain" : {
      "comment" : "Toast when a source found several shows that could be this one and could not tell which. The episodes shown are AniList's until one is picked. The source is its name. Argument 1: source (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat mehr als eine Serie gefunden, die diese sein könnte. Deshalb stammen die Folgen vorerst von AniList."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ found more than one show that could be this one, so these episodes are from AniList for now."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ encontró más de una serie que podría ser esta, así que por ahora los episodios vienen de AniList."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a trouvé plusieurs séries qui pourraient être celle-ci. Les épisodes affichés viennent donc d'AniList pour l'instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha trovato più serie che potrebbero essere questa, quindi per ora gli episodi sono quelli di AniList."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@で、この作品の候補になりうる作品が複数見つかりました。候補を選ぶまでは、エピソードはAniListの情報を表示しています。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W %1$@ znaleziono więcej niż jeden tytuł, który może pasować. Na razie odcinki pochodzą z AniList."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ encontrou mais de uma série que pode ser esta, então, por enquanto, os episódios vêm do AniList."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ нашёл несколько подходящих аниме и не может определить, какое из них нужное. Пока эпизоды взяты из AniList."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hittade fler än en serie som kan vara den här, så avsnitten kommer från AniList tills vidare."
          }
        }
      }
    },
    "notice-metadata-cached" : {
      "comment" : "Toast when no metadata service answered and the last cached data is shown.",
