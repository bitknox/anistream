    "torrent-no-index" : {
      "comment" : "Error: torrents are on, but no torrent index is set.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrents need a torrent index. anistream ships none, so add your own address in the settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレントにはトレントインデックスが必要です。anistreamには含まれていないため、設定でアドレスを追加してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrenter kräver ett torrentindex. anistream levererar inget, så lägg till din egen adress i inställningarna."
          }
        }
      }
    },
    "torrent-no-kill-switch" : {
      "comment" : "Toast when torrents are up but no operating-system firewall rule backs the VPN guard. Terminal only: the engine never sends it to the apps.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing on this device stops torrent traffic if the VPN drops. Run \"anistream --doctor\" to set that up."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPNが切断された場合にトレントの通信を止める仕組みが、このデバイスにはありません。「anistream --doctor」を実行すると設定できます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting på den här enheten stoppar torrenttrafiken om VPN:en tappas. Kör \"anistream --doctor\" för att ställa in det."
          }
        }
      }
    },
    "torrent-not-checked" : {
      "comment" : "Toast when the connection check could not run. The reason comes from the VPN settings. Argument 1: reason (Text).",
      "extractionState" : "manual",
