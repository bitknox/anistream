          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este link não deixa mais ninguém entrar. Peça um novo link ou um convite ao dono da loja de plugins."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "магазин плагинов больше не принимает по этой ссылке. Попросите новую ссылку или приглашение у владельца."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
