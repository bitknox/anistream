              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Queued one episode."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Queued %1$lld episodes."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "notice-kitsu-signs-in-on-accounts" : {
      "comment" : "Toast on a screen that opens Kitsu's sign-in as a prompt. It is shown with a button to open it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitsu signs in from the Accounts screen."
          }
        }
      }
    },
    "notice-mal-client-missing" : {
      "comment" : "Toast when MyAnimeList sign-in needs a client id in the config file. The setting name and the address are not translated. Argument 1: setting (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList needs a client id. Register an app of type other at myanimelist.net/apiconfig, then set %1$@ in the config file."
          }
        }
      }
    },
    "notice-mal-client-missing-build" : {
      "comment" : "Toast when this build has no MyAnimeList client to finish a sign-in with.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't finish signing in to MyAnimeList: this build has no client for it."
          }
        }
      }
    },
    "notice-mal-no-refresh-token" : {
      "comment" : "Toast when MyAnimeList signed in without a refresh token, so the sign-in lapses in about a month.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MyAnimeList didn't issue a refresh token. You'll need to sign in again in about a month."
          }
        }
      }
    },
    "notice-mapping-data-failed" : {
      "comment" : "Toast when the mapping data could not be downloaded. It is said once; the retries are silent. Argument 1: datasets (Text). Argument 2: wait (Seconds). Argument 3: cause (Cause).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't refresh the mapping data (%1$@). Trying again in %2$@. %3$@"
          }
        }
      }
    },
    "notice-mapping-data-refreshed" : {
      "comment" : "Toast when the mapping data downloads work again after a failure.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapping data refreshed."
          }
        }
      }
    },
    "notice-not-saved" : {
      "comment" : "Toast when a setting could not be stored. The reason comes from the system. Argument 1: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't save that setting. %1$@"
          }
        }
      }
    },
    "notice-not-saved-because" : {
      "comment" : "Toast when a setting could not be stored. The cause says why and what to do. Argument 1: cause (Cause).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't save that setting. %1$@"
          }
        }
      }
    },
    "notice-playback-failed" : {
      "comment" : "Toast when playback stops with an error.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback failed. Try another source."
          }
        }
      }
    },
    "notice-protection-not-checked" : {
      "comment" : "Toast when the torrent protection could not be checked. The cause says why. Argument 1: cause (Cause).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't check the torrent protection. %1$@"
          }
        }
      }
    },
    "notice-protection-saved" : {
      "comment" : "Toast when the torrent protection choice was saved.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved torrent protection."
          }
        }
      }
    },
    "notice-proxy-password-not-kept" : {
      "comment" : "Toast when the proxy's password could not be stored. The reason comes from the system. Argument 1: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't keep the proxy's password. Enter it again to try saving it. %1$@"
          }
        }
      }
    },
    "notice-saved" : {
      "comment" : "Toast after a setting is stored. The label is the setting's name. Argument 1: label (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved %1$@."
          }
        }
      }
    },
    "notice-show-no-such-subtitles" : {
      "comment" : "Toast when a subtitle choice names subtitles the show has not used.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't save that subtitle choice. This show hasn't used those subtitles before."
          }
        }
      }
    },
    "notice-show-not-reset" : {
      "comment" : "Toast when resetting a show's settings failed. The reason comes from the local database. Argument 1: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reset this show's settings. %1$@"
          }
        }
      }
    },
    "notice-show-setting-refused" : {
      "comment" : "Toast when a show's setting was given a value it does not take. The value is what was given. Argument 1: value (Text). Argument 2: setting (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't save that setting. %1$@ isn't a value for %2$@."
          }
        }
      }
    },
    "notice-sign-in-failed" : {
      "comment" : "Toast when a sign-in did not finish. The reason comes from the tracker or the network. Argument 1: tracker (Text). Argument 2: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't sign in to %1$@. Try again. %2$@"
          }
        }
      }
    },
    "notice-sign-in-needs-redirect" : {
      "comment" : "Toast on an app that cannot receive a browser redirect. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing in to %1$@ needs a browser redirect, which this app can't receive."
          }
        }
      }
    },
    "notice-sign-in-no-token" : {
      "comment" : "Toast when a tracker sent the person back without a token. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in to %1$@ came back without a token. Try again."
          }
        }
      }
    },
    "notice-sign-in-not-waiting" : {
      "comment" : "Toast when a sign-in redirect arrives and no sign-in is waiting for it. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No sign-in to %1$@ is waiting for that. Start the sign-in again."
          }
        }
      }
    },
    "notice-sign-in-stopped" : {
      "comment" : "Toast when the wait for a sign-in ended early. The reason comes from the system. Argument 1: tracker (Text). Argument 2: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in to %1$@ stopped before it finished. Try again. %2$@"
          }
        }
      }
    },
    "notice-sign-in-unsupported" : {
      "comment" : "Toast when a tracker has no way to sign in yet. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing in to %1$@ isn't supported yet."
          }
        }
      }
    },
    "notice-sign-in-wrong-request" : {
      "comment" : "Toast when a sign-in redirect does not match the request that was made. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That sign-in to %1$@ didn't come back from this request. Start the sign-in again."
          }
        }
      }
    },
    "notice-sign-out-failed" : {
      "comment" : "Toast when signing out of a tracker failed. The reason comes from the system. Argument 1: tracker (Text). Argument 2: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't sign out of %1$@. Try again. %2$@"
          }
        }
      }
    },
    "notice-signed-in" : {
      "comment" : "Toast after a tracker sign-in succeeded. The tracker is its name, such as AniList. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signed in to %1$@."
          }
        }
      }
    },
    "notice-signed-in-file" : {
      "comment" : "Toast after a sign-in succeeded on a device with no keychain. The token is in a file only this user can read. It is said so that someone on a shared computer knows. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signed in to %1$@. No keychain is available, so the token is in a private file on this device."
          }
        }
      }
    },
    "notice-signed-in-keychain" : {
      "comment" : "Toast after a sign-in succeeded and the token went into the system keychain. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signed in to %1$@. The token is in the OS keychain."
          }
        }
      }
    },
    "notice-signed-in-unsaved" : {
      "comment" : "Toast when a sign-in worked but the token could not be stored. The reason comes from the system. Argument 1: tracker (Text). Argument 2: reason (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signed in to %1$@, but the token wasn't saved, so you'll need to sign in again next time. %2$@"
          }
        }
      }
    },
    "notice-signed-out" : {
      "comment" : "Toast after signing out of a tracker with nothing waiting to send. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signed out of %1$@."
          }
        }
      }
    },
    "notice-signed-out-queue" : {
      "comment" : "Toast after signing out of a tracker. The changes were not discarded: they are sent after the next sign-in. Argument 1: tracker (Text). Argument 2: count (Int).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Signed out of %1$@. One queued change is kept for the next sign-in."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Signed out of %1$@. %2$lld queued changes are kept for the next sign-in."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
