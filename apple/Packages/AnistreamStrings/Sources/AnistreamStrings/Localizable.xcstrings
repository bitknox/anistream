      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Library"
          }
        }
      }
    },
    "notice-episodes-queued" : {
      "comment" : "Toast after episodes are added to the download queue. Argument 1: count (Int).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Queued one episode."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Queued %1$lld episodes."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "notice-not-saved" : {
      "comment" : "Toast when a setting could not be stored. The reason comes from the system. Argument 1: reason (Text).",
