    "sources-torrents-note" : {
      "comment" : "Note under the facts on the Torrents page in Sources. Torrents are built in, not a plugin.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrents gehören zu anistream und sind kein Plugin. Den Schutz des Datenverkehrs, die Verbindungsprüfung und das Seeding stellst du in den Einstellungen unter Quellen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrents are part of anistream, not a plugin. What protects their traffic, the connection check and seeding are set in Settings, under Sources."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los torrents forman parte de anistream, no de un complemento. La protección de su tráfico, la verificación de conexión y la siembra se configuran en Ajustes, en Fuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les torrents font partie de anistream, pas d'un plugin. Le réglage qui protège leur trafic, le contrôle de connexion et le partage se trouvent dans les réglages, sous Sources."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrent adalah bagian dari anistream, bukan plugin. Pelindung lalu lintasnya, pemeriksaan koneksi, dan seeding diatur di Pengaturan, di bawah Sumber-sumber."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I torrent fanno parte di anistream, non sono un plugin. La protezione del loro traffico, il controllo della connessione e il seeding si impostano nelle Impostazioni, sotto Fonti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレントはプラグインではなく、anistreamに含まれています。通信の保護、接続確認、シーディングは、設定のソースで設定します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrenty są wbudowane w anistream, to nie wtyczka. Ochronę ruchu, sprawdzanie połączenia i seedowanie ustawiasz w ustawieniach, w sekcji „Źródła”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrents fazem parte do anistream, e não de um plugin. A proteção do tráfego, a verificação de conexão e a semeadura são definidas em Configurações, em Fontes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торренты входят в anistream, а не плагин. Защита трафика, проверка соединения и раздача настраиваются в разделе «Источники» в настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrent ingår i anistream, inte i ett tillägg. Vad som skyddar deras trafik, anslutningskontrollen och seedningen ställs in i Inställningar, under Källor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrent'ler anistream'ın parçasıdır, bir eklenti değil. Trafiklerini koruyan ayarlar, bağlantı denetimi ve paylaşım, Ayarlar'da, Kaynaklar altında yapılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torrent là một phần của anistream, không phải plugin. Mục bảo vệ lưu lượng của chúng, kiểm tra kết nối và chia sẻ được đặt trong Cài đặt, ở mục Các nguồn."
          }
        }
      }
    },
