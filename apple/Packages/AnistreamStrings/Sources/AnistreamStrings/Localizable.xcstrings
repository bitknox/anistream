    "accounts-clash-detail" : {
      "comment" : "Line under it. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese wurden bei %1$@ und hier seit der letzten Synchronisierung geändert. Behalte jeweils eine Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These changed on %1$@ and here since the last sync. Keep one side of each."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos cambiaron en %1$@ y aquí desde la última sincronización. Conserva un lado de cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces éléments ont changé sur %1$@ et ici depuis la dernière synchronisation. Gardez l'un des deux pour chacun."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini berubah di %1$@ dan di sini sejak sinkronisasi terakhir. Pilih satu sisi untuk setiap baris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi sono cambiati su %1$@ e qui dall'ultima sincronizzazione. Scegli quale lato tenere per ogni voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@とこのデバイスで、前回の同期後に変更された項目があります。それぞれ、どちらか一方を残してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te dane zmieniły się w %1$@ i tutaj od ostatniej synchronizacji. Zachowaj jedną stronę z każdej pary."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes campos mudaram em %1$@ e aqui desde a última sincronização. Mantenha um dos lados de cada campo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти поля изменились в %1$@ и здесь с последней синхронизации. Для каждого оставьте одну из версий."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa ändrades hos %1$@ och här sedan senaste synken. Behåll ett av värdena för varje."
