    "shell-start-failed-body" : {
      "comment" : "Plain line under the title of the page shown when the engine could not start. The reason follows it, in the engine's words, for a bug report.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas hat verhindert, dass anistream öffnet. Versuch es noch einmal. Wenn es immer wieder passiert, sende einen Bericht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something stopped anistream from opening. Try again, and if it keeps happening, send a report."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo impidió que anistream se abriera. Inténtalo otra vez y, si sigue pasando, envía un reporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose a empêché anistream de s’ouvrir. Réessayez et, si cela continue, envoyez un rapport."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa ha impedito l'apertura di anistream. Riprova e, se succede ancora, invia una segnalazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何らかの理由でanistreamを開けませんでした。もう一度お試しください。それでも同じ場合は、不具合を報告してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś uniemożliwiło otwarcie anistream. Spróbuj ponownie, a jeśli to się powtarza, wyślij zgłoszenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo impediu a anistream de abrir. Tente de novo e, se continuar acontecendo, envie um relatório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что-то помешало открыть anistream. Попробуйте ещё раз. Если это повторяется, отправьте отчёт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något hindrade anistream från att öppnas. Försök igen, och skicka en rapport om det fortsätter."
          }
        }
      }
    },
