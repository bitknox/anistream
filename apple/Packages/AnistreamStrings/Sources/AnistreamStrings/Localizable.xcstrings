    "accounts-scan-code" : {
      "comment" : "Line on the TV's sign-in screen for a tracker that signs in by code. Argument 1: tracker (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne mit deinem Telefon. Öffne dort %1$@, erlaube anistream und füge dann den Code auf dieser Seite ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan with your phone. Open %1$@ there, allow anistream, then paste the code on this page."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea con tu teléfono. Abre %1$@ ahí, permite el acceso a anistream y luego pega el código en esta página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez avec votre téléphone. Ouvrez %1$@ là-bas, autorisez anistream, puis collez le code sur cette page."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindai dengan ponsel Anda. Buka %1$@ di sana, izinkan anistream, lalu tempel kodenya di halaman ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra con il telefono. Apri %1$@ lì, consenti anistream, poi incolla il codice in questa pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンで読み取ってください。そこで%1$@を開き、anistreamを許可してから、このページにコードを貼り付けてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj telefonem. Otwórz tam %1$@, zezwól anistream, a potem wklej kod na tej stronie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie com seu celular. Abra %1$@ nele, permita o anistream e cole o código nesta página."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте телефоном. Откройте там %1$@, разрешите anistream, затем вставьте код на этой странице."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna med din telefon. Öppna %1$@ där, tillåt anistream och klistra in koden på den här sidan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonunuzla tarayın. %1$@ uygulamasını orada açın, anistream uygulamasına izin verin, ardından kodu bu sayfaya yapıştırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quét bằng điện thoại. Mở %1$@ ở đó, cho phép anistream, rồi dán mã vào trang này."
          }
        }
      }
    },
