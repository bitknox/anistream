    "party-needs-server" : {
      "comment" : "Message when a watch party was asked for with no server chosen. The names are a suggested server and who runs it. Terminal only: the engine never sends it to the apps. Argument 1: server (Text). Argument 2: operator (Text).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle zuerst einen Server für die Watchparty als syncplay.server. %1$@ wird von %2$@ betrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a server for the watch party first, as syncplay.server. %1$@ is run by %2$@."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero elige un servidor para la watch party, en el ajuste syncplay.server. %1$@ es operado por %2$@."
