          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ zawiera ustawienie, którego anistream nie może użyć: %2$@. Popraw je lub usuń, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
