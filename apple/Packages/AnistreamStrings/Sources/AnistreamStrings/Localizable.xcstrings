    "stores-plugin-limits" : {
      "comment" : "Line under the plugin list: what a plugin may do.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Plugin kann nur die Hosts kontaktieren, die mit ihm aufgelistet sind, und kann deine Dateien nicht lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each plugin can contact only the hosts listed with it and cannot read your files."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada complemento solo puede conectarse a los hosts que aparecen con él y no puede leer tus archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque plugin ne peut contacter que les serveurs listés avec lui et ne peut pas lire vos fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni plugin può contattare solo gli host elencati insieme a lui e non può leggere i tuoi file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各プラグインは、一覧に示されたホストにのみ接続でき、お使いのファイルを読み取ることはできません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda wtyczka może łączyć się tylko z hostami wymienionymi przy niej i nie może czytać twoich plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada plugin só pode contatar os endereços listados com ele e não pode ler seus arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый плагин может обращаться только к серверам, указанным вместе с ним, и не может читать ваши файлы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje tillägg kan bara nå de värdar som står listade med det och kan inte läsa dina filer."
          }
        }
      }
    },
