    "notice-not-aired-yet" : {
      "comment" : "A play's explanation: the episode is after the next one to air. The \"when\" says when that one airs. Argument 1: episode (Int). Argument 2: next (Int). Argument 3: when (Cause).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
