            "state" : "translated",
            "value" : "%1$llds"
          }
        }
      }
    },
    "episode-unsourced" : {
      "comment" : "Under an episode that is out but that no source lists. The row is dimmed and can't be played.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No source has this episode"
          }
        }
      }
    },
    "episodes-count" : {
      "comment" : "A number of episodes, alone: a badge or a count under a title. Argument 1: count (Int).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$lld episode"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%1$lld episodes"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "group-in-progress" : {
