    "settings-system-captions-detail" : {
      "comment" : "Line under it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfache Untertitel nutzen deine Einstellungen für Untertitel aus der Bedienungshilfe. Gestaltete Untertitel behalten ihr eigenes Aussehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plain subtitles use your caption preferences from Accessibility. Styled subtitles keep their own look."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos simples usan tus preferencias de subtítulos de Accesibilidad. Los subtítulos con estilo mantienen su propio aspecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres simples utilisent vos préférences de sous-titrage de l’Accessibilité. Les sous-titres stylisés gardent leur propre aspect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sottotitoli semplici usano le tue preferenze per i sottotitoli in Accessibilità. I sottotitoli con stile mantengono il proprio aspetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "装飾のない字幕は、アクセシビリティの字幕設定に従います。装飾された字幕は、独自の見た目のままです。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwykłe napisy korzystają z ustawień napisów z Ułatwień dostępu. Napisy ze stylem zachowują własny wygląd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legendas simples usam suas preferências de legenda em Acessibilidade. Legendas estilizadas mantêm o próprio visual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычные субтитры берут настройки из «Универсального доступа». Субтитры с собственным оформлением сохраняют свой вид."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanliga undertexter använder dina textinställningar från Tillgänglighet. Stilade undertexter behåller sin egen look."
          }
        }
      }
    },
