    "torrents-unprotected-detail" : {
      "comment" : "Line under it.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere können deine IP-Adresse sehen, während du einen Torrent herunterlädst und teilst, und anistream prüft die Verbindung nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other people can see your IP address while you download and share a torrent, and anistream doesn't check the connection."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otras personas pueden ver tu dirección IP mientras descargas y compartes un torrent, y anistream no comprueba la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’autres personnes peuvent voir votre adresse IP pendant que vous téléchargez et partagez un torrent, et anistream ne vérifie pas la connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altre persone possono vedere il tuo indirizzo IP mentre scarichi e condividi un torrent, e anistream non controlla la connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレントのダウンロードと共有中は、ほかの人があなたのIPアドレスを見ることができます。また、anistreamは接続を確認しません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas pobierania i udostępniania torrenta inni mogą zobaczyć adres IP, a anistream nie sprawdza połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outras pessoas podem ver o seu endereço IP enquanto você baixa e compartilha um torrent, e o anistream não verifica a conexão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие люди могут видеть ваш IP-адрес, пока вы скачиваете и раздаёте торрент, а anistream не проверяет соединение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andra kan se din IP-adress medan du laddar ner och delar en torrent, och anistream kontrollerar inte anslutningen."
          }
        }
      }
    },
