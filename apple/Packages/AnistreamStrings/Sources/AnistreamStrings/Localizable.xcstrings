    "torrents-keep-running-detail" : {
      "comment" : "Line under the question: what the choice is about.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was mit Torrents passiert, wenn die Prüfung Datenverkehr außerhalb deines VPNs oder Proxys findet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What happens to torrents when the check finds traffic leaving outside your VPN or proxy."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que pasa con los torrents cuando la comprobación encuentra tráfico que sale fuera de tu VPN o proxy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui arrive aux torrents lorsque la vérification trouve du trafic hors de votre VPN ou de votre proxy."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa succede ai torrent quando il controllo rileva traffico che esce al di fuori della VPN o del proxy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続確認で、VPNまたはプロキシの外に通信が出ていることがわかった場合、トレントをどうするかを選びます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co dzieje się z torrentami, gdy sprawdzenie wykryje ruch poza VPN lub proxy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que acontece com os torrents quando a verificação encontra tráfego saindo fora da sua VPN ou do seu proxy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что будет с торрентами, если проверка найдёт трафик вне VPN или прокси."
