<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anistream.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:player="using:Anistream.Windows.Player"
    Title="anistream">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The title bar: the app icon, "anistream", back, the pane toggle and the search box,
         with the content extended into it. Mica shows through it. -->
    <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="anistream"
              IsBackButtonVisible="True" IsPaneToggleButtonVisible="True"
              BackRequested="OnBackRequested" PaneToggleRequested="OnPaneToggleRequested">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Assets/anistream.ico" />
      </TitleBar.IconSource>
      <AutoSuggestBox x:Name="SearchBox" MinWidth="320" MaxWidth="480" VerticalAlignment="Center"
                      PlaceholderText="Search titles" QueryIcon="Find"
                      AutomationProperties.Name="Search titles"
                      QuerySubmitted="OnSearchSubmitted" TextChanged="OnSearchTextChanged"
                      SuggestionChosen="OnSuggestionChosen">
        <AutoSuggestBox.KeyboardAccelerators>
          <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearch" />
          <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="OnFocusSearch" />
        </AutoSuggestBox.KeyboardAccelerators>
      </AutoSuggestBox>
    </TitleBar>

    <NavigationView x:Name="Nav" Grid.Row="1"
                    IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="True" PaneDisplayMode="Auto"
                    ExpandedModeThresholdWidth="1008" CompactModeThresholdWidth="641"
                    OpenPaneLength="240" IsTitleBarAutoPaddingEnabled="False"
                    SelectionChanged="OnNavSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Continue" Tag="continue" ToolTipService.ToolTip="Continue">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Calendar" Tag="calendar" ToolTipService.ToolTip="Calendar">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE787;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Seasonal" Tag="seasonal" ToolTipService.ToolTip="Seasonal">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Library" Tag="library" ToolTipService.ToolTip="Library">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="AccountItem" Tag="account" SelectsOnInvoked="True">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="AccountText" Text="Not signed in" VerticalAlignment="Center" />
            <Ellipse x:Name="AccountDot" Width="6" Height="6" Fill="{ThemeResource WaterBrush}"
                     VerticalAlignment="Center" Visibility="Collapsed" />
          </StackPanel>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Frame x:Name="ContentFrame" Navigated="OnFrameNavigated" />
    </NavigationView>

    <!-- What the engine says in passing: marked watched, a sync failed. -->
    <InfoBar x:Name="Toast" Grid.Row="1" IsOpen="False" IsClosable="True" MaxWidth="480"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" />

    <!-- The player, over the page it came from, with the title bar as its top bar. -->
    <player:PlayerView x:Name="Player" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" />
  </Grid>
</Window>
