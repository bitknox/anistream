<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Anistream.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- The design brief's Fluent mapping: Obi and Silk in Fluent's own theme resources, dark
           only at v1. The colours, then the brushes the controls read, since a brush that
           XamlControlsResources made from a colour does not follow an override of the colour. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#F2A64B</Color>
          <Color x:Key="SystemAccentColorLight1">#DE9340</Color>
          <Color x:Key="SystemAccentColorLight2">#F2A64B</Color>
          <Color x:Key="SystemAccentColorLight3">#F7C98B</Color>
          <Color x:Key="SystemAccentColorDark1">#DE9340</Color>
          <Color x:Key="SystemAccentColorDark2">#C57C2C</Color>
          <Color x:Key="SystemAccentColorDark3">#A35C0C</Color>
          <Color x:Key="SolidBackgroundFillColorBase">#161A2E</Color>
          <Color x:Key="LayerFillColorDefault">#161A2E</Color>
          <Color x:Key="CardBackgroundFillColorDefault">#222638</Color>
          <Color x:Key="ControlFillColorDefault">#2A2F45</Color>
          <Color x:Key="ControlFillColorSecondary">#343A57</Color>
          <Color x:Key="ControlFillColorTertiary">#222638</Color>
          <Color x:Key="ControlStrokeColorDefault">#2F3242</Color>
          <Color x:Key="CardStrokeColorDefault">#2F3242</Color>
          <Color x:Key="DividerStrokeColorDefault">#2F3242</Color>
          <Color x:Key="TextFillColorPrimary">#E4E0D6</Color>
          <Color x:Key="TextFillColorSecondary">#9298B5</Color>
          <Color x:Key="TextFillColorDisabled">#5C6073</Color>
          <Color x:Key="TextOnAccentFillColorPrimary">#161A2E</Color>
          <Color x:Key="SystemFillColorCritical">#E06B54</Color>

          <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#161A2E" />
          <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#161A2E" />
          <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#222638" />
          <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2F3242" />
          <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2A2F45" />
          <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#343A57" />
          <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#222638" />
          <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2F3242" />
          <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#2F3242" />
          <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4E0D6" />
          <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9298B5" />
          <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C6073" />
          <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#161A2E" />
          <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#161A2E" />
          <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F2A64B" />
          <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#F2A64B" Opacity="0.9" />
          <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#DE9340" />
          <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F7C98B" />
          <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#F7C98B" />
          <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#F2A64B" />
          <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#E06B54" />

          <!-- Toggles, switches and the selector bar: amber when on, ground text on it. -->
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#F2A64B" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#F2A64B" Opacity="0.9" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#DE9340" />
          <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#161A2E" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#161A2E" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#161A2E" />
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#F2A64B" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#F2A64B" Opacity="0.9" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#DE9340" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#161A2E" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#161A2E" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#161A2E" />
          <SolidColorBrush x:Key="SelectorBarItemPillFill" Color="#F2A64B" />

          <!-- Progress: amber on the rule colour. -->
          <SolidColorBrush x:Key="ProgressBarForeground" Color="#F2A64B" />
          <SolidColorBrush x:Key="ProgressBarBackground" Color="#434653" />
          <SolidColorBrush x:Key="ProgressBarBorderBrush" Color="#434653" />
          <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="#F2A64B" />

          <!-- The timeline and the volume: played part amber on the rule colour. -->
          <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F2A64B" />
          <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#F2A64B" />
          <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#F2A64B" />
          <SolidColorBrush x:Key="SliderTrackFill" Color="#434653" />
          <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#434653" />
          <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#434653" />
          <SolidColorBrush x:Key="SliderThumbBackground" Color="#F2A64B" />
          <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#F7C98B" />
          <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#DE9340" />

          <!-- The pane shows Mica; the content is the solid ground. -->
          <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#161A2E" />
          <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#2F3242" />
          <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
          <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
          <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
          <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#2F3242" />
          <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#F2A64B" />
          <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#F2A64B" />
          <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#F2A64B" />
          <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#DE9340" />

          <!-- Dialogs on the raised surface, their button row on the ground. -->
          <SolidColorBrush x:Key="ContentDialogBackground" Color="#161A2E" />
          <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#222638" />
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#2F3242" />

          <!-- The app's own. -->
          <SolidColorBrush x:Key="GroundBrush" Color="#161A2E" />
          <SolidColorBrush x:Key="RaisedBrush" Color="#222638" />
          <SolidColorBrush x:Key="SilkBrush" Color="#E4E0D6" />
          <SolidColorBrush x:Key="HazeBrush" Color="#9298B5" />
          <SolidColorBrush x:Key="AmberBrush" Color="#F2A64B" />
          <SolidColorBrush x:Key="WaterBrush" Color="#7FC7D9" />
          <SolidColorBrush x:Key="RuleBrush" Color="#434653" />
          <SolidColorBrush x:Key="FaintRuleBrush" Color="#2F3242" />
          <!-- The player's 35% dim of the ground over the frame. -->
          <SolidColorBrush x:Key="DimBrush" Color="#161A2E" Opacity="0.35" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
