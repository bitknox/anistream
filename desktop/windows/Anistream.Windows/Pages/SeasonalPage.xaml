<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anistream.Windows.Pages.SeasonalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Anistream.Windows"
    xmlns:local="using:Anistream.Windows.Pages"
    Background="{ThemeResource GroundBrush}">
  <Grid Padding="36,20,36,0" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Seasonal" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
      <local:OfflineLine />
    </StackPanel>
    <!-- The season as a picker, with the seasons before and after it beside it. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
      <Button x:Name="Earlier" Click="OnEarlier" ToolTipService.ToolTip="Previous season" AutomationProperties.Name="Previous season" Height="32">
        <FontIcon Glyph="&#xE76B;" FontSize="12" />
      </Button>
      <DropDownButton x:Name="SeasonPicker" MinWidth="140" Height="32" AutomationProperties.Name="Season">
        <DropDownButton.Flyout>
          <MenuFlyout x:Name="SeasonMenu" Placement="BottomEdgeAlignedLeft" />
        </DropDownButton.Flyout>
      </DropDownButton>
      <Button x:Name="Later" Click="OnLater" ToolTipService.ToolTip="Next season" AutomationProperties.Name="Next season" Height="32">
        <FontIcon Glyph="&#xE76C;" FontSize="12" />
      </Button>
    </StackPanel>
    <SelectorBar x:Name="Formats" Grid.Row="2" SelectionChanged="OnFormatChanged" Margin="-8,0,0,0">
      <SelectorBarItem Text="All" Tag="" IsSelected="True" />
      <SelectorBarItem Text="TV" Tag="TV,TV_SHORT" />
      <SelectorBarItem Text="Movie" Tag="MOVIE" />
      <SelectorBarItem Text="OVA" Tag="OVA,SPECIAL" />
      <SelectorBarItem Text="ONA" Tag="ONA" />
    </SelectorBar>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <local:StateHost x:Name="State" Padding="0,4,0,24">
        <app:CoverGrid x:Name="Grid" />
      </local:StateHost>
    </ScrollViewer>
  </Grid>
</Page>
