<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anistream.Windows.Pages.ContinuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anistream.Windows.Pages"
    xmlns:app="using:Anistream.Windows"
    Background="{ThemeResource GroundBrush}">
  <Page.Resources>
    <CollectionViewSource x:Name="Groups" IsSourceGrouped="True" />
  </Page.Resources>
  <Grid Padding="36,20,36,0" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Continue" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
      <local:OfflineLine />
    </StackPanel>
    <TextBlock x:Name="SyncLine" Grid.Row="1" Style="{StaticResource HazeCaptionStyle}" Visibility="Collapsed" />

    <!-- The queue down the start edge, 360 wide; the selected row's preview beside it when the
         content is 780 wide or more. Narrower, the queue alone, a row opening its title. -->
    <local:StateHost x:Name="State" Grid.Row="2">
    <Grid x:Name="Body" ColumnSpacing="32" Visibility="Collapsed" SizeChanged="OnBodySizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="QueueColumn" Width="360" />
        <ColumnDefinition x:Name="PreviewColumn" Width="*" />
      </Grid.ColumnDefinitions>
      <ListView x:Name="Queue" SelectionMode="Single" ItemClick="OnQueueItemClick"
                SelectionChanged="OnSelectionChanged" DoubleTapped="OnQueueDoubleTapped"
                KeyDown="OnQueueKeyDown" Margin="-12,0,0,0" Padding="0,0,0,24"
                AutomationProperties.Name="Continue watching">
        <ListView.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate x:DataType="local:QueueGroup">
                <TextBlock Text="{x:Bind Key}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListView.GroupStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:QueueRow">
            <Grid Height="62" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
              <Grid.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="{x:Bind MenuPlay}" Click="OnMenuPlay" Tag="{x:Bind}" IsEnabled="{x:Bind Item.Playable}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Play from the beginning" Click="OnMenuFromStart" Tag="{x:Bind}"
                                  Visibility="{x:Bind FromStartShown}" IsEnabled="{x:Bind Item.Playable}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Mark as watched" Click="OnMenuWatched" Tag="{x:Bind}" KeyboardAcceleratorTextOverride="Ctrl+Shift+M">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Hide from Continue" Click="OnMenuHide" Tag="{x:Bind}" KeyboardAcceleratorTextOverride="Delete">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="Drop" Click="OnMenuDrop" Tag="{x:Bind}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Open title" Click="OnMenuOpen" Tag="{x:Bind}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </Grid.ContextFlyout>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="36" Height="54" CornerRadius="6" Background="{x:Bind Cover.Placeholder}">
                <Image Source="{x:Bind Cover.Cover, Mode=OneWay}" Stretch="UniformToFill" />
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind Cover.Title}" Style="{StaticResource ShowTitleStyle}" />
                <TextBlock Text="{x:Bind Item.Action}" Style="{StaticResource HazeCaptionStyle}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <ScrollViewer Grid.Column="1" x:Name="Preview" VerticalScrollBarVisibility="Auto" Padding="0,0,0,24">
        <StackPanel x:Name="PreviewBody" Spacing="12" MaxWidth="720" HorizontalAlignment="Stretch">
          <Grid x:Name="Banner" CornerRadius="8" Background="{ThemeResource RaisedBrush}" MaxHeight="360"
                Tapped="OnBannerTapped" SizeChanged="OnBannerSizeChanged" AutomationProperties.Name="Open the title page">
            <Image x:Name="BannerImage" Stretch="UniformToFill" />
          </Grid>
          <TextBlock x:Name="PreviewTitle" Style="{StaticResource ShowTitleLargeStyle}" Margin="0,8,0,0" />
          <TextBlock x:Name="EpisodeLine" Style="{StaticResource BodyLargeTextBlockStyle}" />
          <StackPanel x:Name="Meter" Spacing="6">
            <ProgressBar x:Name="EpisodeProgress" Maximum="1" Width="320" HorizontalAlignment="Left" />
            <TextBlock x:Name="LeftLine" Style="{StaticResource HazeCaptionStyle}" />
          </StackPanel>
          <Button x:Name="PlayButton" Style="{StaticResource PrimaryActionStyle}" Click="OnPlay" Margin="0,4,0,0" />
          <TextBlock x:Name="WaitingLine" Style="{StaticResource HazeBodyStyle}" Visibility="Collapsed" />
          <TextBlock x:Name="Synopsis" Style="{StaticResource HazeBodyStyle}" TextWrapping="WrapWholeWords" MaxLines="8"
                     TextTrimming="WordEllipsis" Margin="0,8,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    </local:StateHost>
  </Grid>
</Page>
