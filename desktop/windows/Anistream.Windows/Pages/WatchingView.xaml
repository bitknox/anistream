<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Anistream.Windows.Pages.WatchingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anistream.Windows.Pages"
    xmlns:app="using:Anistream.Windows"
    xmlns:s="using:Anistream.App">
  <UserControl.Resources>
    <CollectionViewSource x:Name="Groups" IsSourceGrouped="True" />
    <DataTemplate x:Key="QueueRowTemplate" x:DataType="local:QueueRow">
            <Grid Height="64" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
              <Grid.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="{x:Bind MenuPlay}" Click="OnMenuPlay" Tag="{x:Bind}" IsEnabled="{x:Bind Playable}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="{x:Bind s:T.EpisodePlayFromBeginning}" Click="OnMenuFromStart" Tag="{x:Bind}"
                                  Visibility="{x:Bind FromStartShown}" IsEnabled="{x:Bind Playable}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="{x:Bind s:T.EpisodeMarkWatched}" Click="OnMenuWatched" Tag="{x:Bind}" KeyboardAcceleratorTextOverride="Ctrl+Shift+M">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="{x:Bind s:T.ContinueHide}" Click="OnMenuHide" Tag="{x:Bind}" KeyboardAcceleratorTextOverride="Delete">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="{x:Bind s:T.ContinueDrop}" Click="OnMenuDrop" Tag="{x:Bind}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="{x:Bind s:T.TitleOpen}" Click="OnMenuOpen" Tag="{x:Bind}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </Grid.ContextFlyout>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="36" Height="54" CornerRadius="6" Background="{x:Bind Cover.Placeholder}">
                <Image Source="{x:Bind Cover.Cover, Mode=OneWay}" Stretch="UniformToFill" />
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind Cover.Title}" Style="{StaticResource ShowTitleStyle}" />
                <TextBlock Text="{x:Bind Lead}" Style="{StaticResource HazeCaptionStyle}" />
                <ProgressBar Maximum="1" Value="{x:Bind Fraction}" Height="3" MinHeight="3" Margin="0,2,0,0"
                             Visibility="{x:Bind MeterShown}" IsHitTestVisible="False" />
              </StackPanel>
            </Grid>
          </DataTemplate>
    <DataTemplate x:Key="SuggestionRowTemplate" x:DataType="local:QueueRow">
            <Grid Height="64" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
              <Grid.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="{x:Bind s:T.TitleButtonPlay(1)}" Click="OnSuggestionPlay" Tag="{x:Bind}" Visibility="{x:Bind PlayShown}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="{x:Bind s:T.UpNextAddPlanning}" Click="OnSuggestionPlan" Tag="{x:Bind}" Visibility="{x:Bind PlanShown}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="{x:Bind s:T.TitleOpen}" Click="OnMenuOpen" Tag="{x:Bind}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="{x:Bind s:T.UpNextNotInterested}" Click="OnSuggestionDismiss" Tag="{x:Bind}" KeyboardAcceleratorTextOverride="Delete">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED1A;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </Grid.ContextFlyout>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="36" Height="54" CornerRadius="6" Background="{x:Bind Cover.Placeholder}">
                <Image Source="{x:Bind Cover.Cover, Mode=OneWay}" Stretch="UniformToFill" />
              </Grid>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind Cover.Title}" Style="{StaticResource ShowTitleStyle}" />
                <Grid ColumnSpacing="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind Lead}" Style="{StaticResource HazeCaptionStyle}" TextWrapping="NoWrap" TextTrimming="None" Margin="0,0,3,0" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Tail}" Style="{StaticResource HazeCaptionStyle}" />
                </Grid>
              </StackPanel>
            </Grid>
          </DataTemplate>
  </UserControl.Resources>
  <Grid RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="SyncLine" Style="{StaticResource HazeCaptionStyle}" Visibility="Collapsed" />

    <!-- The queue down the start edge, 360 wide; the selected row's preview beside it when the
         content is 780 wide or more. Narrower, the queue alone, a row opening its title. -->
    <local:StateHost x:Name="State" Grid.Row="1">
    <Grid x:Name="Body" ColumnSpacing="32" Visibility="Collapsed" SizeChanged="OnBodySizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="QueueColumn" Width="360" />
        <ColumnDefinition x:Name="PreviewColumn" Width="*" />
      </Grid.ColumnDefinitions>
      <ListView x:Name="Queue" SelectionMode="Single" ItemClick="OnQueueItemClick"
                SelectionChanged="OnSelectionChanged" DoubleTapped="OnQueueDoubleTapped"
                KeyDown="OnQueueKeyDown" Margin="-12,0,0,0" Padding="0,0,0,24"
                AutomationProperties.Name="{x:Bind s:T.ContinueHeading}">
        <ListView.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate x:DataType="local:QueueGroup">
                <TextBlock Text="{x:Bind Key}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="{x:Bind Gap}" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListView.GroupStyle>
        <ListView.ItemTemplateSelector>
          <local:QueueTemplates Queue="{StaticResource QueueRowTemplate}" Suggestion="{StaticResource SuggestionRowTemplate}" />
        </ListView.ItemTemplateSelector>
      </ListView>

      <ScrollViewer Grid.Column="1" x:Name="Preview" VerticalScrollBarVisibility="Auto" Padding="0,0,0,24">
        <StackPanel x:Name="PreviewBody" Spacing="12" MaxWidth="720" HorizontalAlignment="Stretch">
          <Grid x:Name="Banner" CornerRadius="8" Background="{ThemeResource RaisedBrush}" MaxHeight="360"
                Tapped="OnBannerTapped" SizeChanged="OnBannerSizeChanged" AutomationProperties.Name="{x:Bind s:T.TitleOpen}">
            <Image x:Name="BannerImage" Stretch="UniformToFill" />
          </Grid>
          <TextBlock x:Name="PreviewTitle" Style="{StaticResource ShowTitleLargeStyle}" Margin="0,8,0,0" />
          <TextBlock x:Name="EpisodeLine" Style="{StaticResource BodyLargeTextBlockStyle}" />
          <StackPanel x:Name="Meter" Spacing="6">
            <ProgressBar x:Name="EpisodeProgress" Maximum="1" Width="320" HorizontalAlignment="Left" />
            <TextBlock x:Name="LeftLine" Style="{StaticResource HazeCaptionStyle}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button x:Name="PlayButton" Style="{StaticResource PrimaryActionStyle}" Click="OnPlay" />
            <Button x:Name="OpenButton" MinHeight="40" Padding="16,0" Click="OnOpenPreview" Visibility="Collapsed" Content="{x:Bind s:T.TitleEpisodes}" />
          </StackPanel>
          <TextBlock x:Name="WaitingLine" Style="{StaticResource HazeBodyStyle}" Visibility="Collapsed" />
          <TextBlock x:Name="Synopsis" Style="{StaticResource HazeBodyStyle}" TextWrapping="WrapWholeWords" MaxLines="8"
                     TextTrimming="WordEllipsis" Margin="0,8,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    </local:StateHost>

  </Grid>
</UserControl>
