<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anistream.Windows.Pages.ProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anistream.Windows.Pages"
    xmlns:app="using:Anistream.App"
    Background="{ThemeResource GroundBrush}">
  <Grid Padding="36,20,36,0" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <TextBlock Text="{x:Bind app:T.SourcesTitle}" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <local:OfflineLine />
        <TextBlock Text="{x:Bind app:T.SourcesOrderDetail}" Style="{StaticResource HazeBodyStyle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="{x:Bind app:T.SourcesCheck}" Click="OnCheck" MinHeight="32" />
        <DropDownButton x:Name="AddButton" Content="{x:Bind app:T.SourcesAdd}" MinHeight="32" AutomationProperties.Name="{x:Bind app:T.SourcesAdd}">
          <DropDownButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuFlyoutItem Text="{x:Bind app:T.SourcesAddFolder}" Click="OnAddFolder">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="{x:Bind app:T.SourcesAddServer}" Click="OnAddServer">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE839;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="{x:Bind app:T.SourcesAddStore}" Click="OnAddStore">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
      </StackPanel>
    </Grid>
    <!-- No sources: the empty state in place of both columns. -->
    <Border x:Name="NoSources" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,80" />
    <!-- The list beside the selected source; below about 760 the detail goes under the list. -->
    <Grid x:Name="Columns" Grid.Row="1" ColumnSpacing="24" RowSpacing="16" SizeChanged="OnColumnsSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ListColumn" Width="420" />
        <ColumnDefinition x:Name="DetailColumn" Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="ListRow" Height="*" />
        <RowDefinition x:Name="DetailRow" Height="0" />
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Padding="0,0,8,24">
          <TextBlock x:Name="Rebuilding" Style="{StaticResource HazeCaptionStyle}" Text="{x:Bind app:T.SourcesRebuilding}" Visibility="Collapsed" />
          <StackPanel x:Name="Sections" Spacing="4" AutomationProperties.Name="{x:Bind app:T.SourcesOrder}" />
          <TextBlock x:Name="Note" Style="{StaticResource HazeBodyStyle}" Visibility="Collapsed" />
          <TextBlock Text="{x:Bind app:T.LegalHostsNoContent}" Style="{StaticResource HazeCaptionStyle}" Margin="0,8,0,0" />
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="DetailScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Detail" Spacing="8" Padding="0,0,12,24" MaxWidth="560" HorizontalAlignment="Stretch" />
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
