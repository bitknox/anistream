<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anistream.Windows.Pages.ProvidersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource GroundBrush}">
  <Grid Padding="36,20,36,0" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <TextBlock Text="Providers" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="Sources are tried top to bottom. Drag one to change the order." Style="{StaticResource HazeBodyStyle}" />
      </StackPanel>
      <Button Grid.Column="1" Content="Check sources" Click="OnCheck" Height="32" VerticalAlignment="Center" />
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Padding="0,0,8,24">
          <TextBlock x:Name="Rebuilding" Style="{StaticResource HazeCaptionStyle}" Text="Sources are being set up again" Visibility="Collapsed" />
          <ListView x:Name="Order" SelectionMode="Single" CanReorderItems="True" AllowDrop="True"
                    SelectionChanged="OnSelected" DragItemsCompleted="OnDragCompleted"
                    AutomationProperties.Name="Source order" Margin="-12,0,0,0" />
          <TextBlock x:Name="Note" Style="{StaticResource HazeBodyStyle}" Visibility="Collapsed" />
          <TextBlock Text="anistream hosts no content." Style="{StaticResource HazeCaptionStyle}" Margin="0,8,0,0" />
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Detail" Spacing="8" Padding="0,0,12,24" MaxWidth="560" HorizontalAlignment="Stretch" />
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
