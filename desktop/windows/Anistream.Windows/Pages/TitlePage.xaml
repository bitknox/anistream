<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anistream.Windows.Pages.TitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anistream.Windows.Pages"
    Background="{ThemeResource GroundBrush}">
  <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" SizeChanged="OnSizeChanged">
    <Grid>
      <!-- The banner across the content, up to 360 high, the ground over its lower part. -->
      <Grid x:Name="Banner" VerticalAlignment="Top" Height="300">
        <Image x:Name="BannerImage" Stretch="UniformToFill" VerticalAlignment="Center" />
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00161A2E" Offset="0.25" />
              <GradientStop Color="#D9161A2E" Offset="0.75" />
              <GradientStop Color="#FF161A2E" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
      <Grid x:Name="Columns" Padding="36,200,36,24" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="SideColumn" Width="260" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="Main" Spacing="20">
          <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="CoverFrame" Width="120" Height="180" CornerRadius="8" VerticalAlignment="Bottom">
              <Image x:Name="CoverImage" Stretch="UniformToFill" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
              <TextBlock x:Name="ShowTitle" Style="{StaticResource ShowTitleLargeStyle}" />
              <TextBlock x:Name="Secondary" Style="{StaticResource HazeBodyStyle}" />
              <TextBlock x:Name="Meta" Style="{StaticResource HazeBodyStyle}" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                <Button x:Name="PrimaryAction" Style="{StaticResource PrimaryActionStyle}" Click="OnPrimary" />
                <DropDownButton x:Name="StatusButton" Height="40" AutomationProperties.Name="List">
                  <DropDownButton.Flyout>
                    <MenuFlyout x:Name="StatusMenu" Placement="BottomEdgeAlignedLeft" />
                  </DropDownButton.Flyout>
                </DropDownButton>
                <Button Height="40" Width="40" Padding="0" ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                  <FontIcon Glyph="&#xE712;" />
                  <Button.Flyout>
                    <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedLeft">
                      <MenuFlyoutItem Text="Mark all previous watched" Click="OnMarkPrevious">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="TrailerItem" Text="Play trailer" Click="OnTrailer">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE714;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem Text="Open in AniList" Click="OnOpenAnilist">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
              <TextBlock x:Name="WaitingLine" Style="{StaticResource HazeBodyStyle}" Visibility="Collapsed" />
            </StackPanel>
          </Grid>

          <TextBlock x:Name="Synopsis" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="WrapWholeWords" MaxWidth="720" HorizontalAlignment="Left" />

          <StackPanel Spacing="4">
            <TextBlock Text="Episodes" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock x:Name="EpisodesNote" Style="{StaticResource HazeCaptionStyle}" Visibility="Collapsed" />
            <ListView x:Name="EpisodeList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEpisodeClick"
                      Margin="-12,4,0,0" AutomationProperties.Name="Episodes">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:EpisodeItem">
                  <Grid Height="72" Margin="0,4" ColumnSpacing="14" AutomationProperties.Name="{x:Bind Name}" Opacity="{x:Bind Dim}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="128" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="128" Height="72" CornerRadius="6" Background="{ThemeResource RaisedBrush}">
                      <Image Source="{x:Bind Still, Mode=OneWay}" Stretch="UniformToFill" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                      <TextBlock Text="{x:Bind Heading}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind Line}" Style="{StaticResource HazeCaptionStyle}" />
                      <ProgressBar Value="{x:Bind Watched}" Maximum="1" Width="160" HorizontalAlignment="Left" Visibility="{x:Bind PartWay}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Width="36" Height="32" Padding="0" IsChecked="{x:Bind Completed}"
                                  Click="OnWatchedToggle" Tag="{x:Bind}" ToolTipService.ToolTip="Watched"
                                  AutomationProperties.Name="Watched" VerticalAlignment="Center">
                      <FontIcon Glyph="&#xE73E;" FontSize="14" />
                    </ToggleButton>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
          <StackPanel x:Name="DetailsBelow" Spacing="16" />
        </StackPanel>
        <StackPanel x:Name="Side" Grid.Column="1" Spacing="16" Margin="0,190,0,0" />
      </Grid>
    </Grid>
  </ScrollViewer>
</Page>
