<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anistream.Windows.Pages.TitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anistream.Windows.Pages"
    xmlns:s="using:Anistream.App"
    Background="{ThemeResource GroundBrush}">
  <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" SizeChanged="OnSizeChanged">
    <local:StateHost x:Name="State">
    <Grid x:Name="Body">
      <!-- The banner across the content, up to 360 high, the ground over its lower part. On a title that
           may play a trailer it is 280 high from the first frame and the art fades away over the video. -->
      <Grid x:Name="Banner" VerticalAlignment="Top" Height="300">
        <Grid x:Name="Art">
          <Image x:Name="BannerImage" Stretch="UniformToFill" VerticalAlignment="Center" />
          <Rectangle x:Name="Scrim">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00161A2E" Offset="0.25" />
                <GradientStop Color="#D9161A2E" Offset="0.75" />
                <GradientStop Color="#FF161A2E" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
        </Grid>
      </Grid>
      <Grid x:Name="Columns" Padding="36,200,36,24" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="SideColumn" Width="260" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="Main" Spacing="20">
          <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="CoverFrame" Width="120" Height="180" CornerRadius="8" VerticalAlignment="Bottom">
              <Image x:Name="CoverImage" Stretch="UniformToFill" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
              <TextBlock x:Name="ShowTitle" Style="{StaticResource ShowTitleLargeStyle}" />
              <TextBlock x:Name="Secondary" Style="{StaticResource HazeBodyStyle}" />
              <TextBlock x:Name="Meta" Style="{StaticResource HazeCaptionStyle}" />
              <local:OfflineLine />
              <Grid ColumnSpacing="8" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PrimaryAction" Style="{StaticResource PrimaryActionStyle}" Click="OnPrimary" />
                <!-- Play on TV: the episode the primary action plays, on a TV with anistream. -->
                <Button x:Name="TvAction" Grid.Column="1" HorizontalAlignment="Left" Height="40" Width="40" Padding="0" Visibility="Collapsed" Click="OnPlayOnTv"
                        ToolTipService.ToolTip="{x:Bind s:T.TitlePlayOnTvTooltip}" AutomationProperties.Name="{x:Bind s:T.TvPlayOn}">
                  <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                </Button>
                <DropDownButton x:Name="StatusButton" Grid.Column="2" Height="40" AutomationProperties.Name="{x:Bind s:T.TitleListStatus}">
                  <DropDownButton.Flyout>
                    <MenuFlyout x:Name="StatusMenu" Placement="BottomEdgeAlignedLeft" />
                  </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="MoreButton" Grid.Column="3" Height="40" Width="40" Padding="0" ToolTipService.ToolTip="{x:Bind s:T.ActionMore}" AutomationProperties.Name="{x:Bind s:T.ActionMore}">
                  <FontIcon Glyph="&#xE712;" />
                  <Button.Flyout>
                    <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedLeft">
                      <MenuFlyoutItem Text="{x:Bind s:T.TitleShowSettingsMenu}" Click="OnShowSettings" KeyboardAcceleratorTextOverride="Ctrl+I">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="DownloadItem" Text="{x:Bind s:T.TitleDownloadMenu}" Click="OnDownloadRange">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="PartyItem" Text="{x:Bind s:T.PartyOpen}" Click="OnWatchParty">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE716;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="SourceItem" Click="OnPickSource">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutSeparator />
                      <MenuFlyoutItem Text="{x:Bind s:T.EpisodeMarkPreviousWatched}" Click="OnMarkPrevious">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="TrailerItem" Text="{x:Bind s:T.TitlePlayTrailer}" Click="OnTrailer">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE714;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem Text="{x:Bind s:T.TitleOpenAnilist}" Click="OnOpenAnilist">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <TextBlock x:Name="WaitingLine" Style="{StaticResource HazeBodyStyle}" Visibility="Collapsed" />
            </StackPanel>
          </Grid>

          <TextBlock x:Name="Synopsis" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="WrapWholeWords" MaxWidth="720" HorizontalAlignment="Left" />

          <StackPanel Spacing="4">
            <!-- The season picker and the dub line sit beside the heading, so their arriving moves nothing. -->
            <Grid ColumnSpacing="16" MinHeight="36">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind s:T.TitleEpisodes}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
              <ComboBox x:Name="SeasonPicker" Grid.Column="1" MinWidth="220" VerticalAlignment="Center" Visibility="Collapsed"
                        AutomationProperties.Name="{x:Bind s:T.FilterSeason}" SelectionChanged="OnSeasonPicked" />
              <!-- How far the dub goes. Faded in when the engine says. -->
              <TextBlock x:Name="DubLine" Style="{StaticResource HazeCaptionStyle}" Grid.Column="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         Margin="0,4,0,0" Opacity="0">
                <TextBlock.OpacityTransition>
                  <ScalarTransition Duration="0:0:0.2" />
                </TextBlock.OpacityTransition>
              </TextBlock>
            </Grid>
            <TextBlock x:Name="EpisodesNote" Style="{StaticResource HazeCaptionStyle}" Visibility="Collapsed" />
            <ListView x:Name="EpisodeList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEpisodeClick"
                      ContainerContentChanging="OnEpisodeContainer"
                      Margin="-12,4,0,0" AutomationProperties.Name="{x:Bind s:T.TitleEpisodes}">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:EpisodeItem">
                  <Grid Height="72" Margin="0,4" ColumnSpacing="14" AutomationProperties.Name="{x:Bind Name}" Opacity="{x:Bind Dim}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="128" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.ContextFlyout>
                      <MenuFlyout>
                        <MenuFlyoutItem Text="{x:Bind s:T.ActionPlay}" Click="OnEpisodePlay" Tag="{x:Bind}" IsEnabled="{x:Bind Playable}" />
                        <MenuFlyoutItem Text="{x:Bind s:T.EpisodePlayFromBeginning}" Click="OnEpisodeFromStart" Tag="{x:Bind}" Visibility="{x:Bind PartWay}" />
                        <MenuFlyoutItem Text="{x:Bind s:T.TvPlayOn}" Click="OnEpisodeOnTv" Tag="{x:Bind}" Visibility="{x:Bind OnTv}" IsEnabled="{x:Bind Playable}" />
                        <MenuFlyoutItem Text="{x:Bind WatchedAction}" Click="OnEpisodeWatched" Tag="{x:Bind}" />
                        <MenuFlyoutItem Text="{x:Bind s:T.TitleEpisodeDownload}" Click="OnEpisodeDownload" Tag="{x:Bind}" IsEnabled="{x:Bind CanDownload, Mode=OneWay}" />
                      </MenuFlyout>
                    </Grid.ContextFlyout>
                    <Grid Width="128" Height="72" CornerRadius="6" Background="{ThemeResource RaisedBrush}">
                      <Image Source="{x:Bind Still, Mode=OneWay}" Stretch="UniformToFill" />
                      <!-- A still past the next episode, blurred: the spoiler pattern. -->
                      <Border Visibility="{x:Bind SpoilerShown}" Background="{ThemeResource SpoilerBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                      <TextBlock Text="{x:Bind Heading}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{x:Bind Line}" Style="{StaticResource HazeCaptionStyle}" />
                      <ProgressBar Value="{x:Bind Watched}" Maximum="1" Width="160" HorizontalAlignment="Left" Visibility="{x:Bind PartWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- The episode's download: Download on hover or focus, then how far, then a check.
                         The cell keeps its width in every state, so the row never moves. -->
                    <Button Width="36" Height="36" Padding="0" Style="{StaticResource SubtleButtonStyle}"
                            Opacity="{x:Bind DownloadOpacity, Mode=OneWay}" IsEnabled="{x:Bind Playable}"
                            Click="OnDownloadCell" Tag="{x:Bind}" GotFocus="OnDownloadCellFocus"
                            ToolTipService.ToolTip="{x:Bind DownloadSay, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind DownloadSay, Mode=OneWay}">
                      <Grid>
                        <FontIcon Glyph="{x:Bind DownloadGlyph, Mode=OneWay}" FontSize="16"
                                  Foreground="{x:Bind DownloadTint, Mode=OneWay}" Visibility="{x:Bind GlyphShown, Mode=OneWay}" />
                        <ProgressRing Width="20" Height="20" Visibility="{x:Bind RingShown, Mode=OneWay}"
                                      IsIndeterminate="{x:Bind RingWaiting, Mode=OneWay}" IsActive="{x:Bind RingActive, Mode=OneWay}"
                                      Value="{x:Bind RingValue, Mode=OneWay}" Maximum="100" />
                      </Grid>
                    </Button>
                    <!-- Watched is a state: a neutral check box, not an amber toggle. -->
                    <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind Completed}"
                              Click="OnWatchedToggle" Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind s:T.EpisodeWatched}"
                              AutomationProperties.Name="{x:Bind s:T.EpisodeWatched}" VerticalAlignment="Center">
                      <!-- On the control itself: the app's theme overrides do not reach a template's check box. -->
                      <CheckBox.Resources>
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#E4E0D6" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#E4E0D6" Opacity="0.9" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#9298B5" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#E4E0D6" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#E4E0D6" />
                        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#9298B5" />
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#161A2E" />
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#161A2E" />
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#161A2E" />
                      </CheckBox.Resources>
                    </CheckBox>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
          <StackPanel x:Name="DetailsBelow" Spacing="16" />
        </StackPanel>
        <StackPanel x:Name="Side" Grid.Column="1" Spacing="16" Margin="0,190,0,0" />
      </Grid>
      <!-- Sound for the playing trailer: off at every start, 8 below the video's trailing corner,
           outside the player, only while one shows. -->
      <Button x:Name="SoundButton" Style="{StaticResource SubtleButtonStyle}" Width="40" Height="40" Padding="0" CornerRadius="4"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,272,36,0" Visibility="Collapsed"
              ToolTipService.ToolTip="{x:Bind s:T.TitleTrailerSound}" AutomationProperties.Name="{x:Bind s:T.TitleTrailerSound}">
        <FontIcon Glyph="&#xE74F;" FontSize="16" />
      </Button>
    </Grid>
    </local:StateHost>
  </ScrollViewer>
</Page>
