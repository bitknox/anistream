<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anistream.Windows.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Anistream.Windows"
    xmlns:local="using:Anistream.Windows.Pages"
    xmlns:s="using:Anistream.App"
    Background="{ThemeResource GroundBrush}">
  <Grid Padding="36,20,36,0" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{x:Bind s:T.NavLibrary}" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
      <local:OfflineLine />
    </StackPanel>
    <Grid x:Name="Bar" Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <SelectorBar x:Name="Lists" SelectionChanged="OnListChanged" Margin="-8,0,0,0" />
      <DropDownButton x:Name="OrderButton" Grid.Column="1" Content="{x:Bind s:T.LibrarySortUpdated}" Height="32">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <RadioMenuFlyoutItem Text="{x:Bind s:T.LibrarySortUpdated}" GroupName="order" Tag="updated" IsChecked="True" Click="OnOrder" />
            <RadioMenuFlyoutItem Text="{x:Bind s:T.LibrarySortTitle}" GroupName="order" Tag="title" Click="OnOrder" />
            <RadioMenuFlyoutItem Text="{x:Bind s:T.LibrarySortScore}" GroupName="order" Tag="score" Click="OnOrder" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </Grid>
    <ScrollViewer x:Name="Scroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <local:StateHost x:Name="State" Padding="0,4,0,24">
        <app:CoverGrid x:Name="Grid" />
      </local:StateHost>
    </ScrollViewer>
    <!-- Signed out: Nagare, a line and one action. -->
    <Border x:Name="SignedOut" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Margin="0,0,0,80" />
  </Grid>
</Page>
