<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anistream.Windows.Pages.StoresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anistream.Windows.Pages"
    xmlns:app="using:Anistream.App"
    Background="{ThemeResource GroundBrush}">
  <Grid Padding="36,20,36,0" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <TextBlock Text="{x:Bind app:T.NavPluginStores}" Style="{StaticResource PageTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
        <local:OfflineLine />
        <TextBlock Text="{x:Bind app:T.StoresIntro}" Style="{StaticResource HazeBodyStyle}" />
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind app:T.StoresJoinShort}" Click="OnJoin" MinHeight="32" VerticalAlignment="Center" />
    </Grid>
    <!-- The stores beside the selected one; below about 760 the detail goes under the list. -->
    <Grid Grid.Row="1" ColumnSpacing="24" RowSpacing="16" SizeChanged="OnColumnsSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ListColumn" Width="320" />
        <ColumnDefinition x:Name="DetailColumn" Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="ListRow" Height="*" />
        <RowDefinition x:Name="DetailRow" Height="0" />
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Padding="0,0,8,24">
          <ListView x:Name="StoreList" SelectionMode="Single" SelectionChanged="OnSelected" Margin="-12,0,0,0"
                    AutomationProperties.Name="{x:Bind app:T.NavPluginStores}" />
          <StackPanel x:Name="Empty" Spacing="4" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="{x:Bind app:T.StoresEmptyTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="{x:Bind app:T.StoresEmptyDetail}" Style="{StaticResource HazeBodyStyle}" />
          </StackPanel>
          <TextBlock Text="{x:Bind app:T.LegalHostsNoContent}" Style="{StaticResource HazeCaptionStyle}" Margin="0,8,0,0" />
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="DetailScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Detail" Spacing="8" Padding="0,0,12,24" MaxWidth="620" HorizontalAlignment="Stretch" />
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>
