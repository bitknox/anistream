<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Show titles are Zen Kaku Gothic New 700; everything else is the Fluent type ramp. -->
  <FontFamily x:Key="ShowFont">ms-appx:///Assets/Fonts/ZenKakuGothicNew-Bold.ttf#Zen Kaku Gothic New</FontFamily>

  <!-- 28/36: the title page and the Continue preview. -->
  <Style x:Key="ShowTitleLargeStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ShowFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
  </Style>

  <!-- 15/20: rows and under covers. -->
  <Style x:Key="ShowTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ShowFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style x:Key="HazeCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="HazeBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- Page titles, 28/36 semibold, as Fluent's Title. -->
  <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
    <Setter Property="Margin" Value="0,0,0,0" />
  </Style>

  <!-- A section on a page: Subtitle 20/28. -->
  <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}" />

  <!-- The title page's primary action and the Continue preview's: 40 high, amber. -->
  <Style x:Key="PrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Player bar buttons: icon only, 40 square, silk on the dim. -->
  <Style x:Key="PlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
  </Style>

  <!-- Setting rows, after the Toolkit's SettingsCard: 68 high with a description, 48 without. -->
  <Style x:Key="SettingCardStyle" TargetType="Grid">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="16,8,16,8" />
    <Setter Property="ColumnSpacing" Value="16" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</ResourceDictionary>
