<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Anistream.Windows.Player.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark" IsTabStop="True" TabFocusNavigation="Cycle">
  <UserControl.Resources>
    <!-- The skip glyphs: Segoe Fluent's open circle arrow, mirrored for back, with the seconds
         inside it. Fluent has a back-10 glyph but its forward twin says 30. -->
    <Style x:Key="SkipDigitsStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
  </UserControl.Resources>
  <UserControl.KeyboardAccelerators>
    <KeyboardAccelerator Key="Space" Invoked="OnKeyPause" />
    <KeyboardAccelerator Key="K" Invoked="OnKeyPause" />
    <KeyboardAccelerator Key="J" Invoked="OnKeyBack10" />
    <KeyboardAccelerator Key="L" Invoked="OnKeyForward10" />
    <KeyboardAccelerator Key="Left" Invoked="OnKeyBack5" />
    <KeyboardAccelerator Key="Right" Invoked="OnKeyForward5" />
    <KeyboardAccelerator Key="Left" Modifiers="Shift" Invoked="OnKeyBack30" />
    <KeyboardAccelerator Key="Right" Modifiers="Shift" Invoked="OnKeyForward30" />
    <KeyboardAccelerator Key="Up" Invoked="OnKeyVolumeUp" />
    <KeyboardAccelerator Key="Down" Invoked="OnKeyVolumeDown" />
    <KeyboardAccelerator Key="F" Invoked="OnKeyFullscreen" />
    <KeyboardAccelerator Key="F11" Invoked="OnKeyFullscreen" />
    <KeyboardAccelerator Key="Escape" Invoked="OnKeyEscape" />
    <KeyboardAccelerator Key="Enter" Invoked="OnKeyEnter" />
    <KeyboardAccelerator Key="S" Invoked="OnKeySkip" />
    <KeyboardAccelerator Key="N" Invoked="OnKeyNext" />
    <KeyboardAccelerator Key="N" Modifiers="Shift" Invoked="OnKeyPrevious" />
    <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnKeyClose" />
  </UserControl.KeyboardAccelerators>
  <Grid x:Name="Root" Background="Black" PointerMoved="OnPointerMoved" Tapped="OnVideoTapped"
        DoubleTapped="OnVideoDoubleTapped" PointerWheelChanged="OnWheel">
    <!-- The video is the bottom layer; the bars are XAML inside the SwapChainPanel, which
         composition draws under with no airspace. -->
    <SwapChainPanel x:Name="VideoPanel" SizeChanged="OnPanelSizeChanged">

      <!-- The starting screen: the banner full frame, the episode and a 32 px ring. -->
      <Grid x:Name="Starting" Background="{ThemeResource GroundBrush}" Visibility="Collapsed">
        <Image x:Name="StartingArt" Stretch="UniformToFill" Opacity="0.45" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
          <TextBlock x:Name="StartingShow" Style="{StaticResource ShowTitleLargeStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBlock x:Name="StartingLine" Style="{StaticResource BodyLargeTextBlockStyle}" HorizontalAlignment="Center" />
          <ProgressRing IsActive="True" Width="32" Height="32" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- The controls on a 35% dim of the ground, collapsed when they fade so nothing sits
           over the video. -->
      <Grid x:Name="Chrome" Background="{ThemeResource DimBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: back, the show and the episode, then subtitles, episodes, fullscreen. -->
        <Grid x:Name="TopBar" Padding="8,8,148,8" ColumnSpacing="8" PointerEntered="OnBarEntered" PointerExited="OnBarExited">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource PlayerButtonStyle}" Click="OnClose" ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
            <FontIcon Glyph="&#xE72B;" FontSize="16" />
          </Button>
          <StackPanel x:Name="TitleArea" Grid.Column="1" VerticalAlignment="Center" Spacing="0" Background="Transparent">
            <TextBlock x:Name="ShowTitle" Style="{StaticResource ShowTitleStyle}" FontSize="18" LineHeight="24" />
            <TextBlock x:Name="EpisodeTitle" Style="{StaticResource HazeCaptionStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.8" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
            <Button x:Name="TracksButton" Style="{StaticResource PlayerButtonStyle}" ToolTipService.ToolTip="Subtitles and audio (T)" AutomationProperties.Name="Subtitles and audio">
              <FontIcon Glyph="&#xE7F0;" FontSize="16" />
              <Button.Flyout>
                <MenuFlyout x:Name="TracksMenu" Placement="BottomEdgeAlignedRight" Opened="OnMenuOpened" Closed="OnMenuClosed" />
              </Button.Flyout>
            </Button>
            <Button x:Name="EpisodesButton" Style="{StaticResource PlayerButtonStyle}" ToolTipService.ToolTip="Episodes (E)" AutomationProperties.Name="Episodes">
              <FontIcon Glyph="&#xE8FD;" FontSize="16" />
              <Button.Flyout>
                <MenuFlyout x:Name="EpisodesMenu" Placement="BottomEdgeAlignedRight" Opened="OnMenuOpened" Closed="OnMenuClosed" />
              </Button.Flyout>
            </Button>
            <Button Style="{StaticResource PlayerButtonStyle}" Click="OnFullscreen" ToolTipService.ToolTip="Fullscreen (F)" AutomationProperties.Name="Fullscreen">
              <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="16" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- Bottom bar: play, back and forward 10 s, the timeline and the times, volume and settings. -->
        <Grid x:Name="BottomBar" Grid.Row="2" Padding="12,0,12,12" ColumnSpacing="6" PointerEntered="OnBarEntered" PointerExited="OnBarExited">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="PlayPause" Style="{StaticResource PlayerButtonStyle}" Click="OnPlayPause" ToolTipService.ToolTip="Play or pause (Space)" AutomationProperties.Name="Pause">
            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="18" />
          </Button>
          <Button Grid.Column="1" Style="{StaticResource PlayerButtonStyle}" Click="OnBack10" ToolTipService.ToolTip="Back 10 s (J)" AutomationProperties.Name="Back 10 seconds">
            <Grid>
              <FontIcon Glyph="&#xE72C;" FontSize="22" RenderTransformOrigin="0.5,0.5">
                <FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform>
              </FontIcon>
              <TextBlock Text="10" Style="{StaticResource SkipDigitsStyle}" />
            </Grid>
          </Button>
          <Button Grid.Column="2" Style="{StaticResource PlayerButtonStyle}" Click="OnForward10" ToolTipService.ToolTip="Forward 10 s (L)" AutomationProperties.Name="Forward 10 seconds">
            <Grid>
              <FontIcon Glyph="&#xE72C;" FontSize="22" />
              <TextBlock Text="10" Style="{StaticResource SkipDigitsStyle}" />
            </Grid>
          </Button>
          <TextBlock x:Name="Elapsed" Grid.Column="3" Text="0:00" VerticalAlignment="Center" Margin="6,0,4,0" Style="{StaticResource CaptionTextBlockStyle}" />
          <Slider x:Name="Timeline" Grid.Column="4" VerticalAlignment="Center" Minimum="0" Maximum="1" StepFrequency="1"
                  IsThumbToolTipEnabled="False" ValueChanged="OnTimelineChanged" AutomationProperties.Name="Timeline" />
          <TextBlock x:Name="Remaining" Grid.Column="5" Text="-0:00" VerticalAlignment="Center" Margin="4,0,6,0" Style="{StaticResource CaptionTextBlockStyle}" />
          <Button x:Name="VolumeButton" Grid.Column="6" Style="{StaticResource PlayerButtonStyle}" ToolTipService.ToolTip="Volume" AutomationProperties.Name="Volume">
            <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16" />
            <Button.Flyout>
              <Flyout Placement="Top" Opened="OnMenuOpened" Closed="OnMenuClosed">
                <Slider x:Name="VolumeSlider" Width="160" Minimum="0" Maximum="100" StepFrequency="5" Value="100"
                        ValueChanged="OnVolumeChanged" AutomationProperties.Name="Volume" />
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="7" Style="{StaticResource PlayerButtonStyle}" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Playback settings">
            <FontIcon Glyph="&#xE713;" FontSize="16" />
            <Button.Flyout>
              <MenuFlyout x:Name="SettingsMenu" Placement="TopEdgeAlignedRight" Opened="OnMenuOpened" Closed="OnMenuClosed" />
            </Button.Flyout>
          </Button>
        </Grid>
      </Grid>

      <!-- Corner cards at the bottom end: skip, Up Next, the stall prompt. -->
      <StackPanel x:Name="Corner" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,80" Spacing="8">
        <Button x:Name="SkipCard" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="OnSkip" MinHeight="40" Padding="16,0" />
        <Grid x:Name="UpNextCard" Visibility="Collapsed" Background="{ThemeResource RaisedBrush}" CornerRadius="8" Padding="16" Width="300" RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Up next" Style="{StaticResource HazeCaptionStyle}" />
          <TextBlock x:Name="UpNextTitle" Grid.Row="1" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
          <ProgressBar x:Name="UpNextBar" Grid.Row="2" Maximum="1" />
          <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UpNextLine" Style="{StaticResource HazeCaptionStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Cancel" Click="OnCancelNext" />
            <Button Grid.Column="2" Content="Play now" Style="{StaticResource AccentButtonStyle}" Click="OnPlayNext" />
          </Grid>
        </Grid>
        <Grid x:Name="StallCard" Visibility="Collapsed" Background="{ThemeResource RaisedBrush}" CornerRadius="8" Padding="16" Width="300" RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="StallLine" TextWrapping="WrapWholeWords" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Keep waiting" Click="OnStallWait" />
            <Button Content="Try another source" Style="{StaticResource AccentButtonStyle}" Click="OnStallSwitch" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- What the player says on the video: an alert, briefly. -->
      <Border x:Name="AlertCard" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0"
              Background="{ThemeResource RaisedBrush}" CornerRadius="8" Padding="16,10">
        <TextBlock x:Name="AlertText" TextWrapping="WrapWholeWords" MaxWidth="480" />
      </Border>
    </SwapChainPanel>
  </Grid>
</UserControl>
