<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Anistream.Windows.CoverGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anistream.Windows">
  <!-- A poster grid: covers 150 wide at 2:3, as many columns as fit with 16 between, the title in
       Zen Kaku 15 and one caption line in haze under each. -->
  <ItemsView x:Name="Items" SelectionMode="None" IsItemInvokedEnabled="True" ItemInvoked="OnInvoked"
             TabFocusNavigation="Once">
    <ItemsView.Layout>
      <UniformGridLayout MinItemWidth="150" MinColumnSpacing="16" MinRowSpacing="20" ItemsJustification="Start" />
    </ItemsView.Layout>
    <ItemsView.ItemTemplate>
      <DataTemplate x:DataType="local:CoverItem">
        <ItemContainer AutomationProperties.Name="{x:Bind Title}" CornerRadius="8">
          <ItemContainer.ContextFlyout>
            <MenuFlyout>
              <MenuFlyoutItem Text="Open title" Click="OnOpen" Tag="{x:Bind}">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Add to Planning" Click="OnPlan" Tag="{x:Bind}">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
            </MenuFlyout>
          </ItemContainer.ContextFlyout>
          <StackPanel Width="150" Spacing="2" Padding="0,0,0,6">
            <Grid Width="150" Height="225" CornerRadius="8" Background="{x:Bind Placeholder}" Margin="0,0,0,6">
              <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
            </Grid>
            <TextBlock Text="{x:Bind Title}" Style="{StaticResource ShowTitleStyle}" MaxLines="2" TextWrapping="WrapWholeWords" />
            <TextBlock Text="{x:Bind Caption}" Style="{StaticResource HazeCaptionStyle}" />
          </StackPanel>
        </ItemContainer>
      </DataTemplate>
    </ItemsView.ItemTemplate>
  </ItemsView>
</UserControl>
