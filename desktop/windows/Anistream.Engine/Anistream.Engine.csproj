<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine as the Windows app holds it: the C# bindings uniffi-bindgen-cs generates from the
       engine's library, compiled as they are, with the library beside them. The flavour is
       Directory.Build.props': release unless a build names testing, for the fixture scenes. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Anistream.Engine</RootNamespace>
  </PropertyGroup>
  <Import Project="../Engine.props" />
</Project>
