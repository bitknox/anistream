tui-log-bug-report-link = Segnalazione di errore: { $url }
toast-keybinding-not-applied = Scorciatoia non applicata: { $problem }. Controlla la sezione dei tasti nel file di configurazione.
tui-config-problem = { $file }: { $what }. Uso i valori predefiniti finché non viene corretto.
tui-config-problem-at-line = { $file }, riga { $line }: { $what }. Uso i valori predefiniti finché non viene corretto.
tui-config-problem-logged = { $path }: { $problem }. Uso i valori predefiniti.
chrome-status-state = { $source } · { $audio } · { $quality }p
