# The product name. It is never translated.
-app-name = anistream

# A site or feed anistream reads episodes from. Never "provider".
-source = fonte
-source-cap = Fonte
-source-pl = fonti
-source-cap-pl = Fonti

# A WebAssembly add-on that supplies a source.
-plugin = plugin
-plugin-cap = Plugin
-plugin-pl = plugin
-plugin-cap-pl = Plugin

# The invite-based list plugins are installed from.
-plugin-store = negozio di plugin
-plugin-store-cap = Negozio di plugin
-plugin-store-pl = negozi di plugin
-plugin-store-cap-pl = Negozi di plugin

# A plugin store on second mention, once the sentence has already said "plugin store". Short forms for tight places such as the terminal. Never the first mention.
-store = negozio
-store-cap = Negozio

# Shows you have saved, with status.
-library = libreria
-library-cap = Libreria

# AniList, Kitsu and similar accounts anistream updates.
-tracker = tracker
-tracker-cap = Tracker
-tracker-pl = tracker
-tracker-cap-pl = Tracker

# Watching in sync with other people. Never "watch together".
-watch-party = watch party
-watch-party-cap = Watch party
-watch-party-pl = watch party
-watch-party-cap-pl = Watch party

# Where releases are looked up.
-torrent-index = indice torrent
-torrent-index-cap = Indice torrent

# One downloadable file in a torrent index. Not a place episodes come from.
-release = versione
-release-cap = Versione
-release-pl = versioni
-release-cap-pl = Versioni

# One release that holds many episodes.
-batch = raccolta
-batch-cap = Raccolta

# A phone, tablet, TV or computer running anistream.
-device = dispositivo
-device-cap = Dispositivo
-device-pl = dispositivi
-device-cap-pl = Dispositivi

# The button that resumes the show.
-continue = continua a guardare
-continue-cap = Continua a guardare

# The episode that plays after this one.
-up-next = prossimo
-up-next-cap = Prossimo

# The audio setting's two values.
-subbed = sottotitolato
-subbed-cap = Sottotitolato
-dubbed = doppiato
-dubbed-cap = Doppiato
