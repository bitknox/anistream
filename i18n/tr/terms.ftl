# The product name. It is never translated.
-app-name = anistream

# A site or feed anistream reads episodes from. Never "provider".
-source = kaynak
-source-cap = Kaynak
-source-pl = kaynaklar
-source-cap-pl = Kaynaklar

# A WebAssembly add-on that supplies a source.
-plugin = eklenti
-plugin-cap = Eklenti
-plugin-pl = eklentiler
-plugin-cap-pl = Eklentiler

# The invite-based list plugins are installed from.
-plugin-store = eklenti mağazası
-plugin-store-cap = Eklenti mağazası
-plugin-store-pl = eklenti mağazaları
-plugin-store-cap-pl = Eklenti mağazaları

# A plugin store on second mention, once the sentence has already said "plugin store". Short forms for tight places such as the terminal. Never the first mention.
-store = mağaza
-store-cap = Mağaza

# Shows you have saved, with status.
-library = kitaplık
-library-cap = Kitaplık

# AniList, Kitsu and similar accounts anistream updates.
-tracker = takip hizmeti
-tracker-cap = Takip hizmeti
-tracker-pl = takip hizmetleri
-tracker-cap-pl = Takip hizmetleri

# Watching in sync with other people. Never "watch together".
-watch-party = birlikte izleme
-watch-party-cap = Birlikte izleme
-watch-party-pl = birlikte izlemeler
-watch-party-cap-pl = Birlikte izlemeler

# Where releases are looked up.
-torrent-index = torrent dizini
-torrent-index-cap = Torrent dizini

# One downloadable file in a torrent index. Not a place episodes come from.
-release = sürüm
-release-cap = Sürüm
-release-pl = sürümler
-release-cap-pl = Sürümler

# One release that holds many episodes.
-batch = toplu sürüm
-batch-cap = Toplu sürüm

# A phone, tablet, TV or computer running anistream.
-device = cihaz
-device-cap = Cihaz
-device-pl = cihazlar
-device-cap-pl = Cihazlar

# The button that resumes the show.
-continue = izlemeye devam et
-continue-cap = İzlemeye devam et

# The episode that plays after this one.
-up-next = sıradaki
-up-next-cap = Sıradaki

# The audio setting's two values.
-subbed = altyazılı
-subbed-cap = Altyazılı
-dubbed = dublajlı
-dubbed-cap = Dublajlı
