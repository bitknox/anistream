stores-open-off-detail = Chỉ những người bạn mời mới tham gia được. Khi bật, bất kỳ ai có liên kết đều tham gia, không cần tên.
stores-open-no-names = Không lưu tên nào.
stores-open-keep-working = Chúng vẫn hoạt động cho đến khi bạn gỡ bỏ.
stores-device-seen = Đã thấy { $when }
stores-device-never-seen = Chưa thấy từ khi tham gia
stores-publish-short = Đăng { -plugin-cap }
stores-publish-none-hint = Một { -plugin } bạn xây dựng hoặc cài đặt sẽ hiện ở đây.
stores-not-published = Chưa có trong { -plugin-store }
stores-store-offers = { -plugin-store-cap } có phiên bản { $version }.
stores-published-current = Đã cập nhật trong { -plugin-store }
stores-published-state = Đã đăng
stores-publish-label = Đăng { $name } { $version }
