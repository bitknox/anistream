stores-device-count = { $count ->
   *[other] { $count } { -device }
 }
stores-dialog-title = { $title }, { $store }
stores-owner-unreachable = Không liên lạc được với { -plugin-store }
stores-owner-no-answer = { -plugin-store-cap } không phản hồi
stores-owner-no-answer-detail = Có thể nó đang bận, hoặc máy tính của nó đang tắt.
stores-owner-needs-connection = { -plugin-store-cap } cần kết nối
stores-owner-needs-connection-detail = Thử lại khi { -device } này trở lại trực tuyến.
stores-owner-link-offline = Tạo liên kết cần kết nối đến { -plugin-store }.
stores-send-link-until = Gửi liên kết này. Liên kết chỉ dùng được một lần, đến { $until }.
