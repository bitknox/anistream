# The product name. It is never translated.
-app-name = anistream

# A site or feed anistream reads episodes from. Never "provider".
-source = nguồn
-source-cap = Nguồn
-source-pl = các nguồn
-source-cap-pl = Các nguồn

# A WebAssembly add-on that supplies a source.
-plugin = plugin
-plugin-cap = Plugin
-plugin-pl = các plugin
-plugin-cap-pl = Các plugin

# The invite-based list plugins are installed from.
-plugin-store = cửa hàng plugin
-plugin-store-cap = Cửa hàng plugin
-plugin-store-pl = các cửa hàng plugin
-plugin-store-cap-pl = Các cửa hàng plugin

# A plugin store on second mention, once the sentence has already said "plugin store". Short forms for tight places such as the terminal. Never the first mention.
-store = cửa hàng
-store-cap = Cửa hàng

# Shows you have saved, with status.
-library = thư viện
-library-cap = Thư viện

# AniList, Kitsu and similar accounts anistream updates.
-tracker = dịch vụ theo dõi
-tracker-cap = Dịch vụ theo dõi
-tracker-pl = các dịch vụ theo dõi
-tracker-cap-pl = Các dịch vụ theo dõi

# Watching in sync with other people. Never "watch together".
-watch-party = xem chung
-watch-party-cap = Xem chung
-watch-party-pl = các buổi xem chung
-watch-party-cap-pl = Các buổi xem chung

# Where releases are looked up.
-torrent-index = chỉ mục torrent
-torrent-index-cap = Chỉ mục torrent

# One downloadable file in a torrent index. Not a place episodes come from.
-release = bản phát hành
-release-cap = Bản phát hành
-release-pl = các bản phát hành
-release-cap-pl = Các bản phát hành

# One release that holds many episodes.
-batch = bản gộp
-batch-cap = Bản gộp

# A phone, tablet, TV or computer running anistream.
-device = thiết bị
-device-cap = Thiết bị
-device-pl = các thiết bị
-device-cap-pl = Các thiết bị

# The button that resumes the show.
-continue = xem tiếp
-continue-cap = Xem tiếp

# The episode that plays after this one.
-up-next = tiếp theo
-up-next-cap = Tiếp theo

# The audio setting's two values.
-subbed = có phụ đề
-subbed-cap = Có phụ đề
-dubbed = lồng tiếng
-dubbed-cap = Lồng tiếng
