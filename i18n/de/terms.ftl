# The product name. It is never translated.
-app-name = anistream

# A site or feed anistream reads episodes from. Never "provider".
-source = Quelle
-source-cap = Quelle
-source-pl = Quellen
-source-cap-pl = Quellen

# A WebAssembly add-on that supplies a source.
-plugin = Plugin
-plugin-cap = Plugin
-plugin-pl = Plugins
-plugin-cap-pl = Plugins

# The invite-based list plugins are installed from.
-plugin-store = Plugin-Store
-plugin-store-cap = Plugin-Store
-plugin-store-pl = Plugin-Stores
-plugin-store-cap-pl = Plugin-Stores

# A plugin store on second mention, once the sentence has already said "plugin store". Short forms for tight places such as the terminal. Never the first mention.
-store = Store
-store-cap = Store

# Shows you have saved, with status.
-library = Mediathek
-library-cap = Mediathek

# AniList, Kitsu and similar accounts anistream updates.
-tracker = Tracker
-tracker-cap = Tracker
-tracker-pl = Tracker
-tracker-cap-pl = Tracker

# Watching in sync with other people. Never "watch together".
-watch-party = Watchparty
-watch-party-cap = Watchparty
-watch-party-pl = Watchpartys
-watch-party-cap-pl = Watchpartys

# Where releases are looked up.
-torrent-index = Torrent-Index
-torrent-index-cap = Torrent-Index

# One downloadable file in a torrent index. Not a place episodes come from.
-release = Release
-release-cap = Release
-release-pl = Releases
-release-cap-pl = Releases

# One release that holds many episodes.
-batch = Sammelpaket
-batch-cap = Sammelpaket

# A phone, tablet, TV or computer running anistream.
-device = Gerät
-device-cap = Gerät
-device-pl = Geräte
-device-cap-pl = Geräte

# The button that resumes the show.
-continue = Weiterschauen
-continue-cap = Weiterschauen

# The episode that plays after this one.
-up-next = als Nächstes
-up-next-cap = Als Nächstes

# The audio setting's two values.
-subbed = untertitelt
-subbed-cap = Untertitelt
-dubbed = synchronisiert
-dubbed-cap = Synchronisiert
