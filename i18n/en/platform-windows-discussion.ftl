## Windows: the discussion pane's own words, beside the shared ones in ui-discussion.ftl.

# Line above the field while the viewer edits their own comment.
# @only windows
# @max 40
discussion-editing = Editing your comment

# Accessible name of the button that opens a comment's menu.
# @only windows
# @max 40
discussion-comment-menu = More for this comment

# Accessible name of the discussion pane.
# @only windows
# @arg episode: int
# @max 40
discussion-pane-label = Episode { $episode } discussion

# After the author's name on a reply to a reply, naming who it answers.
# @only windows
# @arg name: text
# @max 32
discussion-answering = to { $name }
