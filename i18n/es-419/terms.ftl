# The product name. It is never translated.
-app-name = anistream

# A site or feed anistream reads episodes from. Never "provider".
-source = fuente
-source-cap = Fuente
-source-pl = fuentes
-source-cap-pl = Fuentes

# A WebAssembly add-on that supplies a source.
-plugin = complemento
-plugin-cap = Complemento
-plugin-pl = complementos
-plugin-cap-pl = Complementos

# The invite-based list plugins are installed from.
-plugin-store = tienda de complementos
-plugin-store-cap = Tienda de complementos
-plugin-store-pl = tiendas de complementos
-plugin-store-cap-pl = Tiendas de complementos

# A plugin store on second mention, once the sentence has already said "plugin store". Short forms for tight places such as the terminal. Never the first mention.
-store = tienda
-store-cap = Tienda

# Shows you have saved, with status.
-library = biblioteca
-library-cap = Biblioteca

# AniList, Kitsu and similar accounts anistream updates.
-tracker = servicio de seguimiento
-tracker-cap = Servicio de seguimiento
-tracker-pl = servicios de seguimiento
-tracker-cap-pl = Servicios de seguimiento

# Watching in sync with other people. Never "watch together".
-watch-party = watch party
-watch-party-cap = Watch party
-watch-party-pl = watch parties
-watch-party-cap-pl = Watch parties

# Where releases are looked up.
-torrent-index = índice de torrents
-torrent-index-cap = Índice de torrents

# One downloadable file in a torrent index. Not a place episodes come from.
-release = lanzamiento
-release-cap = Lanzamiento
-release-pl = lanzamientos
-release-cap-pl = Lanzamientos

# One release that holds many episodes.
-batch = lote
-batch-cap = Lote

# A phone, tablet, TV or computer running anistream.
-device = dispositivo
-device-cap = Dispositivo
-device-pl = dispositivos
-device-cap-pl = Dispositivos

# The button that resumes the show.
-continue = continuar viendo
-continue-cap = Continuar viendo

# The episode that plays after this one.
-up-next = siguiente
-up-next-cap = Siguiente

# The audio setting's two values.
-subbed = subtitulado
-subbed-cap = Subtitulado
-dubbed = doblado
-dubbed-cap = Doblado
