chrome-header-section = { -app-name } · { $section }
chrome-meta-chip = Metadane { $mark }
chrome-activity-more = +{ $count }
chrome-job-held = { $note }, { $countdown }
overlays-window-position = { $from }–{ $to } z { $total }
overlays-help-page = Strona { $page } z { $pages }
overlays-logs-empty = Dziennik jest na razie pusty
overlays-hint-manual-query = Wpisz, czego szukać, albo zostaw puste dla automatycznego dopasowania.
overlays-hint-kitsu-username = E-mail lub nazwa użytkownika.
overlays-hint-kitsu-password = Twoje hasło zostanie wymienione na token i nie jest zapisywane.
overlays-hint-download-range = 4 dla jednego odcinka, 1-12 dla serii, 7- dla wszystkiego od tego miejsca.
overlays-hint-edit-setting = Wpisz nową wartość dla: { $setting }.
overlays-hint-join-store = Wklej zaproszenie lub link, który dostałeś, aby dołączyć.
overlays-hint-invite-name = Imię osoby, tak jak pojawi się na liście członków.
overlays-heading-plugin = { $name }   { $version }  ·  z { $store }
overlays-heading-invite-for = Dla: { $name }
overlays-title-link-device = Link: inne { -device-pl }
overlays-heading-open-link-of = { $store }
overlays-heading-publish-to = Do { $store }
overlays-heading-disambiguate = Dopasowanie dla: { $name }
overlays-heading-watch-order = Wokół: { $name }
overlays-heading-recommendations = Bo polubiłeś: { $name }
overlays-heading-release = Inne { -source-pl } uzupełniają braki.
overlays-heading-source = { $name }
overlays-heading-releases = Odcinek { $episode }. Enter odtwarza wybór.
overlays-heading-releases-bare = Enter odtwarza wybór.
toast-download-done = Już pobrane. Naciśnij { $delete }, aby usunąć je wraz z plikiem.
toast-nothing-selected = Nic nie jest zaznaczone. Najpierw wybierz tytuł.
toast-ranges-elsewhere = Zakresy są dodawane do kolejki z tabeli odcinków.
toast-filters-elsewhere = Filtry są w wyszukiwaniu i w tabeli odcinków.
toast-watched-elsewhere = Oznaczenia obejrzanych są w tabeli odcinków.
toast-at-top = Jesteś na górze. Naciśnij { $quit }, aby wyjść.
toast-works-elsewhere = { $action } działa { $place }.
toast-bug-report-opening = Otwieranie zgłoszenia błędu w przeglądarce. Link jest w dzienniku.
tui-log-bug-report-link = Zgłoszenie błędu: { $url }
toast-keybinding-not-applied = Skrót nie został zastosowany: { $problem }. Sprawdź sekcję skrótów w pliku konfiguracji.
tui-config-problem = { $file }: { $what }. Do czasu naprawy używane są ustawienia domyślne.
tui-config-problem-at-line = { $file }, wiersz { $line }: { $what }. Do czasu naprawy używane są ustawienia domyślne.
tui-config-problem-logged = { $path }: { $problem }. Używane są ustawienia domyślne.
chrome-status-state = { $source } · { $audio } · { $quality }p
