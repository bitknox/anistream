# The product name. It is never translated.
-app-name = anistream

# A site or feed anistream reads episodes from. Never "provider".
-source = źródło
-source-cap = Źródło
-source-pl = źródła
-source-cap-pl = Źródła

# A WebAssembly add-on that supplies a source.
-plugin = wtyczka
-plugin-cap = Wtyczka
-plugin-pl = wtyczki
-plugin-cap-pl = Wtyczki

# The invite-based list plugins are installed from.
-plugin-store = sklep z wtyczkami
-plugin-store-cap = Sklep z wtyczkami
-plugin-store-pl = sklepy z wtyczkami
-plugin-store-cap-pl = Sklepy z wtyczkami

# A plugin store on second mention, once the sentence has already said "plugin store". Short forms for tight places such as the terminal. Never the first mention.
-store = sklep
-store-cap = Sklep

# Shows you have saved, with status.
-library = biblioteka
-library-cap = Biblioteka

# AniList, Kitsu and similar accounts anistream updates.
-tracker = tracker
-tracker-cap = Tracker
-tracker-pl = trackery
-tracker-cap-pl = Trackery

# Watching in sync with other people. Never "watch together".
-watch-party = wspólne oglądanie
-watch-party-cap = Wspólne oglądanie
-watch-party-pl = wspólne oglądania
-watch-party-cap-pl = Wspólne oglądania

# Where releases are looked up.
-torrent-index = indeks torrentów
-torrent-index-cap = Indeks torrentów

# One downloadable file in a torrent index. Not a place episodes come from.
-release = wydanie
-release-cap = Wydanie
-release-pl = wydania
-release-cap-pl = Wydania

# One release that holds many episodes.
-batch = paczka
-batch-cap = Paczka

# A phone, tablet, TV or computer running anistream.
-device = urządzenie
-device-cap = Urządzenie
-device-pl = urządzenia
-device-cap-pl = Urządzenia

# The button that resumes the show.
-continue = kontynuuj oglądanie
-continue-cap = Kontynuuj oglądanie

# The episode that plays after this one.
-up-next = następny
-up-next-cap = Następny

# The audio setting's two values.
-subbed = z napisami
-subbed-cap = Z napisami
-dubbed = z dubbingiem
-dubbed-cap = Z dubbingiem
