# The product name. It is never translated.
-app-name = anistream

# A site or feed anistream reads episodes from. Never "provider".
-source = sumber
-source-cap = Sumber
-source-pl = sumber-sumber
-source-cap-pl = Sumber-sumber

# A WebAssembly add-on that supplies a source.
-plugin = plugin
-plugin-cap = Plugin
-plugin-pl = plugin-plugin
-plugin-cap-pl = Plugin-plugin

# The invite-based list plugins are installed from.
-plugin-store = toko plugin
-plugin-store-cap = Toko plugin
-plugin-store-pl = toko-toko plugin
-plugin-store-cap-pl = Toko-toko plugin

# A plugin store on second mention, once the sentence has already said "plugin store". Short forms for tight places such as the terminal. Never the first mention.
-store = toko
-store-cap = Toko

# Shows you have saved, with status.
-library = pustaka
-library-cap = Pustaka

# AniList, Kitsu and similar accounts anistream updates.
-tracker = pelacak
-tracker-cap = Pelacak
-tracker-pl = pelacak-pelacak
-tracker-cap-pl = Pelacak-pelacak

# Watching in sync with other people. Never "watch together".
-watch-party = nonton bareng
-watch-party-cap = Nonton bareng
-watch-party-pl = nonton bareng
-watch-party-cap-pl = Nonton bareng

# Where releases are looked up.
-torrent-index = indeks torrent
-torrent-index-cap = Indeks torrent

# One downloadable file in a torrent index. Not a place episodes come from.
-release = rilis
-release-cap = Rilis
-release-pl = rilis
-release-cap-pl = Rilis

# One release that holds many episodes.
-batch = paket
-batch-cap = Paket

# A phone, tablet, TV or computer running anistream.
-device = perangkat
-device-cap = Perangkat
-device-pl = perangkat
-device-cap-pl = Perangkat

# The button that resumes the show.
-continue = lanjutkan menonton
-continue-cap = Lanjutkan menonton

# The episode that plays after this one.
-up-next = berikutnya
-up-next-cap = Berikutnya

# The audio setting's two values.
-subbed = bersubtitle
-subbed-cap = Bersubtitle
-dubbed = berdubbing
-dubbed-cap = Berdubbing
