store-joined = Bergabung dengan { $store } sebagai { $member }.
store-joined-unnamed = Bergabung dengan { $store } tanpa nama.
store-left = Keluar dari { $store }. { -plugin-pl } tetap terpasang.
plugin-removed = { $plugin } dihapus.
store-member-removed = Anggota dihapus, dan { -device-pl } miliknya tidak lagi bekerja dengan { -plugin-store } ini.
store-invite-cancelled = Undangan dibatalkan. Tautannya tidak lagi berfungsi.
store-open-join-on = Siapa pun yang memiliki tautan { -plugin-store } ini bisa bergabung sekarang. Salin dari layar anggota.
store-open-join-off = Hanya orang yang Anda undang yang bisa bergabung sekarang.
store-open-join-off-devices = { $devices ->
   *[other] Hanya orang yang Anda undang yang bisa bergabung sekarang. { $devices } { -device-pl } yang bergabung lewat tautan tetap berfungsi sampai Anda menghapusnya.
 }
store-device-removed = Satu { -device } itu tidak lagi bekerja dengan { -plugin-store } ini.
store-devices-removed = Semua { -device } yang bergabung lewat tautan sudah dihapus.
plugin-published = { $plugin } { $version } diterbitkan.
plugin-unpublished = { $plugin } tidak lagi ditawarkan.
store-admin-opened = Halaman admin dibuka di peramban Anda. Tautannya hanya bisa dipakai sekali, selama 10 menit.
store-admin-open-failed = Tidak bisa membuka peramban ({ $reason }). Di mesin { -plugin-store }, jalankan "{ -app-name } store admin" untuk mencetak tautan.
plugin-installed-unused = Terpasang { $plugin } { $version }, tetapi { -plugin-pl } dimatikan di urutan { -source }, jadi tidak dipakai.
plugin-installed-name-clash = Terpasang { $plugin }, tetapi { $id } adalah nama { -source } bawaan, jadi tidak dimuat.
plugin-installed = Terpasang { $plugin } { $version }.
plugin-installed-not-loaded = Terpasang { $plugin }, tetapi tidak bisa dimuat. { $reason }
plugin-updates-ready = { $count ->
   *[other] { $count } pembaruan { -plugin } siap: { $names }.
 }
plugins-load-failed = Tidak bisa memuat { -plugin-pl }. { $reason }
store-token-missing = Tidak ada token untuk { $store } di { -device } ini. Bergabung lagi dengan undangan baru.
store-not-joined = Anda tidak lagi bergabung dengan { -plugin-store } itu.
store-key-damaged = Kunci untuk { -plugin-store } ini di { -device } ini rusak. Keluar dari { -plugin-store }, lalu bergabung lagi dengan undangan baru.
store-device-refused = { $store } tidak lagi menerima { -device } ini. Bergabung lagi dengan undangan baru.
store-unreachable = Tidak bisa menjangkau { $store }. { $reason }
store-moved = { $store } sudah bergabung di { $current }, tetapi tautan ini mengarah ke { $target }. Jika { -plugin-store } sudah pindah, keluar dulu, lalu bergabung lagi.
store-join-would-unname = Anda sudah bergabung dengan { $store } sebagai { $member }. Tautan ini akan bergabung lagi tanpa nama Anda, jadi tidak ada yang diubah.
store-not-the-invited = { $url } bukan { -plugin-store } dalam undangan ({ $reason }). Tidak ada yang bergabung.
store-token-not-kept = Tidak bisa menyimpan token untuk { -plugin-store } ini. { $reason }
store-invite-unusable = Undangan itu sudah dipakai, dibatalkan, atau kedaluwarsa. Minta yang baru.
store-open-link-unusable = Tautan itu sudah tidak mengizinkan siapa pun bergabung. Minta tautan atau undangan baru dari pemilik { -plugin-store }.
plugin-reserved-name = { $plugin } adalah nama { -source } bawaan, jadi tidak bisa menjadi { -plugin }.
store-plugin-withdrawn = { $store } tidak lagi menawarkan { $plugin }.
store-plugin-changed = { $store } mengubah { $plugin } setelah ditampilkan. Lihat lagi sebelum memasangnya.
plugin-from-other-store = { $plugin } dipasang dari { $store }, yang menjaganya tetap diperbarui.
plugin-duplicate-file = { $path } sudah mendeklarasikan { $plugin }. Hapus file itu dulu, atau dua salinan akan berjalan.
plugin-install-failed = Tidak bisa memasang { $plugin }. { $reason }
plugin-publish-failed = Tidak bisa menerbitkan { $plugin }. { $reason }
plugin-missing-locally = { $plugin } tidak lagi ada di folder { -plugin }.
store-invite-needs-link = Anda sudah bergabung dengan { $store } dari { -device } ini lewat tautan. Tempelkan tautan yang sama di { -device } lain.
store-link-malformed = Tautan yang dikirim { -plugin-store } tidak berfungsi. Minta pemiliknya memeriksa { -plugin-store }. { $reason }
store-link-wrong-key = Tautan dari { -plugin-store } ini memakai kunci yang berbeda. Periksa alamat tempat { -plugin-store } itu dijalankan.
store-admin-missing = { $store } tidak punya halaman admin. Servernya mungkin versi lama.
store-admin-link-foreign = { $store } mengirim tautan admin untuk alamat lain.
store-open-join-unsupported = Server { $store } versi lama dan tidak bisa mengizinkan siapa pun bergabung lewat tautan. Perbarui dulu.
source-switched-off = { $name } dimatikan. Tidak diperiksa saat mencari episode.
source-switched-on = { $name } dinyalakan.
plugin-not-loaded = { $id } tidak dimuat. Periksa apakah sudah terpasang di { -source-cap-pl }.
release-pinned = { $name } akan dipakai untuk judul ini.
notice-choice-not-saved = Pilihan itu tidak bisa disimpan. { $reason }
torrent-check-failed-running = Pemeriksaan koneksi gagal. Torrent tetap berjalan.
torrent-vpn-waiting = Torrent mulai setelah penjaga VPN lolos. { $reason }
torrent-vpn-unverified = Torrent mulai setelah penjaga VPN lolos. Koneksi belum diverifikasi.
torrent-no-index = Torrent butuh { -torrent-index }. { -app-name } tidak menyediakannya, jadi tambahkan alamat Anda sendiri di pengaturan.
torrent-interface-closed = { -app-name } ditutup sebelum torrent mulai.
torrent-session-failed = Tidak bisa memulai sesi torrent. { $reason }
torrent-no-kill-switch = Tidak ada yang menghentikan lalu lintas torrent di { -device } ini jika VPN terputus. Jalankan "{ -app-name } --doctor" untuk mengaturnya.
torrent-not-checked = Tidak bisa memeriksa koneksi. { $reason }
sources-reloaded-torrents-pending = { -source-cap-pl } dimuat ulang. Torrent mulai setelah penjaga VPN lolos.
sources-reloaded-torrents-off = Torrent dimatikan. Sesinya dihentikan.
job-anilist-limit = Menunggu batas permintaan AniList
notice-anilist-limit = Menunggu { $wait } karena batas permintaan AniList.
notice-anilist-unreachable = AniList tidak menjawab. Untuk sementara menampilkan data dari layanan lain.
notice-metadata-cached = Tidak ada layanan metadata yang menjawab. Menampilkan data terakhir yang tersimpan.
notice-anilist-back = AniList sudah kembali.
notice-party-not-built = { -watch-party-cap-pl } tidak disertakan di aplikasi ini.
