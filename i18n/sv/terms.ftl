# The product name. It is never translated.
-app-name = anistream

# A site or feed anistream reads episodes from. Never "provider".
-source = källa
-source-cap = Källa
-source-pl = källor
-source-cap-pl = Källor

# A WebAssembly add-on that supplies a source.
-plugin = tillägg
-plugin-cap = Tillägg
-plugin-pl = tillägg
-plugin-cap-pl = Tillägg

# The invite-based list plugins are installed from.
-plugin-store = tilläggsbutik
-plugin-store-cap = Tilläggsbutik
-plugin-store-pl = tilläggsbutiker
-plugin-store-cap-pl = Tilläggsbutiker

# A plugin store on second mention, once the sentence has already said "plugin store". Short forms for tight places such as the terminal. Never the first mention.
-store = butik
-store-cap = Butik

# Shows you have saved, with status.
-library = bibliotek
-library-cap = Bibliotek

# AniList, Kitsu and similar accounts anistream updates.
-tracker = spårningstjänst
-tracker-cap = Spårningstjänst
-tracker-pl = spårningstjänster
-tracker-cap-pl = Spårningstjänster

# Watching in sync with other people. Never "watch together".
-watch-party = gemensam tittning
-watch-party-cap = Gemensam tittning
-watch-party-pl = gemensamma tittningar
-watch-party-cap-pl = Gemensamma tittningar

# Where releases are looked up.
-torrent-index = torrentindex
-torrent-index-cap = Torrentindex

# One downloadable file in a torrent index. Not a place episodes come from.
-release = utgåva
-release-cap = Utgåva
-release-pl = utgåvor
-release-cap-pl = Utgåvor

# One release that holds many episodes.
-batch = paket
-batch-cap = Paket

# A phone, tablet, TV or computer running anistream.
-device = enhet
-device-cap = Enhet
-device-pl = enheter
-device-cap-pl = Enheter

# The button that resumes the show.
-continue = fortsätta titta
-continue-cap = Fortsätt titta

# The episode that plays after this one.
-up-next = nästa
-up-next-cap = Nästa

# The audio setting's two values.
-subbed = textat
-subbed-cap = Textat
-dubbed = dubbat
-dubbed-cap = Dubbat
